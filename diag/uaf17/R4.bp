// R4 — R3 con DOS threads. Aquí entra la concurrencia de verdad.
module R4
  public class C
    public property v: integer
    public function C(v_: integer)
      v := v_
    end C
  end C

  public class W extends Thread
    public function W()
      super(1000)
    end W
    public function run()
      var s: integer := 0
      var i: integer := 1
      while i <= 200 do
        var c: C := C(i)
        s := s + c.v
        i := i + 1
      endwh
    end run
  end W

  function Main()
    var w1: W := W()
    var w2: W := W()
    w1.start()
    w2.start()
    w1.join()
    w2.join()
    print "R4 ok"
  end Main
end R4
