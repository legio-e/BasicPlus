// R5 — R4 + los workers guardan su resultado en un CAMPO y se lee tras el join.
// Es lo último que le falta al original: leer estado del thread desde fuera.
module R5
  public class C
    public property v: integer
    public function C(v_: integer)
      v := v_
    end C
  end C

  public class W extends Thread
    var total: integer
    public function W()
      super(1000)
      total := 0
    end W
    public function run()
      var s: integer := 0
      var i: integer := 1
      while i <= 200 do
        var c: C := C(i)
        s := s + c.v
        i := i + 1
      endwh
      total := s
    end run
    public function getTotal(): integer
      return this.total
    end getTotal
  end W

  function Main()
    var w1: W := W()
    var w2: W := W()
    w1.start()
    w2.start()
    w1.join()
    w2.join()
    print "w1 =", w1.getTotal()
    print "w2 =", w2.getTotal()
    print "R5 ok (esperado 20100 los dos)"
  end Main
end R5
