// R3 — R2 + run() ALOCA 200 objetos. Un solo thread.
module R3
  public class C
    public property v: integer
    public function C(v_: integer)
      v := v_
    end C
  end C

  public class W extends Thread
    public function W()
      super(1000)
    end W
    public function run()
      var s: integer := 0
      var i: integer := 1
      while i <= 200 do
        var c: C := C(i)
        s := s + c.v
        i := i + 1
      endwh
    end run
  end W

  function Main()
    var w: W := W()
    w.start()
    w.join()
    print "R3 ok"
  end Main
end R3
