// R2 — R1 + run() hace cuentas. Sigue SIN alocar nada.
module R2
  public class W extends Thread
    public function W()
      super(1000)
    end W
    public function run()
      var s: integer := 0
      var i: integer := 1
      while i <= 200 do
        s := s + i
        i := i + 1
      endwh
    end run
  end W

  function Main()
    var w: W := W()
    w.start()
    w.join()
    print "R2 ok"
  end Main
end R2
