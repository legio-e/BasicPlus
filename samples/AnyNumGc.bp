// Seguridad de #14: un slot que el GC TRAZA y que contiene un NÚMERO, no una
// referencia. markObject hace mark_recursive(número) → debe VALIDAR y saltarlo,
// sin crash. Peor caso: -1 (todos los bits altos) y 0x40000001 (que PARECE un
// handle tageado idx=1). Esperado: n=-1 / m=1073741825 / fin, sin crash.
//
// #389 — el número entraba antes por un campo `Object`, cuando `Object` era un
// alias de `any`. Ya no: `Object` es la raíz del modelo de objetos y un escalar
// no entra sin envolver, que es EXACTAMENTE lo que #389 buscaba. Pero el caso
// que este sample vigila sigue siendo real, porque `List.add` toma `any` —el
// comodín interno del compilador— y guarda el número crudo en un array de refs
// que el GC recorre entero. Así que se prueba por ahí, que es donde vive hoy.
//
// ⚠️ El día que `List` pase también a `Object`, este camino desaparece de fuente
// BP: entonces habrá que decidir si el test se retira (porque el modelo hace el
// fallo inalcanzable) o se fuerza desde la VM. No envolverlo en `Integer(...)`
// para "arreglarlo": eso deja el sample verde SIN PROBAR NADA, porque entonces
// lo que hay en el slot es una referencia de verdad.
module AnyNumGc
  class Box
    var l: List
    public function Box()
      this.l := List()
    end Box
    public function put(x: integer)
      this.l.add(x)
    end put
    public function getInt(): integer
      return this.l.getInteger(0)
    end getInt
  end Box

  function churn()
    var i: integer := 0
    while i < 50 do
      var junk: Box := Box()
      i := i + 1
    endwh
  end churn

  function Main()
    var b: Box := Box()
    b.put(-1)
    churn()
    print "n =", b.getInt()
    var c: Box := Box()
    c.put(1073741825)    // 0x40000001 = TAG|1: parece handle
    churn()
    print "m =", c.getInt()
    print "fin"
  end Main
end AnyNumGc
