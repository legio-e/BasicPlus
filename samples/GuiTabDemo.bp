// GuiTabDemo.bp — H6 tanda 6: tabview (pestañas).
//
// addTab devuelve la página (un Component) donde se cuelgan los hijos; `active`
// es el índice de la pestaña visible, y cambiarla levanta onChange.
//
// MIGRADO a eventos H5.c (#324): antes una subclase de Gui.Tabview sólo para
// reescribir onChange. Convención: <componente>_<evento>.
module GuiTabDemo
  import Gui

  class Panel
    function event tv_onChange(quien: Gui.Component)
      print "[tabview] cambio de pestana"
    end tv_onChange
  end Panel

  function Main()
    var scr: Gui.Screen := Gui.Screen()
    var p: Panel := Panel()

    var tv: Gui.Tabview := Gui.Tabview(scr)
    tv.onChange := p::tv_onChange

    var p1: Gui.Component := tv.addTab("Uno")
    var l1: Gui.Label := Gui.Label(p1, "Pagina 1")

    var p2: Gui.Component := tv.addTab("Dos")
    var l2: Gui.Label := Gui.Label(p2, "Pagina 2")

    tv.active := 1

    print "== widgets =="
    print Gui.__guiDumpTree()

    Gui.__guiChange(tv)          // simula el cambio de pestaña activa
    Gui.run()
  end Main

end GuiTabDemo
