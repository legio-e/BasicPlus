// EvThrow — un handler de evento que se protege a sí mismo.
//
// La regla: si una excepción se escapa de un handler, se lleva por delante el
// programa entero, igual que cualquier otra que nadie atrape. Y en la placa eso
// es peor de lo que parece, porque la VM-C todavía no imprime la traza: te
// quedas con un código de salida y sin saber de dónde vino (H13, 3-ago).
//
// Así que la forma correcta es la que enseña este ejemplo: el handler atrapa lo
// suyo. El despacho sigue, el programa llega a "fin" y termina de forma regular.
//
// Antes esto se demostraba al revés —dejando que reventara— y no valía: un
// ejemplo que muere callado no enseña nada. Lo que pasa cuando NO se atrapa
// queda dicho aquí arriba, que es donde se lee.
//
// Esperado:
//   handler n=1
//   el handler atrapó lo suyo: revienta el handler
//   fin
module EvThrow

  class Boton
    event onClick(n: integer)
    public function Boton()
    end Boton
    public function pulsa(n: integer)
      raise onClick(n)
    end pulsa
  end Boton

  class Panel
    public function Panel()
    end Panel
    function event pulsado(n: integer)
      print("  handler n=" + n)
      try
        throw RuntimeError("revienta el handler")
      catch e: Core.Exception
        print("  el handler atrapó lo suyo: " + e.msg)
      endtry
    end pulsado
  end Panel

  public function main()
    var b: Boton := Boton()
    var p: Panel := Panel()
    b.onClick := p::pulsado
    b.pulsa(1)
    var i: integer
    for i := 1 to 6 do
      sleep(5)
    next
    print("fin")
  end main

end EvThrow
