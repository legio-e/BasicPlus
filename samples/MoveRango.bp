module MoveRango
  // #535 (V7) — `move(src, dst, srcStart, dstStart, count)` con cada tipo de array y cada error.
  // Antes, la VM-C no comprobaba nada: con un null o count <= 0 volvía en silencio, un move fuera
  // de rango escribía FUERA del array y copiaba 4 B por elemento aunque el array fuera de bytes o
  // de 8 B (long[], double[], refs). Y miVM rechazaba long[] y double[] («no es un array
  // (type=5)»). Paridad: el mismo stdout en las dos VMs, errores incluidos.

  public class Caja
    var n: integer
    public function Caja(x: integer)
      this.n := x
    end Caja
    public function valor(): integer
      return this.n
    end valor
  end Caja

  function lista(a: integer[], n: integer): string
    var s: string := ""
    var i: integer := 0
    while i < n do
      if i > 0 then
        s := s + " "
      endif
      s := s + a[i]
      i := i + 1
    endwh
    return s
  end lista

  function Main()
    // 1. integer[]: de un array a otro, y dentro del mismo (solapado, en los dos sentidos)
    var src: integer[] := [10, 20, 30, 40, 50]
    var dst: integer[] := newIntArray(5)
    move(src, dst, 1, 0, 3)
    print "integer[]      " + lista(dst, 5)
    var a: integer[] := [1, 2, 3, 4, 5]
    move(a, a, 0, 1, 4)
    print "a la derecha   " + lista(a, 5)
    move(a, a, 1, 0, 4)
    print "a la izquierda " + lista(a, 5)
    move(a, a, 5, 5, 0)
    print "count 0 al final: nada que copiar"

    // 2. byte[]: un byte por elemento (la VM-C copiaba 4 y pisaba a los vecinos)
    var bs: byte[] := newByteArray(6)
    var bd: byte[] := newByteArray(6)
    var i: integer := 0
    while i < 6 do
      bs[i] := byte(i + 1)
      bd[i] := byte(0xAA)
      i := i + 1
    endwh
    move(bs, bd, 0, 2, 2)
    print "byte[]         " + bd[0] + " " + bd[1] + " " + bd[2] + " " + bd[3] + " " + bd[4] + " " + bd[5]

    // 3. long[] y double[]: 8 B por elemento (miVM decía «no es un array»; la VM-C copiaba 4)
    var ls: long[] := newLongArray(3)
    ls[0] := 5000000000L
    ls[1] := -7L
    ls[2] := 123456789012L
    var ld: long[] := newLongArray(3)
    move(ls, ld, 0, 0, 3)
    print "long[]         " + ld[0] + " " + ld[1] + " " + ld[2]
    var ds: double[] := newDoubleArray(2)
    ds[0] := 1.5
    ds[1] := -2.25
    var dd: double[] := newDoubleArray(2)
    move(ds, dd, 0, 0, 2)
    print "double[]       " + dd[0] + " " + dd[1]

    // 4. arrays de referencias: 8 B por elemento (la VM-C copiaba media referencia)
    var os: Caja[] := [Caja(7), Caja(8), Caja(9)]
    var od: Caja[] := [Caja(0), Caja(0), Caja(0)]
    move(os, od, 0, 0, 3)
    print "Caja[]         " + od[0].valor() + " " + od[1].valor() + " " + od[2].valor()
    var oo: Object[] := newObjArray(2)
    move(os, oo, 1, 0, 2)
    var c1: Caja := Caja(oo[1])
    print "Object[]       " + c1.valor()
    var ss: string[] := ["uno", "dos", "tres"]
    var sd: string[] := ["", "", ""]
    move(ss, sd, 1, 0, 2)
    print "string[]       " + sd[0] + " " + sd[1] + " [" + sd[2] + "]"

    // 5. los errores, uno a uno
    var nulo: integer[]
    try
      move(nulo, dst, 0, 0, 1)
      print "no deberia llegar"
    catch e1: Core.Exception
      print e1.msg
    endtry
    try
      move(src, nulo, 0, 0, 1)
      print "no deberia llegar"
    catch e2: Core.Exception
      print e2.msg
    endtry
    try
      move(nulo, nulo, 0, 0, 0)
      print "no deberia llegar"
    catch e3: Core.Exception
      print e3.msg + "  (con count 0 tambien)"
    endtry
    var caja: Caja := Caja(1)
    try
      move(caja, dst, 0, 0, 1)
      print "no deberia llegar"
    catch e4: Core.Exception
      print e4.msg
    endtry
    try
      move(src, caja, 0, 0, 1)
      print "no deberia llegar"
    catch e5: Core.Exception
      print e5.msg
    endtry
    try
      move(src, ld, 0, 0, 1)
      print "no deberia llegar"
    catch e6: Core.Exception
      print e6.msg
    endtry
    try
      move(bs, dst, 0, 0, 1)
      print "no deberia llegar"
    catch e7: Core.Exception
      print e7.msg
    endtry
    try
      move(src, dst, 0, 0, -1)
      print "no deberia llegar"
    catch e8: Core.Exception
      print e8.msg
    endtry
    try
      move(src, dst, -1, 0, 1)
      print "no deberia llegar"
    catch e9: Core.Exception
      print e9.msg
    endtry
    try
      move(src, dst, 0, -2, 1)
      print "no deberia llegar"
    catch e10: Core.Exception
      print e10.msg
    endtry
    try
      move(src, dst, 3, 0, 3)
      print "no deberia llegar"
    catch e11: Core.Exception
      print e11.msg
    endtry
    var testigo: integer[] := [0, 0, 0, 0, 0]
    try
      move(src, testigo, 0, 4, 2)
      print "no deberia llegar"
    catch e12: Core.Exception
      print e12.msg
    endtry
    print "el destino, intacto: " + lista(testigo, 5)
    try
      move(src, dst, 2147483647, 0, 1)
      print "no deberia llegar"
    catch e13: Core.Exception
      print e13.msg
    endtry
    try
      move(src, dst, 6, 0, 0)
      print "no deberia llegar"
    catch e14: Core.Exception
      print e14.msg + "  (count 0 pasado el final)"
    endtry
    print "fin"
  end Main
end MoveRango
