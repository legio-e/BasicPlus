// fromtest.bp — la SINTAXIS de `import X from "ruta"`. Los dos modulos no
// existen a proposito: el frontend avisa («no se localizo ... se omitira») y
// compila igual, que es lo que este ejemplo demuestra. No es un import roto.
library "test.app"
module FromTest

  import OtherMod from "external/other.mod"
  import lib.Util from "../shared/util.mod"

  function Main()
    print "[FromTest] imports declarados con 'from'"
    print "  (ningun CALL_EXT generado todavia)"
  end Main

end FromTest
