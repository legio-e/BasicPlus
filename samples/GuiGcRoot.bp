// GuiGcRoot.bp — repro #302 paso 3 (host): el objeto BP ligado a un widget
// cuyo UNICO holder es el propio widget (objptr en gui.c, fuera de vm->memory).
// makeButton() crea el boton Y su oyente en locales que MUEREN al volver -> sin
// la raiz GUI, gc() los barre EN VIVO y el clic real es un use-after-free.
//
// MIGRADO a eventos H5.c (#324), y la prueba sale REFORZADA: ahora la cadena que
// tiene que sobrevivir es de dos eslabones — el widget lo sostiene el objptr, y
// el widget sostiene al oyente por el campo `recv` del evento, que el layout
// marca como referencia para el GC. Si ese bit faltara, el oyente moriria aqui.
module GuiGcRoot
  import Gui

  class Pantalla
    public property target: Gui.Label

    function event btn_onClick(quien: Gui.Component)
      print "[onClick] vivo tras gc()"
      this.target.setText("PULSADO")
    end btn_onClick
  end Pantalla

  // El boton y su oyente se crean AQUI: al volver, la unica referencia viva al
  // widget es el objptr (C global de gui.c), y al oyente solo lo sostiene el
  // campo recv del evento.
  function makeButton(scr: Gui.Screen, lbl: Gui.Label)
    var pant: Pantalla := Pantalla()
    pant.target := lbl
    var btn: Gui.Button := Gui.Button(scr, "Pulsame")
    btn.onClick := pant::btn_onClick
    btn.align(Gui.Align.CENTER, 0, 0)
  end makeButton

  function Main()
    var scr: Gui.Screen := Gui.Screen()
    var lbl: Gui.Label := Gui.Label(scr, "esperando")
    lbl.align(Gui.Align.TOP_MID, 0, 10)

    makeButton(scr, lbl)

    gc()                          // sin raiz GUI: barreria el boton en vivo

    print "== tras gc() =="

    Gui.run()                     // clic real via BPVM_GUI_SCRIPT -> dispatch

    print "== al salir =="
    print Gui.__guiDumpTree()
  end Main

end GuiGcRoot
