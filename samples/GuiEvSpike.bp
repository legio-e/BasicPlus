// GuiEvSpike.bp — SPIKE de #324. No es una demo: es una MEDIDA.
//
// LA PREGUNTA ORIGINAL. El backend llamaba, desde dentro de __guiRun(), a
// Gui.__guiDispatch(self) -> self.onClick(), que corria SINCRONO. Al pasar el
// GUI a eventos H5.c ese onClick pasa a ser un `raise`, que ENCOLA y se drena
// entre quanta. Se drena antes de que Gui.run() devuelva, o despues?
//
// RESULTADO (30-jul). Salio lo peor: "3 handler" NO aparecia. El lazo del GUI
// vivia DENTRO del builtin __guiRun(), y ahi no hay quanta — el scheduler solo
// inyecta el frame del handler ENTRE quanta, asi que el evento se quedaba en la
// cola para siempre. Arreglado partiendo el bombeo en __guiRunOnce() y subiendo
// el lazo a BP (Gui.run()), donde cada vuelta es frontera de instruccion. La
// condicion de salida tuvo que incluir "quedan eventos BP encolados", no solo
// "quedan clics": con lo segundo el lazo salia antes del drenaje.
//
// QUE MIDE HOY. Lo mismo, un escalon mas arriba: el clic ya ES un evento, y su
// handler levanta OTRO evento. Si el segundo tambien se drena dentro de run(),
// el bombeo aguanta eventos anidados y no solo el primer nivel.
//
// LECTURA DEL RESULTADO — el orden de las lineas lo dice todo:
//   "3 handler" ANTES de "4 tras run"  -> el drenaje ocurre DENTRO de run().
//   "3 handler" DESPUES de "4 tras run" -> el evento anidado se difiere.
//   No sale "3 handler"                 -> el anidado no se drena nunca.
module GuiEvSpike
  import Gui

  // El que ESCUCHA el segundo salto. Su handler solo deja constancia de CUANDO corre.
  class Testigo
    function event alPulsar(quien: Object)
      print "3 handler (el evento se ha drenado)"
    end alPulsar
  end Testigo

  // El de en medio: escucha el clic del boton y, desde DENTRO de ese handler,
  // levanta su propio evento. Ahi es donde se mide el anidamiento.
  class Puente
    event pulsado(quien: Object)

    function event btn_onClick(quien: Gui.Component)
      print "2 dentro del upcall (justo antes del raise)"
      raise pulsado(this)
    end btn_onClick
  end Puente

  public function Main()
    var scr: Gui.Screen := Gui.Screen()
    var btn: Gui.Button := Gui.Button(scr, "spike")

    var t: Testigo := Testigo()
    var pu: Puente := Puente()
    pu.pulsado := t::alPulsar
    btn.onClick := pu::btn_onClick

    print "1 antes del clic"
    Gui.__guiClick(btn)
    Gui.run()
    print "4 tras run()"
  end Main

end GuiEvSpike
