// Medidas.bp — el lado *N* de una relación 1 → N (V5/H5, paso 2).
//
// Éste es el aspecto que tendrá un DAO GENERADO: contesta a las tres preguntas
// del contrato de `Orm.Dao` y pone encima los verbos que necesitan conocer la
// entidad. Todo lo demás —`list`, `selectDonde`, `uno`, `delete(id)`, `close`—
// lo hereda ya escrito.
//
// Comparado con la versión a mano de esta mañana: se han ido 10 métodos.
//
// Un sensor ([[Sensores.bp]]) tiene muchas medidas. Cada tabla, su módulo.
//
// ─── EL REPARTO ────────────────────────────────────────────────────────────
//
//   Medida       una FILA. Datos y nada más: ni SQL, ni conexión, ni saber
//                que existe una base de datos.
//   MedidasDao   la TABLA. TODO el SQL vive aquí y sólo aquí. Quien usa el DAO
//                no escribe una sola sentencia — que es justo para lo que está.
//
// ─── LO QUE SÓLO PUEDE ESTAR AQUÍ ──────────────────────────────────────────
//
//   columnas()   el ORDEN de las columnas
//   read(q)      fila -> Medida, leyendo EN ESE ORDEN
//
// Son el mismo contrato dicho dos veces, y por eso están pegados: si uno cambia
// y el otro no, no salta ningún error — devuelve datos mal, callado. Que es
// peor que romperse.
//
//   insert / update    leen los campos de la entidad, así que la base no puede
//                      escribirlos por nosotros.
//
// ─── LO QUE UN GENERADOR TENDRÍA QUE EMITIR ────────────────────────────────
//
// Exactamente esto, y nada más: 3 respuestas del contrato + `insert`/`update` +
// los `load`/`delete` tipados, que son envoltorios de una línea. Si alguien
// quiere ampliarlo, hereda de esta clase en vez de editarla — así se puede
// regenerar sin perderle nada.
//
// ─── EL FLUJO QUE SUPONE (Eduardo) ─────────────────────────────────────────
//
// La base se diseña en el PC y se copia hecha a la tarjeta. O sea que el DAO
// NO crea tablas ni migra esquemas: se encuentra la tabla puesta y trabaja con
// ella. Un `crearTabla()` aquí sería resolver un problema que el usuario no
// tiene.
//
// ─── LO QUE FALTA, DICHO ───────────────────────────────────────────────────
//
// El SQL se compone concatenando, porque `SQLite.bp` todavía no tiene `bind`.
// Con un texto que lleve un apóstrofo la sentencia se rompe. Decisión de hoy:
// no tocarlo ahora — primero el DAO funcionando, y los mecanismos de SQL
// vienen después. Queda escrito aquí para que nadie lo descubra por su cuenta.

module Medidas
  import SQLite
  import Orm
  import Str

  // ── LA ENTIDAD ────────────────────────────────────────────────────────────
  //
  // `id` es la clave, y la pone la BD: en un objeto recién construido vale 0,
  // que es como se distingue "esto todavía no está guardado".
  //
  // `sensorId` es la clave ajena: el lado *N* de la relación. Un long, no el
  // objeto `Sensor` — el DAO carga filas, no grafos. Quien quiera el sensor lo
  // pide a su DAO, que para eso comparten conexión.
  public class Medida
    public property id:       long
    public property sensorId: long
    public property valor:    double
    public property t:        long

    public function Medida()
      this.id       := 0
      this.sensorId := 0
      this.valor    := 0.0d
      this.t        := 0
    end Medida
  end Medida

  // ── EL DAO ────────────────────────────────────────────────────────────────
  public class MedidasDao extends Orm.Dao

    public function MedidasDao(base: SQLite.Db)
      super(base)
    end MedidasDao

    // ══ LAS TRES DEL CONTRATO ═══════════════════════════════════════════════

    public function tabla(): string
      return "medidas"
    end tabla

    // EL ORDEN. `read` lo respeta, y están pegados a propósito.
    public function columnas(): string
      return "id, sensor_id, valor, t"
    end columnas

    public function read(q: SQLite.Query): Object
      var m: Medida := Medida()
      m.id       := q.getLong(0)
      m.sensorId := q.getLong(1)
      m.valor    := q.getDouble(2)
      m.t        := q.getLong(3)
      return m
    end read

    // ══ LOS VERBOS QUE CONOCEN LA ENTIDAD ═══════════════════════════════════
    //
    // Nombrado de Eduardo: **el verbo pelado toma la ENTIDAD, `...ById` toma la
    // clave**. Una regla y ya está — no hay que recordar qué acepta cada uno, y
    // ningún verbo queda sobrecargado.

    // ── load ────────────────────────────────────────────────────────────────
    //
    // Por CLAVE: devuelve la fila, o null si no está. No lanza — que una fila
    // no exista es algo que PASA, no un fallo del programa. Mismo criterio que
    // `connect`, que devuelve false en vez de romper.
    //
    // Una línea: la base pone el SELECT, el cursor y el mapeo; aquí sólo se
    // estrecha el tipo de Object a Medida.
    public function loadById(id: long): Medida
      return Medida(this.uno("id = " + Str.longToString(id)))
    end loadById

    // Por OBJETO: lo rellena a partir de su propio id. Devuelve si lo encontró.
    public function load(m: Medida): boolean
      var otro: Medida := this.loadById(m.id)
      if otro == null then
        return false
      endif
      this.copiar(otro, m)
      return true
    end load

    // ── refresh ─────────────────────────────────────────────────────────────
    //
    // Releer del disco lo que ya tenías. Hace lo mismo que `load(objeto)`, y
    // existe aparte porque DICE otra cosa: no es "traer", es "volver a traer
    // por si alguien lo cambió". El nombre es la documentación.
    public function refresh(m: Medida): boolean
      return this.load(m)
    end refresh

    // ── insert / add ────────────────────────────────────────────────────────
    //
    // Al volver, el objeto lleva su `id` puesto — el que asignó la BD. Sin eso
    // el llamante tendría que ir a buscarlo, que es justo el trabajo que el DAO
    // viene a quitar.
    public function insert(m: Medida)
      this.db.exec("INSERT INTO " + this.tabla() + "(sensor_id, valor, t) VALUES("
            + Str.longToString(m.sensorId) + ", "
            + Str.doubleToString(m.valor) + ", "
            + Str.longToString(m.t) + ")")
      m.id := this.db.lastInsertId()
    end insert

    // Mismo verbo, otro nombre. Cuesta dos líneas y le ahorra a cada uno tener
    // que recordar cuál de los dos eligió esta librería.
    public function add(m: Medida)
      this.insert(m)
    end add

    // ── update ──────────────────────────────────────────────────────────────
    //
    // Devuelve si tocó alguna fila: false = ese id no estaba. La diferencia
    // entre "actualizado" y "no había nada que actualizar" importa, y sin esto
    // las dos serían indistinguibles.
    public function update(m: Medida): boolean
      this.db.exec("UPDATE " + this.tabla()
            + " SET sensor_id = " + Str.longToString(m.sensorId)
            + ", valor = "        + Str.doubleToString(m.valor)
            + ", t = "            + Str.longToString(m.t)
            + " WHERE id = "      + Str.longToString(m.id))
      return this.db.changes() > 0
    end update

    // ── delete ──────────────────────────────────────────────────────────────
    //
    // `deleteById` lo hereda de `Orm.Dao`: borrar por clave no necesita conocer
    // la entidad. Éste sí, porque además le pone el `id` a 0 — después del
    // borrado ese objeto ya no corresponde a ninguna fila, y dejarle el id
    // viejo invita a volver a usarlo como si existiera.
    public function delete(m: Medida): boolean
      var fue: boolean := this.deleteById(m.id)
      if fue then
        m.id := 0
      endif
      return fue
    end delete

    function copiar(de: Medida, a: Medida)
      a.id       := de.id
      a.sensorId := de.sensorId
      a.valor    := de.valor
      a.t        := de.t
    end copiar

  end MedidasDao

end Medidas
