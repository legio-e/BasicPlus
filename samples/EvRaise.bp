// EvRaise — H5.c: un evento SIN SUSCRIPTOR se ignora.
//
// No es un descuido: un evento es una NOTIFICACIÓN, no una llamada. Si nadie
// escucha no pasa nada — el mismo criterio que los eventos de Swing. Por eso
// este sample corre entero y termina normal aunque `pulsa()` dispare.
//
// Para ver el bytecode del `raise`:
//   java -cp miVM/target/classes edu.bpgenvm.MainDisasm samples/EvRaise.mod
// antes del CALL_BUILTIN [221] van, en orden, los argumentos declarados (cada
// uno en su ancho natural), la máscara ref|ancho, el nº de argumentos, el
// destino (4B) y el receptor (8B) — la cabecera encima para que el despachador
// la saque primero.
module EvRaise

  class Boton
    var id: integer
    // El evento declara SU firma. `veces` tiene valor por defecto, así que
    // `raise onClick(this)` vale.
    event onClick(sender: Boton, veces: integer := 1)
    public function Boton(n: integer)
      this.id := n
    end Boton
    // El propio botón dispara SU evento — nadie más puede.
    public function pulsa()
      raise onClick(this)          // el `veces` omitido lo pone el compilador
    end pulsa
    public function pulsaVarias(n: integer)
      raise onClick(this, n)
    end pulsaVarias
  end Boton

  public function main()
    var b: Boton := Boton(1)
    b.pulsa()
    b.pulsaVarias(5)
    print("nadie escuchaba: los dos disparos se ignoran")
  end main

end EvRaise
