// EvRaise — H5.c paso 3: comprueba que `raise` EMITE bien.
//
// ⚠️ ESTE SAMPLE NO CORRE TODAVÍA, Y ES LO ESPERADO. El `raise` emite
// CALL_BUILTIN 221 (__eventRaise) y ese builtin llega en el PASO 4, con la cola
// y el drenaje. Hasta entonces las dos VMs paran con un mensaje claro
// ("builtin no implementado"), que es el comportamiento correcto.
//
// Se verifica DESENSAMBLANDO, no ejecutando:
//   java -cp miVM/target/classes edu.bpgenvm.MainDisasm samples/EvRaise.mod
// y comprobando que antes del CALL_BUILTIN [221] van, en orden: los argumentos
// declarados (todos de 8 bytes), la máscara de refs, el número de argumentos,
// el destino (4B) y el receptor (8B) — la cabecera encima para que el
// despachador la saque primero.
module EvRaise

  class Boton
    var id: integer
    // El evento declara SU firma: quién lo dispara y con qué datos.
    // `veces` tiene valor por defecto, así que `raise onClick(this)` vale.
    event onClick(sender: Boton, veces: integer := 1)
    public function Boton(n: integer)
      this.id := n
    end Boton
    // El propio botón dispara SU evento — nadie más puede.
    public function pulsa()
      raise onClick(this)          // el `veces` omitido lo pone el compilador
    end pulsa
    public function pulsaVarias(n: integer)
      raise onClick(this, n)
    end pulsaVarias
  end Boton

  public function main()
    var b: Boton := Boton(1)
    b.pulsa()
    print("no se llega aqui hasta el paso 4")
  end main

end EvRaise
