// MoveTest.bp — regresión #6 (racimo miVM): el builtin move(src,dst,...) de miVM
// popeaba src/dst con popTc(4B) y usaba el handle como dirección física SIN
// refDeref. Fix: popTcRef(8B)+refDeref. VM-C ya era correcto → paridad.
module MoveTest
  function Main()
    var src: integer[] := newIntArray(5)
    src[0] := 10
    src[1] := 20
    src[2] := 30
    src[3] := 40
    src[4] := 50
    var dst: integer[] := newIntArray(5)
    move(src, dst, 1, 0, 3)
    print "d0=" + intToString(dst[0])
    print "d1=" + intToString(dst[1])
    print "d2=" + intToString(dst[2])
  end Main
end MoveTest
