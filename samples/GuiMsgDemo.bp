// GuiMsgDemo.bp — H6 tanda 6: msgbox (aviso modal).
//
// setButtons pone las etiquetas \n-separadas; al pulsar una, el índice queda en
// `result` y se levanta onChange.
//
// MIGRADO a eventos H5.c (#324): antes una subclase de Gui.Msgbox sólo para
// reescribir onChange. Convención: <componente>_<evento>.
module GuiMsgDemo
  import Gui

  class Panel
    function event mb_onChange(quien: Gui.Component)
      print "[msgbox] boton pulsado"
    end mb_onChange
  end Panel

  function Main()
    var scr: Gui.Screen := Gui.Screen()
    var p: Panel := Panel()

    var mb: Gui.Msgbox := Gui.Msgbox(scr, "Operacion completada")
    mb.onChange := p::mb_onChange
    mb.setButtons("OK")          // un aviso: con un botón basta (al pulsar, se cierra)

    print "== antes =="
    print Gui.__guiDumpTree()

    mb.result := 0               // simula que se pulsó OK (botón 0)
    Gui.__guiChange(mb)
    Gui.run()

    print "== despues =="
    print Gui.__guiDumpTree()
  end Main

end GuiMsgDemo
