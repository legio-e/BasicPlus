// NatNew — [V6/N1.5] CREAR cosas dentro de una `native`: un array y un objeto.
//
// ─── QUÉ DEMUESTRA ───
//
// Hasta hoy una `native` sabía OPERAR con lo que le pasaran, pero no podía
// FABRICAR nada: `[1,2,3]` abortaba la compilación de esa función y el módulo
// caía a bytecode interpretado. Los cuatro helpers de reserva de la tabla AOT
// eran `return 0` — o sea que, de haberse invocado, el native habría recibido
// una referencia nula y el fallo habría salido lejos del sitio.
//
// ⚠️ Lo que lo bloqueaba de verdad NO era el emisor. Un objeto recién creado
// dentro de una native vive en un local de C, y hasta V5 el GC no miraba ahí:
// fabricarlo era fabricar algo que podía recolectarse en vivo. Lo desatascó
// #302 paso 3 (idea de Eduardo: que el GC escanee la pila de C del native con
// el volcado de registros de setjmp).
//
// ─── QUÉ MIRAR ───
//
//  1. Los tres valores esperados. Son exactos: si el camino compilado y el
//     interpretado difirieran, saldría aquí.
//  2. La salida tiene que ser IDÉNTICA en miVM y en la VM-C (el invariante).
//  3. En placa, `[mdn] 1 bloque(s) nativo(s) desde el propio .mod` en el log.
//
// 📌 Un objeto NO se aloca en C: se construye llamando a su factoría
// `__cls_new_Punto` por el puente, que ejecuta el constructor DE VERDAD en el
// intérprete. Alocar los campos y devolver el ref daría un objeto a medio hacer.
module NatNew

  public class Punto
    public property x: integer
    public property y: integer
    public function Punto(a: integer, b: integer)
      this.x := a
      this.y := b
    end Punto
  end Punto

  // ── 1. Un array de integer creado DENTRO de la native ───────────────────
  native function sumaArray(n: integer): integer
    var v: integer[] := [10, 20, 30, 40]
    var t: integer := 0
    var i: integer := 0
    while i < 4 do
      t += v[i]
      i += 1
    endwh
    return t + n
  end sumaArray

  // ── 2. Un array de long: 8 bytes por casilla (el slot que faltaba) ──────
  native function sumaLargos(): long
    var v: long[] := [3000000000L, 4000000000L]
    return v[0] + v[1]
  end sumaLargos

  // ── 3. Un array de word: DOS bytes por casilla ──────────────────────────
  // Este es el que descubrió el fallo: el emisor elegía el helper por el
  // ancho, y para todo lo que no fuera `byte` elegía el de 4 bytes. Un
  // `word[]` se leía de cuatro en cuatro y un `long[]` de cuatro en ocho.
  // No fallaba: devolvía otro número. Aquí se escribe y se relee dentro de
  // la native, que es el camino que estaba mudo.
  native function tocaPalabras(v: word[]): integer
    v[0] := 1000
    v[1] := 2000
    v[2] := 3000
    return v[0] + v[1] + v[2]
  end tocaPalabras

  // ── 4. Un array de double creado dentro de la native ────────────────────
  native function mediaDobles(): double
    var d: double[] := newDoubleArray(2)
    d[0] := 3.0d
    d[1] := 5.0d
    return (d[0] + d[1]) / 2.0d
  end mediaDobles

  // ── 5. Un array de REFERENCIAS creado dentro de la native ───────────────
  // El más exigente de todos con el GC: el array es una referencia, y CADA
  // elemento es otra referencia recién alocada. Con colecta en cada alocación,
  // rellenar la casilla 1 dispara un GC mientras la 0 sólo la sostiene el
  // propio array. Si `array_store_ref` guardara el handle sin su generación
  // viva, el elemento 0 se leería como objeto muerto — no daría error: daría
  // use-after-free.
  //
  // ⚠️ Sin literales de cadena a propósito: un `.mdn` sólo se lleva `.text` y un
  // literal vive en `.rodata`. Los strings se fabrican con intToString.
  native function largoDeDos(a: integer, b: integer): integer
    var v: string[] := [intToString(a), intToString(b)]
    return len(v[0]) + len(v[1])
  end largoDeDos

  // ── 6. Un array de float ────────────────────────────────────────────────
  native function sumaFloats(): float
    var f: float[] := [1.5, 2.5]
    return f[0] + f[1]
  end sumaFloats

  // ── 7. Un OBJETO creado dentro de la native, leído por sus getters ───────
  native function areaDe(a: integer, b: integer): integer
    var p: Punto := Punto(a, b)
    return p.x * p.y
  end areaDe

  function Main()
    print "== NatNew =="
    print "  sumaArray(5)  =", sumaArray(5), " (esperado 105)"
    print "  sumaLargos()  =", sumaLargos(), " (esperado 7000000000)"
    var w: word[3]
    print "  tocaPalabras()=", tocaPalabras(w), " (esperado 6000)"
    print "  mediaDobles() =", mediaDobles(), " (esperado 4)"
    print "  largoDeDos()  =", largoDeDos(1234, 56), " (esperado 6)"
    print "  sumaFloats()  =", sumaFloats(), " (esperado 4)"
    print "  areaDe(6,7)   =", areaDe(6, 7), " (esperado 42)"
    print "== FIN =="
  end Main

end NatNew
