// CatchSinTipo.bp — #459: un `catch` SIN tipo entrega un valor roto.
//
// Caso mínimo, sacado de que `samples/trytest.bp` imprimiera basura del heap en
// la ESP32-P4. Está aquí y no en samples/ porque COMPILA y EJECUTA: lo que falla
// es la SALIDA, así que no se camufla entre los que fallan al compilar.
//
// Lo que tiene que imprimir cuando esté arreglado:
//   TIPADO   .msg : [con tipo]
//   ---
//   SIN TIPO .msg : [sin tipo]
//   FIN
//
// Lo que imprime hoy: la segunda línea saca bytes del heap (la tabla de símbolos,
// normalmente) porque el emisor trata la variable del catch genérico como si
// fuera un string — ver la ficha.
module CatchSinTipo
  import Core

  function Main()
    try
      throw RuntimeError("con tipo")
    catch e: Core.RuntimeError
      print "TIPADO   .msg :", "[" + e.msg + "]"
    endtry
    print "---"
    try
      throw RuntimeError("sin tipo")
    catch e2
      print "SIN TIPO .msg :", "[" + e2.msg + "]"
    endtry
    print "FIN"
  end Main

end CatchSinTipo
