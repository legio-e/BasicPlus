// H8.2 — tuplas first-class: guardar en var, pasar como parámetro, devolver una
// tupla almacenada, destructuring a lvalues no-simples (arr[i], obj.x) y colecciones.
module TupleFC

  class Point
    public property x: integer
    public property y: integer
    public function Point()
      this.x := 0
      this.y := 0
    end Point
  end Point

  function pair(): (integer, string)
    return (42, "hi")
  end pair

  function coords(): (integer, integer)
    return (10, 20)
  end coords

  // guardar una tupla en una var y destructurarla DESDE la var
  function fStoreVar(): string
    var t: (integer, string) := pair()
    var n: integer := 0
    var s: string := ""
    { n, s } := t
    return s + "/" + intToString(n)
  end fStoreVar

  // tupla como parámetro
  function useTuple(t: (integer, string)): integer
    var n: integer := 0
    var s: string := ""
    { n, s } := t
    return n
  end useTuple

  // devolver una tupla ALMACENADA (no literal)
  function passthrough(): (integer, string)
    var t: (integer, string) := pair()
    return t
  end passthrough

  // El sustituto de "una tupla dentro de una List": una clase con dos
  // propiedades. Cuesta cinco lineas y a cambio los campos tienen nombre.
  class Par
    public property numero: integer
    public property texto: string

    public function Par(n: integer, t: string)
      this.numero := n
      this.texto  := t
    end Par
  end Par

  function main()
    print fStoreVar()                       // hi/42

    var t: (integer, string) := pair()
    print intToString(useTuple(t))          // 42  (var-tupla como argumento)

    var n2: integer := 0
    var s2: string := ""
    { n2, s2 } := passthrough()             // destructurar una tupla devuelta
    print s2                                 // hi

    // destructuring a lvalues no-simples: índice de array
    var arr: integer[] := newIntArray(2)
    { arr[0], arr[1] } := coords()
    print intToString(arr[0] + arr[1])      // 30

    // ... y campos de objeto
    var p: Point := Point()
    { p.x, p.y } := coords()
    print intToString(p.x + p.y)            // 30

    // COLECCIONES: una tupla NO entra en una List, y es a proposito.
    //
    // Hasta V4 colaba, porque `any` era asignable en los dos sentidos. Desde
    // `#389` la raiz del modelo de objetos es `Object` y una tupla no lo es, asi
    // que `lst.add(pair())` ya no compila. Decision de Eduardo (21-ago): se queda
    // asi. La tupla es para DEVOLVER varios valores de una funcion, que es donde
    // gana; para guardarlos, el lenguaje ya tiene dos formas mejores.
    //
    // Quien quiera una coleccion de pares, lo hace como aqui abajo: una clase con
    // sus dos propiedades —que ademas les pone NOMBRE— o un `Map`.
    var lst: List := List()
    var n3: integer := 0
    var s3: string := ""
    { n3, s3 } := pair()
    lst.add(Par(n3, s3))
    var q: Par := Par(lst.get(0))
    print q.texto + intToString(q.numero)   // hi42
  end main

end TupleFC
