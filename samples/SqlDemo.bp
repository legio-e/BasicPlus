// SqlDemo.bp — un registro de medidas en una base de datos (V5/H4).
//
// Enseña las tres formas de hablar con la base, que son las tres que hay:
//
//   1. `exec`      — mandar y ya (CREATE, INSERT, UPDATE, DELETE…)
//   2. `execInt` y compañía — pedir UN dato (un contador, una media)
//   3. `query`     — recorrer filas con un cursor
//
// Y la regla que hace difícil equivocarse: **sólo lo que devuelve `query` hay
// que liberarlo**. Todo lo demás termina solo.
//
// ── PARA CORRERLO HACE FALTA EL PACK ────────────────────────────────────────
// El motor no está en la VM: está en un pack nativo grabado en la placa que se
// publica como "SQLI". Sin él, la primera llamada lanza una excepción que lo
// DICE con ese nombre — no devuelve ceros ni se cuelga.
//
// -- EL CAMINO SI ES UN ARGUMENTO (desde el 6-sep, #412) ---------------------
// Esta cabecera decia «POR QUE EL CAMINO NO ES UN ARGUMENTO: porque HOY NO SE
// PUEDE (tarea #386)». Ya se puede: el argumento de ejecucion llega por el wire,
// por el IDE (`run SqlDemo <ruta>`) y por los dos CLI, y el valor por defecto se
// declara en el propio parametro.
//
// Y de paso se arregla algo que no cuadraba: la cabecera decia que este modulo
// es el de "medidas.db" y el codigo llamaba a "/sd/medidas.db" -- la ruta de la
// TARJETA en el demo que NO es el de la tarjeta.
//
//   . en flash (PC, simulador o placa)  "medidas.db"      <- este modulo
//   . en la tarjeta de la Metro         "/sd/medidas.db"  <- SqlDemoSd

module SqlDemo
  import SQLite
  import Str

  // V6/#412 — el argumento de ejecucion, POR FIN USADO. Este sample es el que
  // motivo la ficha: recibia `arg` y lo TIRABA, llamando siempre a la ruta de la
  // tarjeta. Ahora el defecto va donde le toca —en la declaracion— y se puede
  // probar con otra ruta sin tocar el fuente:
  //
  //    run SqlDemo /app/medidas.db      (en el simulador, que no tiene /sd)
  //    run SqlDemo                      (la Metro con tarjeta: manda el defecto)
  // El defecto va en la declaracion, que es donde se configura el despliegue;
  // el argumento sirve para PROBAR con otra base sin tocar el fuente:
  //     run SqlDemo             -> medidas.db, en la flash
  //     run SqlDemo otra.db     -> la que digas
  function Main(arg: string := "medidas.db")
    correr(arg)
  end Main

  public function correr(camino: string)
    var db: SQLite.Db := SQLite.Db()

    // connect() devuelve false en vez de lanzar: que no haya tarjeta o que la
    // ruta esté mal es algo que PASA, y el programa decide qué hacer.
    if not db.connect(camino) then
      print "no se pudo abrir", camino, "->", db.errorMessage()
      return
    endif
    print "base abierta:", camino

    // ── 1. Mandar y ya ────────────────────────────────────────────────────
    // Varias sentencias en una llamada, separadas por ';'. Si el SQL está mal
    // escrito eso SÍ es excepción: es un fallo del programa, no del mundo.
    db.exec("DROP TABLE IF EXISTS medidas;"
          + "CREATE TABLE medidas ("
          + "  id     INTEGER PRIMARY KEY,"
          + "  sensor TEXT,"
          + "  valor  REAL,"
          + "  t      INTEGER)")

    var i: integer := 0
    while i < 6 do
      var sensor: string := "temp"
      if i mod 2 == 1 then
        sensor := "hum"
      endif
      // 20.0, 20.5, 21.0 … y una marca de tiempo en milisegundos, que NO cabe
      // en 32 bits — de ahí que `lastInsertId` devuelva `long`.
      //
      // ⚠️ Fíjate en la **L** de `1754300000000L`. Sin ella el literal se trunca
      // a 32 bits EN SILENCIO y aquí saldría 1953343232 (tarea #385). Con `long`
      // grande, el sufijo no es decoración.
      db.exec("INSERT INTO medidas(sensor, valor, t) VALUES('" + sensor + "', "
              + Str.doubleToString(20.0d + double(i) * 0.5d) + ", "
              + Str.longToString(1754300000000L + long(i) * 1000) + ")")
      i := i + 1
    endwh

    print "filas insertadas:", 6
    print "  el ultimo id:  ", db.lastInsertId()
    print "  changes():     ", db.changes()

    // ── 2. Pedir UN dato ──────────────────────────────────────────────────
    // Hay un método por tipo de respuesta porque BP es de tipado estático: el
    // tipo de retorno tiene que estar decidido al compilar.
    print ""
    print "cuantas medidas:  ", db.execInt("SELECT count(*) FROM medidas")
    print "cuantas de 'temp':", db.execInt("SELECT count(*) FROM medidas"
                                         + " WHERE sensor = 'temp'")
    print "media de 'temp':  ", db.execDouble("SELECT avg(valor) FROM medidas"
                                            + " WHERE sensor = 'temp'")
    print "el primer sensor: ", db.execStr("SELECT sensor FROM medidas"
                                         + " ORDER BY id LIMIT 1")

    // El segundo parámetro es qué contestar CUANDO NO HAY NINGUNA FILA, que no
    // es lo mismo que "vale cero". Aquí no existe el sensor, así que sale -1.
    print "un sensor que no existe:", db.execInt("SELECT valor FROM medidas"
                                               + " WHERE sensor = 'viento'", -1)

    // ── 3. Recorrer filas ─────────────────────────────────────────────────
    print ""
    print "-- todas las medidas --"
    var q: SQLite.Query := db.query("SELECT sensor, valor, t FROM medidas"
                                  + " ORDER BY valor")
    var n: integer := 0
    while q.nextRow() do
      // Las columnas van por índice, empezando en 0 como los arrays de BP.
      print "  ", q.getStr(0), q.getDouble(1), q.getLong(2)
      n := n + 1
    endwh
    q.release()          // ← LO ÚNICO que hay que liberar
    print "  (", n, "filas )"

    // ── Y lo que de verdad hace falta: una consulta DENTRO de otra ─────────
    //
    // Se puede porque cada `query` lleva su propio cursor y avanzan
    // independientes. Los `execInt` de dentro abren y sueltan el suyo sin
    // tocar el de fuera.
    print ""
    print "-- cuantas medidas por sensor --"
    var s: SQLite.Query := db.query("SELECT DISTINCT sensor FROM medidas")
    while s.nextRow() do
      var nombre: string := s.getStr(0)
      var cuantas: integer := db.execInt("SELECT count(*) FROM medidas"
                                       + " WHERE sensor = '" + nombre + "'")
      print "  ", nombre, "->", cuantas
    endwh
    s.release()

    // ── Terminar ──────────────────────────────────────────────────────────
    // `close` es de la BASE DE DATOS y va una sola vez, al final. No tiene
    // nada que ver con el `release` de las consultas.
    db.close()
    print ""
    print "cerrada."
  end correr

end SqlDemo
