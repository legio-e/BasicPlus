// PicoInfo.bp — vuelca la información del microcontrolador.
//
// En PC (VM Java) devuelve los valores stub: "host-pc", "host",
// 25.0 °C, etc. En la Pico 2 real devuelve datos del chip.
module PicoInfo
  import Machine

  function Main()
    print "============================================"
    print "  Información del microcontrolador"
    print "============================================"
    print "Board:        ", Machine.boardName()
    print "Serial number:", Machine.uniqueId()
    print "CPU freq:     ", Machine.cpuFreqHz(), "Hz"
    print "Chip temp:    ", Machine.tempC(), "°C"
    print "Uptime:       ", Machine.uptimeMs(), "ms"
    print ""
    print "Capacidades:"
    print "  I2C buses:    ", Machine.I2C_BUSES()
    print "  SPI buses:    ", Machine.SPI_BUSES()
    print "  UART buses:   ", Machine.UART_BUSES()
    print "  GPIO count:   ", Machine.GPIO_COUNT()
    print "  ADC channels: ", Machine.ADC_CHANNELS()
    print "  PWM slices:   ", Machine.PWM_SLICES()
    print "============================================"
  end Main

end PicoInfo
