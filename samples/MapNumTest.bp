module MapNumTest
  import Collections
  import Core          // #446 — los envoltorios viven aqui

  function Main()
    // Map con claves Integer (boxing manual) + comparador natural (numérico).
    var m: Collections.Map := Collections.numericMap()
    m.put(Core.Integer(30), "treinta")
    m.put(Core.Integer(5),  "cinco")
    m.put(Core.Integer(100),"cien")
    m.put(Core.Integer(42), "cuarentaydos")

    print "size=" + intToString(m.size())
    var v: string := string(m.get(Core.Integer(42)))
    print "get(42) -> " + v
    print "contains 5: " + boolToString(m.containsKey(Core.Integer(5)))
    print "contains 7: " + boolToString(m.containsKey(Core.Integer(7)))

    // Iteración en orden de clave: debe ser NUMÉRICO (5,30,42,100),
    // no lexicográfico (que daría 100,30,42,5).
    var i: integer := 0
    while i < m.size() do
      var k: Core.Integer := Core.Integer(m.keyAt(i))
      var vv: string := string(m.valueAt(i))
      print "  [" + intToString(i) + "] " + intToString(k.value()) + " = " + vv
      i := i + 1
    endwh

    print "Integer(7).toString = " + Core.Integer(7).toString()
    print "Double(3.5).toString = " + Core.Double(3.5d).toString()
    print "Boolean(true).toString = " + Core.Boolean(true).toString()
  end Main
end MapNumTest
