// FontLoadDemo.bp — V3 (gráficos): carga de una fuente .bin (LVGL binfont) en
// runtime y aplicación a un widget con setFont().
//
// Hay DOS caminos para las fuentes y sólo uno necesita fichero:
//
//   1. El catálogo COMPILADO, dentro de la imagen: Montserrat en 12, 14, 16, 18,
//      20, 24, 28, 32, 36, 40 y 48 px. Se elige con `fontSize` y funciona en todas
//      las placas y en el PC sin nada más. Es el camino normal. (Un tamaño que no
//      esté en la lista cae a 14 sin avisar.)
//   2. loadFont(fichero), que es la salida de emergencia: cargar EN RUNTIME una
//      fuente que NO está en la imagen — otra tipografía, una negrita, u otro
//      juego de caracteres. Por definición necesita un fichero.
//
// Este sample enseña los dos. El .bin es formato LVGL (el mismo que usa
// MicroPython) y se genera con lv_font_conv; aquí va montserrat_26_bold.bin al
// lado, así que la demo funciona tal cual desde la instalación.
//
// loadFont() lo busca junto al programa (cwd en el PC, /app en placa) y devuelve
// un id; setFont(id) lo aplica. En el host con LVGL se ve la fuente de verdad; en
// miVM/Swing el id es válido pero el texto sale con la por defecto.
//
// ⚠️ EN PLACA hay que subir el .bin a mano (arrastrándolo al explorador del IDE):
// un sample SUELTO sólo sube su .mod, no lleva recursos. Y ojo — si el fichero no
// está, loadFont NO falla: devuelve un id igualmente y setFont se queda en nada,
// así que la etiqueta sale con la fuente por defecto y PARECE que funciona. Lo
// único que lo delata es un aviso de la VM en la consola.
module FontLoadDemo
  import Gui

  function Main()
    var scr: Gui.Screen := Gui.Screen()

    var titulo: Gui.Label := Gui.Label(scr, "Fuentes en BasicPlus")
    titulo.align(Gui.Align.TOP_MID, 0, 10)

    // Catálogo compilado: tamaño por px (ASCII Montserrat).
    var porDefecto: Gui.Label := Gui.Label(scr, "Por defecto (14 px)")
    porDefecto.align(Gui.Align.TOP_MID, 0, 50)

    var grande: Gui.Label := Gui.Label(scr, "fontSize = 32")
    grande.fontSize := 32
    grande.align(Gui.Align.TOP_MID, 0, 90)

    // Fuente cargada en runtime desde un .bin del proyecto.
    var fid: integer := Gui.loadFont("montserrat_26_bold.bin")
    print "loadFont('montserrat_26_bold.bin') -> id " + intToString(fid)

    var cargada: Gui.Label := Gui.Label(scr, "Cargada .bin (26 bold)")
    cargada.setFont(fid)
    cargada.align(Gui.Align.TOP_MID, 0, 150)

    print "== widgets =="
    print Gui.__guiDumpTree()
    Gui.run()
  end Main

end FontLoadDemo
