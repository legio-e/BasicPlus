// GuiCheckDemo.bp — H6 widget #1: checkbox + evento onChange.
//
// El toggle (real o sintético vía __guiChange) levanta el evento onChange del
// checkbox; el estado se lee/escribe con la propiedad `checked`. Verificable
// headless por dumpTree (el checkbox sale con `val=N`).
//
// MIGRADO a eventos H5.c (#324). Antes esto era una subclase de Gui.Checkbox cuyo
// UNICO fin era reescribir onChange: para atender un widget habia que fabricar una
// clase. Ahora el handler es una funcion de un objeto cualquiera y el widget se
// usa tal cual. Convencion de nombres (Eduardo): <componente>_<evento>, con el
// mismo nombre que la variable que sostiene el widget.
module GuiCheckDemo
  import Gui

  class Panel
    function event cb_onChange(quien: Gui.Component)
      print "[onChange] toggled"
    end cb_onChange
  end Panel

  function Main()
    var scr: Gui.Screen := Gui.Screen()
    var p: Panel := Panel()

    var cb: Gui.Checkbox := Gui.Checkbox(scr, "Activar")
    cb.onChange := p::cb_onChange
    cb.checked := true

    print "== antes =="
    print Gui.__guiDumpTree()

    Gui.__guiChange(cb)          // simula un toggle (verificable headless)
    Gui.run()                    // bombea: drena el evento onChange

    print "== despues =="
    print Gui.__guiDumpTree()
  end Main

end GuiCheckDemo
