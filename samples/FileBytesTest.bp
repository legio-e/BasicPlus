// FileBytesTest.bp — regresión #6 (racimo miVM): I/O binario de byte[].
// writeFileBytes popeaba el byte[] con popTc(4B) y lo usaba como dirección
// física SIN refDeref; readFileBytes truncaba el handle de salida con (int) y
// lo empujaba a 4B (pushTc). Fix: popTcRef+refDeref (write) y handle 64b
// completo + pushTcRef (read). El NUL en b1 prueba el carril binario (readFile
// de texto lo mutilaría). VM-C ya era correcto → paridad.
module FileBytesTest
  function Main()
    var data: byte[] := newByteArray(5)
    data[0] := 72     // H
    data[1] := 0      // NUL
    data[2] := 105    // i
    data[3] := 33     // !
    data[4] := 90     // Z
    writeFileBytes("fbtest.bin", data)
    var rd: byte[] := readFileBytes("fbtest.bin")
    print "len=" + intToString(len(rd))
    print "b0=" + intToString(rd[0])
    print "b1=" + intToString(rd[1])
    print "b2=" + intToString(rd[2])
    print "b3=" + intToString(rd[3])
    print "b4=" + intToString(rd[4])
  end Main
end FileBytesTest
