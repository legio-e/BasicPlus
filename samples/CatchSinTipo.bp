// CatchSinTipo.bp — #459: un `catch` SIN tipo entregaba un valor roto.
//
// Caso mínimo, sacado de que `samples/trytest.bp` imprimiera basura del heap en
// la ESP32-P4. Vivió en samples/pendientes/ mientras estuvo roto (compilaba y
// ejecutaba: lo que fallaba era la SALIDA); cerrado el 30-ago, vuelve a
// samples/ como prueba de regresión. Las dos VMs imprimen esto:
//   TIPADO   .msg : [con tipo]
//   ---
//   SIN TIPO .msg : [sin tipo]
//   FIN
//
// Lo que imprimía antes del arreglo: la segunda línea sacaba bytes del heap (la
// tabla de símbolos, normalmente) porque el emisor trataba la variable del catch
// genérico como si fuera un string — ver la ficha.
module CatchSinTipo
  import Core

  function Main()
    try
      throw RuntimeError("con tipo")
    catch e: Core.RuntimeError
      print "TIPADO   .msg :", "[" + e.msg + "]"
    endtry
    print "---"
    try
      throw RuntimeError("sin tipo")
    catch e2
      print "SIN TIPO .msg :", "[" + e2.msg + "]"
    endtry
    print "FIN"
  end Main

end CatchSinTipo
