// AnnProbe.bp — la anotación BIEN puesta (V5/H5).
module AnnProbe

  @BD{ tabla = "medidas" }
  public class Medida
    @BD{}                          public property id:       long
    @BD{ columna = "sensor_id" }   public property sensorId: long
    @BD{}                          public property valor:    double
    public property cache: string          // sin anotación: no va a la BD

    public function Medida()
      this.id := 0
      this.sensorId := 0
      this.valor := 0.0d
      this.cache := ""
    end Medida
  end Medida

  // Repartida en varias líneas.
  @BD{
     tabla = "sensores"
  }
  public class Sensor
    @BD{} public property id: long
    public function Sensor()
      this.id := 0
    end Sensor
  end Sensor

  function Main(arg: string)
    var m: Medida := Medida()
    m.valor := 21.5d
    print "anotaciones OK, valor =", m.valor
  end Main

end AnnProbe
