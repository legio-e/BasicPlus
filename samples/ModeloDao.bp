      return "medidas"
    end tabla

    // EL ORDEN. `read` lo respeta, y por eso van pegados.
    public function columnas(): string
      return "id, sensor_id, valor, t"
    end columnas

    public function read(q: SQLite.Query): Object
      var e: Modelo.Medida := Modelo.Medida()
      e.id := q.getLong(0)
      e.sensorId := q.getLong(1)
      e.valor := q.getDouble(2)
      e.t := q.getLong(3)
      return e
    end read

    public function loadById(id: long): Modelo.Medida
      return this.uno("id = " + Str.longToString(id))
    end loadById

