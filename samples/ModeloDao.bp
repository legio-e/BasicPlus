    // Al volver, el objeto lleva su clave puesta — la que asignó la BD.
    public function insert(e: Modelo.Medida)
      this.db.exec("INSERT INTO " + this.tabla() + "(sensor_id, valor, t) VALUES("
            + Str.longToString(e.sensorId) + ", "
            + Str.doubleToString(e.valor) + ", "
            + Str.longToString(e.t)
            + ")")
      e.id := this.db.lastInsertId()
    end insert

