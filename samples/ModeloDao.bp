      this.insert(e)
    end add

    // Devuelve si tocó alguna fila: false = esa clave no estaba.
    public function update(e: Modelo.Medida): boolean
      this.db.exec("UPDATE " + this.tabla()
            + " SET sensor_id = " + Str.longToString(e.sensorId)
            + ", valor = " + Str.doubleToString(e.valor)
            + ", t = " + Str.longToString(e.t)
            + " WHERE id = " + Str.longToString(e.id))
      return this.db.changes() > 0
    end update

    // Por clave lo hereda de `Orm.Dao`. Éste además pone la pk a 0:
    // tras el borrado el objeto ya no es ninguna fila.
    public function delete(e: Modelo.Medida): boolean
      var fue: boolean := this.deleteById(e.id)
      if fue then
        e.id := 0
      endif
      return fue
    end delete

    function copiar(de: Modelo.Medida, a: Modelo.Medida)
      a.id := de.id
      a.sensorId := de.sensorId
      a.valor := de.valor
      a.t := de.t
    end copiar

  end MedidaDao

