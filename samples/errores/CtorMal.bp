// CtorMal.bp — #511/#515 (19-sep): lo que un constructor NO puede hacer. (1) delegar en si mismo;
// (2) delegarse en ciclo; (3) delegar y ademas llamar a super(...) (que ya no seria la primera sentencia); (4) construir desde fuera una
// clase con constructor private; (5) construir desde fuera una con constructor protegido (sin
// modificador); (6) super() implicito a un constructor private del padre; (7) super(...) con argumentos a un padre sin
// constructor (sin ellos vale, y no hace nada: #753, 1-nov); (8) un constructor sin super(...) cuando el del padre tiene
// parametros, aunque tengan valor por defecto (#804, 7-nov: el constructor que se define es el oficial, y la hija que
// define el suyo llama a base con sus parametros; una hija SIN constructor se sigue construyendo con los del padre).
module CtorMal
  import Core
  public class A
    var v: integer := 0
    public function A(v: integer)
      A(v)
    end A
  end A
  public class B
    public function B()
      B(1)
    end B
    public function B(x: integer)
      B()
    end B
  end B
  public class Padre
    public function Padre()
    end Padre
  end Padre
  public class C extends Padre
    public function C()
      C(1)
      super()
    end C
    public function C(x: integer)
    end C
  end C
  public class Cerrada
    private function Cerrada()
    end Cerrada
    public function abre(): Cerrada
      return Cerrada()
    end abre
  end Cerrada
  public class Familiar
    function Familiar()
    end Familiar
  end Familiar
  public class Nieto extends Familiar
    public function Nieto()
    end Nieto
  end Nieto
  public class Base
    private function Base()
    end Base
  end Base
  public class Derivada extends Base
    public function Derivada()
    end Derivada
  end Derivada
  public class SinCtor
    public function quien(): string
      return "SinCtor"
    end quien
  end SinCtor
  public class ConArgs extends SinCtor
    public function ConArgs()
      super(5)
    end ConArgs
  end ConArgs
  public class ConValor
    var n: integer
    public function ConValor(n: integer := 2)
      this.n := n
    end ConValor
  end ConValor
  public class HijaDeConValor extends ConValor
    public function HijaDeConValor()
    end HijaDeConValor
  end HijaDeConValor
  function main()
    var c: Cerrada := Cerrada()
    var f: Familiar := Familiar()
    var n: Nieto := Nieto()
    print "no compila"
  end main
end CtorMal
