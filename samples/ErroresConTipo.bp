// ErroresConTipo.bp — V8/H7.5 (7-nov): los errores de la VM con su tipo, como en Java (Eduardo: «los runtime error se
// puede poner una excepción dentro como excepción específica»). Cada uno se provoca y se mira con qué clase se atrapa:
// la suya, aunque antes vaya otra que no le toca; RuntimeError, su padre, también; y el mensaje, el de siempre. Se
// comprueba a sí mismo: una línea que empieza por FALLO es rojo en compat.sh. Las dos VMs, la misma salida. Y (#806) el
// throw de una excepción null: un NullReferenceError del propio throw, que se atrapa como los demás.
module ErroresConTipo

  import Core
  import Math
  import Collections
  import IO

  var fallos: integer

  class Animal
    public property nombre: string
    var edad: integer           // un campo: leerlo es GET_FIELD (una property sería su getter, un método)
    public function Animal(n: string)
      this.nombre := n
    end Animal
    public function edadDe(otro: Animal): integer
      return otro.edad
    end edadDe
    // un método privado: sobre null, el `this` null de #752
    private function secreto(): string
      return this.nombre
    end secreto
    public function delOtro(otro: Animal): string
      return otro.secreto()
    end delOtro
  end Animal

  class Perro extends Animal
    public function Perro(n: string)
      super(n)
    end Perro
  end Perro

  class Caja
    public property owner contenido: Animal
    public function Caja(a: Animal)
      this.contenido := a
    end Caja
    public function cambia(nuevo: Animal)
      this.contenido := nuevo   // suelta el de antes
    end cambia
  end Caja

  // #805: un «Mutex» con un id que no vale (su campo 0, el que lee el builtin)
  class IdFalso
    var id: integer
    public function IdFalso(i: integer)
      this.id := i
    end IdFalso
  end IdFalso

  function mira(cond: boolean, que: string)
    if cond then
      print "ok   " + que
    else
      print "FALLO " + que
      fallos := fallos + 1
    endif
  end mira

  // la clase con que se atrapa: por orden, una que no le toca, la suya y RuntimeError
  function aritmetica(caso: integer): string
    var cero: integer := 0
    var ceroL: long := 0L
    try
      if caso == 1 then
        print 10 / cero
      elseif caso == 2 then
        print 10 mod cero
      elseif caso == 3 then
        print 10L / ceroL
      elseif caso == 4 then
        print 2 ^ (cero - 1)
      elseif caso == 5 then
        print byte(300 + cero)
      else
        print Math.factorial(13 + cero)
      endif
      return "nada"
    catch e: IndexError
      return "IndexError: " + e.msg
    catch e2: ArithmeticError
      return "ArithmeticError: " + e2.msg
    catch e3: RuntimeError
      return "RuntimeError: " + e3.msg
    endtry
  end aritmetica

  function nula(caso: integer): string
    var a: Animal := null
    var s: string := null
    var v: integer[] := null
    try
      if caso == 1 then
        var c1: Animal := Animal("c1")
        print c1.edadDe(a)
      elseif caso == 2 then
        print a.delOtro(a)
      elseif caso == 3 then
        var b: Animal := Animal("b")
        print b.delOtro(a)
      elseif caso == 4 then
        print strlen(s)
      elseif caso == 5 then
        print v[0]
      elseif caso == 6 then
        var owner c: Caja := Caja(Animal("Rex"))
        var rex: Animal := c.contenido
        c.cambia(Animal("Toby"))
        print rex.nombre
      else
        var m: Collections.Map := Collections.Map()
        m.put(null, "x")
      endif
      return "nada"
    catch e: ArithmeticError
      return "ArithmeticError: " + e.msg
    catch e2: NullReferenceError
      return "NullReferenceError: " + e2.msg
    catch e3: RuntimeError
      return "RuntimeError: " + e3.msg
    endtry
  end nula

  function indice(caso: integer): string
    var v: integer[] := [1, 2]
    var b: byte[] := newByteArray(2)
    var l: List := List()
    l.add(7)
    try
      if caso == 1 then
        print v[5]
      elseif caso == 2 then
        print b[3]
      elseif caso == 3 then
        print charAt("abc", 7)
      else
        print l.get(3)
      endif
      return "nada"
    catch e: NullReferenceError
      return "NullReferenceError: " + e.msg
    catch e2: IndexError
      return "IndexError: " + e2.msg
    catch e3: RuntimeError
      return "RuntimeError: " + e3.msg
    endtry
  end indice

  function conversion(): string
    var o: Object := Animal("gato")
    try
      var p: Perro := Perro(o)
      print p.nombre
      return "nada"
    catch e: IOError
      return "IOError: " + e.msg
    catch e2: CastError
      return "CastError: " + e2.msg
    catch e3: RuntimeError
      return "RuntimeError: " + e3.msg
    endtry
  end conversion

  // #805: los textos de un fallo con ficheros, los mismos en las dos VMs (antes, en la VM-Java, el del sistema)
  function fichero(caso: integer): string
    try
      if caso == 1 then
        print readFile("no_existe_h75.txt")
      elseif caso == 3 then
        print IO.fileSize("no_existe_h75.txt")
      elseif caso == 4 then
        print IO.lastModified("no_existe_h75.txt")
      elseif caso == 5 then
        IO.mkdir("h805_fichero.txt")   // ya es un fichero: la carpeta no se puede crear
      elseif caso == 6 then
        IO.rmdir("h805_carpeta")       // no está vacía
      else
        var malo: byte[] := newByteArray(2)
        malo[0] := 0x41
        malo[1] := 0xFF
        print fromBytes(malo)
      endif
      return "nada"
    catch e: CastError
      return "CastError: " + e.msg
    catch e2: IOError
      return "IOError: " + e2.msg
    catch e3: RuntimeError
      return "RuntimeError: " + e3.msg
    endtry
  end fichero

  // la de antes: RuntimeError las sigue atrapando todas, y EncodingError es la suya
  function soloRuntime(): string
    var cero: integer := 0
    try
      print 1 / cero
      return "nada"
    catch e: RuntimeError
      return "RuntimeError: " + e.msg
    endtry
  end soloRuntime

  function codificacion(): string
    var malo: byte[] := newByteArray(1)
    malo[0] := 0xFF
    try
      print fromBytes(malo)
      return "nada"
    catch e: EncodingError
      return "EncodingError: " + e.msg
    catch e2: IOError
      return "IOError: " + e2.msg
    endtry
  end codificacion

  // #806 (Eduardo: el throw «se empieza a ejecutar pero no acaba») — el throw de una excepción null es un
  // NullReferenceError del propio throw: con la suya, aunque antes vaya otra que no le toca; con RuntimeError, con
  // Exception, sin tipo y sin nombre; y el finally corre
  function lanzaNula(caso: integer): string
    var e: Exception := null
    try
      if caso == 1 then
        throw e
      elseif caso == 2 then
        try
          throw e
        catch a: RuntimeError
          return "RuntimeError: " + a.msg
        endtry
      elseif caso == 3 then
        try
          throw e
        catch b: Exception
          return "Exception: " + b.msg
        endtry
      elseif caso == 4 then
        try
          throw e
        catch c
          return "sin tipo: " + c.msg
        endtry
      else
        var pasos: string := ""
        try
          try
            throw e
          finally
            pasos := "finally"
          endtry
        catch
          return pasos + ", y atrapada sin nombre"
        endtry
      endif
      return "nada"
    catch x1: IndexError
      return "IndexError: " + x1.msg
    catch x2: NullReferenceError
      return "NullReferenceError: " + x2.msg
    endtry
  end lanzaNula

  // #805: el builtin del Mutex (Core.__mutexLock es público) con un id que no vale y con un null: atrapables en las dos
  // VMs (antes, la VM-C paraba la VM, y la VM-Java leía el id de un null en la memoria del principio)
  function cerrojo(caso: integer): string
    try
      if caso == 1 then
        __mutexLock(IdFalso(999))
      elseif caso == 2 then
        __mutexUnlock(IdFalso(999))
      elseif caso == 3 then
        __mutexLock(null)
      else
        __mutexUnlock(null)
      endif
      return "nada"
    catch e: NullReferenceError
      return "NullReferenceError: " + e.msg
    catch e2: RuntimeError
      return "RuntimeError: " + e2.msg
    endtry
  end cerrojo

  function Main()
    var r: string := aritmetica(1)
    mira(r == "ArithmeticError: División por cero", "división por cero: " + r)
    r := aritmetica(2)
    mira(r == "ArithmeticError: Módulo por cero", "módulo por cero: " + r)
    r := aritmetica(3)
    mira(r == "ArithmeticError: División por cero", "un long por cero: " + r)
    r := aritmetica(4)
    mira(r == "ArithmeticError: exponente negativo en potencia entera", "exponente negativo: " + r)
    r := aritmetica(5)
    mira(r == "ArithmeticError: I32_TO_U8: valor fuera de rango 300", "byte(300): " + r)
    r := aritmetica(6)
    mira(r == "ArithmeticError: factorial: 13 desborda integer (máx 12)", "factorial(13): " + r)

    r := nula(1)
    mira(r == "NullReferenceError: referencia nula: acceso a un campo de un objeto null", "un campo de null: " + r)
    r := nula(2)
    mira(r == "NullReferenceError: referencia nula: llamada a un método de un objeto null", "un método de null: " + r)
    r := nula(3)
    mira(r == "NullReferenceError: referencia nula: llamada a un método de un objeto null", "un método privado de null: " + r)
    r := nula(4)
    mira(r == "NullReferenceError: referencia nula: strlen de un string null", "una cadena null: " + r)
    r := nula(5)
    mira(r == "NullReferenceError: referencia nula: acceso a un elemento de un array null", "un array null: " + r)
    r := nula(6)
    mira(r == "NullReferenceError: referencia a objeto eliminado (use-after-free)", "un objeto eliminado: " + r)
    r := nula(7)
    mira(r == "NullReferenceError: referencia nula: Map.put con una clave null", "una clave null: " + r)

    r := indice(1)
    mira(r == "IndexError: ALOAD: índice fuera de rango 5 (length=2)", "un array: " + r)
    r := indice(2)
    mira(r == "IndexError: ALOAD_U8: idx fuera de rango 3 (len=2)", "un byte[]: " + r)
    r := indice(3)
    mira(r == "IndexError: charAt: idx fuera de rango 7 (len=3)", "charAt: " + r)
    r := indice(4)
    mira(r == "IndexError: List: índice fuera de rango 3 (length=1)", "una List: " + r)

    r := conversion()
    mira(r == "CastError: conversion invalida: el valor no es un 'Perro'", "una conversión: " + r)

    r := fichero(1)
    mira(r == "IOError: readFile('no_existe_h75.txt'): no se pudo abrir", "un fichero que no está: " + r)
    r := fichero(2)
    mira(r == "IOError: fromBytes: UTF-8 mal formado en el byte 1 (0xFF)", "UTF-8 malo, por IOError: " + r)
    r := fichero(3)
    mira(r == "IOError: fileSize('no_existe_h75.txt'): no se pudo leer el tamaño", "fileSize de uno que no está: " + r)
    r := fichero(4)
    // en una placa sin fechas en su FS (littlefs), el otro texto: no es un fallo de lectura
    var bien4: boolean := (r == "IOError: lastModified('no_existe_h75.txt'): no se pudo leer") or (r == "IOError: lastModified('no_existe_h75.txt'): no implementado en esta plataforma")
    mira(bien4, "lastModified de uno que no está: " + r)
    writeFile("h805_fichero.txt", "x")
    r := fichero(5)
    IO.removeFile("h805_fichero.txt")
    mira(r == "IOError: mkdir('h805_fichero.txt'): no se pudo crear", "mkdir sobre un fichero: " + r)
    IO.mkdir("h805_carpeta")
    writeFile("h805_carpeta/a.txt", "x")
    r := fichero(6)
    IO.removeFile("h805_carpeta/a.txt")
    IO.rmdir("h805_carpeta")
    mira(r == "IOError: rmdir('h805_carpeta'): no se pudo borrar (¿no vacío?)", "rmdir de una que no está vacía: " + r)

    r := soloRuntime()
    mira(r == "RuntimeError: División por cero", "RuntimeError las atrapa: " + r)
    r := codificacion()
    mira(r == "EncodingError: fromBytes: UTF-8 mal formado en el byte 0 (0xFF)", "EncodingError, la suya: " + r)

    r := cerrojo(1)
    mira(r == "RuntimeError: mutex.lock: id inválido 999", "un Mutex con un id que no vale: " + r)
    r := cerrojo(2)
    mira(r == "RuntimeError: mutex.unlock: id inválido 999", "y su unlock: " + r)
    r := cerrojo(3)
    mira(r == "NullReferenceError: referencia nula: mutex.lock de un Mutex null", "un Mutex null: " + r)
    r := cerrojo(4)
    mira(r == "NullReferenceError: referencia nula: mutex.unlock de un Mutex null", "y su unlock: " + r)

    r := lanzaNula(1)
    mira(r == "NullReferenceError: referencia nula: throw de un objeto null", "un throw de un null: " + r)
    r := lanzaNula(2)
    mira(r == "RuntimeError: referencia nula: throw de un objeto null", "un throw de un null, con RuntimeError: " + r)
    r := lanzaNula(3)
    mira(r == "Exception: referencia nula: throw de un objeto null", "un throw de un null, con Exception: " + r)
    r := lanzaNula(4)
    mira(r == "sin tipo: referencia nula: throw de un objeto null", "un throw de un null, sin tipo: " + r)
    r := lanzaNula(5)
    mira(r == "finally, y atrapada sin nombre", "un throw de un null, con su finally: " + r)

    print "fallos: " + fallos
  end Main

end ErroresConTipo
