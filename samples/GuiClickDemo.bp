// GuiClickDemo.bp — upcall de eventos (V3, H3.4; migrado a H5.c en #324).
//
// Un clic (real, o sintetico via __guiClick) hace que la VM llame POR NOMBRE a
// Gui.__guiDispatch(self) -> self.__fireClick(), que LEVANTA el evento onClick
// del boton. El scheduler drena la cola entre quanta e inyecta el frame del
// handler suscrito, que cambia el texto de un label. Verificable headless
// comparando el dumpTree antes/despues del clic.
//
// MIGRADO: antes habia una subclase de Gui.Button cuyo unico fin era reescribir
// onClick. Con eventos el boton se usa tal cual y el handler vive donde quieras.
// Convencion de nombres (Eduardo): <componente>_<evento>, con el mismo nombre
// que la variable que sostiene el widget.
module GuiClickDemo
  import Gui

  // El que ESCUCHA. Guarda lo que necesita tocar; antes eso era estado de la
  // subclase del boton.
  class Pantalla
    public property target: Gui.Label

    function event btn_onClick(quien: Gui.Component)
      print "[onClick] override ejecutado"
      this.target.setText("PULSADO")
    end btn_onClick
  end Pantalla

  function Main()
    var scr: Gui.Screen := Gui.Screen()

    var lbl: Gui.Label := Gui.Label(scr, "esperando")
    lbl.align(Gui.Align.TOP_MID, 0, 10)

    var pant: Pantalla := Pantalla()
    pant.target := lbl

    var btn: Gui.Button := Gui.Button(scr, "Pulsame")
    btn.onClick := pant::btn_onClick
    btn.align(Gui.Align.CENTER, 0, 0)

    print "== antes del clic =="
    print Gui.__guiDumpTree()

    Gui.__guiClick(btn)          // simula un clic sobre el widget (verificable headless)
    Gui.run()                    // bombea el evento: drena onClick -> cambia el label

    print "== despues del clic =="
    print Gui.__guiDumpTree()
  end Main

end GuiClickDemo
