// GuiValueDemo.bp — H6 tanda 3: value-widgets enteros (switch, slider, bar).
//
// Los tres comparten `value` + `setRange`; el arrastre del slider levanta
// onChange. Verificable headless por dumpTree (`val=N`).
//
// MIGRADO a eventos H5.c (#324). Antes esto era una subclase de Gui.Slider cuyo
// UNICO fin era reescribir onChange: para atender un widget habia que fabricar una
// clase. Ahora el handler es una funcion de un objeto cualquiera y el widget se
// usa tal cual. Convencion de nombres (Eduardo): <componente>_<evento>, con el
// mismo nombre que la variable que sostiene el widget.
module GuiValueDemo
  import Gui

  class Panel
    function event sl_onChange(quien: Gui.Component)
      print "[slider] cambió"
    end sl_onChange
  end Panel

  function Main()
    var scr: Gui.Screen := Gui.Screen()
    var p: Panel := Panel()

    var sw: Gui.Toggle := Gui.Toggle(scr)
    sw.checked := true
    sw.align(Gui.Align.TOP_MID, 0, 20)

    var sl: Gui.Slider := Gui.Slider(scr)
    sl.onChange := p::sl_onChange
    sl.setRange(0, 200)
    sl.value := 150
    sl.align(Gui.Align.TOP_MID, 0, 90)

    var pb: Gui.Bar := Gui.Bar(scr)
    pb.setRange(0, 10)
    pb.value := 7
    pb.align(Gui.Align.TOP_MID, 0, 160)

    print "== widgets =="
    print Gui.__guiDumpTree()

    Gui.__guiChange(sl)          // simula el arrastre del slider (verificable headless)
    Gui.run()                    // bombea: drena el evento onChange
  end Main

end GuiValueDemo
