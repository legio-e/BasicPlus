module ParallelTest

  // Worker que hace CPU-bound puro: SIN llamadas a yield() / sleep().
  //
  // LO QUE DEMUESTRA: que los dos avancen a la vez NO depende de que haya dos
  // cores. En las placas hay UN solo worker de intérprete (en el RP2350 el otro
  // core lleva la comunicación, no ejecuta BP), y aun así los dos threads
  // progresan acompasados: el cambio de contexto lo hace el planificador de la
  // propia BP-VM entre quanta, no el sistema operativo. Por eso el test no lleva
  // yields — si hicieran falta, esto no funcionaría.
  //
  // En el PC con --smp=2 sí hay dos workers de verdad y corren en paralelo, así
  // que el tiempo total ≈ el de uno; con un worker, ≈ 2× el de uno.
  //
  // Los `print` de progreso NO son adorno: 2.000.000 de iteraciones interpretadas
  // son minutos en un micro, y sin ellos el programa está mudo todo ese rato y
  // parece colgado. Que el usuario vea lo que está haciendo es parte de la prueba.
  class Worker extends Thread
    var id:     integer
    var iters:  integer
    var result: integer

    public function Worker(id: integer, iters: integer)
      super(2048)
      this.id     := id
      this.iters  := iters
      this.result := 0
    end Worker

    public function run()
      var sum: integer := 0
      var i:   integer := 0
      while i < this.iters do
        sum := sum + (i * 3) - (i / 2)
        if (i mod 100000) == 0 then
          print "w" + intToString(this.id) + " @" + intToString(i)
        endif
        i := i + 1
      endwh
      this.result := sum
      print "worker " + intToString(this.id) + " sum=" + intToString(sum)
    end run
  end Worker

  function main(arg: string)
    var iters: integer := 2000000

    print "[main] arrancando workers (CPU-bound, sin yield)"
    var t0: integer := now()
    var w1: Thread := Worker(1, iters)
    var w2: Thread := Worker(2, iters)
    w1.start()
    w2.start()
    w1.join()
    w2.join()
    var elapsed: integer := now() - t0
    print "[main] total ms = " + intToString(elapsed)
  end main

end ParallelTest
