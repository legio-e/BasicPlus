library "acme"
module LibHdr
  import Core

  public class Caja
    var v: integer := 3
    public function Caja()
      this.v := 3
    end Caja
    public function doble(): integer
      return this.v * 2
    end doble
  end Caja

  public function main()
    var c: Caja := Caja()
    print "doble=" + c.doble()
  end main

end LibHdr
