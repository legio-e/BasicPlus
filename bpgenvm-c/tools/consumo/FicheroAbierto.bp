// FicheroAbierto.bp — un fichero abierto para escribir, que sigue abierto al acabar Main. Un global: un local `owner`
// lo cerraría su destructor al salir de Main. ⚠️ Desde #668 (8-oct) también lo cierra su destructor, en la destrucción
// del final, ANTES de la línea «mem:» del firmware: lo que esa línea cuenta de más sobre Limpia es la destrucción
// (ConDestructor la aísla, sin IO), no el fichero (FicheroCerrado, con el fichero cerrado, gasta lo mismo).
module FicheroAbierto
  import Core
  import IO

  var f: IO.TextFile := null

  function Main()
    f := IO.TextFile("/app/medida_mem.txt", "w")
    f.writeLine("una linea")
    print "fichero abierto"
    print "fin"
  end Main
end FicheroAbierto
