// NeoUna.bp — ¿le quedan al programa los canales RMT de una tira que creó un programa ANTERIOR? Una sola tira, en el
// GPIO1: el programa no tiene ninguna otra.
module NeoUna
  import Core
  import Neopixel

  function Main()
    try
      var px: Neopixel.Strip := Neopixel.Strip(1, 1)
      print "una tira en el GPIO1: iniciada"
    catch e: RuntimeError
      print "una tira en el GPIO1: atrapada: " + e.msg
    endtry
    print "fin"
  end Main
end NeoUna
