// Importa5.bp — lo que cuesta importar módulos de la stdlib (sin tomar ningún recurso): cinco más que Nada.
module Importa5
  import Core
  import Math
  import Str
  import Collections
  import Json
  import Time

  function Main()
    var c: Collections.StringComparator := Collections.StringComparator()
    var j: Json.JsonValue := Json.JsonValue()
    var b: boolean := Time.esBisiesto(2024)
    print "importa5: " + Str.fromCharCode(65) + " " + intToString(c.compare("a", "b")) + " " + j.isNull() + " " + b + " " + Math.pi()
    print "fin"
  end Main
end Importa5
