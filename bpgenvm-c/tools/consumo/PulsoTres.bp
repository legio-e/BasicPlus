// PulsoTres.bp — un contador de pulsos en el GPIO3, en marcha al acabar.
module PulsoTres
  import Core
  import Pulse

  function Main()
    try
      var c: Pulse.Counter := Pulse.Counter(3, 0)
      c.start()
      print "contador en el GPIO3: en marcha"
    catch e: RuntimeError
      print "contador en el GPIO3: atrapado: " + e.msg
    endtry
    print "fin"
  end Main
end PulsoTres
