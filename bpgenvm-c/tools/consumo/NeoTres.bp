// NeoTres.bp — una tira NeoPixel en el GPIO3, pintada (8 LED).
module NeoTres
  import Core
  import Neopixel

  function Main()
    try
      var px: Neopixel.Strip := Neopixel.Strip(3, 8)
      px.setColor(0, 0, 4)
      px.show()
      print "una tira en el GPIO3: iniciada"
    catch e: RuntimeError
      print "una tira en el GPIO3: atrapada: " + e.msg
    endtry
    print "fin"
  end Main
end NeoTres
