// FicheroCerrado.bp — como FicheroAbierto, pero el fichero se CIERRA antes de acabar: el objeto sigue vivo (un global,
// con su destructor), el fichero no. Medido en la C6 el 8-oct: lo mismo que FicheroAbierto (20 B de diferencia),
// porque desde #668 el destructor cierra el abierto antes de la línea «mem:». Limpia lo borra después.
module FicheroCerrado
  import Core
  import IO

  var f: IO.TextFile := null

  function Main()
    f := IO.TextFile("/app/medida_mem.txt", "w")
    f.writeLine("una linea")
    f.close()
    print "fichero cerrado"
    print "fin"
  end Main
end FicheroCerrado
