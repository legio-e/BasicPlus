<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- V8 #763 (2-nov) — LA PÁGINA DE CÓDIGOS DE LA VM-C DE PC, EN WINDOWS: UTF-8.
     El C estándar que usa la VM-C (main, fopen, opendir/readdir) va por las funciones «A» de Windows, que hablan la
     página de códigos del proceso, y sin esto era la del sistema (la 1252 en un Windows en español): el argumento
     «¿hola?» llegaba como BF 68 6F…, un fichero ¡hola.txt salía de listDir como A1 68 6F… —UTF-8 roto, que empieza por
     un byte de continuación (#739)—, y lo que el programa creaba como ñ.txt quedaba en el disco como Ã±.txt. Con
     activeCodePage (desde Windows 10 1903), las funciones «A» hablan UTF-8: el mismo código da y recibe UTF-8. Lo
     enlazan el CLI y el simulador (Makefile, WIN_RES); lo prueba samples/Utf8Sistema.bp en la red. -->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity type="win32" name="BasicPlus.bpgenvm-c" version="1.0.0.0"/>
  <application>
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
