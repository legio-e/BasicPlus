// V7/H2 (#509/#513) — oráculo de paridad: la mitad CONSUMIDORA de CtorBase.bp.
// Construcción externa por sobrecarga (incluida la de tipo clase), `super(args)` por firma
// desde otro módulo, super implícito hacia la sobrecarga sin args, y #513: `CtorBase.Der(7)`
// (derivada sin ctor propio) y un nieto que hace super sobre ella.
module CtorHijo
  import CtorBase

  public class Nieto extends CtorBase.Der
    public function Nieto(v: integer)
      super(v, "nieto")
    end Nieto
    public function Nieto()
    end Nieto
  end Nieto

  public class Hija extends CtorBase.Base
    public function Hija(v: integer)
      super(v)
    end Hija
    public function Hija(t: string)
      super(3, t)
    end Hija
  end Hija

  public function main()
    print CtorBase.local()
    var a: CtorBase.Base := CtorBase.Base(5)
    var b: CtorBase.Base := CtorBase.Base()
    var c: CtorBase.Base := CtorBase.Base(6, "dos")
    var d: CtorBase.Base := CtorBase.Base(a)
    print a.quien() + " " + b.quien() + " " + c.quien() + " " + d.quien()
    var e: CtorBase.Der := CtorBase.Der(7)
    var e2: CtorBase.Der := CtorBase.Der()
    print e.marca() + " " + e2.marca()
    var f: CtorBase.DerCon := CtorBase.DerCon(8)
    var g: CtorBase.DerCon := CtorBase.DerCon()
    print f.marca() + " " + g.marca()
    var h: Hija := Hija(9)
    var i: Hija := Hija("tres")
    print h.quien() + " " + i.quien()
    var n: Nieto := Nieto(10)
    var n2: Nieto := Nieto()
    print n.marca() + " " + n2.marca()
    // Revisión del 14-sep: hija LOCAL sin ctor propio de una base externa, construida aquí
    var hs: HijaSin := HijaSin(21)
    var hs2: HijaSin := HijaSin()
    print hs.quien() + " " + hs2.quien()
    var t: CtorBase.Tarea := CtorBase.Tarea(4096)
    t.start()
    t.join()
    print "tarea " + t.cuenta()
  end main

  public class HijaSin extends CtorBase.Base
  end HijaSin
end CtorHijo
