// ParseNumero.bp — V8 (23-oct, #716): QUÉ ES UN NÚMERO PARA parseInt Y parseFloat, lo mismo en las dos VMs.
//
// Antes, cada VM heredaba lo de su biblioteca: la VM-C, strtol y strtod, que leen lo que pueden y callan ("12abc" → 12,
// "abc" → 0, "0x1F" → 31 en parseFloat; un entero grande, el tope); la VM-Java, Long.parseLong y Double.parseDouble, que
// mataban el hilo sin que el try lo viera (y un entero grande, sus 32 bits de abajo). La regla de Eduardo (*«Me valen
// las propuestas»*), con la misma rutina en las dos VMs:
//   - alrededor, espacios (los bytes de 0 a 32, como el trim de Java); dentro, nada;
//   - parseInt:   [+-] dígitos, y que quepa en 32 bits;
//   - parseFloat: [+-] (dígitos [. dígitos] | . dígitos) [(e|E) [+-] dígitos], y que quepa en un float;
//   - si no: un RuntimeError atrapable, con el texto (40 bytes como mucho).
// Lo que tiene que salir, escrito a mano: una línea FALLO pone la red en rojo aunque las dos VMs coincidan.
module ParseNumero

  var malas: integer := 0

  function mira(que: string, obtenido: string, esperado: string)
    if obtenido == esperado then
      print "ok " + que + ": " + obtenido
    else
      malas += 1
      print "FALLO " + que + ": [" + obtenido + "], se esperaba [" + esperado + "]"
    endif
  end mira

  // la etiqueta, sin caracteres de control: un retorno de carro en la salida lo escriben distinto la consola de la VM-C
  // y la de la VM-Java en Windows, y la paridad veía dos salidas aunque el número fuera el mismo
  function visible(s: string): string
    return replace(replace(replace(s, "\t", "\\t"), "\r", "\\r"), "\n", "\\n")
  end visible

  function entero(s: string, esperado: string)
    try
      mira("parseInt('" + visible(s) + "')", intToString(parseInt(s)), esperado)
    catch e: RuntimeError
      mira("parseInt('" + visible(s) + "')", e.msg, esperado)
    endtry
  end entero

  // un float: que valga lo que dice el literal (sin depender de cómo se escribe un float)
  function decimal(s: string, esperado: float)
    try
      mira("parseFloat('" + s + "')", boolToString(parseFloat(s) == esperado), "true")
    catch e: RuntimeError
      mira("parseFloat('" + s + "')", e.msg, "un número")
    endtry
  end decimal

  function decimalMal(s: string, esperado: string)
    try
      var f: float := parseFloat(s)
      mira("parseFloat('" + s + "')", "valió", esperado)
    catch e: RuntimeError
      mira("parseFloat('" + s + "')", e.msg, esperado)
    endtry
  end decimalMal

  function Main()
    // parseInt: lo que vale
    entero("42", "42")
    entero("-42", "-42")
    entero("+7", "7")
    entero(" 13 ", "13")
    entero("\t-5\r\n", "-5")
    entero("007", "7")
    entero("-0", "0")
    entero("2147483647", "2147483647")
    entero("-2147483648", "-2147483648")
    // parseInt: lo que no
    entero("", "parseInt: '' no es un número entero")
    entero("   ", "parseInt: '   ' no es un número entero")
    entero("abc", "parseInt: 'abc' no es un número entero")
    entero("12abc", "parseInt: '12abc' no es un número entero")
    entero("1 2", "parseInt: '1 2' no es un número entero")
    entero("0x1F", "parseInt: '0x1F' no es un número entero")
    entero("1e3", "parseInt: '1e3' no es un número entero")
    entero("4.5", "parseInt: '4.5' no es un número entero")
    entero("+", "parseInt: '+' no es un número entero")
    entero("--1", "parseInt: '--1' no es un número entero")
    entero("١٢", "parseInt: '١٢' no es un número entero")
    // parseInt: lo que no cabe
    entero("2147483648", "parseInt: '2147483648' no cabe en un integer")
    entero("-2147483649", "parseInt: '-2147483649' no cabe en un integer")
    entero("99999999999", "parseInt: '99999999999' no cabe en un integer")
    entero("1234567890123456789012345678901234567890123", "parseInt: '1234567890123456789012345678901234567890...' no cabe en un integer")

    // parseFloat: lo que vale
    decimal("1.5", 1.5)
    decimal("-.5", -0.5)
    decimal("1.", 1.0)
    decimal("1e3", 1000.0)
    decimal("2.5E-3", 0.0025)
    decimal("+0.25", 0.25)
    decimal(" 3.25 ", 3.25)
    decimal("1.e2", 100.0)
    decimal("42", 42.0)
    decimal("-0", 0.0)
    decimal("1e-50", 0.0)
    decimal("3.4028235e38", 3.4028235e38)
    // parseFloat: lo que no
    decimalMal("", "parseFloat: '' no es un número")
    decimalMal(".", "parseFloat: '.' no es un número")
    decimalMal("e3", "parseFloat: 'e3' no es un número")
    decimalMal("1e", "parseFloat: '1e' no es un número")
    decimalMal("1e+", "parseFloat: '1e+' no es un número")
    decimalMal("inf", "parseFloat: 'inf' no es un número")
    decimalMal("nan", "parseFloat: 'nan' no es un número")
    decimalMal("Infinity", "parseFloat: 'Infinity' no es un número")
    decimalMal("0x1F", "parseFloat: '0x1F' no es un número")
    decimalMal("1.5f", "parseFloat: '1.5f' no es un número")
    decimalMal("1..5", "parseFloat: '1..5' no es un número")
    decimalMal("12abc", "parseFloat: '12abc' no es un número")
    // parseFloat: lo que no cabe
    decimalMal("1e39", "parseFloat: '1e39' no cabe en un float")
    decimalMal("-1e39", "parseFloat: '-1e39' no cabe en un float")
    decimalMal("1e400", "parseFloat: '1e400' no cabe en un float")

    print "ParseNumero: " + intToString(malas) + " mal"
  end Main
end ParseNumero
