// Teclado.bp — V8/H2, paso 2 (9-nov): el teclado del SO y Keyboards.Keyboard, sin ventana, igual en las dos VMs
// (V8_IDEAS §E1, «El paso 2»). Las teclas entran con Keyboards.__kbInject, como si llegaran de un teclado de verdad: el
// int32 (abajo el código HID, arriba los bits de estado) y su carácter, como código Unicode.
//
// Lo que se prueba: el evento, en el hilo que creó el teclado (se reparte uno por turno: la prueba espera con un bucle
// de sleep); con dos teclados, el evento a los dos; preguntando, el búfer del SO, y el primero que lee se la lleva; los
// bits de estado y isKey; y close(), que deja de recibir.
module Teclado
  import Keyboards

  class Pant
    public property nombre: string
    public property n: integer

    public function Pant(nombre: string)
      this.nombre := nombre
      this.n := 0
    end Pant

    function event tecla(t: Keyboards.Keyboard, k: integer, c: string)
      this.n := this.n + 1
      print this.nombre + ": codigo " + Keyboards.getCode(k) + " [" + c + "]" + this.estado(k)
    end tecla

    function estado(k: integer): string
      var s: string := ""
      if Keyboards.isShift(k) then
        s := s + " shift"
      endif
      if Keyboards.isCtrl(k) then
        s := s + " ctrl"
      endif
      if Keyboards.isAlt(k) then
        s := s + " alt"
      endif
      if Keyboards.isAltGr(k) then
        s := s + " altgr"
      endif
      if Keyboards.isWin(k) then
        s := s + " win"
      endif
      if Keyboards.isCapsLock(k) then
        s := s + " mayus"
      endif
      return s
    end estado
  end Pant

  // Los eventos se reparten entre turno y turno: este hilo los recibe cuando corre, y un sleep le da turnos.
  function espera(p: Pant, cuantas: integer)
    var i: integer := 0
    while p.n < cuantas and i < 400 do
      sleep(5)
      i := i + 1
    endwh
  end espera

  function Main()
    var a: Keyboards.Keyboard := Keyboards.Keyboard()
    var pa: Pant := Pant("a")
    a.onKey := pa::tecla
    print "teclado conectado: " + a.isConnected()
    print "hay teclas: " + a.hasKey()

    // una 'a', Enter, Shift+B, Ctrl+C, AltGr+2 (la @ de un teclado español), la ñ (en un teclado español, la tecla del
    // punto y coma de uno de EE. UU.) y una A con Bloq Mayús
    Keyboards.__kbInject(4, 97)
    Keyboards.__kbInject(40, 0)
    Keyboards.__kbInject(5 | (1 shl 17), 66)
    Keyboards.__kbInject(6 | (1 shl 16), 0)
    Keyboards.__kbInject(31 | (1 shl 22), 64)
    Keyboards.__kbInject(51, 241)
    Keyboards.__kbInject(4 | (1 shl 24), 65)
    espera(pa, 7)
    print "eventos de a: " + pa.n

    // dos teclados: cada tecla, a los dos
    var b: Keyboards.Keyboard := Keyboards.Keyboard()
    var pb: Pant := Pant("b")
    b.onKey := pb::tecla
    Keyboards.__kbInject(44, 32)
    espera(pa, 8)
    espera(pb, 1)
    print "eventos: a " + pa.n + ", b " + pb.n

    // preguntando: el búfer del SO tiene las 8, y el primero que lee se la lleva
    print "hay teclas: " + a.hasKey()
    var k: integer := a.readKey()
    print "a lee: codigo " + Keyboards.getCode(k) + " [" + a.getChar() + "]"
    k := b.readKey()
    print "b lee: codigo " + Keyboards.getCode(k) + " [" + b.getChar() + "]"
    print "isKey: " + Keyboards.isKey(k, Keyboards.Key.ENTER) + " " + Keyboards.isKey(k, Keyboards.Key.A)
    var resto: integer := 0
    while a.hasKey() do
      k := a.readKey()
      resto := resto + 1
    endwh
    print "quedaban: " + resto
    k := a.readKey()
    print "sin teclas, readKey: " + k + " [" + a.getChar() + "]"

    // close: b deja de recibir; a, no
    b.close()
    Keyboards.__kbInject(41, 0)
    espera(pa, 9)
    sleep(20)
    print "eventos: a " + pa.n + ", b " + pb.n
    print "fin"
  end Main
end Teclado
