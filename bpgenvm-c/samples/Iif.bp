// Iif.bp — V8/H7.1 (#747, 31-oct): el ternario, iif(condición, a, b) (Eduardo: «El ternario BP como una función
// inline»): el valor de a si la condición se cumple, y si no el de b. Tiene forma de función, pero sólo se calcula el
// valor que toca, como el `c ? a : b` de C# (y así se escribe en JC): un fib recursivo con iif termina, y
// iif(p != null, p.nombre, "nadie") no falla con p nulo. Su tipo, el de las dos ramas: números (gana el más ancho), una
// clase y su hija (gana el padre), null y una referencia, un enum. Es de paridad (está en el corpus).
module Iif

  var vecesA: integer := 0
  var vecesB: integer := 0

  enum Color
    Rojo
    Verde
  end Color

  class Animal
    public function habla(): string
      return "..."
    end habla
  end Animal

  class Perro extends Animal
    public function habla(): string
      return "guau"
    end habla
  end Perro

  class Persona
    public property nombre: string

    public function Persona(n: string)
      this.nombre := n
    end Persona
  end Persona

  function a(): integer
    vecesA += 1
    return 1
  end a

  function b(): integer
    vecesB += 1
    return 2
  end b

  function signo(x: integer): integer
    return iif(x > 0, 1, iif(x < 0, -1, 0))
  end signo

  function fib(n: integer): integer
    return iif(n < 2, n, fib(n - 1) + fib(n - 2))
  end fib

  function main()
    print "signo:", signo(5), signo(-3), signo(0)
    print "fib(15):", fib(15)

    var r: integer := iif(true, a(), b())
    r := iif(false, a(), b())
    print "sólo la que toca:", vecesA, vecesB, r

    print "mezcla:", iif(true, 1, 2.5), iif(false, 1, 3000000000)

    var x: integer := 4
    print "cadena:", iif(x mod 2 == 0, "par", "impar")

    var an: Animal := iif(x > 3, Perro(), Animal())
    print "clase:", an.habla()

    var p: Persona := iif(x > 10, Persona("Ana"), null)
    print "nulo:", iif(p != null, p.nombre, "nadie")
    p := Persona("Eva")
    print "nulo:", iif(p != null, p.nombre, "nadie")

    if iif(x > 0, x < 10, false) then
      print "en un if: sí"
    endif

    var total: long := 0
    for k := 1 to 10 do
      total += iif(k mod 2 == 0, k * 100, k)
    next
    print "en un for:", total

    var col: Color := iif(x > 0, Color.Verde, Color.Rojo)
    print "enum:", col == Color.Verde

    var dd: double := iif(x > 0, 1.5d, 2)
    print "double:", dd, iif(x < 0, 1, 2) * 10
  end main
end Iif
