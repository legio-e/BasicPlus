// InterfacesUsa.bp — V8 H7.3 (#756): un programa que implementa las interfaces de otro módulo (InterfacesLib) y llama
// por ellas; la librería llama también por su interfaz a la clase del programa (describe). Las tablas de la clase las
// construye el cargador por clave al enlazar: si la librería cambia una interfaz, el enlace lo dice (E11, E12…).
// mod8: fuera — las interfaces son del enlace tardío (MOD9)
module InterfacesUsa
  import InterfacesLib

  public class Rect implements InterfacesLib.Medible
    var an: double
    var al: double
    @implement{ Medible }
    public property escala: integer
    public function Rect(a: double, b: double)
      this.an := a
      this.al := b
      this.escala := 1
    end Rect
    @implement{ Forma }
    public function area(): double
      return this.an * this.al * this.escala
    end area
    @implement{ Medible }
    public function nombre(): string
      return "rect"
    end nombre
  end Rect

  function Main()
    var r: Rect := Rect(2.0, 3.0)
    var f: InterfacesLib.Forma := r
    print InterfacesLib.describe(f)
    var m: InterfacesLib.Medible := r
    m.escala := 2
    print "escala", m.escala, "area", f.area()
    var p: InterfacesLib.Forma := InterfacesLib.Punto()
    print InterfacesLib.describe(p)
    print "is", p instanceof InterfacesLib.Medible, f instanceof InterfacesLib.Medible
    print "fin"
  end Main
end InterfacesUsa
