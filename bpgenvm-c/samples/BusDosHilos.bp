// smp: orden libre
// BusDosHilos.bp — V7 #659 (7-oct): tres hilos escriben A LA VEZ, cada uno en SU bus (SPI, I2C y UART). El stub del PC
// escribia cada traza a trozos (un bpvm_out por byte): con dos runs, las piezas de una linea se colaban entre las de
// otra, y el stdout es el oraculo de la paridad (con dos runs, 10 de 10 pasadas con lineas mezcladas). Una traza es
// UNA linea: sale entera. Con un worker no se ve —un builtin no se corta—; lo ve la pasada de dos workers de la red,
// que compara ordenadas las lineas de un sample de orden libre. Las cinco trazas de varias piezas: el write y el
// transfer de SPI, el write y la transaccion de I2C, y el write de UART (con su texto).
module BusDosHilos
  import Spi
  import I2c
  import Uart

  class PorSpi extends Thread
    public function PorSpi()
      super(4096)
    end PorSpi

    public function run()
      var bus: Spi.Bus := Spi.Bus(0, 2, 3, 4, 1000000, 0)
      var datos: integer[] := [0x10, 0x11, 0x12, 0x13, 0x14, 0x15, 0x16, 0x17, 0x18, 0x19, 0x1A, 0x1B, 0x1C, 0x1D, 0x1E, 0x1F]
      var rx: integer[] := newIntArray(16)
      var i: integer := 0
      while i < 60 do
        bus.write(datos, 16)
        bus.transfer(datos, rx, 16)
        i := i + 1
      endwh
    end run
  end PorSpi

  class PorI2c extends Thread
    public function PorI2c()
      super(4096)
    end PorI2c

    public function run()
      var bus: I2c.Bus := I2c.Bus(1, 10, 11, 100000)
      var datos: integer[] := [0x20, 0x21, 0x22, 0x23, 0x24, 0x25, 0x26, 0x27, 0x28, 0x29, 0x2A, 0x2B, 0x2C, 0x2D, 0x2E, 0x2F]
      var rx: integer[] := newIntArray(4)
      var i: integer := 0
      while i < 60 do
        bus.write(0x3C, datos, 16)
        bus.writeRead(0x3C, datos, 8, rx, 4)
        i := i + 1
      endwh
    end run
  end PorI2c

  class PorUart extends Thread
    public function PorUart()
      super(4096)
    end PorUart

    public function run()
      var puerto: Uart.Port := Uart.Port(0, 8, 9, 115200, 8, 1, 0)
      var datos: integer[] := [0x41, 0x42, 0x43, 0x44, 0x45, 0x46, 0x47, 0x48, 0x49, 0x4A, 0x4B, 0x4C, 0x4D, 0x4E, 0x4F, 0x50]
      var i: integer := 0
      while i < 60 do
        puerto.write(datos, 16)
        i := i + 1
      endwh
    end run
  end PorUart

  function Main()
    var a: PorSpi := PorSpi()
    var b: PorI2c := PorI2c()
    var c: PorUart := PorUart()
    a.start()
    b.start()
    c.start()
    a.join()
    b.join()
    c.join()
    print "fin"
  end Main
end BusDosHilos
