// TcpCloseSuelto.bp — V8 (23-oct, #705): `Net.tcpClose` suelto no puede cambiar las variables de antes.
//
// Tras cada llamada sin resultado, el compilador tira un valor de 4 B, y los builtins que no devuelven nada empujan uno
// para eso. `tcpClose` no lo empujaba, en ninguna de las dos VMs: cada llamada suelta se llevaba 4 B de lo de debajo
// en la pila, y lo siguiente que se apilaba pisaba la última variable local. Lo que se veía dependía de qué variable
// era: con dos enteros, otros números (32 y 264, igual en las dos VMs: la paridad no lo veía); con una cadena, en la
// VM-C, «referencia a objeto eliminado». Es el único de los 94 builtins sin resultado que no lo empujaba (el censo del
// 23-oct). Cada caso en su función, con su marco. Sin conexión: el 0 no es ninguna, y cerrarlo no hace nada.
module TcpCloseSuelto
  import Net

  function mira(que: string, obtenido: string, esperado: string)
    if obtenido == esperado then
      print "ok " + que + ": " + obtenido
    else
      print "FALLO " + que + ": [" + obtenido + "], se esperaba [" + esperado + "]"
    endif
  end mira

  function dosEnteros()
    var a: integer := 7
    var b: integer := 9
    Net.tcpClose(0)
    Net.tcpClose(0)
    mira("dos enteros, tras dos tcpClose", "a = " + intToString(a) + " b = " + intToString(b), "a = 7 b = 9")
  end dosEnteros

  function unaCadena()
    var c: string := "sigue"
    Net.tcpClose(0)
    Net.tcpClose(0)
    mira("una cadena, tras dos tcpClose", c, "sigue")
  end unaCadena

  function Main()
    dosEnteros()
    unaCadena()
    print "TcpCloseSuelto: fin"
  end Main
end TcpCloseSuelto
