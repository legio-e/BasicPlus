// DivBordes.bp — #791 (5-nov): dividir en los bordes, igual en las dos VMs. El mínimo entre -1 da la vuelta y su resto es 0;
// en C no está definido, y la VM-C moría en el PC (el idiv de x86 lo convierte en una excepción). Por cero, el error de
// siempre, que se captura. Tiene que salir:
//   -2147483648
//   0
//   -9223372036854775808
//   0
//   -7 3 -1
//   División por cero
//   Módulo por cero
//   División por cero
//   Módulo por cero
//   fin
module DivBordes

  import Core   // V6: los tipos de Core se importan

  function divide(a: integer, b: integer): integer
    try
      return a / b
    catch e: Exception
      print e.msg
      return 0
    endtry
  end divide

  function resto(a: integer, b: integer): integer
    try
      return a mod b
    catch e: Exception
      print e.msg
      return 0
    endtry
  end resto

  function divideLong(a: long, b: long): long
    try
      return a / b
    catch e: Exception
      print e.msg
      return 0L
    endtry
  end divideLong

  function restoLong(a: long, b: long): long
    try
      return a mod b
    catch e: Exception
      print e.msg
      return 0L
    endtry
  end restoLong

  function Main()
    var minimo: integer := 0 - 2147483647 - 1
    var menosUno: integer := 0 - 1
    print minimo / menosUno
    print minimo mod menosUno
    var minimoLong: long := 0L - 9223372036854775807L - 1L
    var menosUnoLong: long := 0L - 1L
    print minimoLong / menosUnoLong
    print minimoLong mod menosUnoLong
    print 7 / menosUno, 7 / 2, 0 - 7 mod 3
    var nada: integer := divide(7, 0)
    nada := resto(7, 0)
    var nadaLong: long := divideLong(7L, 0L)
    nadaLong := restoLong(7L, 0L)
    print "fin"
  end Main

end DivBordes
