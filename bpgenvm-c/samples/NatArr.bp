// NatArr.bp — #573 (V7, 26-sep): los errores de los OPERADORES de arrays y cadenas desde una native, AOT contra
// interpretado. El AOT traduce `a[i]`, `a[i] := v` y el `+` de cadenas a helpers de C (array_load_*, array_store_*,
// string_concat) que eran COPIAS de sus opcodes, con su propio texto: un índice fuera de rango en una native lanzaba
// «array_load_i32: index out of bounds» donde la misma función interpretada —y miVM— lanza «ALOAD: índice fuera de
// rango 7 (length=3)»; y `a + b` sin memoria daba un null callado. Ahora el texto sale de UNA función que usan el
// opcode y el helper (bpvm_prim_texto_indice), y el concat reserva con la del opcode (bpvm_prim_nuevo_array).
// `make test-aotarr` corre el MISMO .mod con el AOT y sin él, con GC en cada alocación, y exige la misma salida,
// 21 comprobaciones y ningún FALLO. Un tipo por helper: cada uno dice qué opcode es.
module NatArr
  import Core

  native function leeI(a: integer[], i: integer): integer
    return a[i]
  end leeI

  native function ponI(a: integer[], i: integer): integer
    a[i] := 5
    return a[i]
  end ponI

  native function leeF(a: float[], i: integer): float
    return a[i]
  end leeF

  native function ponF(a: float[], i: integer): integer
    a[i] := 2.5
    return 0
  end ponF

  native function leeL(a: long[], i: integer): long
    return a[i]
  end leeL

  native function ponL(a: long[], i: integer): integer
    a[i] := 7
    return 0
  end ponL

  native function leeD(a: double[], i: integer): double
    return a[i]
  end leeD

  native function ponD(a: double[], i: integer): integer
    a[i] := 1.5
    return 0
  end ponD

  native function leeB(a: byte[], i: integer): integer
    return a[i]
  end leeB

  native function ponB(a: byte[], i: integer, v: byte): integer
    a[i] := v
    return 0
  end ponB

  native function leeS8(a: int8[], i: integer): integer
    return a[i]
  end leeS8

  native function leeW(a: word[], i: integer): integer
    return a[i]
  end leeW

  native function leeS16(a: int16[], i: integer): integer
    return a[i]
  end leeS16

  native function ponS16(a: int16[], i: integer, v: int16): integer
    a[i] := v
    return 0
  end ponS16

  native function leeR(a: string[], i: integer): string
    return a[i]
  end leeR

  native function ponR(a: string[], i: integer): integer
    a[i] := "x"
    return 0
  end ponR

  native function dobla(n: integer): integer
    var s: string := "ab"
    var k: integer := 0
    while k < n do
      s := s + s
      k += 1
    endwh
    return len(s)
  end dobla

  function Main()
    var a: integer[] := newIntArray(3)
    var nada: integer[] := null
    var f: float[] := [0.5, 1.5, 2.5]
    var l: long[] := newLongArray(3)
    var d: double[] := newDoubleArray(3)
    var b: byte[] := newByteArray(3)
    var s8: int8[] := [int8(1), int8(2), int8(3)]
    var w: word[] := [word(1), word(2), word(3)]
    var s16: int16[] := [int16(1), int16(2), int16(3)]
    var r: string[] := ["p", "q", "r"]
    var menos: integer := 0 - 1
    try
      print "ok integer[] leer: " + intToString(leeI(a, 7))
    catch e: RuntimeError
      print "ok integer[] leer: atrapada: " + e.msg
    endtry
    try
      print "ok integer[] leer negativo: " + intToString(leeI(a, menos))
    catch e: RuntimeError
      print "ok integer[] leer negativo: atrapada: " + e.msg
    endtry
    try
      print "ok integer[] escribir: " + intToString(ponI(a, 7))
    catch e: RuntimeError
      print "ok integer[] escribir: atrapada: " + e.msg
    endtry
    try
      print "ok null leer: " + intToString(leeI(nada, 0))
    catch e: RuntimeError
      print "ok null leer: atrapada: " + e.msg
    endtry
    try
      print "ok null escribir: " + intToString(ponI(nada, 2))
    catch e: RuntimeError
      print "ok null escribir: atrapada: " + e.msg
    endtry
    try
      var x: float := leeF(f, 7)
      print "ok float[] leer: sin error"
    catch e: RuntimeError
      print "ok float[] leer: atrapada: " + e.msg
    endtry
    try
      print "ok float[] escribir: " + intToString(ponF(f, 7))
    catch e: RuntimeError
      print "ok float[] escribir: atrapada: " + e.msg
    endtry
    try
      var y: long := leeL(l, 7)
      print "ok long[] leer: sin error"
    catch e: RuntimeError
      print "ok long[] leer: atrapada: " + e.msg
    endtry
    try
      print "ok long[] escribir: " + intToString(ponL(l, 7))
    catch e: RuntimeError
      print "ok long[] escribir: atrapada: " + e.msg
    endtry
    try
      var z: double := leeD(d, 7)
      print "ok double[] leer: sin error"
    catch e: RuntimeError
      print "ok double[] leer: atrapada: " + e.msg
    endtry
    try
      print "ok double[] escribir: " + intToString(ponD(d, 7))
    catch e: RuntimeError
      print "ok double[] escribir: atrapada: " + e.msg
    endtry
    try
      print "ok byte[] leer: " + intToString(leeB(b, 7))
    catch e: RuntimeError
      print "ok byte[] leer: atrapada: " + e.msg
    endtry
    try
      print "ok byte[] escribir: " + intToString(ponB(b, 7, byte(9)))
    catch e: RuntimeError
      print "ok byte[] escribir: atrapada: " + e.msg
    endtry
    try
      print "ok int8[] leer: " + intToString(leeS8(s8, 7))
    catch e: RuntimeError
      print "ok int8[] leer: atrapada: " + e.msg
    endtry
    try
      print "ok word[] leer: " + intToString(leeW(w, 7))
    catch e: RuntimeError
      print "ok word[] leer: atrapada: " + e.msg
    endtry
    try
      print "ok int16[] leer: " + intToString(leeS16(s16, 7))
    catch e: RuntimeError
      print "ok int16[] leer: atrapada: " + e.msg
    endtry
    try
      print "ok int16[] escribir: " + intToString(ponS16(s16, 7, int16(3)))
    catch e: RuntimeError
      print "ok int16[] escribir: atrapada: " + e.msg
    endtry
    try
      print "ok string[] leer: [" + leeR(r, 7) + "]"
    catch e: RuntimeError
      print "ok string[] leer: atrapada: " + e.msg
    endtry
    try
      print "ok string[] escribir: " + intToString(ponR(r, 7))
    catch e: RuntimeError
      print "ok string[] escribir: atrapada: " + e.msg
    endtry
    try
      print "ok control: " + intToString(ponI(a, 1)) + " " + intToString(leeB(b, 2)) + " " + leeR(r, 2) + " " + intToString(leeS16(s16, 0))
    catch e: RuntimeError
      print "ok control: atrapada: " + e.msg
    endtry
    try
      print "ok concat sin memoria: " + intToString(dobla(40))
    catch e: RuntimeError
      print "ok concat sin memoria: atrapada: " + e.msg
    endtry
  end Main
end NatArr
