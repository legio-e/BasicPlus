// NatKill.bp — V7/H5 P2b.1.d: el `kill` de una native en un bucle SIN FIN. El planificador atiende al
// cable (poll) entre quantums; una native que no cede nunca no le deja llegar, y el programa no se para.
// Con la línea del bucle, la native cede cada rebanada y el `kill` llega. `make test-aotkill`.
module NatKill
  native function eterna(): integer
    var n: integer := 0
    while 1 == 1 do
      n += 1
      if n > 1000000 then
        n := 0
      endif
    endwh
    return n
  end eterna

  function Main()
    print "ok kill: entra en la native"
    var r: integer := eterna()
    print "FALLO: la native volvio " + intToString(r)
  end Main
end NatKill
