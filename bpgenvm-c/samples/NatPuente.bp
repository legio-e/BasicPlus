// NatPuente.bp — #672 (V7, 9-oct): una excepción que lanza el código BP al que llama una native, y que ese código
// no atrapa. Sale por la native —como en el intérprete— hasta el `try` de fuera. Antes, con el AOT, buscaba
// manejador por DEBAJO de la native con sus marcos de C vivos: el `catch` de Main corría dentro del intérprete
// anidado y, al acabar el programa, «la función BP cedió/falló». `make test-aotpuente` corre el MISMO .mod con el
// AOT y sin él y exige la misma salida, completa.
module NatPuente
  import Core

  public class MiError extends RuntimeError
    public function MiError(m: string)
      super(m)
    end MiError
  end MiError

  function lanza(x: integer): integer
    if x > 2 then
      throw RuntimeError("desde BP " + intToString(x))
    endif
    return x
  end lanza

  function lanzaMia(x: integer): integer
    if x == 1 then
      throw MiError("mia")
    endif
    return x
  end lanzaMia

  // BP que atrapa lo suyo: la native no se entera
  function atrapaLaSuya(x: integer): integer
    try
      return lanza(x)
    catch e: RuntimeError
      return 100
    endtry
  end atrapaLaSuya

  native function suma(n: integer): integer
    var s: integer := 0
    var i: integer := 0
    while i < n do
      s += lanza(i)
      i += 1
    endwh
    return s
  end suma

  native function sumaSegura(n: integer): integer
    var s: integer := 0
    var i: integer := 0
    while i < n do
      s += atrapaLaSuya(i)
      i += 1
    endwh
    return s
  end sumaSegura

  native function mia(x: integer): integer
    return lanzaMia(x) + 1
  end mia

  // dos natives de por medio: exterior → medio (BP) → interior → lanza (BP)
  native function interior(x: integer): integer
    return lanza(x) * 2
  end interior

  function medio(x: integer): integer
    return interior(x) + 1
  end medio

  native function exterior(x: integer): integer
    return medio(x) + 1
  end exterior

  // y un BP ENTRE las dos que atrapa lo que sale de la interior
  function medioAtrapa(x: integer): integer
    try
      return interior(x) + 1
    catch e: RuntimeError
      return -1
    endtry
  end medioAtrapa

  native function exteriorAtrapa(x: integer): integer
    return medioAtrapa(x) + 1000
  end exteriorAtrapa

  function Main()
    // 1: sale de BP, cruza la native y la atrapa Main
    try
      print "FALLO 1: no lanzo: " + intToString(suma(5))
    catch e: RuntimeError
      print "ok 1 atrapada fuera: " + e.msg
    endtry
    // 2: la native otra vez, sin excepción: el suelo no se quedó en la pila
    print "ok 2 suma(3) = " + intToString(suma(3))
    // 3: un throw de Main después: lo atrapa su catch, no un suelo rancio
    try
      throw RuntimeError("de Main")
    catch e: RuntimeError
      print "ok 3 " + e.msg
    endtry
    // 4: el BP llamado atrapa lo suyo: la native sigue
    print "ok 4 sumaSegura(5) = " + intToString(sumaSegura(5))
    // 5: una clase del usuario cruza la native y se atrapa por su clase
    try
      print "FALLO 5: no lanzo: " + intToString(mia(1))
    catch e: MiError
      print "ok 5 MiError: " + e.msg
    catch e: RuntimeError
      print "FALLO 5: la atrapo RuntimeError: " + e.msg
    endtry
    // 6: cruza dos natives y un BP sin try
    try
      print "FALLO 6: no lanzo: " + intToString(exterior(7))
    catch e: RuntimeError
      print "ok 6 cruzo dos natives: " + e.msg
    endtry
    // 7 y 8: la atrapa un BP entre las dos natives; y sin excepción
    print "ok 7 exteriorAtrapa(7) = " + intToString(exteriorAtrapa(7))
    print "ok 8 exteriorAtrapa(1) = " + intToString(exteriorAtrapa(1))
    print "ok fin"
  end Main
end NatPuente
