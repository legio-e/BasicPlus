// MapDesplaza.bp — V8/H5 (21-oct): el Map desplaza su lista DE UNA VEZ (move) al meter y al borrar, y sigue dando lo
// mismo.
//
// El Map es una lista ordenada usada como array, con búsqueda dicotómica (la 1 de Eduardo). Al meter y al borrar se
// desplaza el tramo de detrás: antes elemento a elemento en BP, ahora con `move` (V8_IDEAS §E5, «El Map»). Aquí, 3000
// operaciones al azar —meter, actualizar, borrar y buscar— sobre un Map numérico y otro de cadenas, contra un array de
// referencia; y cada 50 operaciones, el Map entero recorrido en orden con keyAt/valueAt: claves crecientes, las mismas
// que la referencia y con su valor. Cubre meter al principio, en medio y al final, borrar el primero, el último y uno
// que no está, y el crecimiento del array de la lista. Se comprueba ella misma, y va en el corpus de la paridad.
module MapDesplaza
  import Core
  import Collections

  var hechas: integer := 0
  var malas: integer := 0
  var x: integer := 5

  function azar(m: integer): integer
    x := (x * 75 + 74) mod 65537
    return x mod m
  end azar

  function mira(que: string, obtenido: integer, esperado: integer)
    hechas += 1
    if obtenido != esperado then
      malas += 1
      if malas <= 20 then
        print "  MAL " + que + ": " + obtenido + " (esperado " + esperado + ")"
      endif
    endif
  end mira

  function clave(k: integer): string
    return "k" + (1000 + k)          // cuatro cifras: el orden de las cadenas es el de los números
  end clave

  function entero(o: Object): integer
    var c: Core.Comparable := Core.Comparable(o)
    return c.toInteger()
  end entero

  // el Map entero, en orden, contra la referencia
  function repasa(num: Collections.Map, cad: Collections.Map, ref: integer[], n: integer)
    var presentes: integer := 0
    var k: integer := 0
    while k < n do
      if ref[k] >= 0 then
        presentes += 1
      endif
      k += 1
    endwh
    mira("size numérico", num.size(), presentes)
    mira("size cadenas", cad.size(), presentes)
    var i: integer := 0
    k := 0
    while i < num.size() and k <= n do
      while k < n and ref[k] < 0 do
        k += 1
      endwh
      mira("keyAt numérico", entero(num.keyAt(i)), k)
      mira("valueAt numérico", entero(num.valueAt(i)), ref[k])
      var esperada: string := clave(k)
      var obtenida: string := string(cad.keyAt(i))
      if obtenida == esperada then
        mira("keyAt cadenas", 1, 1)
      else
        mira("keyAt cadenas " + obtenida + " / " + esperada, 0, 1)
      endif
      mira("valueAt cadenas", entero(cad.valueAt(i)), ref[k])
      i += 1
      k += 1
    endwh
  end repasa

  function Main()
    var n: integer := 300
    var ref: integer[] := newIntArray(n)
    var k: integer := 0
    while k < n do
      ref[k] := -1
      k += 1
    endwh
    var num: Collections.Map := Collections.numericMap()
    var cad: Collections.Map := Collections.stringMap()
    var metidas: integer := 0
    var borradas: integer := 0
    var paso: integer := 0
    while paso < 3000 do
      var key: integer := azar(n)
      var op: integer := azar(10)
      if op < 6 then
        num.put(key, Integer(paso))
        cad.put(clave(key), Integer(paso))
        if ref[key] < 0 then
          metidas += 1
        endif
        ref[key] := paso
      elseif op < 8 then
        var esperado: integer := 0
        if ref[key] >= 0 then
          esperado := 1
          borradas += 1
        endif
        var r1: integer := 0
        if num.remove(key) then
          r1 := 1
        endif
        var r2: integer := 0
        if cad.remove(clave(key)) then
          r2 := 1
        endif
        mira("remove numérico", r1, esperado)
        mira("remove cadenas", r2, esperado)
        ref[key] := -1
      else
        var esta: integer := 0
        if ref[key] >= 0 then
          esta := 1
          mira("get numérico", num.getInteger(key), ref[key])
          mira("get cadenas", cad.getInteger(clave(key)), ref[key])
        endif
        var c1: integer := 0
        if num.containsKey(key) then
          c1 := 1
        endif
        var c2: integer := 0
        if cad.containsKey(clave(key)) then
          c2 := 1
        endif
        mira("containsKey numérico", c1, esta)
        mira("containsKey cadenas", c2, esta)
      endif
      if paso mod 50 == 49 then
        repasa(num, cad, ref, n)
      endif
      paso += 1
    endwh
    // vaciarlo entero, del primero al último, y repasar
    while num.size() > 0 do
      var primero: integer := entero(num.keyAt(0))
      num.remove(primero)
      cad.remove(clave(primero))
      ref[primero] := -1
    endwh
    repasa(num, cad, ref, n)
    print "map: " + metidas + " claves nuevas, " + borradas + " borradas; " + hechas + " comprobaciones, " + malas + " malas"
  end Main
end MapDesplaza
