// NatBuiltin.bp — V7/H5 P2b.2: cualquier intrínseca desde una native, por el despachador de la VM (el helper
// call_builtin), de Core y de otro módulo (Math): float, entero, cadenas y booleano; una que LANZA; y un
// sleep, que bloquea el hilo mientras otro avanza (la native se suspende). Tras el sleep, la native lee una
// global que sólo el otro hilo pone: si la native no se hubiera suspendido DE VERDAD —el sleep sólo dejaría el
// hilo marcado como dormido y se dormiría luego, en el primer builtin ya interpretado—, la leería sin poner (la
// primera versión de esta prueba no lo distinguía: la salida salía igual). `make test-aotbuiltin` corre el
// MISMO .mod con el AOT y sin él y exige la misma salida.
module NatBuiltin
  import Core
  import Math

  var marca: integer := 0

  public function marcar()
    marca := 5
  end marcar

  public class Otro extends Thread
    public function Otro()
      super(0)
    end Otro
    public function run()
      print "ok otro: corre mientras la native duerme"
      marcar()
    end run
  end Otro

  native function raiz(x: float): float
    return sqrt(x)
  end raiz

  native function seno(x: float): float
    return Math.sin(x) + Math.cos(x)
  end seno

  native function valor(n: integer): integer
    return abs(n) * 2
  end valor

  native function empieza(s: string, p: string): boolean
    return startsWith(s, p)
  end empieza

  native function cadena(n: integer): string
    var arr: integer[] := newIntArray(2)
    return __charsToString(arr, n)
  end cadena

  native function dormida(): integer
    sleep(30)
    return marca
  end dormida

  function Main()
    print "ok raiz: " + raiz(2.25)
    print "ok seno: " + seno(0.5)
    print "ok valor: " + intToString(valor(0 - 21))
    print "ok empieza: " + empieza("basicplus", "basic") + " " + empieza("basicplus", "plus")
    try
      print "ok cadena: [" + cadena(0 - 1) + "]"
    catch e: RuntimeError
      print "ok cadena: atrapada: " + e.msg
    endtry
    var o: Otro := Otro()
    o.start()
    print "ok dormida: " + intToString(dormida())
    o.join()
    print "ok fin"
  end Main
end NatBuiltin
