// SmpFallo.bp — V7/H7 #596 (28-sep): una excepción sin atrapar acaba el programa EN ERROR —salida 1, «RuntimeError BP
// no atrapado»—, venga de Main o de otro hilo, y también con el scheduler SMP de la VM-C (antes: «status=OK», salida
// 0). Lo corre test/test_smpfallo.c con el argumento de ejecución: "main" lanza en Main, "hilo" en un hilo, y sin
// argumento no lanza nadie (el control).
module SmpFallo

  class Hilo extends Thread
    public function Hilo()
      super(4096)
    end Hilo
    public function run()
      throw RuntimeError("sin atrapar en un hilo")
    end run
  end Hilo

  function main(arg: string)
    if arg == "main" then
      throw RuntimeError("sin atrapar en Main")
    endif
    if arg == "hilo" then
      var h: Hilo := Hilo()
      h.start()
      h.join()
    endif
    print "fin sin excepcion"
  end main
end SmpFallo
