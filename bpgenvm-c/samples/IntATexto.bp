// IntATexto.bp — V8 #734 (29-oct): un integer pasado a texto, por los tres caminos —intToString, la suma con una cadena
// (el compilador la convierte con INT_TO_STRING) y print— en los bordes (0, ±1, cada cambio de cifra, ±2^31) y en un
// barrido de todo el rango. La VM-C lo hacía con snprintf, que en la RP2350 arrastra vfprintf (8,8 KB) por la caché del
// XIP en cada llamada; desde #734, con una rutina suya de 32 bits. Tiene que dar lo mismo que Integer.toString de la
// VM-Java: es de paridad, y está en el corpus.
module IntATexto

  var lineas: integer := 0

  // los tres caminos, en una línea; y si no casan entre sí, dicho
  function muestra(v: integer)
    var a: string := intToString(v)
    var b: string := "" + v
    print a, b, v
    if a != b then
      print "DISTINTOS", a, b
    endif
    lineas := lineas + 1
  end muestra

  function main()
    var minimo: integer := -2147483647 - 1
    muestra(0)
    muestra(1)
    muestra(-1)
    muestra(7)
    muestra(-7)
    muestra(32767)
    muestra(-32768)
    muestra(65535)
    muestra(65536)
    muestra(2147483647)
    muestra(2147483646)
    muestra(-2147483647)
    muestra(minimo)
    muestra(minimo + 1)
    // cada cambio de cifra: 10^k - 1, 10^k y 10^k + 1, y sus negativos, hasta 10^9
    var p: integer := 1
    for k := 1 to 9 do
      p := p * 10
      muestra(p - 1)
      muestra(p)
      muestra(p + 1)
      muestra(0 - p + 1)
      muestra(0 - p)
      muestra(0 - p - 1)
    next k
    // un barrido de todo el rango, sin desbordar: de -2^31 + 1 a 2^31 - 1 a pasos de 1073741 y un poco
    var v: integer := minimo + 1
    var paso: integer := 1073741 * 2 + 37
    var i: integer := 0
    while i < 1000 do
      muestra(v)
      if v > 2147483647 - paso then
        v := minimo + 1 + i
      else
        v := v + paso
      endif
      i := i + 1
    endwh
    print "lineas", lineas
  end main
end IntATexto
