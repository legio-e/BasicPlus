// HeapCompactEv.bp — V7/H7 #595 (28-sep), el caso que encontró la revisión: un hilo cuya ÚLTIMA sentencia es un
// `raise` muere debiendo su evento, y el scheduler lo resucita para atenderlo (#342). `join` no debe volver hasta que
// lo haya atendido, y entonces Heap.compact() ya no ve ningún hilo vivo. En miVM y en la VM-C sin SMP era así; con
// --smp, el join volvía ANTES del handler y la compactación se rechazaba o no según el momento. La prueba de SMP es
// `make test-compactsmp` (test/test_compactsmp.c), que lo corre muchas veces con dos workers.
module HeapCompactEv
  import Heap

  class Tarea extends Thread
    event alAcabar(quien: Thread)
    public function Tarea()
      super(4096)
    end Tarea
    public function run()
      raise alAcabar(this)
    end run
  end Tarea

  class Oyente
    function event atender(quien: Thread)
      print "handler: atendido"
    end atender
  end Oyente

  public function Main()
    var t: Tarea := Tarea()
    var o: Oyente := Oyente()
    t.alAcabar := o::atender
    t.start()
    t.join()
    print "join vuelto"
    try
      Heap.compact()
      print "compactado"
    catch e: RuntimeError
      print "rechazo: " + e.msg
    endtry
  end Main
end HeapCompactEv
