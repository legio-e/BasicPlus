// UnHiloCalcula.bp — V7/H12, #662 (5-oct): un programa de UN hilo que sólo calcula. Con dos runs, el otro run no tiene
// nada que hacer y no debe despertarse tras cada cuanto (antes: cada 1 024 pasos, un 35 % más lento en el PC y un 7,3 %
// en la Pico 2). test-cola 16 cuenta sus vueltas sin hilo.
module UnHiloCalcula

  function fib(n: integer): integer
    if n < 2 then
      return n
    endif
    return fib(n - 1) + fib(n - 2)
  end fib

  function Main()
    print "fib(22) = " + fib(22)
  end Main

end UnHiloCalcula
