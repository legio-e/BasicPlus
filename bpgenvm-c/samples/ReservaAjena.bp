// ReservaAjena.bp — V8 #762 (4-nov) y #800 (7-nov): la reserva que no cabe tras la colecta de otro. Dos hilos piden
// bloques de 2 KB sin guardar ninguno, y la prueba apaga la colecta por volumen: el heap se llena de basura y cada
// reserva que no cabe va a colectar. La prueba (test/test_cola.c, la parte 21) da la primera por hecha «por otro», sin
// colectar: si la reserva se rinde ahí, «No space in heap» con el heap lleno de basura; tiene que colectar ella. Con 1
// run y con 2 (uno en cada uno). Determinista en el resultado: «sin sitio: 0».
module ReservaAjena
  class Pide extends Thread
    var n: integer
    var sinSitio: integer

    public function Pide(n: integer)
      super(4096)
      this.n := n
      this.sinSitio := 0
    end Pide

    public function run()
      var i: integer := 0
      while i < this.n do
        try
          var b: byte[] := newByteArray(2048)
          b[0] := 1
        catch e: Exception
          this.sinSitio := this.sinSitio + 1
        endtry
        i := i + 1
      endwh
    end run

    public function fallos(): integer
      return this.sinSitio
    end fallos
  end Pide

  function Main()
    var a: Pide := Pide(100)
    var b: Pide := Pide(100)
    a.start()
    b.start()
    a.join()
    b.join()
    print "sin sitio: " + (a.fallos() + b.fallos())
  end Main
end ReservaAjena
