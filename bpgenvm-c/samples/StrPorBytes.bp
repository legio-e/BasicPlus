// StrPorBytes.bp — V8/H5 (21-oct): Str.compare y Str.lastIndexOf POR BYTES dan lo mismo que carácter a carácter.
//
// Eduardo: «La comparación se puede hacer como si fuera byte a byte en vez de caracter a caracter?». En UTF-8 dos
// cadenas son iguales carácter a carácter si y sólo si lo son byte a byte, y el orden de los bytes es el de los
// codepoints: Str las hace ahora por bytes (V8_IDEAS §E5, «Comparar por bytes»). Aquí, las de antes —copiadas tal
// cual, por charCodeAt— hacen de referencia, sobre pares de cadenas casi iguales con caracteres de 1, 2, 3 y 4 bytes
// (también los de los bordes de cada longitud), agujas sacadas de la propia cadena y que no están, y cadenas vacías y
// sin valor. Se comprueba ella misma, y va en el corpus de la paridad.
module StrPorBytes
  import Core
  import Str

  var hechas: integer := 0
  var malas: integer := 0
  var nada: string          // sin valor: es ""

  // ─── las de antes, por caracteres (Str.bp hasta el 21-oct) ───

  function compareAntes(a: string, b: string): integer
    var la: integer := strlen(a)
    var lb: integer := strlen(b)
    var n: integer := la
    if lb < n then
      n := lb
    endif
    var i: integer := 0
    while i < n do
      var ca: integer := charCodeAt(a, i)
      var cb: integer := charCodeAt(b, i)
      if ca < cb then
        return -1
      endif
      if ca > cb then
        return 1
      endif
      i := i + 1
    endwh
    if la < lb then
      return -1
    endif
    if la > lb then
      return 1
    endif
    return 0
  end compareAntes

  function lastIndexOfAntes(s: string, sub: string): integer
    var ls: integer := strlen(s)
    var lsub: integer := strlen(sub)
    if lsub == 0 then
      return ls
    endif
    if lsub > ls then
      return -1
    endif
    var start: integer := ls - lsub
    while start >= 0 do
      var k: integer := 0
      var ok: boolean := true
      while ok and k < lsub do
        if charCodeAt(s, start + k) != charCodeAt(sub, k) then
          ok := false
        endif
        k := k + 1
      endwh
      if ok then
        return start
      endif
      start := start - 1
    endwh
    return -1
  end lastIndexOfAntes

  function mira(que: string, obtenido: integer, esperado: integer, a: string, b: string)
    hechas += 1
    if obtenido != esperado then
      malas += 1
      if malas <= 20 then
        print "  MAL " + que + ": " + obtenido + " (antes " + esperado + ") con [" + a + "] y [" + b + "]"
      endif
    endif
  end mira

  var x: integer := 11

  function azar(m: integer): integer
    x := (x * 75 + 74) mod 65537
    return x mod m
  end azar

  // un carácter de 1, 2, 3 o 4 bytes, también los de los bordes de cada longitud
  function unCaracter(): integer
    var r: integer := azar(16)
    if r == 0 then
      return 127
    elseif r == 1 then
      return 128
    elseif r == 2 then
      return 2047
    elseif r == 3 then
      return 2048
    elseif r == 4 then
      return 65533
    elseif r == 5 then
      return 65535
    elseif r == 6 then
      return 65536
    elseif r == 7 then
      return 128512
    elseif r == 8 then
      return 241
    elseif r == 9 then
      return 233
    elseif r == 10 then
      return 8364
    elseif r == 11 then
      return 10003
    endif
    return 97 + azar(4)
  end unCaracter

  function Main()
    // los dos sentidos de cada par: casi iguales (cambia uno, se corta, crece o nada)
    var k: integer := 0
    while k < 1500 do
      var n: integer := 1 + azar(8)
      var cs: integer[] := newIntArray(n)
      var i: integer := 0
      while i < n do
        cs[i] := unCaracter()
        i += 1
      endwh
      var sa: StringBuilder := StringBuilder()
      var sb: StringBuilder := StringBuilder()
      var donde: integer := azar(n)
      var como: integer := azar(4)
      i := 0
      while i < n do
        sa.appendChar(cs[i])
        if i == donde and como == 0 then
          sb.appendChar(unCaracter())
        elseif i == donde and como == 1 then
          i := n
        else
          sb.appendChar(cs[i])
        endif
        if i < n then
          i += 1
        endif
      endwh
      if como == 2 then
        sb.appendChar(unCaracter())
      endif
      var a: string := sa.toString()
      var b: string := sb.toString()
      mira("compare", Str.compare(a, b), compareAntes(a, b), a, b)
      mira("compare al revés", Str.compare(b, a), compareAntes(b, a), b, a)
      // lastIndexOf: una aguja de la propia cadena (un trozo de 1 a 3 caracteres), la otra cadena, y una que no está
      var d: integer := azar(n)
      var h: integer := d + 1 + azar(3)
      var aguja: string := substring(a, d, h)
      mira("lastIndexOf trozo", Str.lastIndexOf(a + b + a, aguja), lastIndexOfAntes(a + b + a, aguja), a + b + a, aguja)
      mira("lastIndexOf otra", Str.lastIndexOf(a, b), lastIndexOfAntes(a, b), a, b)
      mira("lastIndexOf no está", Str.lastIndexOf(a, aguja + "\t"), lastIndexOfAntes(a, aguja + "\t"), a, aguja)
      k += 1
    endwh
    print "al azar: " + hechas + " comprobaciones, " + malas + " malas"

    // los bordes: vacías, sin valor, iguales, prefijos
    var h0: integer := hechas
    var bordes: string[] := ["", "a", "ab", "ñ", "añ", "aña", "€", "a€", "😀", "a😀b", "ñ😀", "z", Str.fromCharCode(127), Str.fromCharCode(128)]
    var p: integer := 0
    while p < len(bordes) do
      var q: integer := 0
      while q < len(bordes) do
        mira("compare borde", Str.compare(bordes[p], bordes[q]), compareAntes(bordes[p], bordes[q]), bordes[p], bordes[q])
        mira("lastIndexOf borde", Str.lastIndexOf(bordes[p], bordes[q]), lastIndexOfAntes(bordes[p], bordes[q]), bordes[p], bordes[q])
        q += 1
      endwh
      mira("compare con nada", Str.compare(bordes[p], nada), compareAntes(bordes[p], nada), bordes[p], "nada")
      mira("compare nada con", Str.compare(nada, bordes[p]), compareAntes(nada, bordes[p]), "nada", bordes[p])
      mira("lastIndexOf de nada", Str.lastIndexOf(nada, bordes[p]), lastIndexOfAntes(nada, bordes[p]), "nada", bordes[p])
      mira("lastIndexOf nada", Str.lastIndexOf(bordes[p], nada), lastIndexOfAntes(bordes[p], nada), bordes[p], "nada")
      p += 1
    endwh
    print "bordes: " + (hechas - h0) + " comprobaciones"
    print "por bytes: " + hechas + " comprobaciones, " + malas + " malas"
  end Main
end StrPorBytes
