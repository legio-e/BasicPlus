// EnumEntero.bp — V8/H6 (#754, 31-oct): un enum se convierte en su entero con la conversión numérica: integer(c),
// long(c), float(c) y double(c) (en JC, `(int) c`, como en C#). Eduardo: «la conversión de Enum a entero ha de ser
// válida siempre que se haga con la sintaxis correcta. El compilador ya sabe el valor entero del enum así que es el
// compilador el que ha de hacer la conversión. Y si es una variable o un parámetro la traducción es directa también».
// Al revés, de un entero a un enum, sigue sin valer (#522: samples/errores/EnumMal.bp). Es de paridad (está en el
// corpus), y se comprueba sola: una línea FALLO pone la red en rojo aunque las dos VMs coincidan.
module EnumEntero
  import Core

  var malas: integer := 0

  public enum Color
    ROJO
    VERDE
    AZUL := 5
  end Color

  public class Caja
    var c: Color
    public function Caja(c: Color)
      this.c := c
    end Caja
    public function valor(): integer
      return integer(this.c)
    end valor
  end Caja

  function mira(que: string, obtenido: integer, esperado: integer)
    if obtenido == esperado then
      print "ok " + que + ": " + intToString(obtenido)
    else
      malas += 1
      print "FALLO " + que + ": " + intToString(obtenido) + ", se esperaba " + intToString(esperado)
    endif
  end mira

  function delParametro(c: Color): integer
    return integer(c)
  end delParametro

  function main()
    mira("una constante", integer(Color.AZUL), 5)
    var c: Color := Color.VERDE
    mira("una variable", integer(c), 1)
    mira("un parámetro", delParametro(Color.ROJO), 0)
    mira("un campo", Caja(Color.AZUL).valor(), 5)
    mira("con cuentas", integer(c) + integer(Color.AZUL) * 2, 11)
    var a: Color := Color.ROJO
    var mayor: boolean := integer(c) > integer(a)
    mira("al comparar", iif(mayor, 1, 0), 1)
    var l: long := long(Color.AZUL)
    mira("a long", integer(l * 3L), 15)
    var f: float := float(c)
    mira("a float", integer(f * 4.0), 4)
    var d: double := double(Color.AZUL)
    mira("a double", integer(d / 2.0d * 10.0d), 25)
    print "malas: " + intToString(malas)
  end main
end EnumEntero
