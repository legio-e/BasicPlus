// CatCadena.bp — #554 (V7/H7, 27-sep): la concatenación de cadenas, que desde hoy copia con `move` y hace una cadena de
// `+` de una vez (una reserva y un `move` por operando; por grupos de 8 si es más larga). Se comprueba ELLA MISMA contra
// lo esperado —las dos VMs corren el mismo bytecode y podrían fallar igual: la paridad sola no lo vería—: cada línea
// dice «ok» o «FALLO». Y en el corpus de paridad, además, las dos VMs tienen que dar lo mismo.
module CatCadena
  import Core

  var llamadas: string := ""

  public class Punto
    private var x: integer
    private var y: integer
    public function Punto(x: integer, y: integer)
      this.x := x
      this.y := y
    end Punto
    public function toString(): string
      return "(" + this.x + "," + this.y + ")"
    end toString
  end Punto

  function marca(t: string): string
    llamadas := llamadas + t
    return t
  end marca

  function mira(nombre: string, obtenido: string, esperado: string)
    if obtenido == esperado then
      print "ok " + nombre + ": [" + obtenido + "]"
    else
      print "FALLO " + nombre + ": [" + obtenido + "] y se esperaba [" + esperado + "]"
    endif
  end mira

  function Main()
    var a: string := "uno"
    var b: string := "dos"
    var v: string := ""
    mira("dos", a + b, "unodos")
    mira("tres", a + "-" + b, "uno-dos")
    mira("vacias", v + a + v + v + b + v, "unodos")
    mira("todo vacio", v + v + v, "")
    mira("numeros", "x" + 1 + 2, "x12")
    mira("suma antes", 1 + 2 + "x", "3x")
    mira("parentesis", "x" + (1 + 2), "x3")
    mira("asociativo", a + ("-" + b + "-") + a, "uno-dos-uno")
    mira("numero delante", 1 + ("a" + 2) + 3, "1a23")
    mira("utf8", "año" + "·" + "€" + "ñ", "año·€ñ")
    mira("float", "f=" + 1.5 + ";" + 2, "f=1.5;2")
    mira("objeto", "p=" + Punto(1, 2) + "!", "p=(1,2)!")
    mira("objetos", Punto(1, 2) + "-" + Punto(3, 4) + "-" + Punto(5, 6), "(1,2)-(3,4)-(5,6)")
    mira("ocho", "a" + "b" + "c" + "d" + "e" + "f" + "g" + "h", "abcdefgh")
    mira("nueve", "a" + "b" + "c" + "d" + "e" + "f" + "g" + "h" + "i", "abcdefghi")
    mira("doce", "a" + "b" + "c" + "d" + "e" + "f" + "g" + "h" + "i" + "j" + "k" + "l", "abcdefghijkl")
    mira("veinte", "a" + "b" + "c" + "d" + "e" + "f" + "g" + "h" + "i" + "j" + "k" + "l" + "m" + "n" + "o" + "p" + "q" + "r" + "s" + "t", "abcdefghijklmnopqrst")
    mira("quince mixtos", "n" + 1 + "," + 2 + "," + 3 + "," + 4 + "," + 5 + "," + 6 + "," + 7 + ".", "n1,2,3,4,5,6,7.")
    llamadas := ""
    var r: string := marca("1") + marca("2") + marca("3") + marca("4") + marca("5")
    mira("orden de evaluacion", llamadas, "12345")
    mira("orden, el resultado", r, "12345")
    var s: string := ""
    var i: integer := 0
    while i < 50 do
      s := s + i + ","
      i += 1
    endwh
    mira("bucle, largo", "" + strlen(s), "140")
    mira("bucle, principio", substring(s, 0, 10), "0,1,2,3,4,")
    s += "fin" + "."
    mira("mas igual", substring(s, 131, strlen(s)), "47,48,49,fin.")
    print "fin"
  end Main
end CatCadena
