// EvDos.bp — #531 (V7, 27-sep): DÓNDE se entrega un evento y a qué hilo le toca, en las dos VMs.
// 1) Dos eventos en cola, una espera y un bucle que imprime cada 50 vueltas: el primero sale al despertar y el
//    segundo en el siguiente cambio de turno, que las dos VMs ponen a las 1024 instrucciones. Hasta #531, miVM cortaba
//    el turno con un temporizador de 10 ms y «onB» salía en un sitio distinto en cada ejecución (tras `fin` o tras la
//    vuelta 250); la VM-C, siempre tras la 50.
// 2) Dos hilos que calculan sin esperar e imprimen su avance: el reparto entre ellos cae en las mismas instrucciones.
// smp: fuera — #600: con dos workers los hilos de la parte 2 imprimen A LA VEZ, y la línea de uno se parte con
//      la del otro («  A 1000  B 1000»). Arreglado eso, `orden libre`: el orden de sus líneas no es fijo.
module EvDos

  class Fuente
    event onA(n: integer)
    event onB(s: string)
    public function Fuente()
    end Fuente
    public function dispara()
      raise onA(7)
      raise onB("hola")
    end dispara
  end Fuente

  class Oyente
    public function Oyente()
    end Oyente
    function event a(n: integer)
      print "onA " + n
    end a
    function event b(s: string)
      print "onB " + s
    end b
  end Oyente

  class Trabajo extends Thread
    var nombre: string
    public function Trabajo(nombre: string)
      super(8192)
      this.nombre := nombre
    end Trabajo
    public function run()
      var s: integer := 0
      var i: integer := 0
      while i < 3000 do
        s := s + (i mod 7)
        if i mod 500 == 0 then
          print "  " + this.nombre + " " + i
        endif
        i := i + 1
      endwh
      print "  " + this.nombre + " fin " + s
    end run
  end Trabajo

  public function main()
    var f: Fuente := Fuente()
    var o: Oyente := Oyente()
    f.onA := o::a
    f.onB := o::b
    f.dispara()
    sleep(50)
    var i: integer
    for i := 1 to 300 do
      if i mod 50 == 0 then
        print "vuelta " + i
      endif
    next
    print "fin de los eventos"

    var a: Trabajo := Trabajo("A")
    var b: Trabajo := Trabajo("B")
    a.start()
    b.start()
    a.join()
    b.join()
    print "fin"
  end main

end EvDos
