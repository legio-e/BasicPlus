// RutaFueraFlash.bp — #810 (14-nov): una ruta absoluta que se sale de la flash (`/../x`, `/a/../../x`) falla como en la
// placa, donde littlefs no deja subir de la raíz: cada operación con su texto («readFile('/../x'): no se pudo abrir»…), y
// fileExists e isDirectory dan false. La VM-C ya lo hacía así; la VM-Java decía «sandbox: path escapa de la flash» en
// todas, también en fileExists. Si una operación no falla, o fileExists dice que sí, una línea FALLO pone la red en rojo
// aunque las dos VMs digan lo mismo. La clase del error, con un `catch` por tipo y no con `instanceof`: en MOD8,
// `instanceof` no nombra una clase de Core (como en ErroresConTipo).
module RutaFueraFlash
  import IO

  function dice(que: string, clase: string, msg: string)
    print que + " -> " + clase + ": " + msg
  end dice

  function noFalla(que: string)
    print "FALLO: " + que + " no falla con una ruta fuera de la flash"
  end noFalla

  function Main()
    var malas: string[] := ["/../x810", "/a/../../x810"]
    var i: integer := 0
    while i < len(malas) do
      var p: string := malas[i]
      print "== " + p
      if fileExists(p) then
        print "FALLO: fileExists dice que sí"
      else
        print "fileExists -> false"
      endif
      if IO.isDirectory(p) then
        print "FALLO: isDirectory dice que sí"
      else
        print "isDirectory -> false"
      endif
      try
        var t: string := readFile(p)
        noFalla("readFile")
      catch e: IOError
        dice("readFile", "IOError", e.msg)
      catch e2: RuntimeError
        dice("readFile", "RuntimeError", e2.msg)
      endtry
      try
        writeFile(p, "a")
        noFalla("writeFile")
      catch e: IOError
        dice("writeFile", "IOError", e.msg)
      catch e2: RuntimeError
        dice("writeFile", "RuntimeError", e2.msg)
      endtry
      try
        appendFile(p, "a")
        noFalla("appendFile")
      catch e: IOError
        dice("appendFile", "IOError", e.msg)
      catch e2: RuntimeError
        dice("appendFile", "RuntimeError", e2.msg)
      endtry
      try
        var b: byte[] := readFileBytes(p)
        noFalla("readFileBytes")
      catch e: IOError
        dice("readFileBytes", "IOError", e.msg)
      catch e2: RuntimeError
        dice("readFileBytes", "RuntimeError", e2.msg)
      endtry
      try
        var d: byte[] := newByteArray(2)
        writeFileBytes(p, d)
        noFalla("writeFileBytes")
      catch e: IOError
        dice("writeFileBytes", "IOError", e.msg)
      catch e2: RuntimeError
        dice("writeFileBytes", "RuntimeError", e2.msg)
      endtry
      try
        var l: string[] := listDir(p)
        noFalla("listDir")
      catch e: IOError
        dice("listDir", "IOError", e.msg)
      catch e2: RuntimeError
        dice("listDir", "RuntimeError", e2.msg)
      endtry
      try
        IO.mkdir(p)
        noFalla("mkdir")
      catch e: IOError
        dice("mkdir", "IOError", e.msg)
      catch e2: RuntimeError
        dice("mkdir", "RuntimeError", e2.msg)
      endtry
      try
        IO.rmdir(p)
        noFalla("rmdir")
      catch e: IOError
        dice("rmdir", "IOError", e.msg)
      catch e2: RuntimeError
        dice("rmdir", "RuntimeError", e2.msg)
      endtry
      try
        IO.removeFile(p)
        noFalla("removeFile")
      catch e: IOError
        dice("removeFile", "IOError", e.msg)
      catch e2: RuntimeError
        dice("removeFile", "RuntimeError", e2.msg)
      endtry
      try
        IO.rename(p, "/data/fuera810b")
        noFalla("rename(fuera, dentro)")
      catch e: IOError
        dice("rename(fuera, dentro)", "IOError", e.msg)
      catch e2: RuntimeError
        dice("rename(fuera, dentro)", "RuntimeError", e2.msg)
      endtry
      try
        IO.copyFile(p, "/data/fuera810b")
        noFalla("copyFile(fuera, dentro)")
      catch e: IOError
        dice("copyFile(fuera, dentro)", "IOError", e.msg)
      catch e2: RuntimeError
        dice("copyFile(fuera, dentro)", "RuntimeError", e2.msg)
      endtry
      try
        var n: integer := IO.fileSize(p)
        noFalla("fileSize")
      catch e: IOError
        dice("fileSize", "IOError", e.msg)
      catch e2: RuntimeError
        dice("fileSize", "RuntimeError", e2.msg)
      endtry
      try
        var m: integer := IO.lastModified(p)
        noFalla("lastModified")
      catch e: IOError
        dice("lastModified", "IOError", e.msg)
      catch e2: RuntimeError
        dice("lastModified", "RuntimeError", e2.msg)
      endtry
      try
        var f: IO.File := IO.File(p, "r")
        noFalla("File(r)")
        f.close()
      catch e: IOError
        dice("File(r)", "IOError", e.msg)
      catch e2: RuntimeError
        dice("File(r)", "RuntimeError", e2.msg)
      endtry
      try
        var g: IO.File := IO.File(p, "w")
        noFalla("File(w)")
        g.close()
      catch e: IOError
        dice("File(w)", "IOError", e.msg)
      catch e2: RuntimeError
        dice("File(w)", "RuntimeError", e2.msg)
      endtry
      i := i + 1
    endwh
    // El destino de rename y copyFile, fuera, con un origen que existe: el origen no se mueve.
    writeFile("/data/fuera810c", "c")
    try
      IO.rename("/data/fuera810c", "/../x810")
      noFalla("rename(dentro, fuera)")
    catch e: IOError
      dice("rename(dentro, fuera)", "IOError", e.msg)
    catch e2: RuntimeError
      dice("rename(dentro, fuera)", "RuntimeError", e2.msg)
    endtry
    try
      IO.copyFile("/data/fuera810c", "/../x810")
      noFalla("copyFile(dentro, fuera)")
    catch e: IOError
      dice("copyFile(dentro, fuera)", "IOError", e.msg)
    catch e2: RuntimeError
      dice("copyFile(dentro, fuera)", "RuntimeError", e2.msg)
    endtry
    if not fileExists("/data/fuera810c") then
      print "FALLO: el origen se ha movido"
    endif
    IO.removeFile("/data/fuera810c")
    print "fin"
  end Main
end RutaFueraFlash
