// SqlTexto.bp — V8 (#724, 27-oct): EL TEXTO DE SQLITE, de punta a punta.
//
// SQLite guarda los bytes que le den sin mirar si son UTF-8 («garbage in, garbage out», su documentación), y hasta
// #724 el puente los traía tal cual y cortados en 512 bytes. Ahora `getStr` y `execStr` los traen enteros y
// descodificados: EncodingError si no es UTF-8 válido, o «�» con `getStr(i, true)`; `columnName`, igual de estricto;
// y el mensaje de un error, siempre con «�» (no puede fallar al darlo).
//
// Los textos se fabrican DENTRO de SQLite: el SQL que va al pack sigue con su tope de 512 bytes (ése sí avisa), y el
// texto largo sale de zeroblob y replace. El de Latin-1, de un CAST de un blob, como lo traería una base hecha por otro
// programa. Corre en el PC con `make test-sqltexto` y en una placa con el pack de SQLite. Lo que tiene que salir está
// escrito a mano: una línea FALLO pone la red en rojo.
module SqlTexto
  import Core
  import SQLite

  var buenas: integer := 0
  var malas: integer := 0

  function mira(que: string, obtenido: string, esperado: string)
    if obtenido == esperado then
      buenas += 1
      print "ok " + que + ": " + obtenido
    else
      malas += 1
      print "FALLO " + que + ": [" + obtenido + "], se esperaba [" + esperado + "]"
    endif
  end mira

  function hex2(v: integer): string
    var d: string := "0123456789ABCDEF"
    return charAt(d, v / 16) + charAt(d, v mod 16)
  end hex2

  // los bytes de la cadena, en hexadecimal (un «�» se ve como EF BF BD)
  function hex(s: string): string
    var b: byte[] := toBytes(s)
    var r: string := ""
    var i: integer := 0
    while i < len(b) do
      if i > 0 then
        r := r + " "
      endif
      r := r + hex2(b[i] & 255)
      i += 1
    endwh
    return r
  end hex

  function repite(c: string, n: integer): string
    var sb: StringBuilder := StringBuilder()
    var i: integer := 0
    while i < n do
      sb.appendStr(c)
      i += 1
    endwh
    return sb.toString()
  end repite

  // una cadena larga, resumida: sus bytes, sus caracteres y si es la que se esperaba
  function resumen(s: string, esperada: string): string
    var r: string := intToString(len(toBytes(s))) + " bytes, " + intToString(len(s)) + " caracteres"
    if s == esperada then
      return r + ", la esperada"
    endif
    return r + ", OTRA"
  end resumen

  // la fila `id` de la tabla t: getStr(0), o el texto de su EncodingError
  function lee(db: SQLite.Db, id: integer, ignorar: boolean): string
    var q: SQLite.Query := db.query("SELECT txt FROM t WHERE id = " + intToString(id))
    var r: string := "(sin fila)"
    if q.nextRow() then
      try
        if ignorar then
          r := hex(q.getStr(0, true))
        else
          r := hex(q.getStr(0))
        endif
      catch e: EncodingError
        r := e.msg
      endtry
    endif
    q.release()
    return r
  end lee

  function Main()
    var db: SQLite.Db := SQLite.Db()
    if not db.connect("sqltexto.db") then
      print "FALLO connect: " + db.errorMessage()
      return
    endif
    db.exec("DROP TABLE IF EXISTS t")
    db.exec("CREATE TABLE t (id INTEGER, txt TEXT)")
    db.exec("INSERT INTO t VALUES (1, 'año')")
    // 600 bytes: 511 «a», la «ñ» en los bytes 511 y 512 —donde cortaba el puente de antes— y 87 «b»
    db.exec("INSERT INTO t VALUES (2, replace(hex(zeroblob(255)), '0', 'a') || 'añ' || replace(hex(zeroblob(43)), '0', 'b') || 'b')")
    // «Mu», 0xF1 (la ñ de Latin-1), «oz»: lo que traería una base hecha por otro programa
    db.exec("INSERT INTO t VALUES (3, CAST(x'4D75F16F7A' AS TEXT))")

    // 1 — válido, tal cual
    mira("1 getStr", lee(db, 1, false), "61 C3 B1 6F")
    mira("1 execStr", hex(db.execStr("SELECT txt FROM t WHERE id = 1")), "61 C3 B1 6F")

    // 2 — ENTERO (SQLite cuenta 599 caracteres, y llegan todos)
    mira("2 length en SQLite", intToString(db.execInt("SELECT length(txt) FROM t WHERE id = 2")), "599")
    var q: SQLite.Query := db.query("SELECT txt FROM t WHERE id = 2")
    if q.nextRow() then
      mira("2 getStr", resumen(q.getStr(0), repite("a", 511) + "ñ" + repite("b", 87)),
           "600 bytes, 599 caracteres, la esperada")
    else
      mira("2 getStr", "(sin fila)", "600 bytes, 599 caracteres, la esperada")
    endif
    q.release()

    // 3 — Latin-1: EncodingError, o «�» si se pide
    mira("3 getStr", lee(db, 3, false), "fromBytes: UTF-8 mal formado en el byte 2 (0xF1)")
    mira("3 getStr(i, true)", lee(db, 3, true), "4D 75 EF BF BD 6F 7A")
    try
      var s: string := db.execStr("SELECT txt FROM t WHERE id = 3")
      mira("3 execStr", "no lanzó: " + hex(s), "fromBytes: UTF-8 mal formado en el byte 2 (0xF1)")
    catch e: EncodingError
      mira("3 execStr", e.msg, "fromBytes: UTF-8 mal formado en el byte 2 (0xF1)")
    endtry

    // 4 — el nombre de una columna, con acento
    q := db.query("SELECT 1 AS año")
    mira("4 columnName", hex(q.columnName(0)), "61 C3 B1 6F")
    q.release()

    // 5 — el mensaje de un error, por errorMessage
    try
      db.exec("SELECT * FROM no_existe")
      mira("5 exec", "no lanzó", "SQLite: no such table: no_existe")
    catch e: RuntimeError
      mira("5 exec", e.msg, "SQLite: no such table: no_existe")
    endtry

    db.exec("DROP TABLE t")
    db.close()
    print "buenas " + intToString(buenas) + ", malas " + intToString(malas)
  end Main
end SqlTexto
