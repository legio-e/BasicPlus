// NatCoste.bp — V7/H5 P2b.3: LO QUE CUESTA LLAMAR a una native, medido EN LA PLACA. Dos natives que hacen lo mismo,
// llamadas 20 000 veces cada una desde un bucle interpretado: una DIRECTA (sin puntos de cesión: una llamada de C,
// en la pila del worker) y otra con un bucle de una vuelta, que la manda a un EJECUTOR (el testigo: dos cambios de
// tarea por llamada). En el PC el testigo cuesta ~5 us por llamada; en una placa, esto lo dice. Las líneas «tiempo»
// cambian en cada pasada: la tanda las ignora; el resultado, no.
module NatCoste
  import Core
  import Machine

  native function uno(x: integer): integer
    return x + 1
  end uno

  native function unoCede(x: integer): integer
    var r: integer := x
    var i: integer := 0
    while i < 1 do
      r += 1
      i += 1
    endwh
    return r
  end unoCede

  function Main()
    var n: integer := 20000
    var t: integer := 0
    var i: integer := 0
    var t0: integer := Machine.uptimeMs()
    while i < n do
      t := uno(t)
      i += 1
    endwh
    var ms1: integer := Machine.uptimeMs() - t0
    print "ok directa: " + intToString(t)
    print "  tiempo: directa " + intToString(ms1) + " ms las " + intToString(n) + " llamadas"
    t := 0
    i := 0
    t0 := Machine.uptimeMs()
    while i < n do
      t := unoCede(t)
      i += 1
    endwh
    var ms2: integer := Machine.uptimeMs() - t0
    print "ok con ejecutor: " + intToString(t)
    print "  tiempo: con ejecutor " + intToString(ms2) + " ms las " + intToString(n) + " llamadas"
  end Main
end NatCoste
