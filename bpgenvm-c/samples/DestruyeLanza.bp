// DestruyeLanza.bp — V7 #668 (8-oct): un destructor que lanza no corta la limpieza (Eduardo: «Si se produce un error
// al liberar, se atrapa y se continúa con la liberación»). Se dice por stderr, con la clase, y se sigue: sus hermanos
// y su padre se destruyen igual, y el programa sigue. Se comprueba solo (una línea «FALLO» pone el sample en rojo).
module DestruyeLanza
  public property traza: string := ""

  public class Pieza
    public property nombre: string
    var owner primero: Pieza
    var owner segundo: Pieza
    public function Pieza(n: string)
      this.nombre := n
    end Pieza
    public function hijos(a: Pieza, b: Pieza)
      this.primero := a
      this.segundo := b
    end hijos
    public function ~Pieza()
      traza := traza + this.nombre + " "
      if this.nombre == "rota" then
        throw RuntimeError("la pieza rota no se deja cerrar")
      endif
    end ~Pieza
  end Pieza

  function comprueba(esperada: string, que: string)
    if traza != esperada then
      print "FALLO: " + que + ": [" + traza + "], y tenía que ser [" + esperada + "]"
    else
      print "ok  " + que + ": " + traza
    endif
    traza := ""
  end comprueba

  function monta()
    var owner a: Pieza := Pieza("a")
    a.hijos(Pieza("rota"), Pieza("c"))
  end monta

  function main()
    monta()
    comprueba("c rota a ", "el destructor que lanza no corta a los demás")
    try
      monta()
      print "  la limpieza no lanza fuera"
    catch e: Exception
      print "FALLO: la excepción del destructor salió fuera: " + e.msg
    endtry
    comprueba("c rota a ", "y no sale de la limpieza")
    print "fin"
  end main
end DestruyeLanza
