// CadenaNace.bp — V8 #776 (2-nov): el "" de un campo o una property string sin valor (#774) es su valor de NACIMIENTO,
// como el null de Java: se pone antes del constructor del padre, y lo que éste le dé a la hija por un método virtual no
// se borra después. Los inicializadores escritos (:= valor) van tras el super(), como en Java. Eduardo: «primero se
// hacen las inicializaciones implícitas y despues el constructor». Java, con el mismo programa: el campo sin valor
// queda en "hola", y los escritos, con lo suyo. Una clase sin constructor (Nieta), por el sintético, igual.
module CadenaNace
  import Core

  public class Base
    public function Base()
      this.poner("hola")
    end Base
    public function poner(s: string)
    end poner
  end Base

  public class Hija extends Base
    var sinValor: string
    var conVacia: string := ""
    var conTexto: string := "escrito"
    public property prop: string
    public function Hija()
      super()
    end Hija
    public function poner(s: string)
      print "poner() de Hija: " + this.muestra()
      this.sinValor := s
      this.conVacia := s
      this.conTexto := s
      this.prop := s
    end poner
    public function muestra(): string
      var t: string := "sinValor=[" + this.sinValor + "] conVacia=[" + this.conVacia + "]"
      return t + " conTexto=[" + this.conTexto + "] prop=[" + this.prop + "]"
    end muestra
  end Hija

  public class Nieta extends Hija
    var otra: string
    public function otraVacia(): boolean
      return this.otra == ""
    end otraVacia
  end Nieta

  public function main()
    var h: Hija := Hija()
    print "tras Hija(): " + h.muestra()
    var n: Nieta := Nieta()
    print "tras Nieta(): " + n.muestra() + " otra vacia: " + n.otraVacia()
  end main
end CadenaNace
