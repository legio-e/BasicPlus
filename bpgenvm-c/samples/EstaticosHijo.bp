// V7/H2 (#492-B) — oráculo de paridad: la mitad CONSUMIDORA de EstaticosBase.bp.
// Método estático de otro módulo (llamada, sobrecarga, protegido desde una hija, resolución
// por la cadena de bases: `Hija.cuantos()`), property estática (:=, +=, lectura, long,
// desempaquetado) y const estática — y #510: `Base.X` dentro de una derivada.
module EstaticosHijo
  import EstaticosBase

  public class Hija extends EstaticosBase.Base
    public function Hija()
      super()
    end Hija
    public function usa(): integer
      return EstaticosBase.Base.MAX + Hija.cuantos() + EstaticosBase.Base.protegido()
    end usa
  end Hija

  public function par(): (integer, integer)
    return (11, 12)
  end par

  public function main()
    print EstaticosBase.Base.MAX
    print EstaticosBase.Base.cuantos()
    print EstaticosBase.Base.cuantos(4)
    EstaticosBase.Base.total := 5
    print EstaticosBase.Base.total
    EstaticosBase.Base.total += 2
    print EstaticosBase.Base.total
    EstaticosBase.Base.grande := 5000000000L
    print EstaticosBase.Base.grande
    var b: EstaticosBase.Base := EstaticosBase.Base.crea()
    print b.valor()
    var h: Hija := Hija()
    print h.usa()
    print h.usa()
    print Hija.cuantos(2)
    Hija.total := 9
    print EstaticosBase.Base.total
    var x: integer
    { x, EstaticosBase.Base.total } := par()
    print x + EstaticosBase.Base.total
    print EstaticosBase.Base.f(5)
    print EstaticosBase.A_b.c() + EstaticosBase.A.b_c()
    var sab: SubAb := SubAb()
    print sab.m()
  end main

  // `super.m()` cross-module sobre A_b: con '_' llamaba a A.m() (a través de __cls_m_A_b_c…)
  public class SubAb extends EstaticosBase.A_b
    public function SubAb()
      super()
    end SubAb
    public function m(): integer
      return super.m() + 100
    end m
  end SubAb
end EstaticosHijo
