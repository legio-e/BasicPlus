// JsonErrores.bp — V8 (23-oct, #725): parseJson SIGUE TRAS UN ERROR, COMO UN COMPILADOR, Y LOS DA TODOS (diez como mucho).
//
// Eduardo: «Despues de un error debe intentar recuperarse como un compilador. El número de errore, yo pondría un límite
// de 10 como máximo, si hay mas hasta que no arregle los primero el resto no se ven y aborta, lanzando la excepción».
// Cada error, con su línea y columna; al acabar, AggregateError (hija de RuntimeError) con todos en su msg, uno por
// línea, y en su lista `errors`. Tras un error, salta hasta la siguiente ',' o el cierre del nivel; si falta una coma y
// lo que viene es otro elemento, lo apunta y sigue con él. Lo que tiene que salir, calculado a mano: una línea FALLO pone
// la red en rojo aunque las dos VMs coincidan.
module JsonErrores
  import Json

  var malas: integer := 0

  function mira(que: string, obtenido: string, esperado: string)
    if obtenido == esperado then
      print "ok " + que
    else
      malas += 1
      print "FALLO " + que + ": [" + obtenido + "], se esperaba [" + esperado + "]"
    endif
  end mira

  // el msg de la excepción de parseJson (o «sin error»)
  function errores(texto: string): string
    try
      var v: Json.JsonValue := Json.parseJson(texto)
      return "sin error"
    catch e: Json.AggregateError
      return e.msg
    endtry
  end errores

  function Main()
    // 1. lo válido, como siempre
    mira("válido", errores("{\"a\": 1, \"b\": [true, null, -2.5e3], \"c\": \"x\"}"), "sin error")

    // 2. un error: el msg, uno solo
    mira("un error", errores("{\"a\" 1}"), "JSON: línea 1, columna 6: se esperaba ':'")

    // 3. tres en una línea: la coma que falta (y sigue con la clave), una x en un array, un true sin acabar
    mira("tres en una línea", errores("{\"a\": 1 \"b\": 2, \"c\": [1, x, 3], \"d\": tru}"),
         "JSON: 3 errores:\n  línea 1, columna 9: se esperaba ',' o '}'\n  línea 1, columna 26: se esperaba un valor\n  línea 1, columna 41: se esperaba 'e'")

    // 4. en varias líneas: la coma que falta antes de "placas", una coma doble dentro y un entero que no cabe (#716)
    var t4: string := "{\n  \"nombre\": \"BasicPlus\",\n  \"version\": 8\n  \"placas\": [\"Pico\", \"Metro\",, \"P4\"],\n  \"x\": 99999999999\n}"
    mira("en varias líneas", errores(t4),
         "JSON: 3 errores:\n  línea 4, columna 3: se esperaba ',' o '}'\n  línea 4, columna 30: se esperaba un valor\n  línea 5, columna 8: '99999999999' no cabe en un integer")

    // 5. un array sin cerrar: un error, no dos (el segundo, en el mismo sitio, es la cascada)
    mira("sin cerrar", errores("[1, 2"), "JSON: línea 1, columna 6: se esperaba ',' o ']'")

    // 6. las comas que faltan en un array: una por cada una
    mira("comas que faltan", errores("[1 2 3]"),
         "JSON: 2 errores:\n  línea 1, columna 4: se esperaba ',' o ']'\n  línea 1, columna 6: se esperaba ',' o ']'")

    // 7. dentro de las cadenas: un escape que no existe y un sustituto suelto; la tercera clave, bien
    mira("en las cadenas", errores("{\"a\": \"x\\qy\", \"b\": \"\\uD83D\", \"c\": \"ok\"}"),
         "JSON: 2 errores:\n  línea 1, columna 9: escape no válido\n  línea 1, columna 21: sustituto UTF-16 sin su pareja")

    // 8. lo que sobra tras el valor
    mira("sobra texto", errores("{} x"), "JSON: línea 1, columna 4: sobra texto tras el valor")

    // 9. doce errores: se para en el décimo, y lo dice
    var doce: string := "[x, x, x, x, x, x, x, x, x, x, x, x]"
    mira("doce: se para en diez", errores(doce),
         "JSON: 10 errores, los primeros (puede haber más: se para en el décimo):\n  línea 1, columna 2: se esperaba un valor\n  línea 1, columna 5: se esperaba un valor\n  línea 1, columna 8: se esperaba un valor\n  línea 1, columna 11: se esperaba un valor\n  línea 1, columna 14: se esperaba un valor\n  línea 1, columna 17: se esperaba un valor\n  línea 1, columna 20: se esperaba un valor\n  línea 1, columna 23: se esperaba un valor\n  línea 1, columna 26: se esperaba un valor\n  línea 1, columna 29: se esperaba un valor")

    // 10. la lista: cada error, un JsonError con su línea y su columna
    try
      var v: Json.JsonValue := Json.parseJson(t4)
      mira("la lista", "sin error", "3 errores")
    catch e: Json.AggregateError
      mira("la lista, cuántos", intToString(e.errors.length()), "3")
      var p: Json.JsonError := Json.JsonError(e.errors.get(2))
      mira("la lista, el tercero", intToString(p.line) + ":" + intToString(p.column), "5:8")
      mira("la lista, su texto", p.msg, "línea 5, columna 8: '99999999999' no cabe en un integer")
    endtry

    // 11. quien ya atrapaba RuntimeError la atrapa también
    try
      var w: Json.JsonValue := Json.parseJson("[")
      mira("como RuntimeError", "sin error", "atrapada")
    catch e: RuntimeError
      mira("como RuntimeError", "atrapada", "atrapada")
    endtry

    print "JsonErrores: " + intToString(malas) + " mal"
  end Main
end JsonErrores
