// NatPesada.bp — V7 #592 (9-oct): una native cuyas VUELTAS SON LENTAS —cada una llama a un builtin que recorre una
// cadena grande, el indexOf de lo que no está— y que no acaba nunca. Hasta hoy cedía cada 1024 vueltas: con vueltas
// de un cuarto de ms, un cuarto de segundo sin atender a nadie, y el `kill` esperando otro tanto. Con la MARCA del 2º
// temporizador (un bucle que llama a algo la mira en cada vuelta) cede a los ~5 ms —en el PC con Windows, ~15—.
// `make test-aotpesada`.
module NatPesada
  native function pesada(s: string): integer
    var n: integer := 0
    while 1 == 1 do
      n += indexOf(s, "zz")
      if n < -1000000 then
        n := 0
      endif
    endwh
    return n
  end pesada

  function Main()
    var b: byte[] := newByteArray(262144)
    var s: string := fromBytes(b)
    print "ok pesada: entra en la native"
    var r: integer := pesada(s)
    print "FALLO: la native volvio " + intToString(r)
  end Main
end NatPesada
