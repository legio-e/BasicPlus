// HeapEstres.bp — V7/H7 (29-sep): el ESTRÉS de la reserva y del GC con varios hilos, la prueba que pidió Eduardo
// antes de tocar la reserva (#593): «Antes de hacerlo yo lo testearía en el PC, con 1 hilo y con varios».
//
// Cuatro hilos crean cadenas, arrays de cadenas y objetos con los builtins que reservan y llenan (upper, replace,
// substring, split, charAt, intToString, concatenar), se los pasan por un buzón compartido (con Mutex) y cada uno
// comprueba lo que recibe de los demás: la cadena se reconstruye desde su propio nombre y tiene que ser IGUAL. La red
// lo corre con el heap JUSTO (~1.000 colectas por ejecución) y 1, 2 y 4 workers, en las dos VMs. Cualquier fallo sale
// como un error de contenido, una excepción o un «heap descarrilado». La salida es determinista: los totales.
// Lo que cazó: el split de miVM perdía los trozos si una reserva colectaba (#611), y la VM-C de antes de #593
// corrompía con varios workers al crecer la tabla de handles (#610; V7_IDEAS §H7).
module HeapEstres
  import Heap

  public function construye(t: integer, i: integer): string
    var base: string := ""
    var k: integer := 0
    var largo: integer := 5 + (i mod 23)
    while k < largo do
      base := base + charAt("abcdefghijklmnopqrstuvwxyz", (t * 7 + i + k) mod 26)
      k := k + 1
    endwh
    var s: string := "h" + intToString(t) + "-" + intToString(i) + "-" + upper(base) + "-" + replace(base, "a", "AA")
    return substring(s, 0, len(s))
  end construye

  class Nota
    public property hilo: integer
    public property n: integer
    public property texto: string
    public property trozos: string[]

    public function Nota(hilo: integer, n: integer, texto: string, trozos: string[])
      this.hilo := hilo
      this.n := n
      this.texto := texto
      this.trozos := trozos
    end Nota
  end Nota

  class Buzon
    var m: Mutex
    var huecos: Object[]

    public function Buzon(tam: integer)
      this.m := Mutex()
      this.huecos := newObjArray(tam)
      var i: integer := 0
      while i < tam do
        this.huecos[i] := ""
        i := i + 1
      endwh
    end Buzon

    public function deja(i: integer, s: string)
      this.m.lock()
      this.huecos[i] := s
      this.m.unlock()
    end deja

    public function toma(i: integer): string
      this.m.lock()
      var r: string := string(this.huecos[i])
      this.m.unlock()
      return r
    end toma
  end Buzon

  class Obrero extends Thread
    var t: integer
    var k: integer
    var buzon: Buzon
    public property creados: integer
    public property leidos: integer
    public property errores: integer

    public function Obrero(t: integer, k: integer, buzon: Buzon)
      super(8192)
      this.t := t
      this.k := k
      this.buzon := buzon
      this.creados := 0
      this.leidos := 0
      this.errores := 0
    end Obrero

    public function run()
      var i: integer := 0
      while i < this.k do
        var s: string := construye(this.t, i)
        var p: string[] := split(s, "-")
        var nota: Nota := Nota(this.t, i, s, p)
        if len(nota.trozos) != 4 or nota.texto != s or nota.trozos[1] != intToString(i) then
          this.errores := this.errores + 1
        endif
        this.buzon.deja((this.t * 7 + i) mod 64, s)
        var r: string := this.buzon.toma((this.t * 5 + i * 3) mod 64)
        if len(r) > 0 then
          var q: string[] := split(r, "-")
          var tt: integer := parseInt(substring(q[0], 1, len(q[0])))
          var ii: integer := parseInt(q[1])
          if r != construye(tt, ii) then
            this.errores := this.errores + 1
          endif
          this.leidos := this.leidos + 1
        endif
        this.creados := this.creados + 1
        i := i + 1
      endwh
    end run
  end Obrero

  function main(arg: string)
    var k: integer := 400
    if len(arg) > 0 then
      k := parseInt(arg)
    endif
    var b: Buzon := Buzon(64)
    var o0: Obrero := Obrero(0, k, b)
    var o1: Obrero := Obrero(1, k, b)
    var o2: Obrero := Obrero(2, k, b)
    var o3: Obrero := Obrero(3, k, b)
    o0.start()
    o1.start()
    o2.start()
    o3.start()
    o0.join()
    o1.join()
    o2.join()
    o3.join()
    print "creados: ", o0.creados + o1.creados + o2.creados + o3.creados
    print "errores: ", o0.errores + o1.errores + o2.errores + o3.errores
    var lh: boolean := (o0.leidos + o1.leidos + o2.leidos + o3.leidos) > k
    print "leidos de otros: ", lh
    var muchas: boolean := Heap.getCollections() > 20
    print "muchas colectas: ", muchas
  end main

end HeapEstres
