// uafcascade.bp — Paso 5 / cascada owner de >=2 niveles (espeja MaquetaGc C4, H-006).
// A owns B, B owns C (nivel 2), B referencia D (NO-owner). Liberar A cascadea A->B->C
// (los tres gritan "objeto eliminado"); D SOBREVIVE (referenciado pero no owned).
module OwnerCascade

  public class Node
    public property nombre: string
    public property owner hijo: Node    // hijo OWNER: participa en la cascada
    public property vecino: Node        // referencia NO-owner: NO cascadea
    public function Node(nombre: string)
      this.nombre := nombre
    end Node
    public function ponHijo(h: Node)
      this.hijo := h
    end ponHijo
    public function ponVecino(v: Node)
      this.vecino := v
    end ponVecino
  end Node

  public class Box
    public property owner raiz: Node
    public function Box(n: Node)
      this.raiz := n
    end Box
    public function reemplaza(n: Node)
      this.raiz := n   // libera la raiz vieja -> dispara la cascada
    end reemplaza
  end Box

  function Main()
    var a: Node := Node("A")
    var b: Node := Node("B")
    var c: Node := Node("C")
    var d: Node := Node("D")
    a.ponHijo(b)        // A owns B
    b.ponHijo(c)        // B owns C   (nivel 2)
    b.ponVecino(d)      // B -> D     (no-owner)
    var owner box: Box := Box(a)   // box owns A

    print "vivos:", a.nombre, b.nombre, c.nombre, d.nombre   // A B C D

    box.reemplaza(Node("nuevo"))   // libera A -> cascada A, B, C ; D sobrevive

    try
      var na: string := a.nombre
      print "ERROR: A deberia estar liberado"
    catch e: RuntimeError
      print "A liberado:", e.msg
    endtry
    try
      var nb: string := b.nombre
      print "ERROR: B deberia estar liberado"
    catch e: RuntimeError
      print "B liberado (cascada nivel 1):", e.msg
    endtry
    try
      var nc: string := c.nombre
      print "ERROR: C deberia estar liberado"
    catch e: RuntimeError
      print "C liberado (cascada nivel 2):", e.msg
    endtry

    print "D sobrevive (no-owner):", d.nombre

    print "fin OK"
  end Main

end OwnerCascade
