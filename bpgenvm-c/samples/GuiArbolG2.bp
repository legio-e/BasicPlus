// GuiArbolG2.bp - V7/H10 G2 (3-oct; decidido por Eduardo el 2-oct): EL ARBOL DE LA GUI, COMPLETO.
//
//   (a) Bar, Led, Chart y Table se dan de alta en su contenedor como los demas (no lo hacian: no contaban, se
//       perdian en la ida y vuelta del .win y sus clics no llegaban); y toJson() escribe lo que el cargador ya leia
//       y el serializador callaba: el rango (min/max), las opciones y los items, los botones de un Msgbox, los
//       colores, y la forma de un Chart y la rejilla de un Table (que el cargador aprende a construir).
//   (b) el destructor: un widget sujeto por un `var owner` local se borra (nodo y alta en el padre) al salir de
//       ambito; la pantalla no.
//
// Se comprueba solo: cada fallo imprime FALLO (y la red lo cuenta rojo aunque las dos VMs coincidan).
module GuiArbolG2
  import Gui
  import Json
  import Core

  var fallos: integer

  function comprueba(que: string, ok: boolean)
    if ok then
      print "ok: " + que
    else
      print "FALLO: " + que
      fallos := fallos + 1
    endif
  end comprueba

  function contiene(s: string, trozo: string): boolean
    return indexOf(s, trozo) >= 0
  end contiene

  // (b) - un widget con dueño LOCAL: al volver, el destructor lo borra.
  function temporal(p: Gui.Panel)
    var owner t: Gui.Label := Gui.Label(p, "temporal")
    comprueba("(b) con el temporal vivo, el panel tiene 5 hijos", p.childCount() == 5)
  end temporal

  // (b) - la pantalla con dueño local: no se borra.
  function pantallaLocal()
    var owner s: Gui.Screen := Gui.Screen()
    comprueba("(b) la pantalla con dueño local existe", s.lvglId != 0)
  end pantallaLocal

  // El panel de la ida y vuelta: todo lo que toJson() tiene que escribir.
  function rellena(p: Gui.Panel)
    var et: Gui.Label := Gui.Label(p, "etiqueta")
    et.setBgColor(Gui.Color(0x10A0FF))
    et.setTextColor(Gui.Color(0x00FF00))
    var sl: Gui.Slider := Gui.Slider(p)
    sl.setRange(10, 50)
    sl.value := 20
    var br: Gui.Bar := Gui.Bar(p)
    br.setRange(0, 200)
    br.value := 150
    var sp: Gui.Spinbox := Gui.Spinbox(p)
    sp.value := 7
    var ld: Gui.Led := Gui.Led(p)
    ld.on()
    var dd: Gui.Dropdown := Gui.Dropdown(p)
    dd.setOptions("rojo\nverde\nazul")
    dd.selected := 2
    var lb: Gui.ListBox := Gui.ListBox(p)
    lb.setItems("x\ny")
    lb.selected := 1
    var mb: Gui.Msgbox := Gui.Msgbox(p, "hola")
    mb.setButtons("Si\nNo")
    var ch: Gui.Chart := Gui.Chart(p)
    ch.setPointCount(20)
    ch.setType(Gui.Chart.BARS)
    ch.setRange(-10, 10)
    var tb: Gui.Table := Gui.Table(p)
    tb.setGrid(2, 3)
    tb.setCell(0, 0, "a")
    tb.setCell(1, 2, "f")
  end rellena

  function Main()
    fallos := 0
    var scr: Gui.Screen := Gui.Screen()

    // (a) los cuatro, en el arbol
    var panel: Gui.Panel := Gui.Panel(scr)
    var br: Gui.Bar := Gui.Bar(panel)
    var ld: Gui.Led := Gui.Led(panel)
    var ch: Gui.Chart := Gui.Chart(panel)
    var tb: Gui.Table := Gui.Table(panel)
    comprueba("(a) Bar, Led, Chart y Table cuentan: el panel tiene 4 hijos", panel.childCount() == 4)
    comprueba("(a) y su padre es el panel", (br.getParent().lvglId == panel.lvglId) and (ld.getParent().lvglId == panel.lvglId)
              and (ch.getParent().lvglId == panel.lvglId) and (tb.getParent().lvglId == panel.lvglId))
    comprueba("(a) y salen en su JSON", contiene(panel.toJsonText(), "\"Bar\"") and contiene(panel.toJsonText(), "\"Table\""))

    // (b) el destructor de un owner local
    temporal(panel)
    comprueba("(b) al volver, el temporal se ha ido del panel: 4 hijos", panel.childCount() == 4)
    comprueba("(b) y del modelo", not contiene(Gui.__guiDumpTree(), "temporal"))
    pantallaLocal()
    comprueba("(b) la pantalla sigue en el modelo tras su dueño local, con lo suyo", contiene(Gui.__guiDumpTree(), "screen") and contiene(Gui.__guiDumpTree(), "bar"))
    panel.delete()

    // (a) la ida y vuelta: arbol -> J1 -> buildForm -> arbol -> J2
    var w1: Gui.Window := Gui.Window()
    var p1: Gui.Panel := Gui.Panel(w1)
    rellena(p1)
    var j1: string := p1.toJsonText()
    print "J1: " + j1
    comprueba("(a) J1 lleva el rango del slider", contiene(j1, "\"min\":10") and contiene(j1, "\"max\":50"))
    comprueba("(a) J1 lleva las opciones y los items", contiene(j1, "\"options\":\"rojo\\nverde\\nazul\"") and contiene(j1, "\"items\":\"x\\ny\""))
    comprueba("(a) J1 lleva los botones del Msgbox", contiene(j1, "\"buttons\":\"Si\\nNo\""))
    comprueba("(a) J1 lleva los colores", contiene(j1, "\"bgColor\":\"0x10A0FF\"") and contiene(j1, "\"textColor\":\"0x00FF00\""))
    comprueba("(a) J1 lleva la forma del Chart", contiene(j1, "\"points\":20") and contiene(j1, "\"chartType\":\"BARS\"") and contiene(j1, "\"min\":-10"))
    comprueba("(a) J1 lleva la rejilla del Table", contiene(j1, "\"rows\":2") and contiene(j1, "\"cells\":[[\"a\",\"\",\"\"],[\"\",\"\",\"f\"]]"))
    w1.destroy()

    var w2: Gui.Window := Gui.Window()
    var nodo: Json.JsonObject := Json.parseJson(j1).asObject()
    var raiz2: Gui.Component := Gui.buildForm(nodo, w2, w2)
    var j2: string := raiz2.toJsonText()
    comprueba("(a) J2 == J1: lo que se escribe, se lee y se vuelve a escribir igual", j2 == j1)
    if j2 != j1 then
      print "J2: " + j2
    endif
    var o: Object := raiz2
    var cont: Gui.Container := Gui.Container(o)
    comprueba("(a) y el panel reconstruido tiene sus 10 hijos", cont.childCount() == 10)
    print Gui.__guiDumpTree()
    w2.destroy()

    // #477 (lo barato): el giro, en la linea de la pantalla y solo si lo hay
    comprueba("#477: sin giro, la linea de la pantalla no lo dice", not contiene(Gui.__guiDumpTree(), "rot="))
    Gui.setRotation(90)
    comprueba("#477: girada, la linea de la pantalla dice rot=90", contiene(Gui.__guiDumpTree(), " rot=90]"))
    print Gui.__guiDumpTree()
    Gui.setRotation(0)

    if fallos == 0 then
      print "PASS"
    else
      print "FALLO: " + fallos + " comprobaciones"
    endif
  end Main
end GuiArbolG2
