// SueltaNpB.bp — V7 #667, EN PLACA: la otra mitad de SueltaNpA (o de SueltaRedA). Pide tantas tiras como aquél, en
// OTROS pines: si las del programa anterior no se soltaron al acabar, no quedan canales («no quedan canales RMT
// libres», como en la C6 el 7-oct) y sale FALLO con el motivo. Una línea «OK» por tira.
module SueltaNpB
  import Core
  import Machine
  import Neopixel

  function pines(): integer[]
    var m: string := Machine.getMicro()
    if m == "esp32c6" then
      var c6: integer[] := [18, 19]
      return c6
    endif
    if m == "esp32c3" then
      var c3: integer[] := [6, 7]
      return c3
    endif
    if m == "stm32u575" then
      var nu: integer[] := [39]
      return nu
    endif
    if m == "esp32s3" then
      var s3: integer[] := [38, 39, 40, 41]
      return s3
    endif
    if m == "esp32c5" then
      var c5: integer[] := [28, 24]
      return c5
    endif
    if m == "rp2350a" then
      var pa: integer[] := [6, 7, 8, 9]
      return pa
    endif
    if m == "rp2350b" then
      var pb: integer[] := [6, 7, 8]
      return pb
    endif
    if m == "esp32p4" then
      var p4: integer[] := [20]
      return p4
    endif
    if m == "stm32u5g9" then
      var dk2: integer[] := [24]
      return dk2
    endif
    var otro: integer[] := [7]
    return otro
  end pines

  function Main()
    var p: integer[] := pines()
    var vivas: List := List()
    var i: integer := 0
    while i < len(p) do
      try
        var t: Neopixel.Strip := Neopixel.Strip(p[i], 1)
        t.setColor(0, 8, 0)
        t.show()
        vivas.add(t)
        print "OK la tira del pin " + intToString(p[i])
      catch e: RuntimeError
        if contains(e.msg, "no implementado") then
          print "OK esta plataforma no tiene NeoPixel: nada que probar"
          return
        endif
        print "FALLO la tira del pin " + intToString(p[i]) + " no se pudo tomar: " + e.msg
      endtry
      i += 1
    endwh
    print "fin: " + intToString(vivas.length()) + " tiras"
  end Main
end SueltaNpB
