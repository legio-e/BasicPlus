// GcHuecoPila.bp — V8 #799 (13-nov): un objeto muerto se destruye en el primer gc() aunque un hueco de la pila sin
// escribir guarde una referencia vieja a él. ENTER reservaba las locales con lo que hubiera: un File que moría en
// sinCerrar() se quedaba abierto si la función que llamaba a gc() tenía un parámetro entero (su hueco de trabajo caía
// sobre la vieja `f`, con su marca y su generación buenas), o una local de referencia todavía sin escribir; en las dos
// VMs. Ahora ENTER pone las locales a cero. Se comprueba solo: una línea «FALLO» pone la red en rojo, aunque las dos VMs
// lo hagan igual de mal (y antes lo hacían).
//
// Salida esperada (las dos VMs):
//   con un parámetro: abre bien
//   con una local sin escribir: abre bien
//   fin
module GcHuecoPila
  import IO

  const R: string := "gchuecopila.bin"

  function sinCerrar()
    var f: IO.File := IO.File(R, "w")                 // muere sin close()
    f.write(toBytes("123"))
  end sinCerrar

  function reabre(): string
    var r: string := ""
    try
      var otra: IO.File := IO.File(R, "w")
      r := "abre bien"
      otra.close()
    catch e: RuntimeError
      r := "FALLO: el File muerto sigue abierto tras gc() (" + e.msg + ")"
    endtry
    return r
  end reabre

  // el caso medido: la función que llama a gc() tiene un parámetro entero
  function conParametro(x: integer)
    gc()
    sleep(0)                                          // cede: su destructor corre y lo cierra
    print "con un parámetro: " + reabre()
  end conParametro

  // y con una local de referencia que todavía no se ha escrito cuando se llama a gc()
  function conLocal(x: integer)
    gc()
    sleep(0)
    try
      var otra: IO.File := IO.File(R, "w")
      print "con una local sin escribir: abre bien"
      otra.close()
    catch e: RuntimeError
      print "con una local sin escribir: FALLO: el File muerto sigue abierto tras gc() (" + e.msg + ")"
    endtry
  end conLocal

  function borra()
    try
      IO.removeFile(R)
    catch e: RuntimeError
      print "FALLO: no se puede borrar (" + e.msg + ")"
    endtry
  end borra

  public function main()
    sinCerrar()
    conParametro(0)
    borra()
    sinCerrar()
    conLocal(0)
    borra()
    print "fin"
  end main
end GcHuecoPila
