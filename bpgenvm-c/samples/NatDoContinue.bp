// NatDoContinue.bp — V8 (24-oct, #699): `continue` dentro de un `do … loop c` va a la CONDICIÓN, como en C.
//
// La vuelta siguiente de un `do` sólo existe si su condición se cumple: es la regla de C, Java y C#, la del AOT
// (`do { … } while (c)`) y la del manual (§7.5). Hasta el 24-oct, en el intérprete, el `continue` volvía arriba sin
// mirarla: en la vuelta en que la condición ya no se cumplía, el bucle seguía, y el mismo bucle daba otra cosa si la
// función era `native`. Cada caso es una `native`: en el corpus corre interpretada, en las dos VMs; `make test-aotdo`
// la corre con el AOT y sin él, y exige lo mismo. Lo que tiene que salir, escrito a mano: una línea FALLO pone la red
// en rojo aunque las dos VMs coincidan. Los bucles que con la regla de antes no acababan llevan un tope de vueltas: un
// FALLO, y no un cuelgue.
module NatDoContinue
  import Core

  var malas: integer := 0

  function mira(que: string, obtenido: integer, esperado: integer)
    if obtenido == esperado then
      print "ok " + que + ": " + intToString(obtenido)
    else
      malas += 1
      print "FALLO " + que + ": " + intToString(obtenido) + ", se esperaba " + intToString(esperado)
    endif
  end mira

  // 1. El de la ficha: el continue llega en la vuelta en que la condición ya no se cumple, y el bucle acaba con 3.
  //    Con la regla de antes no acababa nunca (el tope: -1).
  native function hastaTres(): integer
    var k: integer := 0
    var vueltas: integer := 0
    do
      vueltas += 1
      if vueltas > 100 then
        return -1
      endif
      k += 1
      if k >= 3 then
        continue
      endif
    loop k < 3
    return k
  end hastaTres

  // 2. El continue salta lo que queda del cuerpo: la suma de los impares hasta 10, 25. Con la regla de antes, el
  //    continue del 10 seguía sin mirar la condición y sumaba el 11: 36.
  native function sumaImpares(): integer
    var k: integer := 0
    var suma: integer := 0
    do
      k += 1
      if k mod 2 == 0 then
        continue
      endif
      suma += k
    loop k < 10
    return suma
  end sumaImpares

  // 3. Dentro de un switch, el continue es del bucle de fuera (#546), y va a su condición: tres vueltas cuentan y la
  //    cuarta acaba (3 y 4: 34). Con la regla de antes, una vuelta más (45).
  native function enSwitch(): integer
    var k: integer := 0
    var n: integer := 0
    do
      k += 1
      switch k
        case 4
          continue
      endsw
      n += 1
    loop k < 4
    return n * 10 + k
  end enSwitch

  // 4. Dentro de un try, el continue cierra su manejador y corre su finally (#673), y va a la condición: tres finally
  //    y acaba con 3 (33). Con la regla de antes, una vuelta más (44).
  native function enTry(): integer
    var k: integer := 0
    var fin: integer := 0
    do
      k += 1
      try
        if k == 3 then
          continue
        endif
      finally
        fin += 1
      endtry
    loop k < 3
    return fin * 10 + k
  end enTry

  // 5. Dos do, uno dentro de otro: el continue del de dentro va a SU condición, y el de fuera da sus tres vueltas
  //    (1 + 100 cada una: 303). Con la regla de antes, el de dentro no acababa (el tope: -1).
  native function anidados(): integer
    var i: integer := 0
    var cuenta: integer := 0
    var vueltas: integer := 0
    do
      i += 1
      var j: integer := 0
      do
        vueltas += 1
        if vueltas > 100 then
          return -1
        endif
        j += 1
        if j >= 2 then
          continue
        endif
        cuenta += 1
      loop j < 2
      cuenta += 100
    loop i < 3
    return cuenta
  end anidados

  function Main()
    mira("1, el continue en la vuelta en que la condición ya no se cumple", hastaTres(), 3)
    mira("2, la suma de los impares hasta 10", sumaImpares(), 25)
    mira("3, el continue dentro de un switch", enSwitch(), 34)
    mira("4, el continue dentro de un try, con su finally", enTry(), 33)
    mira("5, dos do, uno dentro de otro", anidados(), 303)
    print "NatDoContinue: " + intToString(malas) + " mal"
  end Main
end NatDoContinue
