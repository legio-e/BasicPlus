// DatosGrandes.bp — V8 #768 (3-nov): el bloque de datos de un módulo, de más de 32 KB (hasta 64 KB). Los datos de un
// módulo (sus globales, sus literales, sus constantes y el descriptor de cada clase) viven DEBAJO de su código, a un
// desplazamiento negativo, y las instrucciones que los leen lo llevan en 16 bits: hasta el 3-nov, con signo (32 KB
// como mucho: un literal de 33 000 bytes no compilaba, y el error despistaba); desde entonces, un word menos 65 536
// (Eduardo: «si utilizas un word pasamos a 64K»). Aquí el relleno —un literal de 33 000 bytes, el valor de la primera
// variable— es el primer dato, y todo lo demás queda por debajo de -32 768: cada instrucción que lee un dato pasa por el
// camino nuevo, en las dos VMs —las globales de cada tamaño, una cadena, los literales, el descriptor de NEW_OBJECT,
// instanceof, los casts (también el de cadena, con su centinela 0) y el catch de una clase del módulo—. Lo que tiene
// que salir:
//   33000
//   8
//   201 -6 60001 -1235
//   1234567890124 3.5
//   hola, mundo
//   caja 42
//   true false
//   hola, mundo
//   CAST
//   mi error: atrapado
//   fin
module DatosGrandes

  import Core   // V6: los tipos de Core se importan

  // El relleno, el primer dato del módulo: 33 000 bytes ("0123456789", 3 300 veces), en una línea.
  var relleno: string := ""
  var n: integer := 7
  var b: byte := 200
  var c: int8 := -5
  var w: word := 60000
  var s16: int16 := -1234
  var l: long := 1234567890123L
  var d: double := 2.5d
  var texto: string := "hola"

  class Caja
    var v: integer
    public function Caja()
      this.v := 42
    end Caja
    public function di(): string
      return "caja " + this.v
    end di
  end Caja

  class Otra
    public function Otra()
    end Otra
  end Otra

  class MiError extends Exception
    public function MiError(m: string)
      super(m)
    end MiError
  end MiError

  function da(cual: integer): Object
    if cual == 1 then
      return Caja()
    endif
    if cual == 2 then
      return texto
    endif
    return Otra()
  end da

  function Main()
    print len(relleno)
    n := n + 1
    print n
    b := byte(b + 1)
    c := int8(c - 1)
    w := word(w + 1)
    s16 := int16(s16 - 1)
    print b; " "; c; " "; w; " "; s16
    l := l + 1L
    d := d + 1.0d
    print l; " "; d
    texto := texto + ", mundo"
    print texto
    var o: Object := da(1)
    print Caja(o).di()
    print o instanceof Caja, da(3) instanceof Caja
    print string(da(2))
    try
      var k: Caja := Caja(da(3))
      print "NO DEBERIA LLEGAR AQUI"
    catch e: RuntimeError
      print "CAST"
    endtry
    try
      throw MiError("atrapado")
    catch e: MiError
      print "mi error: " + e.msg
    endtry
    print "fin"
  end Main

end DatosGrandes
