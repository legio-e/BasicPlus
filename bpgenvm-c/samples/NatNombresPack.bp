// NatNombresPack.bp — #572 (V7, 27-sep): los identificadores de BP en el PUENTE a un pack. El emisor declara ahí
// `H`, el tipo `fn_t`, `fn`, `nm`, un búfer `b<i>` por cadena y una caja `o<i>` por `long[]`/`double[]`, y usa `r`
// y `k` al volver con una cadena: un parámetro con uno de esos nombres, o con el de `vm`, no compilaba. En el PC no
// hay pack "PRUE": `make test-aotnombres` sólo COMPILA el C que emite el AOT para este módulo (no lo ejecuta).
module NatNombresPack
  import Core
  import v1 from pack "PRUE"

  public native function f(fn: integer, nm: string, H: integer, o3: long[], k: integer, b5: string, r: integer): integer
  public native function g(fn_t: integer, vm: integer): string

  function Main()
    print "sin el pack PRUE no se ejecuta: esta muestra es para el C que emite el AOT"
  end Main
end NatNombresPack
