// DestruyeGc.bp — V7 #668 (8-oct): lo que nadie alcanza también se destruye, con su destructor (Eduardo: «Si
// liberamos el objeto, ha de ejecutar su destructor… lo libere quien lo libere»). El GC no lo suelta: lo aparta, y su
// destructor corre como código BP normal en el siguiente punto de planificación (aquí, el yield). Sus hijos owner,
// antes que él. Se comprueba solo (una línea «FALLO» pone el sample en rojo).
module DestruyeGc
  public property traza: string := ""

  public class Recurso
    public property nombre: string
    var owner hijo: Recurso
    public function Recurso(n: string)
      this.nombre := n
    end Recurso
    public function adopta(h: Recurso)
      this.hijo := h
    end adopta
    public function ~Recurso()
      traza := traza + this.nombre + " "
    end ~Recurso
  end Recurso

  function comprueba(esperada: string, que: string)
    if traza != esperada then
      print "FALLO: " + que + ": [" + traza + "], y tenía que ser [" + esperada + "]"
    else
      print "ok  " + que + ": " + traza
    endif
    traza := ""
  end comprueba

  // Sin owner: al volver, nadie lo alcanza.
  function suelta(n: string)
    var r: Recurso := Recurso(n)
    r.adopta(Recurso(n + "-hijo"))
  end suelta

  function main()
    var vueltas: integer := 1
    suelta("suelto")
    print "  creado y soltado: " + vueltas
    comprueba("", "nadie lo destruye antes del GC")
    gc()
    yield()
    comprueba("suelto-hijo suelto ", "el GC lo destruye, primero su hijo")
    gc()
    yield()
    comprueba("", "y una vez")
    print "fin"
  end main
end DestruyeGc
