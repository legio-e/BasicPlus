// RunTrasRun.bp — V7 #659 (7-oct): lo de un RUN empieza de cero en el siguiente. test/test_runtrasrun.c lo corre DOS
// veces en el mismo proceso —como el micro simulado o una placa: un RUN tras otro— y las dos tienen que decir lo mismo.
// Lee el ADC del stub (una rampa: la de la VM-Java empieza con cada VM) y lanza seis errores por cada camino de aviso:
// un indice fuera de rango (lo lanza el interprete) y un fichero que no existe (lo lanza un builtin). Los cinco
// primeros de cada camino y de cada RUN, avisados en el diagnostico.
module RunTrasRun
  import Adc

  function Main()
    var c: Adc.Channel := Adc.Channel(0)
    print "adc: " + c.read() + " " + c.read() + " " + c.read()
    var arr: integer[] := newIntArray(2)
    var cazadas: integer := 0
    var i: integer := 0
    while i < 6 do
      try
        var x: integer := arr[i + 5]
        print "no deberia llegar " + x
      catch e: Core.Exception
        cazadas := cazadas + 1
      endtry
      try
        var t: string := readFile("no_existe_659.txt")
        print "no deberia llegar " + t
      catch e2: Core.Exception
        cazadas := cazadas + 1
      endtry
      i := i + 1
    endwh
    print "cazadas: " + cazadas
  end Main
end RunTrasRun
