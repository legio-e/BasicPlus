// DestruyeFinal.bp — V7 #668 (8-oct): al acabar el programa se destruye todo lo que queda vivo con destructor —una
// global, un local sin owner del main—, el más nuevo primero (Eduardo: «Si el programa termina, sea de la forma que
// sea, se han de liberar todos los recursos… es importante que todo vuelva a la situación original»). Un owner del
// main se destruye antes, al salir de su ámbito. La salida es el orden: las dos VMs lo tienen que dar igual.
module DestruyeFinal
  public property global: Recurso := null

  public class Recurso
    public property nombre: string
    public function Recurso(n: string)
      this.nombre := n
    end Recurso
    public function ~Recurso()
      print "~" + this.nombre
    end ~Recurso
  end Recurso

  function main()
    global := Recurso("global")
    var suelto: Recurso := Recurso("suelto-del-main")
    var owner propio: Recurso := Recurso("propio")
    print "fin del main (" + suelto.nombre + ")"
  end main
end DestruyeFinal
