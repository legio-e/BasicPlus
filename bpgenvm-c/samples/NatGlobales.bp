// NatGlobales.bp — #588 (V7, 27-sep): una native que lee y escribe globales del módulo cuando ANTES hay globales de
// otros tipos (una string con valor inicial —su literal va justo detrás—, un long, un array, otra string). El AOT
// calculaba la posición de cada global por su cuenta (-4, -8… contando sólo las de 4 bytes) y con una string por delante
// leía otra palabra, sin un error. Ahora la toma del compilador. `make test-aotglobales` corre este .mod con el AOT y
// sin él y exige la misma salida.
module NatGlobales
  import Core

  var nombre: string := "hola"
  var grande: long := 5000000000L
  var n: integer := 5
  var otra: string := "adios"
  var datos: integer[]
  var f: float := 1.5
  var activo: boolean := true
  const K := 7
  var m: integer := 11

  native function suma(): integer
    return n + m + K
  end suma

  native function cambia(x: integer)
    n := n + x
    m := m * 2
  end cambia

  native function mitad(): float
    return f / 2.0
  end mitad

  native function siActivo(): integer
    if activo then
      return 1
    endif
    return 0
  end siActivo

  function Main()
    print "ok suma: " + suma()
    cambia(3)
    print "ok n y m: " + n + " " + m
    print "ok suma despues: " + suma()
    print "ok mitad: " + mitad()
    print "ok activo: " + siActivo()
    print "ok nombre y otra: " + nombre + " " + otra
    print "ok grande: " + grande
  end Main
end NatGlobales
