// PrintEntero.bp — V7/H7 #600 (28-sep): un `print` sale ENTERO. `print "Resultado=", r` son varias instrucciones
// —una por pieza y el salto— y con varios hilos la línea de otro se colaba en medio: con dos workers en cualquier
// momento; con uno, en el cambio de turno. Eduardo: «si haces print a; print b entre los dos se puede colgar un
// print de otro hilo, eso es correcto. Ahora si haces print "Resultado=", r que se cuele algo en medio no es
// correcto». Tres hilos y Main imprimen a la vez líneas de varias piezas, y bloques de tres líneas juntados en un
// StringBuilder e impresos con UN print. Con un worker el orden es fijo y las dos VMs dan lo mismo; con dos, no:
// el arnés compara las líneas ordenadas, y una línea partida no casaría con ninguna.
// smp: orden libre — tres hilos y Main imprimen a la vez: cada línea tiene que salir entera, en el orden que sea
module PrintEntero

  class Imprime extends Thread
    var nombre: string
    public function Imprime(nombre: string)
      super(4096)
      this.nombre := nombre
    end Imprime
    public function run()
      for i := 1 to 150 do
        print "hilo", this.nombre, "linea", i, "resultado=", i * 7, "largo", 1000000000000L + i, "medio", i * 0.5
        if i mod 50 == 0 then
          var sb: StringBuilder := StringBuilder()
          sb.appendStr("bloque " + this.nombre + " " + i + " 1/3\n")
          sb.appendStr("bloque " + this.nombre + " " + i + " 2/3\n")
          sb.appendStr("bloque " + this.nombre + " " + i + " 3/3")
          print sb.toString()
        endif
      next i
    end run
  end Imprime

  function main()
    var a: Imprime := Imprime("A")
    var b: Imprime := Imprime("B")
    var c: Imprime := Imprime("C")
    a.start()
    b.start()
    c.start()
    for i := 1 to 100 do
      print "main", i, "de", 100, true
    next i
    a.join()
    b.join()
    c.join()
    print "fin"
  end main
end PrintEntero
