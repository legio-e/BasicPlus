// TablaHandles.bp — V7/H7 #610 (29-sep): la TABLA DE HANDLES crece mientras otros hilos la leen.
//
// Cuatro hilos guardan cadenas VIVAS en su propio array —cada una, un handle más, así que la tabla crece varias
// veces— y a la vez releen las que ya tenían. En la VM-C la tabla crece moviéndose (un memmove dentro del heap) y los
// demás workers la leen sin cerrojo: sin parar el mundo, quien lee a mitad encuentra una dirección donde espera una
// generación (un use-after-free falso) o un cero donde espera una dirección. La red lo corre con el GC apagado
// (--nogc) y cuatro workers, varias veces: con el GC en marcha la tabla crece justo después de una colecta, con los
// demás parados, y no se ve. Poca basura a propósito: sin GC, cabe en los 512 KB de siempre.
module TablaHandles

  class Guarda extends Thread
    var t: integer
    var n: integer
    public property errores: integer

    public function Guarda(t: integer, n: integer)
      super(8192)
      this.t := t
      this.n := n
      this.errores := 0
    end Guarda

    public function run()
      var a: Object[] := newObjArray(16)
      var i: integer := 0
      while i < this.n do
        if i >= len(a) then
          a := growObjArray(a, len(a) * 2)
        endif
        a[i] := intToString(this.t * 100000 + i)
        var j: integer := (i * 7) mod (i + 1)
        if parseInt(string(a[j])) != this.t * 100000 + j then
          this.errores := this.errores + 1
        endif
        i := i + 1
      endwh
      i := 0
      while i < this.n do
        if parseInt(string(a[i])) != this.t * 100000 + i then
          this.errores := this.errores + 1
        endif
        i := i + 1
      endwh
    end run
  end Guarda

  function main(arg: string)
    var g0: Guarda := Guarda(0, 1500)
    var g1: Guarda := Guarda(1, 1500)
    var g2: Guarda := Guarda(2, 1500)
    var g3: Guarda := Guarda(3, 1500)
    g0.start()
    g1.start()
    g2.start()
    g3.start()
    g0.join()
    g1.join()
    g2.join()
    g3.join()
    print "errores: ", g0.errores + g1.errores + g2.errores + g3.errores
  end main

end TablaHandles
