// HiloExc.bp — V7/H7 #608 (29-sep): una excepción que NADIE atrapa en un hilo que no es el main acaba ESE hilo; los
// demás siguen, y al final el programa sale con error (1), para que el IDE o un script no lo den por bueno
// (Eduardo: «la A»).
//
// Antes dependía de la VM y de quién la lanzó: miVM acababa sólo el hilo con un error de la VM (dividir por cero),
// pero el PROGRAMA entero con un `throw` del programa; la VM-C acababa siempre el programa, aunque su propio aviso
// dijera «el thread TERMINA aquí». Aquí, un hilo que divide por cero y otro que hace `throw`, los dos sin atrapar: el
// main sigue y lo dice, igual en las dos VMs. La excepción del main sí acaba el programa (ThrowSinAtrapar).
module HiloExc

  class Divide extends Thread
    public property hecho: boolean

    public function Divide()
      super(0)
      this.hecho := false
    end Divide

    public function run()
      var cero: integer := 0
      print "divide: voy a dividir"
      print 10 / cero
      this.hecho := true
    end run
  end Divide

  class Lanza extends Thread
    var n: integer
    public property hecho: boolean

    public function Lanza()
      super(0)
      this.n := 0
      this.hecho := false
    end Lanza

    public function run()
      print "lanza: voy a lanzar"
      if this.n == 0 then
        throw RuntimeError("sin atrapar en un hilo")
      endif
      this.hecho := true
    end run
  end Lanza

  function main(arg: string)
    var d: Divide := Divide()
    d.start()
    d.join()
    print "main sigue; divide acabó: ", d.hecho
    var l: Lanza := Lanza()
    l.start()
    l.join()
    print "main sigue; lanza acabó: ", l.hecho
  end main

end HiloExc
