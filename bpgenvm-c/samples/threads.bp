// threads.bp — F4: dos threads BP que incrementan un contador
// protegido por mutex. Verifica:
//   - Thread.start spawnea un nuevo thread BP.
//   - Mutex.lock/unlock serializa el incremento.
//   - Thread.join bloquea hasta que el target termine.
//   - sleep() bloquea con wake-up por timeout.
module Threads

  // Estado compartido entre los Worker (clase del mismo módulo). Como un field
  // no puede ser public (L11.a), el estado que una clase lee del módulo va como
  // property: público ⇒ property. Los sitios de acceso no cambian.
  public property counter: integer
  public property mtx: Mutex

  // Inicializador del módulo (corre antes de Main). El init de una property a
  // nivel módulo no se hornea como el de una var, así que se asigna aquí.
  function Threads()
    counter := 0
    mtx := Mutex()
  end Threads

  public class Worker extends Thread
  
    public function Worker()
      super(1000)
    end Worker

    public function run()
      var i: integer := 0
      while i < 100 do
        mtx.lock()
        counter := counter + 1
        mtx.unlock()
        i := i + 1
      endwh
    end run
  end Worker

  function Main()
    var t1: Worker := Worker()
    var t2: Worker := Worker()
    t1.start()
    t2.start()
    t1.join()
    t2.join()
    print counter
  end Main

end Threads
