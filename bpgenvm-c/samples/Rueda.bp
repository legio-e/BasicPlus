// Rueda.bp — tres hilos que calculan sin ceder la CPU: ¿se turnan en rueda (los tres
// empiezan al principio) o se elige siempre el primero (empiezan de uno en uno)?
module Rueda
  public class Calc extends Thread
    public property nombre: string
    public function Calc(n: string)
      super(0)
      this.nombre := n
    end Calc
    public function run()
      print "empieza " + this.nombre
      var i: integer := 0
      var s: integer := 0
      while i < 2000000 do
        s := s + 1
        i := i + 1
      endwh
      print "acaba " + this.nombre
    end run
  end Calc

  function Main()
    var a: Calc := Calc("A")
    var b: Calc := Calc("B")
    var c: Calc := Calc("C")
    a.start()
    b.start()
    c.start()
    a.join()
    b.join()
    c.join()
    print "fin"
  end Main
end Rueda
