// GuiMismoPadre.bp — V7/H12 (test-cola 20): dos hilos crean etiquetas en el MISMO contenedor a la vez, sin cálculo
// entre medias. La lista de hijos de un contenedor es de la librería (Gui.bp, BP): sin cerrojo, dos altas a la vez la
// rompían —con dos runs, la Gui de antes perdía hijos en 7 de 40 pasadas: «400 creadas, 399 hijos»; con uno, más
// raro—. Desde el cerrojo del árbol (Gui.bp, decidido por Eduardo el 6-oct: «OK A»), siempre 400.
module GuiMismoPadre
  import Gui

  class Creador extends Thread
    var scr: Gui.Screen
    var n: integer

    public function Creador(scr: Gui.Screen)
      super(8192)
      this.scr := scr
      this.n := 0
    end Creador

    public function run()
      var i: integer := 0
      while i < 200 do
        var l: Gui.Label := Gui.Label(this.scr, "x")
        this.n := this.n + 1
        i := i + 1
      endwh
    end run

    public function cuantos(): integer
      return this.n
    end cuantos
  end Creador

  function Main()
    var scr: Gui.Screen := Gui.Screen()
    var a: Creador := Creador(scr)
    var b: Creador := Creador(scr)
    a.start()
    b.start()
    a.join()
    b.join()
    print "creadas: " + (a.cuantos() + b.cuantos()) + ", hijos de la pantalla: " + scr.childCount()
  end Main
end GuiMismoPadre
