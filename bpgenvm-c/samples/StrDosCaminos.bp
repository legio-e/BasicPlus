// StrDosCaminos.bp — V8/H5 (21-oct): los DOS ALGORITMOS de las cadenas dan lo mismo.
//
// Una cadena ASCII nace con el bit «todo ASCII» y va por el camino RÁPIDO (un carácter = un byte). Con un carácter
// especial va por el LENTO, el de siempre (contar el UTF-8). Cada función se pregunta por los dos caminos y las
// respuestas tienen que ser IGUALES; al final, la cuenta. Se comprueba ella misma, y va en el corpus de la paridad.
//
// V8/H5 (23-oct, #714) — el camino lento ya no se fuerza con `move`: una cadena es de SOLO LECTURA desde que nace
// (Eduardo: «Que un string es un invariante no se toca») y `move` la rechaza. Ahora la cadena lenta es la misma con una
// `ñ` AL FINAL: sus caracteres siguen en los mismos sitios, y cada comparación cuenta con esa `ñ` de más.
module StrDosCaminos
  import Core

  var comparadas: integer := 0
  var distintas: integer := 0

  function igual(que: string, rapido: string, lento: string)
    comparadas += 1
    if rapido == lento then
      print "  " + que + ": " + rapido
    else
      distintas += 1
      print "  DISTINTO " + que + ": rapido=[" + rapido + "] lento=[" + lento + "]"
    endif
  end igual

  // la misma cadena, por el camino lento: con una ñ al final ya no es ASCII (#714: move ya no le puede quitar el bit)
  function lenta(s: string): string
    return s + "ñ"
  end lenta

  function minimo(a: integer, b: integer): integer
    if a < b then
      return a
    endif
    return b
  end minimo

  // l = r + "ñ": los caracteres de r en los mismos sitios, y la ñ en el n (n = strlen(r))
  function compara(etiqueta: string, cs_base: string)
    var r: string := fromBytes(toBytes(cs_base))
    var l: string := lenta(cs_base)
    var n: integer := strlen(r)
    print etiqueta + " [" + cs_base + "]"
    igual("strlen", intToString(n), intToString(strlen(l) - 1))
    var i: integer := 0
    while i < n do
      igual("charAt " + i, charAt(r, i), charAt(l, i))
      igual("charCodeAt " + i, intToString(charCodeAt(r, i)), intToString(charCodeAt(l, i)))
      i += 1
    endwh
    // en la lenta, el final se corta en n: lo que la rápida recorta en su final
    igual("substring 1,3", substring(r, 1, 3), substring(l, 1, minimo(3, n)))
    igual("substring -5,2", substring(r, -5, 2), substring(l, -5, minimo(2, n)))
    igual("substring 2,99", substring(r, 2, 99), substring(l, 2, minimo(99, n)))
    igual("substring 3,1", substring(r, 3, 1), substring(l, 3, minimo(1, n)))
    igual("indexOf la", intToString(indexOf(r, "la")), intToString(indexOf(l, "la")))
    igual("indexOf vacía", intToString(indexOf(r, "")), intToString(indexOf(l, "")))
    igual("indexOf ñ", intToString(n), intToString(indexOf(l, "ñ")))
    igual("indexOf larga", intToString(indexOf(r, cs_base + "x")), intToString(indexOf(l, cs_base + "x")))
    igual("contains o", boolToString(contains(r, "o")), boolToString(contains(l, "o")))
    igual("contains ñ", "true", boolToString(contains(l, "ñ")))
    igual("startsWith h", boolToString(startsWith(r, "h")), boolToString(startsWith(l, "h")))
    igual("startsWith vacía", boolToString(startsWith(r, "")), boolToString(startsWith(l, "")))
    igual("endsWith a", boolToString(endsWith(r, "a")), boolToString(endsWith(l, "añ")))
    igual("endsWith larga", boolToString(endsWith(r, "x" + cs_base)), boolToString(endsWith(l, "x" + cs_base + "ñ")))
    igual("upper", upper(r) + "Ñ", upper(l))
    igual("lower", lower(r) + "ñ", lower(l))
    igual("replace o", replace(r, "o", "0") + "ñ", replace(l, "o", "0"))
    igual("concat", r + "!" + r + "ñ", r + "!" + l)
    try
      print "  charAt 99: " + charAt(r, 99)
    catch e: RuntimeError
      try
        print "  charAt 99: " + charAt(l, 99)
      catch f: RuntimeError
        // el texto lleva la longitud, y la lenta tiene un carácter más (la ñ)
        igual("charAt 99, el error", e.msg, replace(f.msg, "len=" + intToString(n + 1), "len=" + intToString(n)))
      endtry
    endtry
  end compara

  function Main()
    compara("ascii", "hola mundo")
    compara("bordes", "\t  Hola, Mundo  \n")
    compara("vacía", "")
    compara("uno", "x")

    // con caracteres especiales: los dos van por el lento; lo de siempre
    var acento: string := fromBytes(toBytes("canción año"))
    print "especiales [" + acento + "]: strlen " + intToString(strlen(acento)) + ", charAt 5 " + charAt(acento, 5) + ", indexOf año " + intToString(indexOf(acento, "año")) + ", upper " + upper(acento)
    // trim por el lento (en compara la ñ del final le quitaría el sitio a los blancos)
    print "trim lento [" + trim(" \t " + acento + " \n") + "]"

    // concatenar: ASCII + ASCII, ASCII + especial, y un trozo especial cortado que vuelve a ser ASCII
    var mezcla: string := fromBytes(toBytes("abc")) + "ñ" + fromBytes(toBytes("de"))
    print "mezcla [" + mezcla + "]: strlen " + intToString(strlen(mezcla)) + ", charAt 3 " + charAt(mezcla, 3) + ", charAt 4 " + charAt(mezcla, 4)
    var cola: string := substring(mezcla, 4, 6)
    print "cola [" + cola + "]: strlen " + intToString(strlen(cola)) + ", charCodeAt 1 " + intToString(charCodeAt(cola, 1))

    // `move` ya no mete una ñ en una cadena (#714): es de solo lectura, y la cadena se queda como estaba
    var m: string := fromBytes(toBytes("abcd"))
    try
      move(toBytes("ñ"), m, 0, 0, 2)
      print "move con ñ: ESCRIBIO [" + m + "]"
    catch em: RuntimeError
      print "move con ñ: " + em.msg + " [" + m + "]: strlen " + intToString(strlen(m)) + ", charAt 0 " + charAt(m, 0)
    endtry

    // un 0 dentro: un carácter más, por el rápido
    var nb: byte[] := newByteArray(3)
    nb[0] := 97
    nb[2] := 98
    var conCero: string := fromBytes(nb)
    print "con un 0: strlen " + intToString(strlen(conCero)) + ", charCodeAt 1 " + intToString(charCodeAt(conCero, 1))

    print "dos caminos: " + intToString(comparadas) + " comparaciones, " + intToString(distintas) + " distintas"
  end Main
end StrDosCaminos
