// StrDosCaminos.bp — V8/H5 (21-oct): los DOS ALGORITMOS de las cadenas dan lo mismo.
//
// Una cadena ASCII nace con el bit «todo ASCII» y va por el camino RÁPIDO (un carácter = un byte). La misma cadena con
// el bit quitado va por el LENTO, el de siempre (contar el UTF-8). Aquí el bit se quita con `move`, que escribe dentro
// —aunque sean los mismos bytes— y por eso lo quita. Cada función se pregunta por los dos caminos y las respuestas
// tienen que ser IGUALES; al final, la cuenta. Y `move` con una `ñ` dentro: si el bit siguiera puesto, strlen diría 4.
// Se comprueba ella misma, y va en el corpus de la paridad.
module StrDosCaminos
  import Core

  var comparadas: integer := 0
  var distintas: integer := 0

  function igual(que: string, rapido: string, lento: string)
    comparadas += 1
    if rapido == lento then
      print "  " + que + ": " + rapido
    else
      distintas += 1
      print "  DISTINTO " + que + ": rapido=[" + rapido + "] lento=[" + lento + "]"
    endif
  end igual

  // la misma cadena, por el camino lento: `move` de sus propios bytes le quita el bit
  function lenta(s: string): string
    var t: string := fromBytes(toBytes(s))
    if strlen(s) > 0 then
      move(toBytes(s), t, 0, 0, __bytesDe(s))
    endif
    return t
  end lenta

  function compara(etiqueta: string, base: string)
    var r: string := fromBytes(toBytes(base))
    var l: string := lenta(base)
    print etiqueta + " [" + base + "]"
    igual("strlen", intToString(strlen(r)), intToString(strlen(l)))
    var i: integer := 0
    while i < strlen(r) do
      igual("charAt " + i, charAt(r, i), charAt(l, i))
      igual("charCodeAt " + i, intToString(charCodeAt(r, i)), intToString(charCodeAt(l, i)))
      i += 1
    endwh
    igual("substring 1,3", substring(r, 1, 3), substring(l, 1, 3))
    igual("substring -5,2", substring(r, -5, 2), substring(l, -5, 2))
    igual("substring 2,99", substring(r, 2, 99), substring(l, 2, 99))
    igual("substring 3,1", substring(r, 3, 1), substring(l, 3, 1))
    igual("indexOf la", intToString(indexOf(r, "la")), intToString(indexOf(l, "la")))
    igual("indexOf vacía", intToString(indexOf(r, "")), intToString(indexOf(l, "")))
    igual("indexOf ñ", intToString(indexOf(r, "ñ")), intToString(indexOf(l, "ñ")))
    igual("indexOf larga", intToString(indexOf(r, base + "x")), intToString(indexOf(l, base + "x")))
    igual("contains o", boolToString(contains(r, "o")), boolToString(contains(l, "o")))
    igual("contains ñ", boolToString(contains(r, "ñ")), boolToString(contains(l, "ñ")))
    igual("startsWith h", boolToString(startsWith(r, "h")), boolToString(startsWith(l, "h")))
    igual("startsWith vacía", boolToString(startsWith(r, "")), boolToString(startsWith(l, "")))
    igual("endsWith a", boolToString(endsWith(r, "a")), boolToString(endsWith(l, "a")))
    igual("endsWith larga", boolToString(endsWith(r, "x" + base)), boolToString(endsWith(l, "x" + base)))
    igual("upper", upper(r), upper(l))
    igual("lower", lower(r), lower(l))
    igual("trim", trim(r), trim(l))
    igual("replace o", replace(r, "o", "0"), replace(l, "o", "0"))
    igual("concat", r + "!" + l, l + "!" + r)
    try
      print "  charAt 99: " + charAt(r, 99)
    catch e: RuntimeError
      try
        print "  charAt 99: " + charAt(l, 99)
      catch f: RuntimeError
        igual("charAt 99, el error", e.msg, f.msg)
      endtry
    endtry
  end compara

  function Main()
    compara("ascii", "hola mundo")
    compara("bordes", "\t  Hola, Mundo  \n")
    compara("vacía", "")
    compara("uno", "x")

    // con caracteres especiales: los dos van por el lento; lo de siempre
    var acento: string := fromBytes(toBytes("canción año"))
    print "especiales [" + acento + "]: strlen " + intToString(strlen(acento)) + ", charAt 5 " + charAt(acento, 5) + ", indexOf año " + intToString(indexOf(acento, "año")) + ", upper " + upper(acento)

    // concatenar: ASCII + ASCII, ASCII + especial, y un trozo especial cortado que vuelve a ser ASCII
    var mezcla: string := fromBytes(toBytes("abc")) + "ñ" + fromBytes(toBytes("de"))
    print "mezcla [" + mezcla + "]: strlen " + intToString(strlen(mezcla)) + ", charAt 3 " + charAt(mezcla, 3) + ", charAt 4 " + charAt(mezcla, 4)
    var cola: string := substring(mezcla, 4, 6)
    print "cola [" + cola + "]: strlen " + intToString(strlen(cola)) + ", charCodeAt 1 " + intToString(charCodeAt(cola, 1))

    // `move` mete una ñ (2 bytes) en una cadena ASCII: el bit tiene que irse
    var m: string := fromBytes(toBytes("abcd"))
    move(toBytes("ñ"), m, 0, 0, 2)
    print "move con ñ [" + m + "]: strlen " + intToString(strlen(m)) + " (3, no 4), charAt 0 " + charAt(m, 0)

    // un 0 dentro: un carácter más, por el rápido
    var nb: byte[] := newByteArray(3)
    nb[0] := 97
    nb[2] := 98
    var conCero: string := fromBytes(nb)
    print "con un 0: strlen " + intToString(strlen(conCero)) + ", charCodeAt 1 " + intToString(charCodeAt(conCero, 1))

    print "dos caminos: " + intToString(comparadas) + " comparaciones, " + intToString(distintas) + " distintas"
  end Main
end StrDosCaminos
