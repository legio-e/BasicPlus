// #530 (V7) — run() HEREDADO de un padre de otro módulo. Un hilo arranca por la ranura 0 de su
// vtable (run()); una clase que no lo redefine lleva ahí -1 («heredada») y hay que subir por la
// cadena, como en cualquier llamada virtual. Antes, la VM-C decía «no soportado F4 v1» y el hilo
// no arrancaba, y miVM saltaba a cs - 1 («Opcode no implementado»). Y la otra mitad de la ficha:
// un objeto cuya clase hereda de un Thread de otro módulo se pasa y se asigna como `Thread`.
module HiloUsa
  import HiloLib

  // hereda run() de HiloLib.Worker (otro módulo)
  public class Sumador extends HiloLib.Worker
    public function Sumador(n: string)
      super(n)
    end Sumador
  end Sumador

  // dos niveles: Sumador (este módulo) no lo tiene; Worker (otro módulo), sí
  public class Nieto extends Sumador
    public function Nieto(n: string)
      super(n)
    end Nieto
  end Nieto

  // redefinido en medio: Bajo lo hereda de Medio, del mismo módulo
  public class Medio extends HiloLib.Worker
    public function Medio(n: string)
      super(n)
    end Medio
    public function run()
      print this.nombre + " run propio de Medio"
    end run
  end Medio
  public class Bajo extends Medio
    public function Bajo(n: string)
      super(n)
    end Bajo
  end Bajo

  // sin run() en ninguna parte: el de Core.Thread, vacío; el hilo arranca y termina
  public class Mudo extends Thread
    public function Mudo()
      super(0)
    end Mudo
  end Mudo

  function arranca(t: Thread)
    t.start()
    t.join()
  end arranca

  function Main()
    var w: HiloLib.Worker := HiloLib.Worker("w1")
    arranca(w)
    var s: Sumador := Sumador("s2")
    s.start()
    s.join()
    print "s2: el total visto desde Main=" + s.total
    arranca(Nieto("n3"))
    arranca(Bajo("b4"))
    arranca(Mudo())
    print "mudo: arrancado y terminado"
    var t: Thread := Sumador("t5")
    t.start()
    t.join()
    print "fin"
  end Main
end HiloUsa
