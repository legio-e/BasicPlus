// FinallyAnidado.bp — V7/H9 #621 (2-oct): un finally DENTRO de otro, y la excepción que cada uno relanza es la SUYA.
// El emisor guardaba la excepción pendiente de todo finally de la función en UN local oculto (`__pending_exc`): un
// try/finally anidado podía pisarla —la de fuera relanzaba la de dentro— y, con la limpieza de #621 (una variable
// oculta vive una sentencia), ponerla a null antes de que la de fuera la relanzara. Ahora cada try/finally tiene la
// suya. Cada línea: el caso, la excepción que llega a Main y el orden en que corrieron los finally.
module FinallyAnidado

  var traza: string := ""

  // 1) Un try/finally DENTRO de un finally: la excepción que atraviesa el de fuera sigue siendo la suya.
  function dentroDelFinally()
    try
      throw RuntimeError("E1")
    finally
      try
        traza := traza + "a"
      finally
        traza := traza + "b"
      endtry
    endtry
  end dentroDelFinally

  // 2) Un try/finally dentro del CUERPO de otro: la excepción atraviesa los dos finally.
  function dentroDelCuerpo()
    try
      try
        throw RuntimeError("E2")
      finally
        traza := traza + "c"
      endtry
    finally
      traza := traza + "d"
    endtry
  end dentroDelCuerpo

  // 3) Dentro del finally, OTRA excepción que atraviesa su propio finally y se caza allí mismo: al acabar, el
  //    finally de fuera relanza la SUYA, no la otra.
  function otraDentro()
    try
      throw RuntimeError("E3")
    finally
      try
        try
          throw RuntimeError("otra")
        finally
          traza := traza + "e"
        endtry
      catch x: RuntimeError
        traza := traza + "f"
      endtry
    endtry
  end otraDentro

  // 4) El de dentro de un try/catch/finally: la excepción sale de un catch, pasa por el finally de dentro del finally.
  function desdeUnCatch()
    try
      throw RuntimeError("primera")
    catch x: RuntimeError
      throw RuntimeError("E4")
    finally
      try
        traza := traza + "g"
      finally
        traza := traza + "h"
      endtry
    endtry
  end desdeUnCatch

  function Main()
    traza := ""
    try
      dentroDelFinally()
      print "FALLO 1: no salio ninguna excepcion"
    catch e: RuntimeError
      print "1 " + e.msg + " " + traza
    endtry
    traza := ""
    try
      dentroDelCuerpo()
      print "FALLO 2: no salio ninguna excepcion"
    catch e: RuntimeError
      print "2 " + e.msg + " " + traza
    endtry
    traza := ""
    try
      otraDentro()
      print "FALLO 3: no salio ninguna excepcion"
    catch e: RuntimeError
      print "3 " + e.msg + " " + traza
    endtry
    traza := ""
    try
      desdeUnCatch()
      print "FALLO 4: no salio ninguna excepcion"
    catch e: RuntimeError
      print "4 " + e.msg + " " + traza
    endtry
    print "fin"
  end Main
end FinallyAnidado
