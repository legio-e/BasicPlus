// NatTry.bp — #578 (V7, 9-oct): `try`/`catch`/`finally` DENTRO de una native, traducido por el AOT. `make test-aottry`
// corre el MISMO .mod con el AOT y sin él (GC en cada reserva) y exige la misma salida, completa; y va a la ronda de
// natives en placa. Se comprueba solo: una línea FALLO es rojo.
module NatTry
  import Core

  public class MiError extends RuntimeError
    public function MiError(m: string)
      super(m)
    end MiError
  end MiError

  // BP al que llaman las natives: lanza una MiError si x > 0
  function lanzaMia(x: integer): integer
    if x > 0 then
      throw MiError("mia " + intToString(x))
    endif
    return 7
  end lanzaMia

  // 1. throw de la native (literal) dentro del try; un local cambiado dentro, leído en el catch
  native function uno(x: integer): integer
    var r: integer := 0
    try
      r := 10
      if x > 0 then
        throw RuntimeError("uno")
      endif
      r := 20
    catch e: RuntimeError
      r := r + 100
    endtry
    return r
  end uno

  // 2. el mensaje del catch: un throw con mensaje calculado, y e.msg leído dentro de la native
  native function dos(x: integer): string
    try
      throw RuntimeError("dos " + intToString(x))
    catch e: RuntimeError
      return "atrapada: " + e.msg
    endtry
    return "FALLO 2"
  end dos

  // 3. la lanza una función BP por el puente; el primer catch que casa es el de su clase
  native function tres(x: integer): integer
    var r: integer := 0
    try
      r := lanzaMia(x)
    catch e: MiError
      r := -1
    catch e: RuntimeError
      r := -2
    endtry
    return r
  end tres

  // 4. un catch que no es suyo: la relanza, y la atrapa el try de fuera (en la misma native)
  native function cuatro(x: integer): integer
    var r: integer := 0
    try
      try
        r := 1
        throw RuntimeError("cuatro")
      catch e: MiError
        r := 50
      endtry
    catch e: RuntimeError
      r := r + 40
    endtry
    return r
  end cuatro

  // 5. el finally en las tres salidas: normal, por el catch, y con un `return` dentro del try
  native function cinco(x: integer): string
    var s: string := ""
    try
      s := s + "t"
      if x == 1 then
        throw RuntimeError("cinco")
      endif
      if x == 2 then
        return s + "R"
      endif
      s := s + "n"
    catch e: RuntimeError
      s := s + "c"
    finally
      s := s + "f"
    endtry
    return s
  end cinco

  // 6. break y continue dentro de un try, con finally, en un bucle (#673 en la native)
  native function seis(n: integer): string
    var s: string := ""
    var i: integer := 0
    while i < n do
      i += 1
      try
        if i == 2 then
          continue
        endif
        if i == 4 then
          break
        endif
        s := s + intToString(i)
      finally
        s := s + "."
      endtry
    endwh
    return s
  end seis

  // 7. lo lanza un builtin (charAt fuera de rango); catch sin tipo
  native function siete(i: integer): string
    try
      return charAt("abc", i)
    catch e
      return "fuera de rango"
    endtry
    return "FALLO 7"
  end siete

  // 8. un catch sin variable; y un try en un bucle con GC en cada reserva: los aterrizajes, a la par
  native function ocho(n: integer): integer
    var s: integer := 0
    var i: integer := 0
    while i < n do
      try
        if i mod 3 == 0 then
          throw RuntimeError("ocho " + intToString(i))
        endif
        s += i
      catch
        s += 1000
      endtry
      i += 1
    endwh
    return s
  end ocho

  // 9. lo que lanza un catch con finally: corre el finally y sale (lo atrapa Main)
  native function nueve(x: integer): integer
    try
      throw RuntimeError("nueve dentro")
    catch e: RuntimeError
      throw RuntimeError("nueve desde el catch")
    finally
      print "  (finally de nueve)"
    endtry
    return 0
  end nueve

  // 10. de una native a otra: lanza la de dentro, la atrapa el try de la de fuera
  native function interior(x: integer): integer
    if x > 1 then
      throw RuntimeError("interior")
    endif
    return x * 3
  end interior

  native function diez(x: integer): integer
    try
      return interior(x) + 1
    catch e: RuntimeError
      return -10
    endtry
    return 0
  end diez

  // 11. sin catch que case: el finally corre y la excepción sigue hasta Main
  native function once(x: integer): integer
    try
      throw MiError("once")
    catch e: RuntimeError
      if x > 0 then
        throw e
      endif
      return 11
    finally
      print "  (finally de once)"
    endtry
    return 0
  end once

  function Main()
    print "ok 1 " + intToString(uno(0)) + " " + intToString(uno(1))
    print "ok 2 " + dos(2)
    print "ok 3 " + intToString(tres(0)) + " " + intToString(tres(1))
    print "ok 4 " + intToString(cuatro(0))
    print "ok 5 " + cinco(0) + " " + cinco(1) + " " + cinco(2)
    print "ok 6 " + seis(9)
    print "ok 7 " + siete(1) + " " + siete(9)
    print "ok 8 " + intToString(ocho(10)) + " " + intToString(ocho(200))
    try
      print "FALLO 9: no lanzo " + intToString(nueve(1))
    catch e: RuntimeError
      print "ok 9 " + e.msg
    endtry
    print "ok 10 " + intToString(diez(1)) + " " + intToString(diez(2))
    print "ok 11 " + intToString(once(0))
    try
      print "FALLO 11: no lanzo " + intToString(once(1))
    catch e: MiError
      print "ok 11b MiError: " + e.msg
    endtry
    print "ok fin"
  end Main
end NatTry
