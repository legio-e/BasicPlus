// InterfacesLib.bp — V8 H7.3 (#756): la librería de InterfacesUsa. Publica dos interfaces (una hereda de la otra y
// lleva una property), una clase suya que implementa la primera y una función que llama por ella sin saber qué clase
// le llega: la de aquí o una del programa. Lo que el programa ve de ellas es lo que publica la sección `interface` del
// .mod (bpi 10: `iface … end iface`, `implements`).
// mod8: fuera — las interfaces son del enlace tardío (MOD9)
module InterfacesLib

  public interface Forma
    function area(): double
    function nombre(): string
  end Forma

  public interface Medible extends Forma
    property escala: integer
  end Medible

  public class Punto implements Forma
    public function Punto()
    end Punto
    @implement{ Forma }
    public function area(): double
      return 0.0
    end area
    @implement{ Forma }
    public function nombre(): string
      return "punto"
    end nombre
  end Punto

  public function describe(f: Forma): string
    return f.nombre() + " de area " + f.area()
  end describe
end InterfacesLib
