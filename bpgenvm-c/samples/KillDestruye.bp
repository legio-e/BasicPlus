// KillDestruye.bp — V7 #668 (8-oct): un programa MATADO también se destruye (Eduardo: «Si el programa termina, sea
// de la forma que sea, se han de liberar todos los recursos… incluso que terminen con un kill»). Una global y un
// `var owner` del main con destructor, y el main dormido en un bucle: tras el KILL, la fase del final destruye los
// dos —el más nuevo primero— y el programa acaba como matado. Lo corre test-kill (fase 9).
module KillDestruye
  public property global: Recurso := null

  public class Recurso
    public property nombre: string
    public function Recurso(n: string)
      this.nombre := n
    end Recurso
    public function ~Recurso()
      print "~" + this.nombre
    end ~Recurso
  end Recurso

  function main()
    global := Recurso("global")
    var owner propio: Recurso := Recurso("propio")
    print "arrancado"
    while true do
      sleep(10)
    endwh
  end main
end KillDestruye
