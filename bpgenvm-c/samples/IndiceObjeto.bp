// IndiceObjeto.bp — V8/H8 (#794, 5-nov): `x[i]` sobre un objeto (Eduardo: «en realidad es la notación de una propiedad»). Una
// property con índice son dos métodos: `x[i]` es `x.get(i)`, y `x[i] := v`, `x.set(i, v)` (`put` en un Map); `x.pin[i]` es
// `x.getPin(i)`, y `x.pin[i] := v`, `x.setPin(i, v)`. Nada que declarar y nada nuevo en la VM. `get()` sin índice y `get(i)`
// son sobrecargas (Eduardo: «get normal no tiene índice, get(i) sería una sobrecarga»). Dentro de la clase, si hay un campo
// o una property `pin`, `pin[i]` es indexar ese miembro. `x[i] += e` calcula el objeto y el índice una vez. Es de paridad (está
// en el corpus) y se escribe en JC.
// mod8: fuera — lleva interfaces de clase, y un cast a una interfaz es del enlace tardío
module IndiceObjeto
  import Collections

  public class Sensor
    var v: integer

    public function Sensor(x: integer)
      this.v := x
    end Sensor

    public function valor(): integer
      return this.v
    end valor

    public function toString(): string
      return "Sensor(" + this.v + ")"
    end toString
  end Sensor

  public interface Indexable
    function get(i: integer): integer
    function set(i: integer, v: integer)
  end Indexable

  // get y set, sin nada más; y `get` en tres sobrecargas
  public class Tabla implements Indexable
    var d: integer[]

    public function Tabla(n: integer)
      this.d := integer[n]
    end Tabla

    @implement{ Indexable }
    public function get(i: integer): integer
      return this.d[i]
    end get

    @implement{ Indexable }
    public function set(i: integer, v: integer)
      this.d[i] := v
    end set

    public function get(k: string): integer
      return len(k)
    end get

    public function get(): integer
      return 99
    end get
  end Tabla

  // la hija redefine `get`: va por la vtable
  public class Doble extends Tabla
    public function Doble(n: integer)
      super(n)
    end Doble

    public function get(i: integer): integer
      return super.get(i) * 2
    end get
  end Doble

  // sin `set`: se lee y no se escribe
  public class SoloLectura
    public function SoloLectura()
    end SoloLectura

    public function get(i: integer): integer
      return i + 100
    end get
  end SoloLectura

  // con nombre, sin ninguna property
  public class Gpio
    var estado: boolean[]

    public function Gpio()
      this.estado := boolean[8]
    end Gpio

    public function getPin(i: integer): boolean
      return this.estado[i]
    end getPin

    public function setPin(i: integer, v: boolean)
      this.estado[i] := v
    end setPin

    public function cuantos(): integer
      var n: integer := 0
      for i := 0 to 7 do
        if pin[i] then   // `pin` no es un miembro: this.pin[i], que es getPin(i)
          n += 1
        endif
      next
      return n
    end cuantos
  end Gpio

  // una property `pin` que convive con getPin(i): sobrecargas
  public class Banco
    public property pin: integer

    public function Banco()
      this.pin := 7
    end Banco

    public function getPin(i: integer): integer
      return this.pin * 10 + i
    end getPin

    public function setPin(i: integer, v: integer)
      this.pin := v + i
    end setPin
  end Banco

  // un campo con ese nombre: dentro de la clase, `pin[i]` es el campo; fuera, el método. Si no, getPin se llamaría a sí mismo.
  public class Registro
    var pin: integer[]

    public function Registro()
      this.pin := integer[4]
    end Registro

    public function getPin(i: integer): integer
      return this.pin[i] + 1
    end getPin

    public function setPin(i: integer, v: integer)
      pin[i] := v * 2
    end setPin

    public function crudo(i: integer): integer
      return pin[i]
    end crudo
  end Registro

  // una hija ve el campo igual que su clase
  public class RegistroHijo extends Registro
    public function RegistroHijo()
      super()
    end RegistroHijo

    public function suma(): integer
      return pin[0] + this.pin[1]
    end suma
  end RegistroHijo

  // con una cadena de índice, y números de otros anchos: los compuestos los recortan y los ensanchan
  public class Contador
    var a: integer
    var b: long
    var c: byte

    public function Contador()
      this.a := 0
      this.b := 0L
      this.c := byte(0)
    end Contador

    public function get(k: string): integer
      return this.a
    end get

    public function set(k: string, v: integer)
      print "set de", k, v
      this.a := v
    end set

    public function getLargo(i: integer): long
      return this.b
    end getLargo

    public function setLargo(i: integer, v: long)
      this.b := v
    end setLargo

    public function getPeque(i: integer): byte
      return this.c
    end getPeque

    public function setPeque(i: integer, v: byte)
      this.c := v
    end setPeque
  end Contador

  // get y set privados: no están en la vtable, y el compuesto los llama como cualquier otro
  public class Privada
    var v: byte

    public function Privada()
      this.v := byte(0)
    end Privada

    private function get(i: integer): byte
      return this.v
    end get

    private function set(i: integer, x: byte)
      this.v := x
    end set

    public function prueba(): integer
      this[0] := byte(3)
      this[0] += 1
      return this[0]
    end prueba
  end Privada

  public class Panel
    var sensores: List<Sensor>

    public function Panel()
      this.sensores := List()
      this.sensores.add(Sensor(40))
    end Panel

    public function primero(): integer
      return this.sensores[0].valor()
    end primero

    public function sensor(i: integer): Sensor
      return sensores[i]
    end sensor
  end Panel

  var llamadas: integer := 0

  function cual(): integer
    llamadas += 1
    return 2
  end cual

  function clave(): string
    llamadas += 1
    return "k"
  end clave

  function laTabla(t: Tabla): Tabla
    llamadas += 10
    return t
  end laTabla

  function mas(a: integer, b: integer): integer
    return a + b
  end mas

  function main()
    // una List a secas: da un Object
    var l: List := List()
    l.add("uno")
    l.add(Sensor(2))
    print "a secas:", l[0], l[1]
    l[0] := "cambiado"
    print "tras set:", l[0], l.length()

    // una List<X>: sale como un X, y entra un X
    var s: List<Sensor> := List()
    s.add(Sensor(1))
    s.add(Sensor(2))
    print "List<Sensor>:", s[1].valor(), s[0]
    s[0] := Sensor(5)
    print "y escrita:", s[0].valor(), s.get(0).valor()
    var ll: List<List<Sensor>> := List()
    ll.add(s)
    print "anidada:", ll[0][1].valor()
    ll[0][1] := Sensor(7)
    print "y escrita:", s[1].valor()
    var c: List<string> := List()
    c.add("a")
    c.add("b")
    c[0] += "!"
    print "de cadenas:", c[0] + c[1], len(c[0])
    var sl: SyncList<Sensor> := SyncList()
    sl.add(Sensor(30))
    print "SyncList:", sl[0].valor()

    // Map: get y put
    var m: Collections.Map<string, Sensor> := Collections.Map()
    m["riego"] := Sensor(3)
    print "Map:", m["riego"].valor(), m.size(), m["nada"] == null
    var num: Collections.Map<integer, Sensor> := Collections.numericMap()
    num[7] := Sensor(4)
    print "Map de integer:", num[7].valor()
    var cad: Collections.Map<string, string> := Collections.Map()
    cad["a"] := "x"
    cad["a"] += "y"
    print "Map de cadenas:", cad["a"]

    // una clase con get y set; las tres sobrecargas
    var t: Tabla := Tabla(4)
    t[1] := 5
    print "Tabla:", t[1], t["hola"], t.get(), t[0]
    print "expresiones:", t[1] + t[1], mas(t[1], 1), t[t[0]]
    if t[1] > 4 then
      print "condicion"
    endif

    // por una interfaz, y por una hija
    var ix: Indexable := t
    ix[2] := 8
    ix[2] += 1
    print "interfaz:", ix[2]
    var d: Tabla := Doble(2)
    d[0] := 4
    print "hija:", d[0]

    // los compuestos: el objeto y el índice, una vez
    t[1] += 5
    print "compuesto:", t[1], llamadas
    t[cual()] += 3
    print "con una llamada:", t[2], llamadas
    laTabla(t)[cual()] *= 2
    print "con dos:", t[2], llamadas
    var a: integer[] := integer[4]
    t[0] := 3
    a[t[0]] += 6                       // el índice de un array, también una llamada
    print "un array:", a[3]

    // con una cadena de índice, y otros anchos
    var k: Contador := Contador()
    k["k"] += 2
    k[clave()] += 3
    print "cadena:", k["k"], llamadas
    k.largo[0] += 5000000000L
    k.largo[0] += 1
    print "long:", k.largo[0]
    k.peque[0] := byte(250)
    k.peque[0] += 10
    print "byte:", k.peque[0]

    // con nombre
    var g: Gpio := Gpio()
    g.pin[3] := true
    print "Gpio:", g.pin[3], g.pin[0], g.cuantos()

    // la property y la sobrecarga
    var b: Banco := Banco()
    print "Banco:", b.pin, b.pin[3]
    b.pin[3] := 4
    print "escrita:", b.pin
    b.pin := 2
    print "y la property:", b.pin, b.pin[1]

    // el campo, dentro; el método, fuera
    var r: Registro := Registro()
    r.pin[1] := 4
    print "Registro:", r.pin[1], r.crudo(1)
    var rh: RegistroHijo := RegistroHijo()
    rh.pin[0] := 1
    rh.pin[1] := 2
    print "hija:", rh.suma()

    print "privados:", Privada().prueba()

    // dentro de una clase, con this y sin él
    var p: Panel := Panel()
    print "Panel:", p.primero(), p.sensor(0).valor()

    // lo que falla, falla igual que con get
    try
      print l[9]
    catch e: Exception
      print "fuera de rango:", e.msg
    endtry
    var nadie: Tabla := null
    try
      print nadie[0]
    catch e: Exception
      print "sin objeto:", e.msg
    endtry
    var solo: SoloLectura := SoloLectura()
    print "solo lectura:", solo[1]
  end main
end IndiceObjeto
