// Raton.bp — V8/H2, paso 3 (9-nov): el ratón del SO y Mice.Mouse, sin ventana, igual en las dos VMs (V8_IDEAS §E1,
// «El paso 3»). Lo que hace el ratón entra con Mice.__msInject, como un informe de un ratón de verdad con el punto en vez
// del desplazamiento: la posición, los botones apretados (los bits de Mice.Button) y la rueda, en muescas.
//
// Lo que se prueba: los eventos, en el hilo que creó el ratón (se reparten uno por turno: la prueba espera con bucles de
// sleep); antes de un onPress, el onMove hasta su punto, y el punto del clic aunque el ratón ya se haya ido; al moverse,
// la última posición y en orden (cuántos onMove llegan depende del reparto: no se imprime); arrastrar, con isPressed; la
// rueda; preguntando, tal como está; dos ratones, cada uno con todo; y close().
module Raton
  import Mice

  class Pant
    public property nombre: string
    public property pulsados: integer
    public property ruedas: integer
    public property x: integer
    public property y: integer
    public property vigilaOrden: boolean
    public property desorden: boolean
    public property arrastrando: string
    public property log: string

    public function Pant(nombre: string)
      this.nombre := nombre
      this.pulsados := 0
      this.ruedas := 0
      this.x := -1
      this.y := -1
      this.vigilaOrden := false
      this.desorden := false
      this.arrastrando := ""
      this.log := ""
    end Pant

    function event pulsado(r: Mice.Mouse, b: Mice.Button, x: integer, y: integer)
      this.pulsados := this.pulsados + 1
      this.log := this.log + " [pulsa " + Enum.getName(b) + " en " + x + "," + y + ", estaba en " + this.x + "," + this.y + "]"
    end pulsado

    function event movido(r: Mice.Mouse, x: integer, y: integer)
      if this.vigilaOrden and (x < this.x or y < this.y) then
        this.desorden := true
      endif
      if x == 50 and y == 60 then
        this.arrastrando := "" + r.isPressed(Mice.Button.LEFT)
      endif
      this.x := x
      this.y := y
    end movido

    function event rueda(r: Mice.Mouse, d: integer)
      this.ruedas := this.ruedas + 1
      this.log := this.log + " [rueda " + d + " en " + this.x + "," + this.y + "]"
    end rueda

    public function suelta(): string
      var s: string := this.nombre + ":" + this.log
      this.log := ""
      return s
    end suelta
  end Pant

  // Los eventos se reparten entre turno y turno: este hilo los recibe cuando corre, y un sleep le da turnos.
  function esperaPulsados(p: Pant, n: integer)
    var i: integer := 0
    while p.pulsados < n and i < 400 do
      sleep(5)
      i := i + 1
    endwh
  end esperaPulsados

  function esperaRuedas(p: Pant, n: integer)
    var i: integer := 0
    while p.ruedas < n and i < 400 do
      sleep(5)
      i := i + 1
    endwh
  end esperaRuedas

  function esperaPunto(p: Pant, x: integer, y: integer)
    var i: integer := 0
    while (p.x != x or p.y != y) and i < 400 do
      sleep(5)
      i := i + 1
    endwh
  end esperaPunto

  function estado(r: Mice.Mouse): string
    var s: string := r.getX() + "," + r.getY()
    if r.isPressed(Mice.Button.LEFT) then
      s := s + " LEFT"
    endif
    if r.isPressed(Mice.Button.RIGHT) then
      s := s + " RIGHT"
    endif
    if r.isPressed(Mice.Button.MIDDLE) then
      s := s + " MIDDLE"
    endif
    if r.isPressed(Mice.Button.BACK) then
      s := s + " BACK"
    endif
    if r.isPressed(Mice.Button.FORWARD) then
      s := s + " FORWARD"
    endif
    return s
  end estado

  function Main()
    var a: Mice.Mouse := Mice.Mouse()
    var pa: Pant := Pant("a")
    a.onPress := pa::pulsado
    a.onMove := pa::movido
    a.onWheel := pa::rueda
    print "raton conectado: " + a.isConnected()
    print "al empezar: " + estado(a)

    // moverse, y un clic donde está
    Mice.__msInject(10, 20, 0, 0)
    esperaPunto(pa, 10, 20)
    print "a se movio a " + pa.x + "," + pa.y
    Mice.__msInject(10, 20, 1, 0)
    esperaPulsados(pa, 1)
    print pa.suelta()
    print "preguntando: " + estado(a)

    // arrastrar: con el izquierdo apretado hasta (50,60), y soltar (soltar no avisa)
    Mice.__msInject(30, 40, 1, 0)
    Mice.__msInject(50, 60, 1, 0)
    esperaPunto(pa, 50, 60)
    print "arrastrando hasta 50,60: " + pa.arrastrando
    Mice.__msInject(50, 60, 0, 0)
    sleep(20)
    print "suelto: " + estado(a) + ", pulsados " + pa.pulsados

    // la rueda, en orden y en su punto
    Mice.__msInject(50, 60, 0, -2)
    Mice.__msInject(50, 60, 0, 1)
    esperaRuedas(pa, 2)
    print pa.suelta()

    // dos botones a la vez, lejos: primero el onMove hasta allí, y un onPress por botón (del bit bajo al alto)
    Mice.__msInject(5, 5, 6, 0)
    esperaPulsados(pa, 3)
    print pa.suelta()
    print "preguntando: " + estado(a)
    Mice.__msInject(5, 5, 0, 0)

    // un clic y el ratón se va en seguida: el clic, con su punto
    Mice.__msInject(60, 70, 1, 0)
    Mice.__msInject(80, 90, 1, 0)
    esperaPulsados(pa, 4)
    esperaPunto(pa, 80, 90)
    print pa.suelta()
    print "a esta en " + pa.x + "," + pa.y
    Mice.__msInject(80, 90, 0, 0)

    // al moverse, sólo la última posición, y en orden
    pa.vigilaOrden := true
    Mice.__msInject(100, 100, 0, 0)
    Mice.__msInject(101, 102, 0, 0)
    Mice.__msInject(102, 104, 0, 0)
    Mice.__msInject(103, 106, 0, 0)
    esperaPunto(pa, 103, 106)
    pa.vigilaOrden := false
    print "la ultima: " + pa.x + "," + pa.y + ", en orden: " + (not pa.desorden)

    // dos ratones: cada uno, con todo
    var b: Mice.Mouse := Mice.Mouse()
    var pb: Pant := Pant("b")
    b.onPress := pb::pulsado
    b.onMove := pb::movido
    b.onWheel := pb::rueda
    Mice.__msInject(7, 8, 8, 0)
    Mice.__msInject(7, 8, 0, 3)
    esperaPulsados(pa, 5)
    esperaPulsados(pb, 1)
    esperaRuedas(pa, 3)
    esperaRuedas(pb, 1)
    print pa.suelta()
    print pb.suelta()

    // close: b deja de recibir; a, no
    b.close()
    Mice.__msInject(9, 9, 16, 0)
    esperaPulsados(pa, 6)
    sleep(20)
    print pa.suelta()
    print pb.suelta()
    print "pulsados: a " + pa.pulsados + ", b " + pb.pulsados
    print "b, preguntando, sigue: " + estado(b)
    Mice.__msInject(9, 9, 0, 0)
    print "fin"
  end Main
end Raton
