// SueltaPwmB.bp — V7 #667, EN PLACA: la otra mitad de SueltaPwmA (o de SueltaRedA). Pide tantos PWM como aquél, en
// OTROS pines, y la UART 1 en otros dos: si lo del programa anterior no se soltó al acabar, en las ESP no quedan
// ranuras del LEDC y sale FALLO con el motivo. Una línea «OK» por cada cosa que consigue. Al acabar, sus propios
// objetos se destruyen y lo sueltan (el siguiente programa los vuelve a tener).
module SueltaPwmB
  import Core
  import Machine
  import Pwm
  import Uart

  function pines(): integer[]
    var m: string := Machine.getMicro()
    if m == "esp32s3" then
      var s3: integer[] := [10, 11, 12, 13, 14, 15]
      return s3
    endif
    if m == "esp32c5" then
      var c5: integer[] := [24, 25, 26, 27]
      return c5
    endif
    if m == "rp2350a" then
      var pa: integer[] := [14, 16]
      return pa
    endif
    if m == "rp2350b" then
      var pb: integer[] := [14, 16]
      return pb
    endif
    if m == "esp32p4" then
      var p4: integer[] := [21]
      return p4
    endif
    if m == "stm32u5g9" then
      var dk2: integer[] := [24]
      return dk2
    endif
    var otro: integer[] := [4, 5]
    return otro
  end pines

  function pinesUart(): integer[]
    var m: string := Machine.getMicro()
    if m == "esp32s3" then
      var s3: integer[] := [17, 18]
      return s3
    endif
    if m == "esp32c5" then
      var c5: integer[] := [28, 2]
      return c5
    endif
    if m == "esp32p4" then
      var p4: integer[] := newIntArray(0)
      return p4
    endif
    if m == "stm32u5g9" then
      var dk2: integer[] := [2, 3]
      return dk2
    endif
    var rp: integer[] := [8, 9]
    return rp
  end pinesUart

  // La UART que se prueba: la 1 en las ESP y las RP2350; en la STM32 la 1 es el cable del IDE, así que la 2.
  function uartId(): integer
    if contains(Machine.getMicro(), "stm32") then
      return 2
    endif
    return 1
  end uartId

  function Main()
    var p: integer[] := pines()
    var vivos: List := List()
    var i: integer := 0
    while i < len(p) do
      try
        var s: Pwm.Slice := Pwm.Slice(p[i], 2000)
        s.setDuty(50)
        s.start()
        vivos.add(s)
        print "OK el PWM del pin " + intToString(p[i])
      catch e: RuntimeError
        print "FALLO el PWM del pin " + intToString(p[i]) + " no se pudo tomar: " + e.msg
      endtry
      i += 1
    endwh
    var u: integer[] := pinesUart()
    if len(u) >= 2 then
      try
        var puerto: Uart.Port := Uart.Port(uartId(), u[0], u[1], 9600, 8, 1, 0)
        vivos.add(puerto)
        print "OK la UART " + intToString(uartId()) + " en sus pines"
      catch e2: RuntimeError
        print "FALLO la UART " + intToString(uartId()) + " no se pudo abrir: " + e2.msg
      endtry
    else
      print "OK sin UART libre en esta placa: no se prueba"
    endif
    print "fin: " + intToString(vivos.length()) + " recursos"
  end Main
end SueltaPwmB
