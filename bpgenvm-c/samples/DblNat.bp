// DblNat.bp — #585: lo que GANA una native con `double` (y con `float`), MEDIDO en la placa contra la misma función
// interpretada. Ninguna placa del sobre tiene FPU de doble precisión: el `double` lo emula el firmware, y la native
// acaba en las MISMAS rutinas por los helpers —la estimación de V6 (DblBench en la Metro, 18-ago) decía ≈3×, no 10×:
// el suelo lo pone la emulación, no el intérprete—. Las tres parejas hacen el mismo bucle: `double`, `float` y, de
// CONTROL, enteros (lo que gana una native cuando nada se emula). Cada resultado nativo tiene que ser IGUAL al bit
// que el interpretado; las líneas de tiempo cambian en cada pasada y la tanda las ignora.
module DblNat
  import Core
  import Machine

  public const VUELTAS: integer := 50000

  // ── double: multiplicar y dividir alternando, para que el acumulador dé vueltas alrededor de 1 (DblBench) ──
  native function dblN(n: integer): double
    var acc: double := 1.5d
    var i: integer := 0
    while i < n do
      acc := acc * 1.000001d
      acc := acc / 1.0000005d
      acc := acc + 0.5d
      acc := acc - 0.5d
      i := i + 1
    endwh
    return acc
  end dblN

  function dblI(n: integer): double
    var acc: double := 1.5d
    var i: integer := 0
    while i < n do
      acc := acc * 1.000001d
      acc := acc / 1.0000005d
      acc := acc + 0.5d
      acc := acc - 0.5d
      i := i + 1
    endwh
    return acc
  end dblI

  // ── float: el mismo bucle ──
  native function fltN(n: integer): float
    var acc: float := 1.5
    var i: integer := 0
    while i < n do
      acc := acc * 1.000001
      acc := acc / 1.0000005
      acc := acc + 0.5
      acc := acc - 0.5
      i := i + 1
    endwh
    return acc
  end fltN

  function fltI(n: integer): float
    var acc: float := 1.5
    var i: integer := 0
    while i < n do
      acc := acc * 1.000001
      acc := acc / 1.0000005
      acc := acc + 0.5
      acc := acc - 0.5
      i := i + 1
    endwh
    return acc
  end fltI

  // ── el CONTROL: enteros, cuatro operaciones por vuelta, sin desbordar (en C un desbordamiento no está definido) ──
  native function entN(n: integer): integer
    var acc: integer := 3
    var i: integer := 0
    while i < n do
      acc := acc * 3
      acc := acc + i
      acc := acc mod 1000003
      acc := acc + 1
      i := i + 1
    endwh
    return acc
  end entN

  function entI(n: integer): integer
    var acc: integer := 3
    var i: integer := 0
    while i < n do
      acc := acc * 3
      acc := acc + i
      acc := acc mod 1000003
      acc := acc + 1
      i := i + 1
    endwh
    return acc
  end entI

  function Main()
    var n: integer := VUELTAS
    print "vueltas: " + n + " (x4 operaciones)"

    var t0: integer := Machine.uptimeMs()
    var dN: double := dblN(n)
    var t1: integer := Machine.uptimeMs()
    var dI: double := dblI(n)
    var t2: integer := Machine.uptimeMs()
    if dN == dI then
      print "ok double: " + dN
    else
      print "FALLO double: nativo " + dN + ", interpretado " + dI
    endif
    print "  tiempo: double, nativo " + (t1 - t0) + " ms, interpretado " + (t2 - t1) + " ms"

    var t3: integer := Machine.uptimeMs()
    var fN: float := fltN(n)
    var t4: integer := Machine.uptimeMs()
    var fI: float := fltI(n)
    var t5: integer := Machine.uptimeMs()
    if fN == fI then
      print "ok float: " + fN
    else
      print "FALLO float: nativo " + fN + ", interpretado " + fI
    endif
    print "  tiempo: float, nativo " + (t4 - t3) + " ms, interpretado " + (t5 - t4) + " ms"

    var t6: integer := Machine.uptimeMs()
    var eN: integer := entN(n)
    var t7: integer := Machine.uptimeMs()
    var eI: integer := entI(n)
    var t8: integer := Machine.uptimeMs()
    if eN == eI then
      print "ok entero: " + eN
    else
      print "FALLO entero: nativo " + eN + ", interpretado " + eI
    endif
    print "  tiempo: entero, nativo " + (t7 - t6) + " ms, interpretado " + (t8 - t7) + " ms"
  end Main
end DblNat
