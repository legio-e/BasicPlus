// ============================================================
// TcpEchoTest.bp — H11 (#241): cliente TCP simple contra un echo
// server local determinista (lo levanta el harness test_net.c, o
// `test_net serve 30` para la pasada de paridad dual-VM).
//
// Salida esperada (byte-idéntica miVM / VM-C host):
//   conectado
//   eco: hola eco
//   eco: BasicPlus en red
//   partida 1: [a]
//   partida 2: [ñb]
//   timeout-len: 0
//   heap: recorrido entero
//   tras-close: false
//   fin
//
// #597 (28-sep): lo recibido tiene que dejar el heap RECORRIBLE. La VM-C
// reservaba el máximo pedido y apuntaba como longitud lo recibido: el
// bloque medía distinto de lo que dice su cabecera y el siguiente GC
// descarrilaba. Heap.compact() colecta y recorre el heap entero.
// ============================================================
module TcpEchoTest

  import Net
  import Heap

  function main()
    var c: Net.Tcp := Net.Tcp()
    if c.connect("127.0.0.1", 47391, 2000) then
      print "conectado"
    else
      print "no conectado"
      return
    endif

    c.sendStr("hola eco")
    print "eco:", c.recvStr(64, 2000)

    c.sendStr("BasicPlus en red")
    print "eco:", c.recvStr(64, 2000)

    // V8/H5 (#711): una ñ (C3 B1) partida entre dos paquetes no es un error: su primer byte se queda en la conexión
    // y se junta con el paquete siguiente
    var p1: byte[] := newByteArray(2)
    p1[0] := byte(0x61)
    p1[1] := byte(0xC3)
    c.send(p1)
    print "partida 1: [" + c.recvStr(64, 2000) + "]"
    var p2: byte[] := newByteArray(2)
    p2[0] := byte(0xB1)
    p2[1] := byte(0x62)
    c.send(p2)
    print "partida 2: [" + c.recvStr(64, 2000) + "]"

    // El server solo responde a lo que recibe: sin tráfico, el recv
    // agota su timeout y devuelve un byte[] vacío.
    var t: byte[] := c.recv(16, 120)
    print "timeout-len:", len(t)

    try
      Heap.compact()
      print "heap: recorrido entero"
    catch e: RuntimeError
      print "heap:", e.msg
    endtry

    c.close()
    print "tras-close:", c.isOpen()
    print "fin"
  end main

end TcpEchoTest
