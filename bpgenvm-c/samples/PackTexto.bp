// PackTexto.bp — V8 (#724, 27-oct): EL TEXTO QUE DEVUELVE UN PACK, por el puente que escribe el compilador.
//
// Un pack da su texto como `const char*`, hasta el NUL. Hasta #724 el puente lo contaba hasta 512 bytes —lo de más se
// perdía sin avisar, a veces a medio carácter— y lo copiaba a una cadena tal cual, fuera UTF-8 o no. Ahora, la regla
// de #711 (Eduardo): los bytes por un lado y el descodificador por otro. Una native que devuelve `string` lo recibe
// ENTERO y DESCODIFICADO (EncodingError si no es UTF-8 válido, como readFile); una que devuelve `byte[]`, los bytes tal
// cual, y lo descodifica quien la llama (fromBytes(b) o fromBytes(b, true)). Sin NUL en 1 MB —el tope del puente—, un
// error con nombre, nunca un corte.
//
// El pack es de mentira, 'PRUE', y lo publica test/test_packtexto.c (`make test-packtexto`): sus dos funciones dan el
// mismo texto, según el número. Sin el pack (la VM-Java, el corpus) este módulo no corre: sus native no tienen cuerpo.
// Lo que tiene que salir está escrito a mano: una línea FALLO pone la red en rojo.
module PackTexto
  import Core
  import v1 from pack "PRUE"

  // 0 «año» · 1 600 bytes: 511 «a», una «ñ» (los bytes 511 y 512) y 87 «b» · 2 «Mu», 0xF1 (la ñ de Latin-1), «oz» ·
  // 3 «» · 4 NULL · 5 1 MB sin NUL · 6 1 048 575 «y» y el NUL (lo más largo que cabe)
  public native function prb_texto(n: integer): string
  public native function prb_bytes(n: integer): byte[]

  var buenas: integer := 0
  var malas: integer := 0

  function mira(que: string, obtenido: string, esperado: string)
    if obtenido == esperado then
      buenas += 1
      print "ok " + que + ": " + obtenido
    else
      malas += 1
      print "FALLO " + que + ": [" + obtenido + "], se esperaba [" + esperado + "]"
    endif
  end mira

  function hex2(v: integer): string
    var d: string := "0123456789ABCDEF"
    return charAt(d, v / 16) + charAt(d, v mod 16)
  end hex2

  // los bytes, en hexadecimal (un «�» se ve como EF BF BD)
  function hexb(b: byte[]): string
    var r: string := ""
    var i: integer := 0
    while i < len(b) do
      if i > 0 then
        r := r + " "
      endif
      r := r + hex2(b[i] & 255)
      i += 1
    endwh
    return r
  end hexb

  function hex(s: string): string
    return hexb(toBytes(s))
  end hex

  function repite(c: string, n: integer): string
    var sb: StringBuilder := StringBuilder()
    var i: integer := 0
    while i < n do
      sb.appendStr(c)
      i += 1
    endwh
    return sb.toString()
  end repite

  // una cadena larga, resumida: sus bytes, sus caracteres y si es la que se esperaba
  function resumen(s: string, esperada: string): string
    var r: string := intToString(len(toBytes(s))) + " bytes, " + intToString(len(s)) + " caracteres"
    if s == esperada then
      return r + ", la esperada"
    endif
    return r + ", OTRA"
  end resumen

  // 0 — lo de siempre: un texto válido sale tal cual por los dos caminos
  function caso0()
    mira("0 string", hex(prb_texto(0)), "61 C3 B1 6F")
    mira("0 byte[]", hexb(prb_bytes(0)), "61 C3 B1 6F")
  end caso0

  // 1 — ENTERO. Con el corte de 512, la cadena acababa en el byte C3 de la ñ, sin su B1: 512 bytes y rota
  function caso1()
    var esperada: string := repite("a", 511) + "ñ" + repite("b", 87)
    mira("1 string", resumen(prb_texto(1), esperada), "600 bytes, 599 caracteres, la esperada")
    var b: byte[] := prb_bytes(1)
    mira("1 byte[]", intToString(len(b)) + " bytes; del 510 al 513: " + hex2(b[510] & 255) + " "
         + hex2(b[511] & 255) + " " + hex2(b[512] & 255) + " " + hex2(b[513] & 255),
         "600 bytes; del 510 al 513: 61 C3 B1 62")
  end caso1

  // 2 — Latin-1, la ñ es 0xF1: con `string`, EncodingError (como readFile); con `byte[]`, los bytes tal cual, y
  // quien llama decide: fromBytes(b, true) deja «�» (EF BF BD) en su sitio
  function caso2()
    try
      var s: string := prb_texto(2)
      mira("2 string", "no lanzó: " + hex(s), "fromBytes: UTF-8 mal formado en el byte 2 (0xF1)")
    catch e: EncodingError
      mira("2 string", e.msg, "fromBytes: UTF-8 mal formado en el byte 2 (0xF1)")
    endtry
    mira("2 byte[]", hexb(prb_bytes(2)), "4D 75 F1 6F 7A")
    mira("2 byte[], fromBytes(b, true)", hex(fromBytes(prb_bytes(2), true)), "4D 75 EF BF BD 6F 7A")
  end caso2

  // 3 — vacío
  function caso3()
    mira("3 string", "[" + prb_texto(3) + "]", "[]")
    mira("3 byte[]", intToString(len(prb_bytes(3))) + " bytes", "0 bytes")
  end caso3

  // 4 — un NULL del pack: null
  function caso4()
    var b: byte[] := prb_bytes(4)
    if b == null then
      mira("4 byte[]", "null", "null")
    else
      mira("4 byte[]", intToString(len(b)) + " bytes", "null")
    endif
  end caso4

  // 5 — sin NUL en 1 MB: un error con nombre (el que redacta la VM, motivo 3), nunca un corte
  function caso5()
    try
      var s: string := prb_texto(5)
      mira("5 string", "no lanzó: " + intToString(len(s)) + " caracteres",
           "pack 'PRUE': el texto que devuelve 'prb_texto' no acaba: no hay NUL en 1048576 bytes (el tope del puente)")
    catch e: RuntimeError
      mira("5 string", e.msg,
           "pack 'PRUE': el texto que devuelve 'prb_texto' no acaba: no hay NUL en 1048576 bytes (el tope del puente)")
    endtry
    try
      var b: byte[] := prb_bytes(5)
      mira("5 byte[]", "no lanzó: " + intToString(len(b)) + " bytes",
           "pack 'PRUE': el texto que devuelve 'prb_bytes' no acaba: no hay NUL en 1048576 bytes (el tope del puente)")
    catch e: RuntimeError
      mira("5 byte[]", e.msg,
           "pack 'PRUE': el texto que devuelve 'prb_bytes' no acaba: no hay NUL en 1048576 bytes (el tope del puente)")
    endtry
  end caso5

  // 6 — lo más largo que cabe: 1 048 575 bytes y el NUL, entero
  function caso6()
    var s: string := prb_texto(6)
    mira("6 string", intToString(len(s)) + " caracteres", "1048575 caracteres")
    mira("6 byte[]", intToString(len(prb_bytes(6))) + " bytes", "1048575 bytes")
  end caso6

  function Main()
    caso0()
    caso1()
    caso2()
    caso3()
    caso4()
    caso5()
    caso6()
    print "buenas " + intToString(buenas) + ", malas " + intToString(malas)
  end Main
end PackTexto
