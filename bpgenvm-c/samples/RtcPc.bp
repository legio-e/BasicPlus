// RtcPc.bp — V7/H10 #625 (2-oct): en el PC el reloj de pared está en hora desde el principio, en las dos VMs. La VM-C
// de host contaba desde el arranque del PC (CLOCK_MONOTONIC sin calibrar: 17737) y la VM-Java daba la hora (1790931534).
// Se comprueba una RELACIÓN —la hora cambia en cada ejecución—: «ok» o «FALLO». Sólo en el PC: una placa empieza en 0
// hasta que el IDE la calibra.
module RtcPc
  import Rtc

  function Main()
    var c: Rtc.Clock := Rtc.Clock()
    // 1759276800 = 2025-10-01 00:00 UTC: cualquier PC de hoy está por encima
    if c.epochSec() > 1759276800 then
      print "ok el reloj del PC esta en hora"
    else
      print "FALLO el reloj del PC no esta en hora"
    endif
    print "fin"
  end Main
end RtcPc
