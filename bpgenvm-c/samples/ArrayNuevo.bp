// ArrayNuevo.bp — V8/H8 (5-nov; Eduardo: «en BP no se var a:miObjeto[] := miObjeto[10]»): `A[n]` crea un array de n
// casillas de A, sea A lo que sea: hasta hoy un array nacía de un literal o de las funciones de Core, y uno de una clase
// no tenía cómo. En JC se escribe `new A[n]`. El árbol es el de indexar: si `A` nombra algo con valor, gana y se indexa.
// Las casillas de un número nacen a cero; las de un objeto o una cadena, a null; y el GC sigue lo que se guarda en ellas.
// Lo que tiene que salir:
//   3 true
//   5 12
//   2 true xx
//   4 6
//   0 0 0
//   2 0 0
//   0 0 0
//   false
//   0 0
//   0 7
//   8 8
//   0
//   3 4
//   Punto 2 true
//   2 true
//   0 1 2
//   fin
module ArrayNuevo

  import Core   // V6: los tipos de Core se importan

  public enum Color
    ROJO
    VERDE := 7
  end Color

  public class Punto
    public property x: integer
    public function Punto(a: integer)
      this.x := a
    end Punto
    public function area(): integer
      return this.x * 2
    end area
  end Punto

  public class Caja
    public property puntos: Punto[]
    public function Caja(n: integer)
      this.puntos := Punto[n]   // dentro de una clase, y sin poner el módulo
    end Caja
  end Caja

  var global: integer[] := integer[3]
  var globales: Punto[] := Punto[4]

  function crea(n: integer): Punto[]
    return Punto[n + 1]
  end crea

  function cuenta(v: Punto[]): integer
    return len(v)
  end cuenta

  // un nombre con valor gana: esto es indexar
  function tapada(): integer
    var Punto: integer[] := [7, 8]
    return Punto[1]
  end tapada

  function Main()
    // de una clase: a null, y lo que se guarda se queda
    var a: Punto[] := Punto[3]
    print len(a), a[0] == null
    a[1] := Punto(6)
    a[2] := Punto(5)
    print a[2].x, a[1].area()

    // de cadenas: nacen a null, y el GC las sigue
    var s: string[] := string[2]
    s[1] := "x" + "x"
    print len(s), s[0] == null, s[1]

    // de los números, cada uno con su ancho
    var ent: integer[] := integer[4]
    ent[3] := 6
    print len(ent), ent[3]
    var b: byte[] := byte[3]
    var w: word[] := word[3]
    var i8: int8[] := int8[3]
    var i16: int16[] := int16[3]
    print b[0], w[1], i8[2]
    b[0] := 2
    print b[0], b[1], i16[2]
    var l: long[] := long[2]
    var d: double[] := double[2]
    var f: float[] := float[2]
    print l[0], l[1], 0
    var bo: boolean[] := boolean[2]
    print bo[1]
    print d[0], f[1]

    // de un enum: su primer valor es el cero
    var c: Color[] := Color[2]
    c[1] := Color.VERDE
    print c[0], c[1]

    // el tamaño, calculado
    var n: integer := 3
    var t: Punto[] := Punto[n + 5]
    print len(t), cuenta(Punto[2 * 4])
    print len(Punto[0])

    // desde una función, en una global, en un campo
    print len(crea(2)), len(globales)
    var ca: Caja := Caja(2)
    print "Punto", len(ca.puntos), ca.puntos[1] == null

    // con el módulo delante
    var q: ArrayNuevo.Punto[] := ArrayNuevo.Punto[2]
    print len(q), q[0] == null

    // en un bucle; y lo que se guarda sobrevive al GC
    var v: Punto[] := Punto[3]
    for i := 0 to 2 do
      v[i] := Punto(i)
    next i
    gc()
    sleep(1)
    print v[0].x, v[1].x, v[2].x
    if tapada() != 8 then
      print "mal"
    endif
    print "fin"
  end Main

end ArrayNuevo
