// Genericos.bp — V8/H7.2 (#749, 31-oct): los genéricos de lo que ya hay (Eduardo: «nuestro List es en realidad
// List<Object>»). `List<Object>` es la List de siempre; `Collections.Map<integer, Object>` y `<string, Object>`, el Map
// de siempre con la llave dicha, que se comprueba al compilar (en un Map() de llaves string, una integer fallaba al
// ejecutar). Recorrer una List con `for x in lista`: x es un Object, la lista se mide una vez. Y #748: una cadena
// guardada en un Object se imprime como texto (su toString() es ella misma, como en C#). Es de paridad (está en el
// corpus) y se escribe en JC (`List<Object>`, `foreach (var x in lista)`). #792: un tipo así al final de una línea (el
// retorno de una función, una property, un campo, una var sin valor) no compilaba: el `>` parecía un operador colgante.
// mod8: fuera — #748 es de MOD9: en MOD8, INSTANCEOF no nombra la clase Object de Core, y una cadena en un Object no se imprime (lo de V7)
module Genericos
  import Collections

  class Punto
    var x: integer

    public function Punto(x: integer)
      this.x := x
    end Punto

    public function toString(): string
      return "Punto(" + this.x + ")"
    end toString
  end Punto

  // #792 — un tipo genérico al final de la línea
  property guardada: List<Object>

  class Caja
    var dentro: List<Object>
    public property otra: List<Object>

    public function Caja()
      this.dentro := crea("del campo")
      this.otra := crea("de la property")
    end Caja

    public function primero(): Object
      return this.dentro.get(0)
    end primero
  end Caja

  public function crea(s: string): List<Object>
    var l: List<Object>
    l := List()
    l.add(s)
    return l
  end crea

  function main()
    guardada := crea("de la global")
    var caja: Caja := Caja()
    print "al final de la línea:", guardada.get(0), caja.primero(), caja.otra.get(0)
    // y un `>` que acaba una línea de verdad sigue siendo un operador colgante
    var mayor: boolean := 3 >
      2
    print "colgante:", mayor

    var l: List<Object> := List()
    l.add("uno")
    l.add(2)
    l.add(Punto(3))
    l.add(2.5d)
    l.add(true)
    for x in l do
      print "elemento:", x
    next

    var o: Object := l.get(0)
    print "una cadena como Object:", o, o.toString(), "[" + o + "]"

    var cuenta: integer := 0
    for x in l do
      if x instanceof Punto then
        continue
      endif
      cuenta += 1
    next
    print "sin el punto:", cuenta

    for x in l do
      if x instanceof Punto then
        print "el primer Punto:", x
        break
      endif
    next

    var vacia: List<Object> := List()
    for x in vacia do
      print "nunca"
    next

    // la lista se mide una vez: lo que se añade dentro no se recorre
    var c: List<Object> := List()
    c.add(1)
    c.add(2)
    var vueltas: integer := 0
    for x in c do
      c.add(9)
      vueltas += 1
    next
    print "tras añadir dentro:", vueltas, c.length()

    var m: Collections.Map<string, Object> := Collections.Map()
    m.put("a", Integer(1))
    m.put("b", "dos")
    print "Map de string:", m.getInteger("a"), m.getString("b"), m.size(), m.containsKey("z")

    var num: Collections.Map<integer, Object> := Collections.numericMap()
    num.put(10, "diez")
    num.put(2, Integer(20))
    print "Map de integer:", num.getString(10), num.getInteger(2), Integer(num.keyAt(0)).value()

    var s: SyncList := SyncList()
    s.add("a")
    s.add("b")
    for x in s do
      print "de una SyncList:", x
    next
  end main
end Genericos
