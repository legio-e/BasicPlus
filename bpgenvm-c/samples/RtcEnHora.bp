// RtcEnHora.bp — V7/H10 #626: ¿está el reloj en hora? Machine.getEnv y Rtc.Clock.isSet().
//
// La placa anota en su ENV la fecha de su imagen (`imagen.fecha`, segundos desde 1970) la primera vez que
// arranca sin ella, y sólo esa vez; isSet() dice que el reloj está en hora si no marca menos que esa fecha (con un
// día de margen, porque la fecha de compilación no lleva zona horaria). El PC no tiene ENV: getEnv da "" e
// isSet() siempre es true —su reloj es el del PC—.
//
// La salida es la MISMA en el PC y en las placas (paridad y tanda): cada comprobación dice «ok» o «FALLO», y lo
// que depende de dónde corre (si hay fecha, qué hora es) no se imprime. Mueve el reloj y lo deja como estaba.
module RtcEnHora
  import Machine
  import Rtc

  function comprueba(cond: boolean, que: string)
    if cond then
      print "ok: " + que
    else
      print "FALLO: " + que
    endif
  end comprueba

  function Main()
    var clk: Rtc.Clock := Rtc.Clock()
    var antes: integer := clk.epochSec()
    var t0: integer := Machine.uptimeMs()

    comprueba(Machine.getEnv("no.existe.esta.clave") == "", "getEnv de una clave que no esta: vacio")
    var f: string := Machine.getEnv("imagen.fecha")
    var sinFecha: boolean := f == ""
    // La fecha de referencia: la de la imagen, o en el PC (sin fecha) una cualquiera.
    var ref: integer := 1790899200
    if not sinFecha then
      ref := parseInt(f)
    endif
    comprueba(ref >= 1767225600, "la fecha de la imagen, si la hay, es de 2026 o posterior")

    clk.setEpochSec(1000)
    comprueba(clk.isSet() == sinFecha, "a 1970: fuera de hora (sin fecha no hay regla: en hora)")
    clk.setEpochSec(ref - 2 * 86400)
    comprueba(clk.isSet() == sinFecha, "dos dias antes de la fecha: fuera de hora (sin fecha, en hora)")
    clk.setEpochSec(ref - 43200)
    comprueba(clk.isSet(), "medio dia antes de la fecha, dentro del margen: en hora")
    clk.setEpochSec(ref + 86400)
    comprueba(clk.isSet(), "un dia despues de la fecha: en hora")

    // El reloj, como estaba (más lo que ha durado esto).
    clk.setEpochSec(antes + (Machine.uptimeMs() - t0) / 1000)
    print "fin"
  end Main
end RtcEnHora
