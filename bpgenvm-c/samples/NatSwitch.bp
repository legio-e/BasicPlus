// NatSwitch.bp — #546 (V7): el switch DENTRO de una native, traducido a C por el AOT.
//   - sujeto string: C no conmuta sobre cadenas; el emisor conmuta sobre el NÚMERO del primer case
//     que casa, comparando por CONTENIDO (string_eq) y en orden, como el intérprete;
//   - un case long con un sujeto integer: la conmutación va en 64 bits (C convertiría la etiqueta al
//     tipo del sujeto, y 5000000000 casaría con 705032704);
//   - `break` sale del switch y `continue` sigue siendo del bucle; un `var` nada más empezar un case
//     (en C, cada case va entre llaves);
//   - #548: `continue` en un `for` avanza (el AOT lo traducía a un `while` con el paso al final, y el
//     `continue` de C saltaba a la condición sin avanzar: bucle infinito);
//   - V8/H8: `break` y `continue` a un `do` con nombre, un goto en C, con los `try` de por medio; y `&`, `|` y
//     `xor` entre dos boolean; y `A[n]`, un array con su tamaño: de números, de cadenas y de objetos, que el GC sigue;
//   - #790: un entero da la vuelta, como en el intérprete (en C no está definido, y gcc quitaba la comparación de
//     `x + 1 > x`): +, -, *, el menos, `+=` en una local, una global y una casilla, y el `i` de un for; y la cuenta de
//     un desplazamiento, con sus 5 bits, o sus 6 en un long;
//   - #791: dividir por cero es un error que se captura, también dentro de la native, y el mínimo entre -1 da la vuelta.
// Las native llevan su bytecode: interpretado corre igual. `make test-aotswitch` lo corre de las dos
// maneras (con el AOT, con GC en cada alocación) y exige la MISMA salida, sin ningún FALLO.
module NatSwitch

  native function porString(s: string): integer
    var r: integer := 0
    switch s
      case "hola"
        r := 1
      case "ho", "ha"
        var extra: integer := 20
        r := extra + 3
      default
        r := 9
    endsw
    return r
  end porString

  native function porLong(x: long): integer
    var r: integer := 0
    switch x
      case 5000000000L
        r := 5
      case 7
        r := 7
      default
        r := -1
    endsw
    return r
  end porLong

  native function porInteger(i: integer): integer
    var r: integer := 0
    switch i
      case 5000000000L
        r := 666
      case 1, 2, 3
        r := 1
      default
        r := 0
    endsw
    return r
  end porInteger

  native function vueltas(n: integer): integer
    var total: integer := 0
    var i: integer := 0
    while i < n do
      i := i + 1
      switch i mod 3
        case 0
          continue
        case 1
          total := total + 10
          break
        default
          total := total + 1
      endsw
      total := total + 100
    endwh
    return total
  end vueltas

  // strings hechos DENTRO de la native, comparados en un bucle (con GC en cada alocación, en el test)
  native function conString(n: integer): integer
    var cuenta: integer := 0
    var i: integer := 0
    while i < n do
      var s: string := "a" + i
      switch s
        case "a1", "a3"
          cuenta := cuenta + 1
        case "a2"
          cuenta := cuenta + 10
      endsw
      i := i + 1
    endwh
    return cuenta
  end conString

  // #548: `continue` en un `for` (con tope: si no avanza, -1 y no un cuelgue)
  native function sumaFor(n: integer): integer
    var total: integer := 0
    var vueltas: integer := 0
    for i := 1 to n do
      vueltas := vueltas + 1
      if vueltas > 100 then
        return -1
      endif
      if i mod 2 == 0 then
        continue
      endif
      total := total + i
    next i
    return total
  end sumaFor

  native function aFuera(n: integer): integer
    var t: integer := 0
    do fuera
      for i := 1 to 5 do
        t += 1
        if i == 2 then
          continue fuera
        endif
        for j := 1 to 5 do
          if t >= n then
            break fuera
          endif
          t += 10
        next j
      next i
    loop t < 100
    return t
  end aFuera

  native function conTry(n: integer): integer
    var t: integer := 0
    do fuera
      try
        t += 1
        if t < n then
          continue fuera
        endif
        break fuera
      finally
        t += 100
      endtry
    loop t < 1000
    return t
  end conTry

  native function bits(a: integer): integer
    var b: boolean := (a > 0) & (a < 9)
    b |= a == 20
    b xor= a == 5
    if b then
      return 1
    endif
    return 0
  end bits

  public class Caja
    public property n: integer
    public function Caja(x: integer)
      this.n := x
    end Caja
  end Caja

  native function arrays(n: integer): integer
    var v: integer[] := integer[n + 1]
    v[n] := 5
    var s: string[] := string[2]
    s[1] := "abc"
    var w: long[] := long[2]
    w[1] := 5000000000L
    var c: Caja[] := Caja[n]
    for i := 0 to n - 1 do
      c[i] := Caja(i + 1)
    next i
    var t: integer := v[n] + len(v) + len(s[1]) + len(w)
    if s[0] == null then
      t += 100
    endif
    if w[1] > 4000000000L then
      t += 1000
    endif
    for i := 0 to n - 1 do
      t += c[i].n
    next i
    return t
  end arrays

  native function vuelta(x: integer): integer
    if x + 1 > x then
      return 1
    endif
    return 0
  end vuelta

  native function vueltaResta(x: integer): integer
    if x - 1 < x then
      return 1
    endif
    return 0
  end vueltaResta

  native function vueltaLong(x: long): integer
    if x + 1L > x then
      return 1
    endif
    return 0
  end vueltaLong

  native function vueltaMul(x: integer): integer
    if x * 2 > x then
      return 1
    endif
    return 0
  end vueltaMul

  native function niega(x: integer): integer
    if -x == x then
      return 1
    endif
    return 0
  end niega

  var global: integer := 2147483647

  native function compuestos(x: integer): integer
    var r: integer := 0
    var y: integer := x
    y += 1
    if y < x then
      r += 1
    endif
    y -= 1
    if y == x then
      r += 10
    endif
    var v: integer[] := [x]
    v[0] += 1
    if v[0] < x then
      r += 100
    endif
    global += 1
    if global < x then
      r += 1000
    endif
    return r
  end compuestos

  native function cuentaFor(): integer
    var c: integer := 0
    for i := 2147483646 to 2147483647 do
      c += 1
      if c == 5 then
        break
      endif
    next i
    return c
  end cuentaFor

  native function desplaza(n: integer): integer
    return 1 shl n
  end desplaza

  native function desplazaDer(n: integer): integer
    return 1024 shr n
  end desplazaDer

  native function desplazaNeg(n: integer): integer
    return (0 - 1024) shr n
  end desplazaNeg

  native function desplazaLong(n: integer): integer
    var u: long := 1L
    var d: long := u shl n
    if d == 2L then
      return 1
    endif
    return 0
  end desplazaLong

  native function divide(a: integer, b: integer): integer
    return a / b
  end divide

  native function resto(a: integer, b: integer): integer
    return a mod b
  end resto

  native function divideLong(a: long, b: long): integer
    var r: long := a / b
    if r == a then
      return 1
    endif
    return 0
  end divideLong

  native function restoLong(a: long, b: long): integer
    var r: long := a mod b
    if r == 0L then
      return 1
    endif
    return 0
  end restoLong

  native function porLiteral(a: integer): integer
    return a / 2 + a mod 7
  end porLiteral

  native function divideDentro(a: integer, b: integer): integer
    try
      return a / b
    catch e: Exception
      return -98
    endtry
  end divideDentro

  function divideFuera(a: integer, b: integer): integer
    try
      return divide(a, b)
    catch e: Exception
      print e.msg
      return -99
    endtry
  end divideFuera

  function restoFuera(a: integer, b: integer): integer
    try
      return resto(a, b)
    catch e: Exception
      print e.msg
      return -99
    endtry
  end restoFuera

  native function conNombres(n: integer): integer
    var t: integer := 0
    var w: integer := 0
    while w < n do fuera
      w += 1
      for i := 1 to 3 do dentro
        if i == 2 then
          continue fuera
        endif
        t += 10
      next i
      t += 1000
    endwh
    for i := 1 to 9 do lejos
      var k: integer := 0
      while true do cerca
        k += 1
        if k == 3 then
          break lejos
        endif
      endwh
      t += 1000
    next i
    return t
  end conNombres

  function mira(que: string, obtenido: integer, esperado: integer)
    if obtenido == esperado then
      print "ok    " + que + " = " + obtenido
    else
      print "FALLO " + que + ": sale " + obtenido + ", se esperaba " + esperado
    endif
  end mira

  function Main()
    mira("porString(hola)", porString("hola"), 1)
    mira("porString(ha)", porString("h" + "a"), 23)
    mira("porString(x)", porString("x"), 9)
    mira("porLong(5e9)", porLong(5000000000L), 5)
    mira("porLong(7)", porLong(7L), 7)
    mira("porLong(8)", porLong(8L), -1)
    mira("porInteger(705032704)", porInteger(705032704), 0)
    mira("porInteger(2)", porInteger(2), 1)
    mira("vueltas(6)", vueltas(6), 422)
    mira("conString(5)", conString(5), 12)
    mira("sumaFor(9)", sumaFor(9), 25)
    mira("aFuera(5)", aFuera(5), 11)
    mira("aFuera(50)", aFuera(50), 53)
    mira("conTry(3)", conTry(3), 202)
    mira("bits(5)", bits(5), 0)
    mira("bits(20)", bits(20), 1)
    mira("arrays(3)", arrays(3), 1120)
    var minimo: integer := 0 - 2147483647 - 1
    mira("vuelta(max)", vuelta(2147483647), 0)
    mira("vuelta(5)", vuelta(5), 1)
    mira("vueltaResta(min)", vueltaResta(minimo), 0)
    mira("vueltaLong(max)", vueltaLong(9223372036854775807L), 0)
    mira("vueltaLong(5)", vueltaLong(5L), 1)
    mira("vueltaMul(max)", vueltaMul(2147483647), 0)
    mira("vueltaMul(3)", vueltaMul(3), 1)
    mira("niega(min)", niega(minimo), 1)
    mira("niega(5)", niega(5), 0)
    mira("compuestos(max)", compuestos(2147483647), 1111)
    mira("cuentaFor()", cuentaFor(), 5)
    mira("desplaza(33)", desplaza(33), 2)
    mira("desplaza(32)", desplaza(32), 1)
    mira("desplazaDer(33)", desplazaDer(33), 512)
    mira("desplazaNeg(33)", desplazaNeg(33), -512)
    mira("desplazaLong(65)", desplazaLong(65), 1)
    mira("conNombres(3)", conNombres(3), 30)
    mira("divide(7, 2)", divide(7, 2), 3)
    mira("resto(7, 2)", resto(7, 2), 1)
    mira("divide(min, -1)", divide(minimo, 0 - 1), minimo)
    mira("resto(min, -1)", resto(minimo, 0 - 1), 0)
    mira("divide(7, -1)", divide(7, 0 - 1), -7)
    var minimoLong: long := 0L - 9223372036854775807L - 1L
    mira("divideLong(min, -1)", divideLong(minimoLong, 0L - 1L), 1)
    mira("restoLong(min, -1)", restoLong(minimoLong, 0L - 1L), 1)
    mira("porLiteral(23)", porLiteral(23), 13)
    mira("divideFuera(7, 0)", divideFuera(7, 0), -99)
    mira("restoFuera(7, 0)", restoFuera(7, 0), -99)
    mira("divideDentro(7, 0)", divideDentro(7, 0), -98)
    mira("divideDentro(9, 3)", divideDentro(9, 3), 3)
  end Main
end NatSwitch
