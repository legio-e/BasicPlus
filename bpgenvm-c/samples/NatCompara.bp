// NatCompara.bp — V8/H5 (#713, 21-oct): <, <=, >, >=, == y != entre cadenas DENTRO de una native.
//
// En el intérprete, los relacionales entre cadenas llaman al builtin __strCompare (un memcmp por bytes; un null,
// «referencia nula», #774).
// En una native, el AOT llama al MISMO builtin por el despachador común (call_builtin), sin tocar la tabla de helpers
// ni la ABI; == y != siguen por el helper string_eq. Hasta hoy el AOT escribía un `<` de C entre los dos handles.
// `make test-aotcompara` corre este .mod con el AOT y sin él (--interp) y exige la misma salida, completa y sin FALLO;
// y comprueba cada resultado contra el que da el intérprete con una referencia carácter a carácter.
module NatCompara
  import Core

  var nada: string

  native function menor(a: string, b: string): boolean
    return a < b
  end menor

  native function menorIgual(a: string, b: string): boolean
    return a <= b
  end menorIgual

  native function mayor(a: string, b: string): boolean
    return a > b
  end mayor

  native function mayorIgual(a: string, b: string): boolean
    return a >= b
  end mayorIgual

  native function igual(a: string, b: string): boolean
    return a == b
  end igual

  native function distinta(a: string, b: string): boolean
    return a != b
  end distinta

  // la referencia, interpretada: carácter a carácter (con cadenas; un null, «referencia nula»)
  function compareRef(a: string, b: string): integer
    var la: integer := strlen(a)
    var lb: integer := strlen(b)
    var n: integer := la
    if lb < n then
      n := lb
    endif
    var i: integer := 0
    while i < n do
      if charCodeAt(a, i) < charCodeAt(b, i) then
        return -1
      endif
      if charCodeAt(a, i) > charCodeAt(b, i) then
        return 1
      endif
      i := i + 1
    endwh
    if la < lb then
      return -1
    endif
    if la > lb then
      return 1
    endif
    return 0
  end compareRef

  function mira(que: string, k: integer, obtenido: boolean, esperado: boolean)
    if obtenido == esperado then
      print "ok " + que + " " + k + ": " + boolToString(obtenido)
    else
      print "FALLO " + que + " " + k + ": " + boolToString(obtenido) + " (esperado " + boolToString(esperado) + ")"
    endif
  end mira

  function Main()
    var cs: string[] := ["", "a", "ab", "b", "ñ", "añ", "€", "😀", "Z"]
    var k: integer := 0
    var p: integer := 0
    while p < len(cs) do
      var q: integer := 0
      while q < len(cs) do
        var a: string := cs[p]
        var b: string := fromBytes(toBytes(cs[q]))        // una del heap
        var c: integer := compareRef(a, b)
        mira("<", k, menor(a, b), c < 0)
        mira("<=", k, menorIgual(a, b), c <= 0)
        mira(">", k, mayor(a, b), c > 0)
        mira(">=", k, mayorIgual(a, b), c >= 0)
        mira("==", k, igual(a, b), p == q)
        mira("!=", k, distinta(a, b), p != q)
        k += 1
        q += 1
      endwh
      p += 1
    endwh
    // sin valor: desde #774 (V8, 2-nov) una global string sin valor nace "" —el compilador le pone el inicializador—,
    // para ordenar y para == (antes, == sólo la daba igual a otra sin valor: #773)
    mira("< nada", k, menor(nada, "a"), true)
    mira(">= nada", k, mayorIgual(nada, ""), true)
    mira("== nada", k, igual(nada, ""), true)
    mira("== nada nada", k, igual(nada, nada), true)
    // #774: una variable string a null. == y != no lanzan (null sólo es igual a null); ordenar pide una cadena, y desde
    // una native el error del builtin sale por call_builtin como cualquier excepción
    var nulo: string := null
    mira("== nulo", k, igual(nulo, ""), false)
    mira("== nulo nulo", k, igual(nulo, nulo), true)
    mira("!= nulo", k, distinta(nulo, "a"), true)
    try
      mira("< nulo", k, menor(nulo, "a"), false)
      print "FALLO < nulo: sin error"
    catch e: RuntimeError
      print "ok < nulo: " + e.msg
    endtry
  end Main
end NatCompara
