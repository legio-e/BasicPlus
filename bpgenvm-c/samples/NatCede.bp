// NatCede.bp — V7/H5 P2b.1.c: una native que llama a una función BP que se BLOQUEA (sleep) mientras otro
// hilo avanza. Hasta P2b.1.c era un error: «call_bp: la función BP cedió/falló (no soportado por el puente
// v1)». Ahora la native se SUSPENDE —su pila de C es la que le presta el intérprete— y el worker atiende al
// otro hilo, que además reserva memoria sin parar: con GC en cada reserva (el arnés lo pone así), la cadena
// que la native guarda en una variable de C tiene que sobrevivir a los GC de mientras duerme. La función BP
// no duerme un tiempo fijo: espera a que el otro hilo diga que ha terminado — el orden de la salida no
// depende del reloj (la primera versión, con un sleep(100), era una carrera). `make test-aotcede` corre el
// MISMO .mod con el AOT y sin él y exige la misma salida.
module NatCede
  import Core

  public property listo: integer := 0

  public class Otro extends Thread
    public function Otro()
      super(0)
    end Otro
    public function run()
      var k: integer := 0
      while k < 3 do
        print "ok otro: paso " + intToString(k)
        var basura: string := "x"
        var j: integer := 0
        while j < 40 do
          basura := basura + intToString(j)
          j += 1
        endwh
        sleep(5)
        k += 1
      endwh
      listo := 1
    end run
  end Otro

  function esperarAlOtro(): integer
    while listo == 0 do
      sleep(10)
    endwh
    return 7
  end esperarAlOtro

  function pausa(): integer
    sleep(10)
    return 1
  end pausa

  // Se suspende y, al volver, LANZA: el límite de fallos tiene que ser el SUYO (el worker pone el suyo en
  // la TLS mientras la native duerme, y ella recupera el propio al reanudarse).
  native function tras(s: string): string
    var p: integer := pausa()
    return charAt(s, 99 + p)
  end tras

  native function espera(ms: integer): string
    var guardado: string := intToString(ms * 1000)
    var r: integer := esperarAlOtro()
    return guardado + "/" + intToString(r)
  end espera

  function Main()
    var o: Otro := Otro()
    o.start()
    print "ok main: antes de la native"
    var s: string := espera(100)
    print "ok main: la native volvio con " + s
    o.join()
    try
      print "ok main: tras = " + tras("abc")
    catch e: RuntimeError
      print "ok main: atrapada tras la pausa: " + e.msg
    endtry
    print "ok fin"
  end Main
end NatCede
