// NatCompuestos.bp — V8/H7.1 (#747, 31-oct): los compuestos nuevos (`*=`, `/=`, `mod=`, `&=`, `|=`, `xor=`, `shl=`,
// `shr=`) y el ternario, `iif`, dentro de una `native`. El AOT escribe un compuesto como `x = x op v` por el camino de la
// expresión binaria —sus helpers son los del intérprete: la división de long, la aritmética de double y la de float— y
// el ternario como el `?:` de C, que sólo calcula la rama que toca. Cada caso es una native: en el corpus corre
// interpretada, en las dos VMs; `make test-aotcompuestos` la corre con el AOT y sin él, y exige lo mismo. Lo que tiene
// que salir, escrito a mano: una línea FALLO pone la red en rojo aunque las dos VMs coincidan.
module NatCompuestos
  import Core

  var malas: integer := 0
  var gi: integer := 10
  var gf: float := 2.5

  function mira(que: string, obtenido: integer, esperado: integer)
    if obtenido == esperado then
      print "ok " + que + ": " + intToString(obtenido)
    else
      malas += 1
      print "FALLO " + que + ": " + intToString(obtenido) + ", se esperaba " + intToString(esperado)
    endif
  end mira

  function miraL(que: string, obtenido: long, esperado: long)
    if obtenido == esperado then
      print "ok " + que + ": " + longToString(obtenido)
    else
      malas += 1
      print "FALLO " + que + ": " + longToString(obtenido) + ", se esperaba " + longToString(esperado)
    endif
  end miraL

  function miraD(que: string, obtenido: double, esperado: double)
    if obtenido == esperado then
      print "ok " + que + ": " + doubleToString(obtenido)
    else
      malas += 1
      print "FALLO " + que + ": " + doubleToString(obtenido) + ", se esperaba " + doubleToString(esperado)
    endif
  end miraD

  native function enteros(): integer
    var i: integer := 7
    i *= 5
    i /= 4
    i mod= 5
    i &= 6
    i |= 5
    i xor= 12
    i shl= 3
    i shr= 2
    return i
  end enteros

  native function negativos(): integer
    var m: integer := -7
    m /= 2
    var r: integer := -7
    r mod= 2
    return m * 10 + r
  end negativos

  native function largos(): long
    var l: long := 1
    l shl= 40
    l *= 3
    l /= 7
    l mod= 1000
    l xor= 255
    return l
  end largos

  native function reales(): double
    var d: double := 10d
    d *= 1.5d
    d /= 4
    d mod= 2d
    return d
  end reales

  native function flotantes(): float
    var f: float := 2.5
    f *= 4
    f /= 8
    return f
  end flotantes

  native function globales(): integer
    gi *= 3
    gi mod= 7
    gf *= 4
    return gi + integer(gf)
  end globales

  native function arrays(a: integer[]): integer
    a[1] := 4
    a[1] *= 5
    a[1] shl= 2
    a[2] := 7
    a[2] mod= 4
    return a[1] + a[2]
  end arrays

  native function ternario(x: integer): integer
    return iif(x > 0, x * 2, iif(x < 0, -x, 100))
  end ternario

  native function ternarioMixto(x: integer): double
    return iif(x > 0, 1.5d, 2)
  end ternarioMixto

  // sólo la rama que toca: con x = 5, a[x] se saldría del array
  native function ternarioPerezoso(a: integer[], x: integer): integer
    return iif(x < 3, a[x], -1)
  end ternarioPerezoso

  function Main()
    mira("1, los ocho compuestos de integer", enteros(), 22)
    mira("2, / y mod con negativos, como en C#", negativos(), -31)
    miraL("3, long: shl, *, / y mod por sus helpers, y xor", largos(), 209)
    miraD("4, double: *, / y mod por sus helpers", reales(), 1.75d)
    miraD("5, float: * y /", double(flotantes()), 1.25d)
    mira("6, las globales de integer y de float", globales(), 12)
    var a: integer[] := [0, 0, 0]
    mira("7, los elementos de un array", arrays(a), 83)
    mira("8a, el ternario", ternario(5), 10)
    mira("8b, el ternario anidado", ternario(-4), 4)
    mira("8c, el ternario anidado, la otra rama", ternario(0), 100)
    miraD("9a, un ternario de double", ternarioMixto(1), 1.5d)
    miraD("9b, la rama integer, pasada a double", ternarioMixto(-1), 2d)
    mira("10, sólo la rama que toca", ternarioPerezoso(a, 5), -1)
    print "NatCompuestos: " + intToString(malas) + " mal"
  end Main
end NatCompuestos
