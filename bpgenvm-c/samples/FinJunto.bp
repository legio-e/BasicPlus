// FinJunto.bp — V7/H12, etapa 2a.2 (4-oct): EL ÚLTIMO QUE SALE. El main arranca un hilo corto y acaba sin esperarlo:
// con dos runs, los dos hilos acaban casi a la vez, cada uno en un run. El fin del programa lo decide el último run que
// suelta su hilo, nunca uno que ve los dos terminados mientras el otro todavía tiene el suyo entre manos
// (test/test_cola.c, con la ventana ensanchada —cada run se entretiene después de su cuanto— y su sabotaje).
module FinJunto
  class Corto extends Thread
    public function Corto()
      super(4096)
    end Corto

    public function run()
      var i: integer := 0
      var s: integer := 0
      while i < 50 do
        s := s + i
        i := i + 1
      endwh
      print "corto:", s
    end run
  end Corto

  function Main()
    var c: Corto := Corto()
    c.start()
    var i: integer := 0
    var s: integer := 0
    while i < 50 do
      s := s + i
      i := i + 1
    endwh
    print "main:", s
  end Main
end FinJunto
