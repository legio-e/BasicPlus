// #516 (18-sep) — el consumidor: construye con el enum (ctor cabeza), llama a la sobrecarga con enum
// y a la de integer, recibe un enum de vuelta y lo pasa a una funcion de modulo. Paridad byte a byte.
module EnumFirma
  import Core
  import EnumFirmaLib
  function Main()
    var a: EnumFirmaLib.Base := EnumFirmaLib.Base(EnumFirmaLib.Color.ROJO)
    var b: EnumFirmaLib.Base := EnumFirmaLib.Base()
    print "m(ROJO) = " + a.m(EnumFirmaLib.Color.ROJO)
    print "m(VERDE) = " + a.m(EnumFirmaLib.Color.VERDE)
    print "m(4) = " + a.m(4)
    print "a: " + EnumFirmaLib.pinta(a.cual()) + " " + a.esRojo() + " " + a.num()
    print "b: " + EnumFirmaLib.pinta(b.cual()) + " " + b.esRojo() + " " + b.num()
    var c: EnumFirmaLib.Color := b.cual()
    if c == EnumFirmaLib.Color.AZUL then
      print "azul de vuelta"
    endif
    print "fin"
  end Main
end EnumFirma
