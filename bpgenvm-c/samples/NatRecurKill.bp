// NatRecurKill.bp — #580 (1): el `kill` de una native RECURSIVA SIN BUCLES. No pasa nunca por la línea del bucle:
// hasta el 3-oct no cedía ni veía el kill —en la C3, fib(40) eran 32 s sin poder pararla—. Desde entonces, «como un
// bucle» (Eduardo): la marca va a la ENTRADA de las natives que están en un ciclo de llamadas, y cede y se para.
// fib(45) son segundos en el PC y minutos en una placa: la prueba no es acabar, es PARARLA. `make test-aotkill` y la
// tanda («kill_tras_ms»).
module NatRecurKill
  native function fib(n: integer): integer
    if n < 2 then
      return n
    endif
    return fib(n - 1) + fib(n - 2)
  end fib

  function Main()
    print "ok kill: entra en la native recursiva"
    var r: integer := fib(45)
    print "FALLO: la native volvio " + intToString(r)
  end Main
end NatRecurKill
