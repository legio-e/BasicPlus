// GenericosOrden.bp — V8/H8 (#793, 5-nov): los genéricos como una orden al compilador (Eduardo: «<miTipo> es una
// instrucción para el compilador, para que sepa que tipo de objetos guarda»). La clase no lleva T y se compila como
// siempre; en `C<X>`, donde la firma dice su tipo base, el compilador lee X: lo que entra tiene que ser un X, y lo que
// sale es un X, con el cast que a mano sería `X(…)`. List y Map no se tocan; una clase nueva dice su tipo base con
// @element{B}. Entre módulos, GenericosOrdenUsa. Es de paridad (está en el corpus) y se escribe en JC.
// mod8: fuera — lleva interfaces de clase, y un cast a una interfaz es del enlace tardío
module GenericosOrden
  import Collections

  public class Sensor
    var v: integer

    public function Sensor(x: integer)
      this.v := x
    end Sensor

    public function valor(): integer
      return this.v
    end valor

    public function toString(): string
      return "Sensor(" + this.v + ")"
    end toString
  end Sensor

  public class Termometro extends Sensor
    public function Termometro(x: integer)
      super(x)
    end Termometro

    public function grados(): string
      return this.valor() + " grados"
    end grados
  end Termometro

  public interface Medida
    function cuanto(): integer
  end Medida

  public class Metro implements Medida
    var m: integer

    public function Metro(x: integer)
      this.m := x
    end Metro

    @implement{Medida}
    public function cuanto(): integer
      return this.m
    end cuanto

    public function enCm(): integer
      return this.m * 100
    end enCm
  end Metro

  // Una clase nueva: su tipo base, Medida. Se compila como siempre, con Medida en las firmas.
  @element{Medida}
  public class Bolsa
    var dentro: List<Medida>

    public function Bolsa()
      this.dentro := List()
    end Bolsa

    public function mete(m: Medida)
      this.dentro.add(m)
    end mete

    public function saca(i: integer): Medida
      return this.dentro.get(i)
    end saca

    public function total(): integer
      var t: integer := 0
      for m in this.dentro do
        t += m.cuanto()
      next
      return t
    end total
  end Bolsa

  // Con Object, y una property: la misma regla. La hija hereda la marca.
  @element{Object}
  public class Caja
    public property ultimo: Object
    var cuantos: integer

    public function Caja()
      this.cuantos := 0
    end Caja

    public function guarda(o: Object)
      this.ultimo := o
      this.cuantos += 1
    end guarda

    // Por dentro todo es Object: el compilador no ve lo que hace la clase.
    public function trampa(): Object
      return "no soy lo que dices"
    end trampa
  end Caja

  public class CajaFuerte extends Caja
    public function cierra(): string
      return "cerrada con " + this.ultimo
    end cierra
  end CajaFuerte

  public function sensores(): List<Sensor>
    var l: List<Sensor> := List()
    l.add(Sensor(1))
    l.add(Termometro(2))
    return l
  end sensores

  public function suma(l: List<Sensor>): integer
    var t: integer := 0
    for s in l do
      t += s.valor()
    next
    return t
  end suma

  public function porNombre(): Collections.Map<string, Sensor>
    var m: Collections.Map<string, Sensor> := Collections.Map()
    m.put("uno", Sensor(10))
    return m
  end porNombre

  function intruso(l: List)
    l.add("intruso")
  end intruso

  function main()
    // una lista de una clase: sin casts, y una hija también entra
    var l: List<Sensor> := sensores()
    l.add(Termometro(3))
    print "get:", l.get(0).valor(), l.get(2), l.length()
    l.set(0, Sensor(5))
    print "suma:", suma(l)
    for s in l do
      print "for:", s, s.valor()
    next
    var t: Termometro := Termometro(l.get(1))   // bajar a la hija sigue siendo un cast
    print t.grados()
    print "null:", l.get(0) == null

    // string, y los números en su caja
    var c: List<string> := List()
    c.add("a")
    c.add("b")
    print "cadena:", c.get(0) + c.get(1), len(c.get(1))
    for x in c do
      print "for de cadenas:", x + "!"
    next
    var n: List<Integer> := List()
    n.add(7)
    n.add(Integer(8))
    print "cajas:", n.get(0).value() + n.getInteger(1)

    // las hijas de List
    var sl: SyncList<Sensor> := SyncList()
    sl.add(Sensor(20))
    print "pop:", sl.pop().valor()
    var ol: OwnerList<Sensor> := OwnerList()
    ol.add(Sensor(21))
    print "owner:", ol.get(0).valor()

    // Map: la llave, como siempre; el valor, un Sensor
    var m: Collections.Map<string, Sensor> := porNombre()
    m.put("dos", Sensor(11))
    print "map:", m.get("dos").valor(), m.valueAt(0).valor(), m.keyAt(1), m.size()
    var num: Collections.Map<integer, Sensor> := Collections.numericMap()
    num.put(3, Sensor(12))
    print "map de integer:", num.get(3).valor()
    print "sin esa llave:", m.get("tres") == null

    // una clase con @element, y una interfaz
    var b: Bolsa<Metro> := Bolsa()
    b.mete(Metro(2))
    b.mete(Metro(3))
    print "bolsa:", b.saca(1).enCm(), b.total()

    // una property, y lo que hereda la hija
    var k: Caja<Sensor> := Caja()
    k.guarda(Sensor(30))
    print "property:", k.ultimo.valor()
    k.ultimo := Sensor(31)
    print "asignada:", k.ultimo.valor()
    var f: CajaFuerte<Sensor> := CajaFuerte()
    f.guarda(Sensor(32))
    print f.cierra(), f.ultimo.valor()

    // anidados
    var ll: List<List<Sensor>> := List()
    ll.add(sensores())
    print "anidado:", ll.get(0).get(1).valor()
    var ml: Collections.Map<string, List<Sensor>> := Collections.Map()
    ml.put("a", sensores())
    print "map de listas:", ml.get("a").get(0).valor()

    // List a secas y List<Sensor> se mezclan, y lo que da la vuelta lo para el cast, en la línea
    var crudo: List := l
    print "a secas:", crudo.length()
    var otra: List<Sensor> := crudo
    print "otra vez:", otra.get(0).valor()
    intruso(l)
    try
      print l.get(3).valor()
    catch e: Exception
      print "el cast:", e.msg
    endtry
    try
      for s in l do
        print "vuelta:", s.valor()
      next
    catch e: Exception
      print "en el for:", e.msg
    endtry
    try
      var ks: Caja<Sensor> := Caja()
      print ks.trampa().valor()
    catch e: Exception
      print "la clase por dentro:", e.msg
    endtry
  end main
end GenericosOrden
