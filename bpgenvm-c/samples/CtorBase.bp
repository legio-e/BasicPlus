// V7/H2 (#509/#513) — oráculo de paridad: CONSTRUCTORES SOBRECARGADOS cruzando el módulo.
// La mitad DUEÑA: Base con tres constructores (la sin-args NO es la cabeza), Der sin ctor
// propio (hereda los tres: #513), y DerCon con super(...) sobre una sobrecarga.
// El consumidor es CtorHijo.bp.
module CtorBase
  public class Base
    var n: integer := 0
    var s: string := ""
    public function Base(v: integer)
      this.n := v
      this.s := "int"
    end Base
    public function Base()
      this.n := 100
      this.s := "vacio"
    end Base
    public function Base(v: integer, t: string)
      this.n := v
      this.s := t
    end Base
    public function Base(o: Base)
      this.n := o.n + 1
      this.s := "copia"
    end Base
    public function quien(): string
      return this.s + ":" + this.n
    end quien
  end Base

  // #513: sin constructor propio — hereda los de Base
  public class Der extends Base
    public function marca(): string
      return "Der/" + this.quien()
    end marca
  end Der

  public class DerCon extends Base
    var extra: integer := 0
    public function DerCon(x: integer)
      super(x, "con")
      this.extra := x * 2
    end DerCon
    public function DerCon()
      // super implícito: la sobrecarga sin args, que NO es la cabeza
      this.extra := 1
    end DerCon
    public function marca(): string
      return "DerCon/" + this.quien() + "/" + this.extra
    end marca
  end DerCon

  public function local(): string
    var a: Base := Base(5)
    var b: Base := Base()
    var c: Base := Base(6, "dos")
    var d: Base := Base(a)
    var e: Der := Der(7)
    var f: DerCon := DerCon(8)
    var g: DerCon := DerCon()
    return a.quien() + " " + b.quien() + " " + c.quien() + " " + d.quien() + " " + e.marca() + " " + f.marca() + " " + g.marca()
  end local
end CtorBase
