// FormsSetter.bp — V7/H7 #607 (30-sep): el setter que llama Forms al cargar una ventana (Gui.bindMember) es una
// llamada NORMAL —el opcode INVOKE_SLOT—: puede CEDER, y su excepción llega al catch de quien cargó.
//
// Antes corría ANIDADO dentro de un builtin (__guiInvokeBySlot, el puente): un setter con un `sleep` se cortaba en
// el `sleep`, en silencio y en las dos VMs; y uno que lanzaba dejaba divergir a las VMs (la VM-C la atrapaba por un
// camino raro —el catch corría dentro del intérprete anidado—; miVM mataba el main). Se comprueba a sí mismo: una
// línea FALLO pone la red en rojo aunque las dos VMs digan lo mismo.
//
// recurso: bpgenvm-c/samples/FormsSetter.win
module FormsSetter
import Gui

  public class Ventana extends Gui.Window
    public property fase: integer
    var lanzar: boolean

    public function Ventana(lanzar: boolean)
      this.fase := 0
      this.lanzar := lanzar
    end Ventana

    // El setter del miembro «boton» del .win: lo llama el cargador de Forms por su nombre.
    public function setBoton(w: Gui.Component)
      print "setter: antes del sleep"
      this.fase := 1
      sleep(20)
      if this.lanzar then
        throw RuntimeError("el setter lanza")
      endif
      print "setter: despues del sleep"
      this.fase := 2
    end setBoton
  end Ventana

  function main(arg: string)
    // 1. El setter CEDE (un sleep): tiene que llegar al final.
    var v1: Ventana := Ventana(false)
    var raiz: Gui.Component := v1.load("FormsSetter.win")
    print "cargada; el setter llego a la fase ", v1.fase
    if v1.fase != 2 then
      print "FALLO: el setter que cede se corto (fase ", v1.fase, ")"
    endif
    v1.destroy()

    // 2. El setter LANZA: la excepción llega al catch de quien carga, en las dos VMs.
    var v2: Ventana := Ventana(true)
    var atrapada: boolean := false
    try
      raiz := v2.load("FormsSetter.win")
    catch e: RuntimeError
      print "atrapada en el main: ", e.msg
      atrapada := true
    endtry
    if not atrapada then
      print "FALLO: la excepcion del setter no llego al catch de quien cargo"
    endif
    print "fin"
  end main
end FormsSetter
