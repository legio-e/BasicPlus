// HeapReposo.bp — V7/H7 #595 (28-sep): el patrón de un programa que corre DÍAS, según Eduardo: «habrá momentos sin
// actividad o con muy poca. Se puede aprovechar esos momentos para cerrar todos los Threads BP y todo lo que esté
// abierto, y compactar y entrar en modo reposo o similar». Heap.compact() sólo se admite desde Main y sin otros
// hilos vivos; aquí es el programa quien prepara ese momento, jornada tras jornada:
//   1. trabajan dos hilos (y ensucian el heap) mientras Main escribe en un fichero abierto;
//   2. la calma: Main da la orden de parar y espera a los hilos (join) —matar un hilo desde fuera no: podría
//      quedarse con un Mutex cogido—, y cierra el fichero;
//   3. compacta, comprueba y «reposa» (hoy un sleep; el reposo de bajo consumo es de V8);
//   4. y la jornada siguiente, con hilos nuevos.
// Lo que se imprime no depende de cuándo corre cada hilo: cada uno hace un trabajo fijo y luego espera la orden.
module HeapReposo
  import IO
  import Heap

  var F: string := "reposo_test.txt"

  // La orden de parar, compartida por Main y los trabajadores, bajo un Mutex.
  class Turno
    var m: Mutex
    var parar: boolean
    public function Turno()
      this.m := Mutex()
      this.parar := false
    end Turno
    public function pide()
      this.m.lock()
      this.parar := true
      this.m.unlock()
    end pide
    public function hayQueParar(): boolean
      this.m.lock()
      var p: boolean := this.parar
      this.m.unlock()
      return p
    end hayQueParar
  end Turno

  // Lo que queda de cada jornada: vive toda la ejecución, y tiene que sobrevivir a cada compactación.
  class Resumen
    var sig: Resumen
    var texto: string
    var sumas: long[]
    public function Resumen(sig: Resumen, texto: string, a: integer, b: integer)
      this.sig := sig
      this.texto := texto
      this.sumas := newLongArray(2)
      this.sumas[0] := a
      this.sumas[1] := b
    end Resumen
    public function siguiente(): Resumen
      return this.sig
    end siguiente
    public function describe(): string
      return this.texto + ": " + this.sumas[0] + " y " + this.sumas[1]
    end describe
  end Resumen

  class Trabajador extends Thread
    var turno: Turno
    var semilla: integer
    var suma: integer
    public function Trabajador(t: Turno, semilla: integer)
      super(4096)
      this.turno := t
      this.semilla := semilla
      this.suma := 0
    end Trabajador
    public function run()
      // un trabajo fijo que ensucia el heap: cadenas y arrays que se tiran en cada vuelta
      for i := 0 to 299 do
        var s: string := "medida " + (this.semilla * 1000 + i)
        var a: integer[] := newIntArray(i mod 13 + 1)
        a[len(a) - 1] := len(s) + i * this.semilla
        this.suma := this.suma + a[len(a) - 1]
      next i
      // y luego, a la espera de la orden de parar, como un trabajador de verdad entre encargos
      while not this.turno.hayQueParar() do
        sleep(1)
      endwh
    end run
    public function total(): integer
      return this.suma
    end total
  end Trabajador

  function mira(nombre: string, cierto: boolean)
    if cierto then
      print "ok " + nombre
    else
      print "FALLO " + nombre
    endif
  end mira

  function Main()
    if fileExists(F) then
      IO.removeFile(F)
    endif
    var resumenes: Resumen := null
    for jornada := 1 to 3 do
      // 1) el trabajo
      var turno: Turno := Turno()
      var a: Trabajador := Trabajador(turno, jornada * 2)
      var b: Trabajador := Trabajador(turno, jornada * 2 + 1)
      a.start()
      b.start()
      var f: IO.File := IO.File(F, "a")
      f.write(toBytes("jornada " + jornada + "\n"))
      // 2) la calma: parar los hilos y cerrar lo abierto
      turno.pide()
      a.join()
      b.join()
      f.close()
      resumenes := Resumen(resumenes, "jornada " + jornada, a.total(), b.total())
      // 3) compactar (ya no queda otro hilo vivo ni nada abierto) y comprobar
      Heap.compact()
      var huecos: integer := Heap.getFreeBlocks()
      var mayor: integer := Heap.getLargestFree()
      var libre: integer := Heap.getFree()
      mira("jornada " + jornada + ": compactado, sin huecos", huecos == 0 and mayor == libre)
      // ... y reposar
      sleep(5)
    next jornada
    // lo que quedó de cada jornada, intacto tras tres compactaciones
    var r: Resumen := resumenes
    while r != null do
      print r.describe()
      r := r.siguiente()
    endwh
    mira("el fichero tiene las tres jornadas", fromBytes(readFileBytes(F)) == "jornada 1\njornada 2\njornada 3\n")
    IO.removeFile(F)
    print "fin"
  end Main
end HeapReposo
