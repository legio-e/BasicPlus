// HeapInfo.bp — V7/H7 (28-sep): el diagnóstico del heap DESDE BP (el módulo Heap; decidido por Eduardo). Los números
// son de CADA VM, no de paridad —su heap no mide lo mismo y colectan en momentos distintos—, así que aquí sólo se
// comprueban RELACIONES, que valen en las dos: cada línea, «ok» o «FALLO», y ningún número en el stdout.
module HeapInfo
  import Heap

  class Nodo
    var sig: Nodo
    var datos: integer[]
    public function Nodo(sig: Nodo)
      this.sig := sig
      this.datos := newIntArray(16)
    end Nodo
  end Nodo

  function mira(nombre: string, cierto: boolean)
    if cierto then
      print "ok " + nombre
    else
      print "FALLO " + nombre
    endif
  end mira

  // V7/H9 (2-oct): llena de enteros (que no son handles) los marcos de encima. El GC recorre la pila palabra a
  // palabra (conservador) y ENTER no pone a cero los locales: en la placa —no en el PC, cuya pila nueva está a
  // cero— las ranuras que aún no se han escrito guardan handles de antes (de otra llamada, de otro RUN), que al
  // contar h0 retienen basura que una colecta del bucle se lleva en cuanto se escriben. En la C6: «FALLO
  // doscientos nodos…» con el arreglo de #621 ya puesto. Por eso la prueba va en su función, con la pila fregada.
  function friega(n: integer): integer
    var a: integer := 0
    var b: integer := 0
    var c: integer := 0
    var d: integer := 0
    if n > 0 then
      return friega(n - 1) + a + b + c + d
    endif
    return 0
  end friega

  function prueba()
    var tam: integer := Heap.getSize()
    var libre: integer := Heap.getFree()
    var mayor: integer := Heap.getLargestFree()
    mira("el heap mide algo", tam > 0)
    mira("lo libre cabe en el heap", libre > 0 and libre <= tam)
    mira("el mayor bloque cabe en lo libre", mayor > 0 and mayor <= libre)
    mira("los huecos se cuentan", Heap.getFreeBlocks() >= 0)
    // V7/H9 (2-oct): se colecta ANTES de contar, para que h0 sean sólo objetos vivos. Si no, h0 cuenta también la
    // basura de las líneas de arriba (las cadenas de «mira»), y una colecta en medio del bucle —en un heap pequeño
    // las hay: en la C6, tres— se la lleva y los nodos parecen menos (h0 7, al final 405: 398 «más», no 400).
    gc()
    var h0: integer := Heap.getHandles()
    // doscientos nodos vivos: cada uno, el objeto y su array
    var cab: Nodo := null
    var i: integer := 0
    while i < 200 do
      cab := Nodo(cab)
      i := i + 1
    endwh
    mira("doscientos nodos son al menos cuatrocientos objetos mas", Heap.getHandles() >= h0 + 400)
    mira("lo libre baja al reservar", Heap.getFree() < libre)
    var libreLleno: integer := Heap.getFree()
    // se sueltan y se colecta
    var c0: integer := Heap.getCollections()
    cab := null
    gc()
    mira("una colecta mas", Heap.getCollections() == c0 + 1)
    mira("tras soltar y colectar, lo libre sube", Heap.getFree() > libreLleno)
    mira("y los objetos bajan", Heap.getHandles() < h0 + 400)
    print "fin"
  end prueba

  function Main()
    friega(64)
    prueba()
  end Main
end HeapInfo
