// FicherosDosRuns.bp — V7/H12, etapa 2b (5-oct): FICHEROS CON DOS RUNS. La regla de siempre: un fichero abierto para
// ESCRIBIR no se abre otra vez (ni para leer ni para escribir); para LEER, cuantas veces se quiera. Con dos runs tiene que
// seguir valiendo: abrir mira si ya está abierto, lo abre y lo registra DE UNA VEZ; si no, los dos lo ven libre y lo
// abren a la vez para escribir (test/test_cola.c, la parte 8, con la ventana ensanchada y su sabotaje).
//   1. Dos escritores, cada uno en su run, sobre el mismo fichero: quien lo encuentra abierto recibe «ya está
//      abierto». Un contador (bajo un Mutex) mira que nunca lo tengan abierto los dos a la vez.
//   2. Dos lectores sobre el mismo fichero: ninguno recibe nunca «ya está abierto».
// Determinista en el resultado: «escrituras: 600 a la vez: 0» y «lecturas: 600 fallidas: 0».
module FicherosDosRuns
  import IO

  class Contador
    var m: Mutex
    var dentro: integer
    var choques: integer

    public function Contador()
      this.m := Mutex()
      this.dentro := 0
      this.choques := 0
    end Contador

    public function entra()
      this.m.lock()
      this.dentro := this.dentro + 1
      if this.dentro > 1 then
        this.choques := this.choques + 1
      endif
      this.m.unlock()
    end entra

    public function sale()
      this.m.lock()
      this.dentro := this.dentro - 1
      this.m.unlock()
    end sale

    public function total(): integer
      return this.choques
    end total
  end Contador

  class Escritor extends Thread
    var c: Contador
    var veces: integer
    var hechos: integer

    public function Escritor(c: Contador, n: integer)
      super(8192)
      this.c := c
      this.veces := n
      this.hechos := 0
    end Escritor

    public function run()
      var i: integer := 0
      while i < this.veces do
        try
          var f: IO.File := IO.File("comun_2b.txt", "w")
          this.c.entra()
          yield()
          this.c.sale()
          f.close()
        catch e: RuntimeError
          // ya está abierto: lo tiene el otro
        endtry
        this.hechos := this.hechos + 1
        i := i + 1
      endwh
    end run

    public function total(): integer
      return this.hechos
    end total
  end Escritor

  class Lector extends Thread
    var veces: integer
    var hechos: integer
    var fallos: integer

    public function Lector(n: integer)
      super(8192)
      this.veces := n
      this.hechos := 0
      this.fallos := 0
    end Lector

    public function run()
      var i: integer := 0
      while i < this.veces do
        try
          var f: IO.File := IO.File("comun_2b.txt", "r")
          yield()
          f.close()
        catch e: RuntimeError
          this.fallos := this.fallos + 1
        endtry
        this.hechos := this.hechos + 1
        i := i + 1
      endwh
    end run

    public function total(): integer
      return this.hechos
    end total

    public function fallidas(): integer
      return this.fallos
    end fallidas
  end Lector

  function Main()
    var c: Contador := Contador()
    var a: Escritor := Escritor(c, 300)
    var b: Escritor := Escritor(c, 300)
    a.start()
    b.start()
    a.join()
    b.join()
    print "escrituras: " + (a.total() + b.total()) + " a la vez: " + c.total()
    var l1: Lector := Lector(300)
    var l2: Lector := Lector(300)
    l1.start()
    l2.start()
    l1.join()
    l2.join()
    print "lecturas: " + (l1.total() + l2.total()) + " fallidas: " + (l1.fallidas() + l2.fallidas())
  end Main
end FicherosDosRuns
