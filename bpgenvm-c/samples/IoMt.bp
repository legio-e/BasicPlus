// IoMt.bp — B1.4b (H2): el requisito de multitarea de Eduardo — VARIOS
// Threads BP leyendo/escribiendo VARIOS archivos a la vez. Cada hilo escribe
// su fichero PROPIO y registra una línea MARCADA en el LOG común. Verificación
// por PROPIEDADES (determinista aunque el orden no lo sea): tamaños exactos +
// ninguna línea rota en el log + conteo por marcador exacto.
//
// V7 #657 (7-oct) — EL LOG ES UN CANAL, NO UN FICHERO. Eduardo: «un fichero
// abierto para escritura no puede volver a abrirse» —el primero que lo abre
// impide al resto abrirlo: cada appendFile es un open y un close, y dos que se
// cruzan sobre el mismo fichero son «ya está abierto»—; y «el log es diferente,
// es un canal de comunicación, que puede grabarse en un archivo, en memoria,
// TCP/IP, etc. Ahí sí que puede haber concurrencia como en el I2C o en el SPI».
// Antes los tres hilos hacían appendFile al mismo fichero; ahora escriben al
// canal Log (que ordena a sus escritores, como el árbitro de un bus) y el canal,
// a su fichero.
module IoMt
  import IO
  import Log

  class Escritor extends Thread
    var propio: string
    var marca: string
    var veces: integer
    public function Escritor(p: string, m: string, n: integer)
      super(4096)
      this.propio := p
      this.marca := m
      this.veces := n
    end Escritor
    public function run()
      writeFile(this.propio, "")
      var i: integer := 0
      while i < this.veces do
        appendFile(this.propio, "o\n")
        Log.info(this.marca)
        i := i + 1
      endwh
    end run
  end Escritor

  function Main()
    writeFile("mt_shared.log", "")
    Log.setConsole(false)
    Log.setMaxSize(1000000)
    Log.setFile("mt_shared.log")
    var a: Escritor := Escritor("mt_own1.txt", "a", 100)
    var b: Escritor := Escritor("mt_own2.txt", "b", 100)
    var c: Escritor := Escritor("mt_own3.txt", "c", 100)
    a.start()
    b.start()
    c.start()
    a.join()
    b.join()
    c.join()

    print "own1 =", IO.fileSize("mt_own1.txt")
    print "own2 =", IO.fileSize("mt_own2.txt")
    print "own3 =", IO.fileSize("mt_own3.txt")
    print "shared =", IO.fileSize("mt_shared.log")

    // ninguna línea rota: el log es una secuencia de líneas "[INFO ] x\n" (10
    // bytes) y cada marca aparece EXACTAMENTE 100 veces
    var s: string := readFile("mt_shared.log")
    var na: integer := 0
    var nb: integer := 0
    var nc: integer := 0
    var rotas: integer := 0
    var i: integer := 0
    while i < len(s) do
      if charCodeAt(s, i) != 91 or charCodeAt(s, i + 7) != 32 then
        rotas := rotas + 1
      endif
      var ch: integer := charCodeAt(s, i + 8)
      if ch == 97 then
        na := na + 1
      elseif ch == 98 then
        nb := nb + 1
      elseif ch == 99 then
        nc := nc + 1
      else
        rotas := rotas + 1
      endif
      if charCodeAt(s, i + 9) != 10 then
        rotas := rotas + 1
      endif
      i := i + 10
    endwh
    print "marcas a/b/c =", na, nb, nc
    print "lineas rotas =", rotas
    print "IoMt: fin"
  end Main
end IoMt
