// #530 (V7) — la biblioteca de HiloUsa: un Worker que extiende Thread y DEFINE run().
module HiloLib
  public class Worker extends Thread
    public property nombre: string
    public property total: integer
    public function Worker(n: string)
      super(0)
      this.nombre := n
      this.total := 0
    end Worker
    public function run()
      var i: integer := 1
      while i <= 100 do
        this.total := this.total + i
        i := i + 1
      endwh
      print this.nombre + " run total=" + this.total
    end run
  end Worker
end HiloLib
