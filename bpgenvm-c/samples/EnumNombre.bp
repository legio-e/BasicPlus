// EnumNombre.bp — V8 #778 (3-nov): `Enum.getName(c)`, el nombre del valor de un enum (Eduardo: «Para los Enum una
// función nueva, algo como Enum.getName(miEnum.enun4) o similar»; y «en tiempo de compilación debería poderse»). Lo
// resuelve el compilador, que sabe los nombres de cada enum: los de uno de este módulo, por su declaración; los de uno
// de otro (EnumNombreLib), por su interfaz. Escribe en el módulo, una vez por enum, la función valor -> nombre: ni la VM
// ni Core cambian. Dos enums con el mismo nombre, uno de aquí y uno importado, no chocan. En una cadena, un enum sigue
// siendo su número (#522). Lo que tiene que salir:
//   AZUL
//   ROJO
//   VERDE
//   CORRIENDO
//   ANDANDO
//   DOS
//   c=5
//   fin
module EnumNombre
  import Core
  import EnumNombreLib

  public enum Color
    ROJO
    VERDE
    AZUL := 5
  end Color

  enum Estado
    UNO
    DOS
  end Estado

  function nombre(c: Color): string
    return Enum.getName(c)
  end nombre

  function Main()
    var c: Color := Color.AZUL
    print Enum.getName(c)
    print Enum.getName(Color.ROJO)
    print nombre(Color.VERDE)
    print Enum.getName(EnumNombreLib.Estado.CORRIENDO)
    var e: EnumNombreLib.Estado := EnumNombreLib.Estado.ANDANDO
    print Enum.getName(e)
    print Enum.getName(Estado.DOS)
    print "c=" + c
    print "fin"
  end Main

end EnumNombre
