// OwnerCarrera.bp — V7/H12, etapa 2b (5-oct, la revisión): DOS HILOS ASIGNAN A LA VEZ EL MISMO CAMPO OWNER. El
// propietario es uno (el campo `primero`); los hilos, dos, y sin Mutex: la carrera es del programa —qué nodo queda es
// cosa suya—, pero la VM no puede romperse por ella. Asignar un campo owner suelta el nodo de antes; con dos runs, los
// dos hilos leían el mismo nodo, los dos lo veían vivo, y los dos lo soltaban: el bloque dos veces en la lista de
// libres, que se apuntaba a sí misma (la siguiente reserva, dando vueltas sin fin, o dos objetos en el mismo hueco).
// Con el arreglo, lo suelta quien mata su handle y el otro no sigue. test/test_cola.c, la parte 9, con su sabotaje.
// Determinista en el resultado: «fin», y el heap sano (el GC del final lo recorre entero).
module OwnerCarrera
  class Nodo
    var v: integer
    public function Nodo(x: integer)
      this.v := x
    end Nodo
    public function valor(): integer
      return this.v
    end valor
  end Nodo

  class Lista
    var owner primero: Nodo
    public function Lista()
      this.primero := Nodo(0)
    end Lista
    public function cambia(x: integer)
      this.primero := Nodo(x)
    end cambia
  end Lista

  class Cambiador extends Thread
    var l: Lista
    var veces: integer
    public function Cambiador(l: Lista, n: integer)
      super(8192)
      this.l := l
      this.veces := n
    end Cambiador
    public function run()
      var i: integer := 0
      while i < this.veces do
        this.l.cambia(i)
        i := i + 1
      endwh
    end run
  end Cambiador

  function Main()
    var l: Lista := Lista()
    var a: Cambiador := Cambiador(l, 3000)
    var b: Cambiador := Cambiador(l, 3000)
    a.start()
    b.start()
    a.join()
    b.join()
    // el heap, sano: reservar mucho después, y un GC que lo recorre entero
    var s: string := ""
    var k: integer := 0
    while k < 3000 do
      s := "x" + k
      k := k + 1
    endwh
    gc()
    print "fin"
  end Main
end OwnerCarrera
