// OwnerHondo.bp — #656 (7-oct): soltar un `owner` SIN recursión. Soltar un owner suelta en cascada sus campos owner
// (y los elementos de un array owner), y lo hacía llamándose a sí mismo por cada uno: una cadena de N owners bajaba N
// niveles de pila, y en placa (16 KB de pila en `run`) una larga desbordaba la tarea y colgaba la VM sin decir nada; en
// el PC no se veía (la pila de un hilo es de megas). Es la familia de #648 (el marcado del GC). Aquí, las dos formas que
// tiene que aguantar:
//   1. HONDA: una cadena de 4000 nodos, cada uno dueño del siguiente (con la recursión, 4000 niveles);
//   2. ANCHA: un array owner de 600 nodos, cada uno dueño de un hijo —llena la pila de trabajo de la VM-C (64) y obliga
//      al REPASO del heap—;
// y que la cascada llegue de verdad al final: un alias (no owner) a los nodos del fondo tiene que encontrarlos MUERTOS.
// En la red: en la paridad (las dos VMs, la misma salida) y en `make test-ownerhondo` (la VM-C en un hilo de 64 KB y la
// VM-Java con -Xss256k: con la recursión, las dos caían).
module OwnerHondo
  public class Nodo
    var owner sig: Nodo
    var v: integer
    public function Nodo(v: integer)
      this.v := v
    end Nodo
    public function pon(s: Nodo)
      this.sig := s
    end pon
    public function valor(): integer
      return this.v
    end valor
    public function siguiente(): Nodo
      return this.sig
    end siguiente
  end Nodo

  // Un array owner (un `var owner` local no puede ser un array; un campo, sí): sus elementos son suyos.
  public class Almacen
    var owner items: Object[]
    public function Almacen(n: integer)
      this.items := newObjArray(n)
    end Almacen
    public function pon(i: integer, o: Object)
      this.items[i] := o
    end pon
  end Almacen

  // Los alias, NO owner: sobreviven a lo que miran.
  public class Testigos
    var a: Nodo
    var b: Nodo
    var c: Nodo
    public function Testigos()
    end Testigos
    public function guarda(i: integer, n: Nodo)
      if i == 0 then
        this.a := n
      elseif i == 1 then
        this.b := n
      else
        this.c := n
      endif
    end guarda
    public function muertos(): integer
      var m: integer := 0
      try
        var x: integer := this.a.valor()
      catch e: RuntimeError
        m := m + 1
      endtry
      try
        var y: integer := this.b.valor()
      catch e: RuntimeError
        m := m + 1
      endtry
      try
        var z: integer := this.c.valor()
      catch e: RuntimeError
        m := m + 1
      endtry
      return m
    end muertos
  end Testigos

  // Una cadena de n nodos: cada uno, dueño del siguiente. Los testigos miran el del medio y el último.
  function cadena(n: integer, t: Testigos): Nodo
    var cab: Nodo := Nodo(0)
    var p: Nodo := cab
    var i: integer := 1
    while i < n do
      var q: Nodo := Nodo(i)
      p.pon(q)
      p := q
      if i == n / 2 then
        t.guarda(0, q)
      endif
      i := i + 1
    endwh
    t.guarda(1, p)
    t.guarda(2, cab)
    return cab
  end cadena

  function honda(t: Testigos)
    var owner lista: Nodo := cadena(4000, t)
    var n: integer := 0
    var p: Nodo := lista
    while p != null do
      n := n + 1
      p := p.siguiente()
    endwh
    print "honda: " + n + " nodos"
  end honda                 // aquí muere `lista`: la cascada suelta los 4000

  function ancha(t: Testigos)
    var owner a: Almacen := Almacen(600)
    var i: integer := 0
    while i < 600 do
      var x: Nodo := Nodo(i)
      x.pon(Nodo(i * 2))
      a.pon(i, x)
      if i == 0 then
        t.guarda(0, x)
      elseif i == 599 then
        t.guarda(1, x.siguiente())
      elseif i == 300 then
        t.guarda(2, x.siguiente())
      endif
      i := i + 1
    endwh
    print "ancha: " + i + " nodos con su hijo"
  end ancha                 // aquí muere `a`: su array, los 600 y sus hijos

  function Main()
    var t1: Testigos := Testigos()
    honda(t1)
    print "honda, muertos: " + t1.muertos() + " de 3"
    var t2: Testigos := Testigos()
    ancha(t2)
    print "ancha, muertos: " + t2.muertos() + " de 3"
    // y la memoria vuelve: otra cadena igual cabe
    var t3: Testigos := Testigos()
    honda(t3)
    print "otra vez, muertos: " + t3.muertos() + " de 3"
    print "fin"
  end Main
end OwnerHondo
