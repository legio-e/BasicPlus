// NatLlamada.bp — V7/H5 P2b.3: LO QUE CUESTA LLAMAR a una native desde código interpretado. Una native
// diminuta (sin bucle: no pasa por la línea del bucle) llamada 200 000 veces desde un bucle interpretado.
// `make medir-llamada` lo corre con el AOT y sin él y dice los milisegundos de cada pasada: es la medida de
// antes y después de pasar las natives a un ejecutor (P2b.3), no una prueba de la red.
module NatLlamada
  import Core

  native function uno(x: integer): integer
    return x + 1
  end uno

  function Main()
    var t: integer := 0
    var i: integer := 0
    while i < 200000 do
      t := uno(t)
      i += 1
    endwh
    print "ok llamadas: " + intToString(t)
  end Main
end NatLlamada
