// UnaLineaAlFinal.bp — V8 (24-oct, #701): un `if`, `while` o `for` de UNA LÍNEA como última sentencia de un bloque de
// su misma clase.
//
// La forma de una línea no lleva terminador, y el parser, para dar un error claro a quien escribe `if E then STMT
// endif`, miraba si venía uno detrás. Pero la sentencia ya se había comido su salto de línea: lo que veía era el
// `endif`, `endwh` o `next` de la línea siguiente, el del bloque de fuera, y se lo llevaba; el programa no compilaba.
// Desde #701, el terminador sólo cuelga si está en su misma línea (ese error sigue: samples/errores/UnaLineaConFin.bp).
// Es la forma que sale de JC a BP: `for (…) { for (…) x; }`. Lo que tiene que salir, escrito a mano: una línea FALLO
// pone la red en rojo aunque las dos VMs coincidan.
module UnaLineaAlFinal

  var malas: integer := 0

  function mira(que: string, obtenido: integer, esperado: integer)
    if obtenido == esperado then
      print "ok " + que + ": " + intToString(obtenido)
    else
      malas += 1
      print "FALLO " + que + ": " + intToString(obtenido) + ", se esperaba " + intToString(esperado)
    endif
  end mira

  // 1. un if de una línea, el último de un if
  function ifEnIf(a: integer): integer
    var r: integer := 0
    if a > 0 then
      r := 1
      if a > 5 then r := 2
    endif
    return r
  end ifEnIf

  // 2. un while de una línea, el último de un while: a llega a 2, a 4 y a 6
  function whileEnWhile(): integer
    var a: integer := 0
    var n: integer := 0
    while n < 3 do
      n += 1
      while a < n * 2 do a += 1
    endwh
    return a
  end whileEnWhile

  // 3. un for de una línea, el último de un for: 1 + (1 + 2) + (1 + 2 + 3)
  function forEnFor(): integer
    var s: integer := 0
    for i := 1 to 3 do
      for j := 1 to i do s += j
    next
    return s
  end forEnFor

  // 4. lo mismo con el nombre en el next de fuera: (1 + 2) + (2 + 4)
  function forEnForConNombre(): integer
    var s: integer := 0
    for i := 1 to 2 do
      for j := 1 to 2 do s += i * j
    next i
    return s
  end forEnForConNombre

  // 5. dos if de una línea, uno dentro de otro, los últimos de un if
  function dosEnIf(a: integer, b: integer): integer
    var r: integer := 0
    if a > 0 then
      r := 1
      if b > 0 then if b > 5 then r := 3
    endif
    return r
  end dosEnIf

  // 6. de clases distintas (esto ya compilaba): un for de una línea, el último de un if (1 + 2 + 3 + 4); y un if de una
  //    línea, el último de un while (100 una vez)
  function mezclados(): integer
    var s: integer := 0
    var k: integer := 0
    if s == 0 then
      for i := 1 to 4 do s += i
    endif
    while k < 3 do
      k += 1
      if k == 2 then s += 100
    endwh
    return s
  end mezclados

  // 7. y la forma de una línea en medio del bloque, con más detrás (también compilaba): 1 + 11 + 1
  function enMedio(): integer
    var s: integer := 0
    for i := 1 to 3 do
      if i == 2 then s += 10
      s += 1
    next
    return s
  end enMedio

  function Main()
    mira("1, un if de una línea, el último de un if (a = 7)", ifEnIf(7), 2)
    mira("1, el mismo, sin entrar en el de dentro (a = 3)", ifEnIf(3), 1)
    mira("2, un while de una línea, el último de un while", whileEnWhile(), 6)
    mira("3, un for de una línea, el último de un for", forEnFor(), 10)
    mira("4, lo mismo, con el nombre en el next de fuera", forEnForConNombre(), 9)
    mira("5, dos if de una línea, uno dentro de otro, los últimos de un if", dosEnIf(1, 7), 3)
    mira("5, el mismo, sin entrar en el más de dentro", dosEnIf(1, 2), 1)
    mira("6, de clases distintas", mezclados(), 110)
    mira("7, en medio del bloque", enMedio(), 13)
    print "UnaLineaAlFinal: " + intToString(malas) + " mal"
  end Main
end UnaLineaAlFinal
