// MutexBucle.bp — V8 #811 (8-nov): un builtin que recibe una referencia (8 bytes en la pila) tiene que sacar los 8. La
// VM-Java sacaba el Mutex de Core.__mutexLock y __mutexUnlock con 4: leía de casualidad la mitad buena y dejaba la otra
// en la pila, 4 bytes por llamada, y un bucle en el mismo método la desbordaba (a las ~2 000 vueltas, con 16 KB). Los dos
// son públicos: un programa llega. La VM-C, bien. Es la clase de #324 y del clic de la GUI (#811): el censo de los
// builtins que reciben referencias encontró, además de los tres de la GUI, estos dos y __prompt (sólo de la VM-Java).
module MutexBucle

  function Main()
    var m: Mutex := Mutex()
    var i: integer := 0
    while i < 20000 do
      Core.__mutexLock(m)
      Core.__mutexUnlock(m)
      i := i + 1
    endwh
    print "vueltas: " + i
    m.lock()
    m.unlock()
    print "y el Mutex sigue bien"
    print "fin"
  end Main
end MutexBucle
