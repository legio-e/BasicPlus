// CadenasUnHilo.bp — V7/H12, la 3.2 (test-cola 17): UN hilo que concatena —cada «+» reserva, y el GC colecta una y
// otra vez— con dos runs. Las colectas no tienen que despertar al run ocioso, que espera trabajo y no al mundo: sus
// vueltas sin hilo, unas pocas. Con el sabotaje (el mundo avisa también a la cola, como antes), tantas como colectas.
module CadenasUnHilo

  function cadenas(n: integer, vueltas: integer): integer
    var total: integer := 0
    var r: integer := 0
    while r < vueltas do
      var s: string := ""
      var i: integer := 0
      while i < n do
        s := s + "x"
        i := i + 1
      endwh
      total := total + charCodeAt(s, n - 1)
      r := r + 1
    endwh
    return total
  end cadenas

  function Main()
    print "resultado = " + cadenas(1000, 16)
  end Main

end CadenasUnHilo
