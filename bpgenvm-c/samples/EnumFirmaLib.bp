// #516 (18-sep) — un enum en las FIRMAS de la interfaz: en el ctor CABEZA (antes la clase entera
// desaparecia de la interfaz) y en una sobrecarga delante de m(integer) (antes se omitia esa firma
// y el consumidor llamaba al metodo equivocado en silencio, #514). Lo importa EnumFirma.
module EnumFirmaLib
  import Core
  public enum Color
    ROJO
    VERDE
    AZUL
  end Color
  public class Base
    var c: Color
    var n: integer
    public function Base(c: Color)
      this.c := c
      this.n := 0
    end Base
    public function Base()
      this.c := Color.AZUL
      this.n := 7
    end Base
    public function m(c: Color): integer
      if c == Color.ROJO then
        return 100
      endif
      return 200
    end m
    public function m(v: integer): integer
      return v + 1
    end m
    public function cual(): Color
      return this.c
    end cual
    public function esRojo(): boolean
      return this.c == Color.ROJO
    end esRojo
    public function num(): integer
      return this.n
    end num
  end Base
  public function pinta(c: Color): string
    if c == Color.ROJO then
      return "rojo"
    endif
    if c == Color.VERDE then
      return "verde"
    endif
    return "azul"
  end pinta
end EnumFirmaLib
