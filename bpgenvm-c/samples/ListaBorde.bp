// ListaBorde.bp — V8/H8 (#795, 5-nov): get, set y remove miran el tamaño de la lista, no la capacidad del array de dentro. En una
// lista de 2, con capacidad 4, `l.get(3)` daba null y `l.set(3, x)` escribía en una casilla que nadie veía; `l.remove(9)` quitaba el
// último. También por `l[i]`, por las hijas y por los captadores tipados.
// mod8: fuera — #748 es de MOD9: en MOD8, una cadena en un Object no se imprime (lo de V7)
module ListaBorde
  import Collections

  function prueba(l: List, i: integer)
    try
      print "get", i, ":", l.get(i)
    catch e: Exception
      print e.msg
    endtry
  end prueba

  function main()
    var l: List := List()
    l.add("a")
    l.add("b")
    prueba(l, 0)
    prueba(l, 1)
    prueba(l, 2)
    prueba(l, 3)
    prueba(l, 9)
    prueba(l, -1)

    try
      l.set(2, "fuera")
      print "set(2) sin error"
    catch e: Exception
      print e.msg
    endtry
    print "sigue con", l.length()

    try
      l.remove(9)
      print "remove(9) sin error"
    catch e: Exception
      print e.msg
    endtry
    print "sigue con", l.length(), l.get(1)

    l.remove(0)
    print "tras quitar uno:", l.length(), l.get(0)
    prueba(l, 1)

    try
      print l[3]
    catch e: Exception
      print "por índice:", e.msg
    endtry
    try
      l[3] := "x"
    catch e: Exception
      print "al escribir:", e.msg
    endtry
    try
      print l.getString(5)
    catch e: Exception
      print "tipado:", e.msg
    endtry

    var vacia: List := List()
    prueba(vacia, 0)

    var s: SyncList := SyncList()
    s.add("x")
    try
      print s.get(1)
    catch e: Exception
      print "SyncList:", e.msg
    endtry
    print "y su cerrojo, suelto:", s.length()
    try
      s.remove(4)
    catch e: Exception
      print "SyncList:", e.msg
    endtry
    print "también al quitar:", s.length()

    var m: Collections.Map := Collections.Map()
    m.put("a", Integer(1))
    try
      print m.keyAt(5)
    catch e: Exception
      print "Map:", e.msg
    endtry
    try
      print m.valueAt(5)
    catch e: Exception
      print "Map:", e.msg
    endtry
    print "y el suyo:", m.size(), m.keyAt(0)

    // un `for` que acorta la lista: `get` da su error
    var c: List := List()
    c.add(1)
    c.add(2)
    c.add(3)
    try
      for x in c do
        print "vuelta:", x
        c.remove(0)
      next
    catch e: Exception
      print "al acortarla:", e.msg
    endtry
  end main
end ListaBorde
