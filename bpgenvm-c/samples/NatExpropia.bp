// NatExpropia.bp — V7/H5 P2b.1.d: una native en un bucle que SÓLO termina si otro hilo corre y cambia
// una global. Sin la línea del bucle la native no cede nunca: el otro hilo no llega a correr y el programa
// se cuelga (la receta lo corta con un tope de tiempo). Con ella, la native cede cada rebanada, el otro hilo
// cambia la global y la native, al reanudarse, la vuelve a leer y sale. `make test-aotexpropia` corre el
// MISMO .mod con el AOT y sin él y exige la misma salida.
module NatExpropia
  import Core

  var parar: integer := 0

  public function pararYa()
    parar := 1
  end pararYa

  public class Otro extends Thread
    public function Otro()
      super(0)
    end Otro
    public function run()
      print "ok otro: dentro"
      pararYa()
    end run
  end Otro

  native function girar(): integer
    var vueltas: integer := 0
    while parar == 0 do
      vueltas += 1
    endwh
    return 1
  end girar

  function Main()
    var o: Otro := Otro()
    o.start()
    print "ok main: gira la native"
    var r: integer := girar()
    print "ok main: la native paro: " + intToString(r)
    o.join()
    print "ok fin"
  end Main
end NatExpropia
