// FicheroYaAbierto.bp — V7 #657 (7-oct): un builtin de fichero entero (writeFile, appendFile, readFile, removeFile,
// rename, copyFile) es un open y un close —Eduardo: «trabajamos siempre con handlers sobre ficheros, así que siempre ha
// de haber un open y un close»—, con la regla de File: un fichero abierto para escribir no se abre otra vez; para
// leer, los que quieran. Antes no miraban: en la SD, un writeFile a un fichero que un File tenia abierto para escribir
// corrompia el volumen. Las dos VMs, la misma salida (los textos de los errores, incluidos).
module FicheroYaAbierto
  import IO

  function Main()
    // 1. Abierto para ESCRIBIR: nadie mas lo abre, ni para leer.
    var f: IO.TextFile := IO.TextFile("fya_a.txt", "w")
    f.writeLine("uno")
    try
      writeFile("fya_a.txt", "otra cosa")
      print "no deberia llegar"
    catch e1: Core.Exception
      print e1.msg
    endtry
    try
      appendFile("fya_a.txt", "mas")
      print "no deberia llegar"
    catch e2: Core.Exception
      print e2.msg
    endtry
    try
      var t: string := readFile("fya_a.txt")
      print "no deberia llegar " + t
    catch e3: Core.Exception
      print e3.msg
    endtry
    try
      IO.removeFile("fya_a.txt")
      print "no deberia llegar"
    catch e4: Core.Exception
      print e4.msg
    endtry
    try
      IO.rename("fya_a.txt", "fya_b.txt")
      print "no deberia llegar"
    catch e5: Core.Exception
      print e5.msg
    endtry
    try
      IO.copyFile("fya_a.txt", "fya_b.txt")
      print "no deberia llegar"
    catch e6: Core.Exception
      print e6.msg
    endtry
    f.close()

    // 2. Cerrado: todo vale.
    writeFile("fya_a.txt", "dos")
    appendFile("fya_a.txt", " y tres")
    print "leido: " + readFile("fya_a.txt")

    // 3. Abierto para LEER: otros lectores si (readFile, copyFile desde el); escribirlo, no.
    var g: IO.TextFile := IO.TextFile("fya_a.txt", "r")
    print "otro lector: " + readFile("fya_a.txt")
    IO.copyFile("fya_a.txt", "fya_b.txt")
    print "copiado: " + readFile("fya_b.txt")
    try
      writeFile("fya_a.txt", "cuatro")
      print "no deberia llegar"
    catch e7: Core.Exception
      print e7.msg
    endtry
    try
      IO.removeFile("fya_a.txt")
      print "no deberia llegar"
    catch e8: Core.Exception
      print e8.msg
    endtry
    try
      IO.rename("fya_b.txt", "fya_a.txt")
      print "no deberia llegar"
    catch e9: Core.Exception
      print e9.msg
    endtry
    try
      IO.copyFile("fya_b.txt", "fya_a.txt")
      print "no deberia llegar"
    catch e10: Core.Exception
      print e10.msg
    endtry
    g.close()

    // 4. Todo cerrado otra vez: se renombra, se borra, y no queda nada.
    IO.rename("fya_b.txt", "fya_c.txt")
    print "renombrado: " + readFile("fya_c.txt")
    IO.removeFile("fya_a.txt")
    IO.removeFile("fya_c.txt")
    print "fin"
  end Main
end FicheroYaAbierto
