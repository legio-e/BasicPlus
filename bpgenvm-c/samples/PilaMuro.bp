// PilaMuro.bp — V7/H7 #605 (29-sep): el MURO de la pila. Eduardo: «excepción stack overflow, sí».
//
// Ninguna de las dos VMs miraba si un hilo se salía de su pila: con la de por defecto (2 KB), un hilo que recursaba
// unos 100 niveles pisaba en silencio la pila del hilo de al lado, y el error salía después, en el vecino y sin nada
// que ver («el receptor no es un objeto»), distinto en cada VM. Ahora cada función, al entrar, mira si le cabe lo
// suyo en SU pila; si no, RuntimeError «desbordamiento de pila», atrapable, en la misma instrucción en las dos VMs.
// Y la VM-C respeta el tamaño que pide Thread(stackSize) (#604), como miVM.
//
//   1. un hilo con la pila por defecto recursa 100 niveles: atrapa su desbordamiento, y el vecino sigue intacto;
//   2. uno que pide 8 KB, los mismos 100 niveles: le caben;
//   3. el main: 300 niveles le caben en sus 16 KB; 2000, no (atrapado).
// (Qué pasa si el hilo NO lo atrapa —¿se acaba el hilo o el programa?— es #608, pendiente de decidir.)
module PilaMuro

  public function hondo(n: integer): integer
    var a: integer := n
    var b: integer := n * 2
    var c: integer := n * 3
    if n == 0 then
      return 0
    endif
    return hondo(n - 1) + 1 + (a + b + c) * 0
  end hondo

  class Hondo extends Thread
    var prof: integer
    public property res: integer
    public property texto: string

    public function Hondo(pila: integer, prof: integer)
      super(pila)
      this.prof := prof
      this.res := -1
      this.texto := ""
    end Hondo

    public function run()
      try
        this.res := hondo(this.prof)
      catch e: RuntimeError
        this.texto := e.msg
      endtry
    end run
  end Hondo

  class Vecino extends Thread
    public property suma: integer

    public function Vecino()
      super(0)
      this.suma := 0
    end Vecino

    public function run()
      var i: integer := 0
      while i < 200 do
        this.suma := this.suma + 7
        yield()
        i := i + 1
      endwh
    end run
  end Vecino

  function main(arg: string)
    var h: Hondo := Hondo(0, 100)
    var v: Vecino := Vecino()
    h.start()
    v.start()
    h.join()
    v.join()
    print "1. pila por defecto: res ", h.res, ", atrapada: ", h.texto
    print "   el vecino: ", v.suma, " (esperado 1400)"

    var g: Hondo := Hondo(8192, 100)
    g.start()
    g.join()
    if g.texto == "" then
      print "2. con 8 KB: res ", g.res, ", sin excepción"
    else
      print "2. con 8 KB: atrapada: ", g.texto
    endif

    print "3. el main, 300 niveles: ", hondo(300)
    try
      var r: integer := hondo(2000)
      print "   el main, 2000 niveles: ", r
    catch e: RuntimeError
      print "   el main, 2000 niveles: atrapada: ", e.msg
    endtry
  end main

end PilaMuro
