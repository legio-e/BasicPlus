// StrNulo.bp — #512 (V7, 14-sep): un string o array SIN inicializar es una referencia
// nula, y las dos VMs tienen que tratarla IGUAL: longitud 0, concatena como "", se
// imprime como "", y un acceso por índice lanza (fuera de rango) — atrapable.
// #540 (24-sep): un LOCAL sin inicializar ya no vale null: es un error de compilación (su valor es
// indeterminado, Eduardo) y un string no admite `:= null`. El string nulo sale de un CAMPO sin
// inicializar —los objetos nacen a cero—, que es lo que este sample sigue comprobando.
// miVM moría aquí con «No space in heap» (leía memory[0] como longitud) y la VM-C
// imprimía vacío: paridad rota desde siempre, cazada por el oráculo de #492.
//
// V8 #774 (2-nov) — CAMBIA LA REGLA (Eduardo: «una cadena no puede ser null, eso se mantiene. Ahora una variable de
// tipo string si que debería poder no referenciar a ningun string»): un campo, una property o una variable de módulo
// string sin valor nace "" (y `== ""` da true: #773); el null se escribe (`:= null`), y una variable lo puede tener.
// Con él, como en C#: concatenar y escribir, como ""; `==`, null sólo es igual a null; lo que pide una cadena (len,
// charAt…), «referencia nula: <primitiva> de un string null», atrapable. Un array sin valor sigue siendo nulo (#512).
module StrNulo
  import Core

  public class Caja
    var etiqueta: string
    var datos: integer[]
    public function Caja()
    end Caja
    public function describe(): string
      return "[" + this.etiqueta + "]"
    end describe
    public function etiquetaDe(): string
      return this.etiqueta
    end etiquetaDe
    public function datosLen(): integer
      return len(this.datos)
    end datosLen
    public function primero(): integer
      return this.datos[0]
    end primero
  end Caja

  var nombre: string

  function nula(): string
    return null
  end nula

  public function main()
    var c: Caja := Caja()
    var v: string := c.etiquetaDe()
    print c.describe()
    print "campo sin valor: [" + v + "] len=" + len(v) + " == vacia: " + (v == "") + " == null: " + (v == null)
    print "global sin valor: [" + nombre + "] == vacia: " + (nombre == "")
    print "datos len=" + c.datosLen()
    try
      print c.primero()
      print "NO deberia llegar aqui"
    catch e: Exception
      print "indice sobre nulo: excepcion atrapada"
    endtry
    var s: string := nula()
    print "s=" + s + "|"
    print "concat de dos nulos=" + (s + s) + "|"
    print s
    print "null == null: " + (s == nula()) + "  null == vacia: " + (s == "") + "  null != vacia: " + (s != "")
    try
      print "len=" + len(s)
      print "NO deberia llegar aqui"
    catch e: RuntimeError
      print "len de null: " + e.msg
    endtry
    // #684 (11-oct): charAt de un string sin valor era charAt de "". Desde #774, el sin valor ya es "" (el índice,
    // fuera de rango), y el null, «referencia nula».
    try
      print "charAt=[" + charAt(s, 0) + "]"
      print "NO deberia llegar aqui"
    catch e: RuntimeError
      print "charAt de null: " + e.msg
    endtry
    try
      print "charAt vacio=[" + charAt(v, 0) + "]"
    catch e: RuntimeError
      print "charAt vacio: " + e.msg
    endtry
    s := "ya"
    print "s=" + s
    s := null
    print "s otra vez null: " + (s == null)
  end main

end StrNulo
