// SuperSinCtor.bp — #753 (1-nov): `super()` hacia un padre sin constructor —Object, el de toda clase sin padre escrito,
// o una clase sin constructor ni nada que inicializar— vale y no hace nada, como el implícito. Hasta hoy el análisis lo
// daba por bueno y el emisor fallaba («super(...): la clase base 'Object' no tiene constructor», sin línea), y no se
// escribía el .mod. Con argumentos, un error del análisis con su línea (samples/errores/CtorMal.bp, el caso 7).
module SuperSinCtor

  // el padre es Object; el campo con valor inicial se pone después del super(), como siempre
  class Raiz
    var n: integer := 7
    public function Raiz()
      super()
      print "Raiz: n =", this.n
    end Raiz
    public function leeN(): integer
      return this.n
    end leeN
  end Raiz

  // un padre de usuario sin constructor ni nada que inicializar
  class Vacia
    public function quien(): string
      return "Vacia"
    end quien
  end Vacia

  class Hija extends Vacia
    var m: integer := 3
    public function Hija()
      super()
      print "Hija: m =", this.m, "y", this.quien()
    end Hija
  end Hija

  // la nieta, sin super() escrito: el implícito llama al constructor de Hija
  class Nieta extends Hija
    public function Nieta()
      print "Nieta"
    end Nieta
  end Nieta

  function Main()
    var r: Raiz := Raiz()
    print "leeN:", r.leeN()
    var h: Hija := Hija()
    print "quien:", h.quien()
    var x: Nieta := Nieta()
    print "fin:", x.quien()
  end Main
end SuperSinCtor
