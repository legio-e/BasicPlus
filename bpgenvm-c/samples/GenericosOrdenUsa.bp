// GenericosOrdenUsa.bp — V8/H8 (#793): `<X>` entre módulos. El cast va aquí, en el que lee, y el tipo llega por la interfaz
// de GenericosOrden, que lo lleva en su `.mod`: la función, el Map, la clase con @element y lo que hereda.
// mod8: fuera — su dependencia, GenericosOrden, lleva interfaces de clase
module GenericosOrdenUsa
  import GenericosOrden
  import Collections

  class Propio extends GenericosOrden.Caja
    public function nada(): string
      return "propio"
    end nada
  end Propio

  function main()
    print GenericosOrden.sensores().get(1).valor()
    var l: List<GenericosOrden.Sensor> := GenericosOrden.sensores()
    for s in l do
      print "for:", s.valor()
    next
    print "suma:", GenericosOrden.suma(l)
    print "map:", GenericosOrden.porNombre().get("uno").valor()
    var b: GenericosOrden.Bolsa<GenericosOrden.Metro> := GenericosOrden.Bolsa()
    b.mete(GenericosOrden.Metro(4))
    print "bolsa:", b.saca(0).enCm()
    var p: Propio<GenericosOrden.Sensor> := Propio()
    p.guarda(GenericosOrden.Sensor(9))
    print p.nada(), p.ultimo.valor()
  end main
end GenericosOrdenUsa
