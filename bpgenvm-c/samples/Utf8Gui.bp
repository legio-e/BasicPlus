// Utf8Gui.bp — V8/H5 (23-oct, #711): el texto de la GUI, una FUENTE DE CONFIANZA (no se valida en marcha), con su test.
//
// Eduardo: «Si la fuente nos garantiza que el string está bien formado no hace falta verificar, es cierto pero es una
// relación de confianza, eso hay que verificarlo con algún test». En la VM-C, setText guarda el texto en un búfer de
// 1 KB, y lo recortaba por BYTES: una ñ justo en el límite quedaba partida, y getText la devolvía como cadena mal
// formada. Ahora se recorta por caracteres. Aquí, 1022 'a' y una ñ (1024 bytes): de vuelta, el texto tiene que ser
// UTF-8 válido (la VM-Java no recorta: también lo es). Sólo se imprime si es válido, para que las dos VMs digan lo
// mismo.
module Utf8Gui
  import Gui

  function Main()
    var scr: Gui.Screen := Gui.Screen()
    var ta: Gui.Textarea := Gui.Textarea(scr)
    var sb: StringBuilder := StringBuilder()
    var i: integer := 0
    while i < 1022 do
      sb.appendChar(97)
      i += 1
    endwh
    sb.appendStr("ñ")
    ta.text := sb.toString()
    var t: string := ta.text
    try
      if fromBytes(toBytes(t)) == t then
        print "ok Utf8Gui: el texto de vuelta es UTF-8 válido"
      else
        print "FALLO Utf8Gui: el texto de vuelta cambió al descodificarlo"
      endif
    catch e: EncodingError
      print "FALLO Utf8Gui: " + e.msg
    endtry
  end Main
end Utf8Gui
