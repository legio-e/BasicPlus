// InvocaRanura.bp — V7 #664 (7-oct): `Gui.__guiInvokeBySlot` llama a un metodo por su RANURA DENTRO del builtin
// (anidado). La VM-Java corria UN cuanto (1024 instrucciones, #531) y cortaba el resto en silencio; y leia la vtable
// a pelo: un metodo heredado de otro modulo, o una ranura de mas, saltaban a basura. La VM-C sigue hasta que el
// metodo vuelve, sube por los padres e ignora lo que no resuelve. Con DOS workers (la pasada de la red), el hilo que
// reserva sin parar para el mundo en mitad de la llamada: hay que aparcarse y seguir, no abandonarla.
module InvocaRanura
  import Gui
  import InvocaRanuraBase

  public class Hija extends InvocaRanuraBase.Base   // publica: en MOD8 la ranura por nombre sale de los marcadores, que exporta solo una clase publica
    var suma: integer

    public function Hija()
      super()
      this.suma := 0
    end Hija

    // Largo a proposito: cientos de cuantos.
    public function largo(quien: Object)
      var a: integer := 0
      var i: integer := 0
      while i < 20000 do
        a := (a * 31 + i) mod 1000003
        i := i + 1
      endwh
      this.suma := this.suma + a
    end largo

    public function total(): integer
      return this.suma
    end total
  end Hija

  class Reservador extends Thread
    var parar: boolean

    public function Reservador()
      super(8192)
      this.parar := false
    end Reservador

    public function pedirParada()
      this.parar := true
    end pedirParada

    public function run()
      while not this.parar do
        var s: string := ""
        var i: integer := 0
        while i < 50 do
          s := s + "x"
          i := i + 1
        endwh
      endwh
    end run
  end Reservador

  function Main()
    var h: Hija := Hija()
    var r: Reservador := Reservador()
    r.start()
    var k: integer := 0
    while k < 4 do
      Gui.__guiInvokeBySlot(h, Gui.__guiSlotOf(h, "largo"), h)
      k := k + 1
    endwh
    r.pedirParada()
    r.join()
    print "largo, cuatro veces: suma = " + h.total()
    Gui.__guiInvokeBySlot(h, Gui.__guiSlotOf(h, "heredado"), h)
    Gui.__guiInvokeBySlot(h, 999, h)                               // una ranura que no existe: se ignora
    Gui.__guiInvokeBySlot(h, Gui.__guiSlotOf(h, "noExiste"), h)    // -1: se ignora
    print "fin"
  end Main
end InvocaRanura
