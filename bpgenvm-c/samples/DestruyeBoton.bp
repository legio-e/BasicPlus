// DestruyeBoton.bp — V8 #695 (29-oct): un Button que muere por su dueño se da de baja de su pantalla y se borra del
// modelo de la GUI. Un Button es un CONTENEDOR (su texto es un Label hijo), y al destruirlo los hijos van primero: en su
// destructor, su lista de hijos ya es nula. Su delete() la leía y lanzaba «referencia nula» antes de borrar el nodo del
// botón (lo dejaba en el log: «el destructor de Gui.Button lanzó»), y el botón se quedaba en la lista de la pantalla,
// como una referencia muerta, y en el árbol. Antes, en las dos VMs: «fuera: 2» y el botón en el árbol.
module DestruyeBoton
  import Gui

  // El botón vive lo que dura la función: su `var owner` lo destruye al volver.
  function temporal(scr: Gui.Screen)
    var owner b: Gui.Button := Gui.Button(scr, "temporal")
    print "dentro: ", scr.childCount()
  end temporal

  function Main()
    var scr: Gui.Screen := Gui.Screen()
    var fija: Gui.Label := Gui.Label(scr, "fija")
    temporal(scr)
    print "fuera: ", scr.childCount()
    print Gui.__guiDumpTree()
  end Main
end DestruyeBoton
