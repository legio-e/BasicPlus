// #511/#515 (19-sep) — desde otro modulo: el ctor public se construye; el protegido solo desde
// una subclase (super(...)); el private ni eso (VisLib.Cuenta.especial() lo usa por dentro). Y los
// inicializadores del padre corren en el super, incluida la clase sin constructor (sintetico).
module VisUsa
  import Core
  import VisLib
  public class Ahorro extends VisLib.Cuenta
    var interes: integer := 3
    public function Ahorro(inicial: integer)
      super(inicial)
    end Ahorro
    public function resumen(): string
      return this.texto() + " +" + this.interes
    end resumen
  end Ahorro
  function main()
    print VisLib.Cuenta().texto()
    print Ahorro(50).resumen()
    print VisLib.Cuenta().especial().texto()
    print VisLib.Sencilla().valor()
    print "fin"
  end main
end VisUsa
