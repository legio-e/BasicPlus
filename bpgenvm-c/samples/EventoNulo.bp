// EventoNulo.bp — V8 #771 (3-nov): «¿tiene suscriptor?» —`onClick != null` y `onClick == null`, dentro de la clase del
// evento o de una hija, como `raise`—, como en C# (`if (Click != null)`). Antes, `onClick != null` pasaba el semántico y
// el emisor se paraba con un mensaje interno; cualquier otro uso de un evento como valor sigue siendo un error
// (samples/errores/EventoValor.bp). El receptor del evento, comparado con null: sin suscribir, null; tras
// `b.onClick := o::clic`, no; tras `b.onClick := null`, null otra vez. Las dos VMs, lo mismo (y check-jc, en JC).
module EventoNulo
  import Core

  public class Boton
    event onClick(veces: integer)
    public function Boton()
    end Boton
    public function tieneSuscriptor(): boolean
      return onClick != null
    end tieneSuscriptor
    public function sinSuscriptor(): boolean
      return this.onClick == null
    end sinSuscriptor
    public function pulsa()
      if null != onClick then
        raise onClick(1)
      endif
    end pulsa
  end Boton

  public class BotonGrande extends Boton
    public function BotonGrande()
    end BotonGrande
    public function heredado(): boolean
      return onClick != null
    end heredado
  end BotonGrande

  public class Oyente
    public property clics: integer
    public function Oyente()
      this.clics := 0
    end Oyente
    function event clic(veces: integer)
      this.clics := this.clics + veces
    end clic
  end Oyente

  public function main()
    var b: Boton := Boton()
    var o: Oyente := Oyente()
    print "sin suscribir: tiene=" + b.tieneSuscriptor() + " sin=" + b.sinSuscriptor()
    b.pulsa()
    b.onClick := o::clic
    print "suscrito: tiene=" + b.tieneSuscriptor() + " sin=" + b.sinSuscriptor()
    b.pulsa()
    sleep(20)
    print "clics: " + o.clics
    b.onClick := null
    print "desuscrito: tiene=" + b.tieneSuscriptor() + " sin=" + b.sinSuscriptor()
    var g: BotonGrande := BotonGrande()
    print "la hija, sin suscribir: " + g.heredado()
    g.onClick := o::clic
    print "la hija, suscrita: " + g.heredado()
  end main
end EventoNulo
