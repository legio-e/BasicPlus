// StrCursor.bp — V8/H5 (21-oct): el CURSOR del lento no cambia ningún resultado.
//
// Una cadena con caracteres especiales va por el lento: los índices son caracteres y hay que contar. La VM-C guarda en
// cada hilo un cursor con los dos contadores —la última cadena del lento, un carácter y el byte donde empieza, y
// cuántos caracteres tiene— y la llamada siguiente sobre la misma cadena sigue desde ahí, hacia delante o hacia atrás.
// La VM-Java cuenta siempre desde el principio: hace de oráculo en la paridad. Aquí se recorren cadenas con ñ, é (2
// bytes), € y ✓ (3 bytes) con todos los patrones de acceso: hacia delante, hacia atrás, a saltos, al azar, fuera de
// rango, desde el final, dos cadenas a la vez, buscar y cortar, tras un `move` que cambia dónde empiezan los
// caracteres, tras un gc(), con handles reciclados, con literales y con dos hilos a la vez. Cada respuesta se compara
// además con la de un oráculo escrito aquí, que decodifica el UTF-8 en BP sobre los bytes (byteAt: sin charAt ni el
// cursor). Se comprueba ella misma, y va en el corpus de la paridad.
module StrCursor
  import Core

  var hechas: integer := 0
  var malas: integer := 0
  var nada: string          // sin valor: es ""

  // un byte de la cadena, sin contar caracteres (ALOAD_U8); public: lo usa la clase
  public function byteAt(s: string, i: integer): integer
    inline ALOAD_U8
  end byteAt

  // El oráculo: los caracteres de una cadena bien formada, decodificando sus bytes en BP.
  class Oraculo
    public property n: integer
    var cps: integer[]
    var offs: integer[]
    var s: string

    public function Oraculo(s: string)
      this.s := s
      var nb: integer := __bytesDe(s)
      this.cps := newIntArray(nb + 1)
      this.offs := newIntArray(nb + 1)
      var cuantos: integer := 0
      var i: integer := 0
      while i < nb do
        var b: integer := byteAt(s, i)
        var cp: integer := b
        var largo: integer := 1
        if b >= 240 then
          cp := b - 240
          largo := 4
        elseif b >= 224 then
          cp := b - 224
          largo := 3
        elseif b >= 192 then
          cp := b - 192
          largo := 2
        endif
        var k: integer := 1
        while k < largo do
          cp := cp * 64 + (byteAt(s, i + k) - 128)
          k += 1
        endwh
        this.cps[cuantos] := cp
        this.offs[cuantos] := i
        cuantos += 1
        i += largo
      endwh
      this.offs[cuantos] := nb
      this.n := cuantos
    end Oraculo

    // charCodeAt según el oráculo: fuera de rango, 0
    public function codigo(i: integer): integer
      if i >= 0 and i < this.n then
        return this.cps[i]
      endif
      return 0
    end codigo

    // substring según el oráculo: los bytes de [desde, hasta), recortado como BP
    public function trozo(desde: integer, hasta: integer): string
      var d: integer := desde
      var h: integer := hasta
      if d < 0 then
        d := 0
      endif
      if h < 0 then
        h := 0
      endif
      if h > this.n then
        h := this.n
      endif
      if d > h then
        d := h
      endif
      var b0: integer := this.offs[d]
      var b1: integer := this.offs[h]
      var bs: byte[] := newByteArray(b1 - b0)
      var k: integer := 0
      while k < b1 - b0 do
        bs[k] := byte(byteAt(this.s, b0 + k))
        k += 1
      endwh
      return fromBytes(bs)
    end trozo
  end Oraculo

  function mira(que: string, como: string, i: integer, obtenido: integer, esperado: integer)
    hechas += 1
    if obtenido != esperado then
      malas += 1
      if malas <= 30 then
        print "  MAL " + que + ", " + como + " " + i + ": " + obtenido + " (esperado " + esperado + ")"
      endif
    endif
  end mira

  function miraCad(que: string, como: string, i: integer, obtenido: string, esperado: string)
    hechas += 1
    if obtenido != esperado then
      malas += 1
      if malas <= 30 then
        print "  MAL " + que + ", " + como + " " + i + ": [" + obtenido + "] (esperado [" + esperado + "])"
      endif
    endif
  end miraCad

  // charAt fuera de rango: el error, con el texto de siempre
  function fuera(que: string, s: string, i: integer, n: integer)
    try
      var c: string := charAt(s, i)
      mira(que, "charAt fuera no lanza", i, 1, 0)
    catch e: RuntimeError
      miraCad(que, "charAt fuera", i, e.msg, "charAt: idx fuera de rango " + i + " (len=" + n + ")")
    endtry
  end fuera

  // m caracteres de 1, 2 y 3 bytes, según la semilla
  function hazCadena(m: integer, semilla: integer): string
    var sb: StringBuilder := StringBuilder()
    var x: integer := semilla
    var i: integer := 0
    while i < m do
      x := (x * 75 + 74) mod 65537
      var r: integer := x mod 10
      if r < 5 then
        sb.appendChar(97 + (x mod 26))
      elseif r < 7 then
        sb.appendChar(241)
      elseif r < 8 then
        sb.appendChar(233)
      elseif r < 9 then
        sb.appendChar(8364)
      else
        sb.appendChar(10003)
      endif
      i += 1
    endwh
    return sb.toString()
  end hazCadena

  // ─── los patrones de acceso ───

  function adelante(s: string, o: Oraculo, que: string)
    var i: integer := 0
    while i < o.n do
      mira(que, "adelante", i, charCodeAt(s, i), o.codigo(i))
      if i mod 37 == 0 then
        mira(que, "strlen", i, strlen(s), o.n)
      endif
      i += 1
    endwh
  end adelante

  function atras(s: string, o: Oraculo, que: string)
    var i: integer := o.n - 1
    while i >= 0 do
      mira(que, "atrás", i, charCodeAt(s, i), o.codigo(i))
      i -= 1
    endwh
  end atras

  function aSaltos(s: string, o: Oraculo, que: string, salto: integer)
    var desde: integer := 0
    while desde < salto do
      var i: integer := desde
      while i < o.n do
        mira(que, "a saltos", i, charCodeAt(s, i), o.codigo(i))
        i += salto
      endwh
      desde += 1
    endwh
  end aSaltos

  // índices al azar, también fuera de rango: ahí, charAt y su error (charCodeAt fuera de rango no se pregunta: da 0 en
  // la VM-C y un error en la VM-Java, #717)
  function alAzar(s: string, o: Oraculo, que: string, veces: integer, semilla: integer)
    var x: integer := semilla
    var k: integer := 0
    while k < veces do
      x := (x * 75 + 74) mod 65537
      var i: integer := (x mod (o.n + 6)) - 3
      if i >= 0 and i < o.n then
        mira(que, "al azar", i, charCodeAt(s, i), o.codigo(i))
        if k mod 5 == 0 then
          miraCad(que, "charAt al azar", i, charAt(s, i), o.trozo(i, i + 1))
        endif
      else
        fuera(que, s, i, o.n)
      endif
      k += 1
    endwh
  end alAzar

  // substring con los dos extremos al azar (fuera de rango y al revés incluidos)
  function trozosAlAzar(s: string, o: Oraculo, que: string, veces: integer, semilla: integer)
    var x: integer := semilla
    var k: integer := 0
    while k < veces do
      x := (x * 75 + 74) mod 65537
      var d: integer := (x mod (o.n + 8)) - 4
      x := (x * 75 + 74) mod 65537
      var h: integer := (x mod (o.n + 8)) - 4
      if k mod 3 == 0 then
        h := d + (x mod 7)                     // trozos cortos, cerca del cursor
      endif
      miraCad(que, "substring " + d, h, substring(s, d, h), o.trozo(d, h))
      k += 1
    endwh
  end trozosAlAzar

  // con strlen primero, el final es un punto conocido: se camina hacia atrás desde él
  function desdeElFinal(s: string, o: Oraculo, que: string)
    mira(que, "strlen", 0, strlen(s), o.n)
    var i: integer := o.n - 1
    while i >= 0 and i >= o.n - 40 do
      mira(que, "desde el final", i, charCodeAt(s, i), o.codigo(i))
      i -= 1
    endwh
    fuera(que, s, o.n, o.n)
    fuera(que, s, o.n + 5, o.n)
  end desdeElFinal

  // dos cadenas a la vez: el cursor salta de una a otra en cada llamada
  function dosALaVez(a: string, oa: Oraculo, b: string, ob: Oraculo, que: string)
    var i: integer := 0
    while i < oa.n or i < ob.n do
      if i < oa.n then
        mira(que, "a", i, charCodeAt(a, i), oa.codigo(i))
      endif
      if i < ob.n then
        mira(que, "b", i, charCodeAt(b, i), ob.codigo(i))
      endif
      i += 1
    endwh
  end dosALaVez

  // buscar y cortar: trozos "ñandú-<k>€✓é;"; la aguja "-<k>€" está una sola vez y su carácter se sabe al construir
  function buscarYCortar()
    var cuantos: integer := 60
    var sb: StringBuilder := StringBuilder()
    var pos: integer[] := newIntArray(cuantos)
    var car: integer := 0
    var k: integer := 0
    while k < cuantos do
      pos[k] := car + 5
      var num: string := intToString(k)
      sb.appendStr("ñandú-" + num + "€✓é;")
      car += 6 + strlen(num) + 4
      k += 1
    endwh
    var s: string := sb.toString()
    var o: Oraculo := Oraculo(s)
    mira("buscar", "strlen", 0, strlen(s), car)
    var vuelta: integer := 0
    var x: integer := 3
    while vuelta < 3 do
      k := 0
      while k < cuantos do
        var j: integer := k                      // en orden
        if vuelta == 1 then
          j := cuantos - 1 - k                    // al revés
        elseif vuelta == 2 then
          x := (x * 75 + 74) mod 65537
          j := x mod cuantos                      // al azar
        endif
        var num: string := intToString(j)
        var aguja: string := "-" + num + "€"
        var largo: integer := strlen(num) + 2
        var i: integer := indexOf(s, aguja)
        mira("buscar", "indexOf", j, i, pos[j])
        miraCad("buscar", "lo encontrado", j, substring(s, i, i + largo), aguja)
        miraCad("buscar", "lo de antes", j, substring(s, 0, i), o.trozo(0, i))
        miraCad("buscar", "lo de después", j, substring(s, i + largo, o.n), o.trozo(i + largo, o.n))
        mira("buscar", "el de después", j, charCodeAt(s, i + largo), o.codigo(i + largo))
        if j mod 4 == 0 then
          mira("buscar", "un carácter lejos", j, charCodeAt(s, o.n - 1 - i), o.codigo(o.n - 1 - i))
          mira("buscar", "otra vez", j, indexOf(s, aguja), pos[j])
        endif
        k += 1
      endwh
      vuelta += 1
    endwh
    mira("buscar", "no está", 0, indexOf(s, "-999€"), -1)
    mira("buscar", "vacía", 0, indexOf(s, ""), 0)
    mira("buscar", "el último", 0, indexOf(s, "-" + (cuantos - 1) + "€✓é;"), pos[cuantos - 1])
    mira("buscar", "strlen", 0, strlen(s), o.n)                                // el final, punto conocido
    mira("buscar", "cerca del final", 0, indexOf(s, "-" + (cuantos - 2) + "€"), pos[cuantos - 2])
  end buscarYCortar

  // `move` escribe dentro de una cadena: cambia dónde empiezan sus caracteres. Lo que el cursor sabía ya no vale.
  function conMove()
    var m: string := fromBytes(toBytes("ñabcdé"))
    var o: Oraculo := Oraculo(m)
    miraCad("move", "antes", 5, charAt(m, 5), o.trozo(5, 6))          // el cursor, en la é
    move(toBytes("xy"), m, 0, 0, 2)                                     // "xyabcdé": un carácter más
    o := Oraculo(m)
    miraCad("move", "después", 5, charAt(m, 5), o.trozo(5, 6))        // la d, no la é
    mira("move", "strlen", 0, strlen(m), o.n)
    mira("move", "charCodeAt", 6, charCodeAt(m, 6), o.codigo(6))
    mira("move", "charCodeAt", 4, charCodeAt(m, 4), o.codigo(4))       // el cursor, en la c
    move(toBytes("ñ"), m, 0, 2, 2)                                      // "xyñcdé": dos bytes que son uno
    o := Oraculo(m)
    mira("move", "charCodeAt otra vez", 4, charCodeAt(m, 4), o.codigo(4))
    mira("move", "strlen otra vez", 0, strlen(m), o.n)
    miraCad("move", "substring", 2, substring(m, 2, 5), o.trozo(2, 5))
    // un move en OTRA cadena también invalida el cursor (la época es de la VM): sólo cuesta tiempo
    var s: string := hazCadena(60, 5)
    var os: Oraculo := Oraculo(s)
    mira("move", "otra cadena antes", 30, charCodeAt(s, 30), os.codigo(30))
    var b: byte[] := newByteArray(4)
    move(toBytes("abcd"), b, 0, 0, 4)
    mira("move", "otra cadena después", 31, charCodeAt(s, 31), os.codigo(31))
    adelante(m, o, "move")
  end conMove

  // gc(): la compactación puede mover la cadena; el cursor guarda posiciones, no direcciones
  function conGc()
    var s: string := hazCadena(400, 7)
    var o: Oraculo := Oraculo(s)
    mira("gc", "antes", 200, charCodeAt(s, 200), o.codigo(200))
    var basura: string := ""
    var k: integer := 0
    while k < 300 do
      basura := hazCadena(20, k) + intToString(k)
      k += 1
    endwh
    gc()
    mira("gc", "después", 201, charCodeAt(s, 201), o.codigo(201))
    mira("gc", "después", 199, charCodeAt(s, 199), o.codigo(199))
    miraCad("gc", "substring", 200, substring(s, 200, 230), o.trozo(200, 230))
    gc()
    atras(s, o, "gc")
  end conGc

  // handles reciclados: la cadena muere y la siguiente ocupa SU número (con otra generación). Entre una y otra no se
  // reserva ni se suelta nada más: el gc() sólo suelta esa, y la lista de libres (una pila) se la da a la siguiente. Cada
  // una tiene los caracteres especiales en otro sitio: un cursor de la anterior daría otra respuesta.
  function reciclados()
    var b0: byte[] := toBytes("ññññññññññabcdefghij")
    var b1: byte[] := toBytes("abcdefghijéééééééééé")
    var b2: byte[] := toBytes("a€b€c€d€e€f€g€h€i€j€")
    var o0: Oraculo := Oraculo(fromBytes(b0))
    var o1: Oraculo := Oraculo(fromBytes(b1))
    var o2: Oraculo := Oraculo(fromBytes(b2))
    var t: string := ""
    var o: Oraculo := o0
    gc()
    var k: integer := 0
    while k < 30 do
      var r: integer := k mod 3
      if r == 0 then
        t := fromBytes(b0)
        o := o0
      elseif r == 1 then
        t := fromBytes(b1)
        o := o1
      else
        t := fromBytes(b2)
        o := o2
      endif
      mira("reciclados", "charCodeAt", 10, charCodeAt(t, 10), o.codigo(10))
      mira("reciclados", "charCodeAt", 11, charCodeAt(t, 11), o.codigo(11))
      mira("reciclados", "charCodeAt", 3, charCodeAt(t, 3), o.codigo(3))
      t := ""
      gc()
      k += 1
    endwh
    // y con substring y charAt, que reservan (su resultado también muere en cada vuelta)
    k := 0
    while k < 30 do
      var r: integer := k mod 3
      if r == 0 then
        t := fromBytes(b0)
        o := o0
      elseif r == 1 then
        t := fromBytes(b1)
        o := o1
      else
        t := fromBytes(b2)
        o := o2
      endif
      miraCad("reciclados", "substring", 5, substring(t, 5, 15), o.trozo(5, 15))
      miraCad("reciclados", "charAt", 12, charAt(t, 12), o.trozo(12, 13))
      t := ""
      gc()
      k += 1
    endwh
  end reciclados

  // los literales no tienen etiqueta: su clave es su dirección
  function literales()
    var a: string := "pingüino, cigüeña y ñandú: 5€ ✓"
    var b: string := "€uro ✓ añil"
    var oa: Oraculo := Oraculo(a)
    var ob: Oraculo := Oraculo(b)
    adelante(a, oa, "literal")
    atras(a, oa, "literal")
    dosALaVez(a, oa, b, ob, "literales")
    alAzar(a, oa, "literal", 80, 9)
    trozosAlAzar(b, ob, "literal", 40, 10)
    mira("literal", "directo", 3, charCodeAt("añil€", 3), 108)
    mira("literal", "directo", 4, charCodeAt("añil€", 4), 8364)
    mira("literal", "directo", 1, charCodeAt("añil€", 1), 241)
    miraCad("literal", "directo", 1, substring("añil€", 1, 4), "ñil")
  end literales

  // los bordes: un carácter, todo especiales, el especial al final, y la cadena sin valor
  function bordes()
    var uno: string := fromBytes(toBytes("€"))
    var ou: Oraculo := Oraculo(uno)
    adelante(uno, ou, "uno")
    fuera("uno", uno, 1, 1)
    fuera("uno", uno, -1, 1)
    miraCad("uno", "substring", 0, substring(uno, 0, 1), "€")
    miraCad("uno", "substring", 1, substring(uno, 1, 1), "")
    var todo: string := fromBytes(toBytes("ñññññ€€€€€"))
    var ot: Oraculo := Oraculo(todo)
    adelante(todo, ot, "todo")
    atras(todo, ot, "todo")
    alAzar(todo, ot, "todo", 60, 13)
    trozosAlAzar(todo, ot, "todo", 60, 14)
    var fin: string := fromBytes(toBytes("abcdé"))
    var of: Oraculo := Oraculo(fin)
    mira("fin", "charCodeAt", 4, charCodeAt(fin, 4), 233)
    fuera("fin", fin, -1, 5)
    miraCad("fin", "substring", 4, substring(fin, 4, 5), "é")
    miraCad("fin", "substring", 5, substring(fin, 5, 9), "")
    miraCad("fin", "substring", 3, substring(fin, 3, 99), "dé")
    miraCad("fin", "substring", 9, substring(fin, 9, 2), "")
    fuera("fin", fin, 5, 5)
    desdeElFinal(fin, of, "fin")
    mira("nada", "strlen", 0, strlen(nada), 0)
    miraCad("nada", "substring", 0, substring(nada, 0, 3), "")
    fuera("nada", nada, 0, 0)
  end bordes

  // dos hilos a la vez, cada uno con su cadena y su cursor
  class Recorre extends Thread
    var s: string
    var o: Oraculo
    public property hechas: integer
    public property malas: integer

    public function Recorre(s: string)
      super(0)
      this.s := s
      this.o := Oraculo(s)
      this.hechas := 0
      this.malas := 0
    end Recorre

    public function run()
      var vuelta: integer := 0
      while vuelta < 3 do
        var i: integer := 0
        while i < this.o.n do
          this.hechas := this.hechas + 1
          if charCodeAt(this.s, i) != this.o.codigo(i) then
            this.malas := this.malas + 1
          endif
          i += 1
        endwh
        i := this.o.n - 1
        while i >= 0 do
          this.hechas := this.hechas + 1
          if charCodeAt(this.s, i) != this.o.codigo(i) then
            this.malas := this.malas + 1
          endif
          i -= 1
        endwh
        vuelta += 1
      endwh
    end run
  end Recorre

  function hilos()
    var h1: Recorre := Recorre(hazCadena(300, 21))
    var h2: Recorre := Recorre(hazCadena(300, 22))
    h1.start()
    h2.start()
    var s: string := hazCadena(300, 23)
    var o: Oraculo := Oraculo(s)
    adelante(s, o, "main con hilos")
    atras(s, o, "main con hilos")
    h1.join()
    h2.join()
    hechas += h1.hechas + h2.hechas
    malas += h1.malas + h2.malas
    print "hilos: " + (h1.hechas + h2.hechas) + " comprobaciones en los dos, " + (h1.malas + h2.malas) + " malas"
  end hilos

  function seccion(que: string, h0: integer, m0: integer)
    print que + ": " + (hechas - h0) + " comprobaciones, " + (malas - m0) + " malas"
  end seccion

  function Main()
    var h0: integer := 0
    var m0: integer := 0
    var s: string := hazCadena(500, 1)
    var o: Oraculo := Oraculo(s)
    print "la cadena: " + o.n + " caracteres, " + __bytesDe(s) + " bytes"
    adelante(s, o, "s")
    atras(s, o, "s")
    aSaltos(s, o, "s", 7)
    aSaltos(s, o, "s", 61)
    alAzar(s, o, "s", 400, 2)
    trozosAlAzar(s, o, "s", 300, 3)
    desdeElFinal(s, o, "s")
    seccion("una cadena", h0, m0)

    h0 := hechas
    m0 := malas
    var b: string := hazCadena(350, 4)
    var ob: Oraculo := Oraculo(b)
    dosALaVez(s, o, b, ob, "dos")
    seccion("dos a la vez", h0, m0)

    h0 := hechas
    m0 := malas
    buscarYCortar()
    seccion("buscar y cortar", h0, m0)

    h0 := hechas
    m0 := malas
    conMove()
    seccion("move", h0, m0)

    h0 := hechas
    m0 := malas
    conGc()
    seccion("gc", h0, m0)

    h0 := hechas
    m0 := malas
    reciclados()
    seccion("handles reciclados", h0, m0)

    h0 := hechas
    m0 := malas
    literales()
    seccion("literales", h0, m0)

    h0 := hechas
    m0 := malas
    bordes()
    seccion("bordes", h0, m0)

    hilos()

    print "cursor: " + hechas + " comprobaciones, " + malas + " malas"
  end Main
end StrCursor
