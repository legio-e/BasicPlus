// AirWifi.bp — V8/H3 (6-nov): el módulo Air, en el PC: encender y apagar la WiFi. En el PC, turnOn() da siempre true, porque el
// PC ya tiene red, y lo mismo en las dos VMs. En una placa lo mismo, con su /sys/wifi.json. (El Bluetooth, que el 6-nov
// decía que no, desde el 8-nov tiene su prueba: AirBluetooth.bp, el del PC, simulado.)
module AirWifi
  import Air

  public function main()
    var wifi: Air.Wifi := Air.Wifi()
    print "disponible: " + wifi.isAvailable()
    print "antes de encender: " + wifi.isConnected()
    print "turnOn: " + wifi.turnOn()
    print "encendida: " + wifi.isConnected()
    print "otra vez turnOn: " + wifi.turnOn()
    wifi.turnOff()
    print "apagada: " + wifi.isConnected()
    wifi.turnOff()
    print "apagar lo apagado: " + wifi.isConnected()
    print "y volver a encender: " + wifi.turnOn()
    print "fin"
  end main
end AirWifi
