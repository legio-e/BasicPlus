// ListaHer.bp — ¿la sobrecarga que DELEGA llega a las subclases?
//
// Eduardo: «el list ya esta y las otras listas heredan de list». Cierto para
// OwnerList (solo declara removeAndFree). SyncList NO hereda: redeclara las
// cinco, y no por capricho — las suyas llevan el LOCK, asi que heredar el add
// de List le daria la version sin candado.
//
// La pregunta que decide cuanto trabajo es: si `add(i:integer)` delega con
// `this.add(o)` y esa llamada es VIRTUAL, la subclase solo necesita su propio
// `add(Object)` —que SyncList ya tiene— y las sobrecargas le llegan gratis.
//
// Aqui se fuerza el caso: `Sub` reescribe SOLO add(Object) y se llama a
// `add(5)`, que es la sobrecarga heredada de la base. Si el marcador dice
// «Sub», la delegacion despacha por vtable y la respuesta es que SI.
module ListaHer

  import Collections

  public class Base
    var marca: string
    var ultimo: integer
    public function Base()
      this.marca  := "(sin llamar)"
      this.ultimo := -1
    end Base

    // La que la subclase reescribira.
    public function add(o: Object)
      this.marca := "Base"
      var i: Collections.Integer := Collections.Integer(o)
      this.ultimo := i.value()
    end add

    // La sobrecarga: envuelve y DELEGA. Esta no se reescribe.
    public function add(i: integer)
      this.add(Collections.Integer(i))
    end add

    // Los campos son PROTEGIDOS por defecto (modelo de #390), asi que se leen
    // por metodo — que es ademas lo que manda la convencion de BP.
    public function verMarca(): string
      return this.marca
    end verMarca
    public function verUltimo(): integer
      return this.ultimo
    end verUltimo
  end Base

  public class Sub extends Base
    public function Sub()
      super()
    end Sub
    // Solo reescribe la de Object — como SyncList, que solo necesita la suya
    // con lock.
    public function add(o: Object)
      this.marca := "Sub"
      var i: Collections.Integer := Collections.Integer(o)
      this.ultimo := i.value() * 10
    end add
  end Sub

  function Main()
    var b: Base := Base()
    b.add(7)
    print "base: marca=" + b.verMarca() + " ultimo=" + b.verUltimo()

    var s: Sub := Sub()
    s.add(7)                       // la SOBRECARGA heredada, que delega
    print "sub : marca=" + s.verMarca() + " ultimo=" + s.verUltimo()

    // Y por referencia a la base, que es como lo usaria un programa real
    var p: Base := Sub()
    p.add(7)
    print "poli: marca=" + p.verMarca() + " ultimo=" + p.verUltimo()
    print "fin"
  end Main

end ListaHer
