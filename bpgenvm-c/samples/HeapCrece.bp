// HeapCrece.bp — #787 (V8, 4-nov): el heap crece de objetos vivos, colecta tras colecta. El mapa de cabeceras del GC de la
// VM-C se pide una vez, para todo el heap: pedirlo mayor en cada colecta acababa en la Metro en «heap descarrilado», con
// memoria de sobra pero no de una pieza. La prueba, test/test_heapdescarrilado.c: tras la primera colecta, la siguiente
// reserva del mapa falla; si alguna colecta la pide, el programa no llega a sumar. En miVM no hay mapa que pedir.
module HeapCrece

  public class Caja
    public property valor: integer
    public property datos: integer[]
    public property siguiente: Caja
    public function Caja(v: integer, s: Caja)
      this.valor := v
      this.siguiente := s
      this.datos := newIntArray(300)
    end Caja
  end Caja

  function Main()
    var c: Caja := null
    var i: integer := 0
    while i < 100 do
      c := Caja(i, c)
      i := i + 1
    endwh
    var suma: integer := 0
    while c != null do
      suma := suma + c.valor
      c := c.siguiente
    endwh
    print "suma", suma
    print "fin"
  end Main
end HeapCrece
