// V7/H2 (#492-B) — oráculo de paridad: los miembros ESTÁTICOS de una clase cruzan el módulo.
// La mitad DUEÑA: método estático (y sobrecargado, y protegido, y que devuelve la clase),
// property estática (integer y long; pública y protegida) y una const estática.
// El consumidor es EstaticosHijo.bp. Pareja de CamposBase/CamposHijo.
module EstaticosBase
  public class Base
    var n: integer := 0
    public const Base.MAX: integer := 3
    public property Base.total: integer := 0
    public property Base.grande: long := 0L
    property Base.prot: integer := 0
    public function Base()
      this.n := 1
    end Base
    public function Base.cuantos(): integer
      return 7
    end Base.cuantos
    public function Base.cuantos(v: integer): integer
      return v * 10
    end Base.cuantos
    public function Base.crea(): Base
      return Base()
    end Base.crea
    function Base.protegido(): integer
      Base.prot += 1
      return 40 + Base.prot
    end Base.protegido
    public function valor(): integer
      return this.n
    end valor
    // Revisión del 14-sep: la CABEZA de la cadena es private y no viaja; el consumidor
    // debe llamar a `f(v)` por su firma, no por su posición (antes: llamaba a la privada)
    private function Base.f(): integer
      return -1
    end Base.f
    public function Base.f(v: integer): integer
      return v * 3
    end Base.f
  end Base

  // Revisión del 14-sep: `A_b.c` y `A.b_c` daban el MISMO nombre de alias con el separador '_'
  public class A_b
    public function A_b()
    end A_b
    public function A_b.c(): integer
      return 1
    end A_b.c
    public function m(): integer
      return 10
    end m
  end A_b
  public class A
    public function A()
    end A
    public function A.b_c(): integer
      return 2
    end A.b_c
    public function m(): integer
      return 20
    end m
  end A
end EstaticosBase
