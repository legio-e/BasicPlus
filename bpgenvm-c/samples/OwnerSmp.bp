// OwnerSmp.bp — V7/H7 #603 (29-sep): dos hilos que crean y sueltan objetos con dueño a la vez.
//
// Soltar un `var owner` al salir de su función es un FREE_REF: el bloque vuelve a la lista de
// libres del heap. En la VM-C eso se hacía SIN el cerrojo de la VM, mientras el alocador de otro
// worker recorría la misma lista bajo el cerrojo: con `--smp=2` (la segunda pasada del corpus,
// `check-smp`) el heap se rompía 10 de cada 10 veces —«heap descarrilado», «use-after-free»,
// «strCopy: dst no es ref a heap»—. Con un worker, y en miVM con dos, bien.
//
// Cada vuelta de `uno` crea dos Caja con dueño (y una cadena cada una) y las suelta al volver:
// `uno(i)` vale 2*i+1, así que cada hilo acumula exactamente `n`.
module OwnerSmp

  class Caja
    var v: integer
    var s: string

    public function Caja(v: integer)
      this.v := v
      this.s := "caja " + intToString(v)
    end Caja

    public function valor(): integer
      return this.v
    end valor
  end Caja

  public function uno(i: integer): integer
    var owner c: Caja := Caja(i)
    var owner d: Caja := Caja(i + 1)
    return c.valor() + d.valor()
  end uno

  class Trabajo extends Thread
    var vueltas: integer
    public property suma: integer

    public function Trabajo(vueltas: integer)
      super(0)
      this.vueltas := vueltas
      this.suma := 0
    end Trabajo

    public function run()
      var i: integer := 0
      var t: integer := 0
      while i < this.vueltas do
        t := t + uno(i) - 2 * i
        i := i + 1
      endwh
      this.suma := t
    end run
  end Trabajo

  function main(arg: string)
    var n: integer := 2000
    if len(arg) > 0 then
      n := parseInt(arg)
    endif
    var a: Trabajo := Trabajo(n)
    var b: Trabajo := Trabajo(n)
    a.start()
    b.start()
    a.join()
    b.join()
    print "a: ", a.suma, " b: ", b.suma, " (esperado ", n, " y ", n, ")"
  end main

end OwnerSmp
