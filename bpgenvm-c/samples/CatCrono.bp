// CatCrono.bp — #554 (V7/H7, 27-sep): lo que cuesta concatenar cadenas, con dos patrones. El bucle que va alargando una
// cadena (`s := s + trozo`, 192 veces hasta casi 2 KB: el caso de `#554`, unos 10 ms por concatenación en la Metro y la
// C5) y una cadena de `+` en una sola expresión (`a + b + c + d + i`, que desde `#554` se hace de una vez: una reserva y
// una copia en bloque por operando). Las líneas «tiempo» cambian en cada pasada (la tanda las ignora); las longitudes, no.
module CatCrono
  import Core
  import Machine

  function Main()
    var trozo: string := "0123456789"
    var s: string := ""
    var i: integer := 0
    var t0: integer := Machine.uptimeMs()
    while i < 192 do
      s := s + trozo
      i += 1
    endwh
    var ms1: integer := Machine.uptimeMs() - t0
    print "ok bucle: " + intToString(strlen(s)) + " bytes"
    print "  tiempo: bucle " + intToString(ms1) + " ms las 192"
    var a: string := "uno "
    var b: string := "dos "
    var c: string := "tres "
    var d: string := "cuatro "
    var total: integer := 0
    i := 0
    t0 := Machine.uptimeMs()
    while i < 500 do
      var r: string := a + b + c + d + i
      total += strlen(r)
      i += 1
    endwh
    var ms2: integer := Machine.uptimeMs() - t0
    print "ok cadena: " + intToString(total) + " bytes en total"
    print "  tiempo: cadena " + intToString(ms2) + " ms las 500"
  end Main
end CatCrono
