// ProtegidoHija.bp — #760 (1-nov): lo protegido de A, usado desde la familia sobre OTRO objeto. Desde B (hija de A),
// sobre un C (hija de B): el campo, la property y el método de A son de B, y un C es un B (hasta hoy, «'campo' es
// protegido de 'C'»); y A, su propio campo sobre un C, que tampoco se podía. Por `super`, sobre `this`. Lo que no vale
// —sobre un objeto que es sólo un A, o desde fuera de la familia—, en samples/errores/ProtegidoMal.bp.
module ProtegidoHija
  class A
    var campo: integer := 1
    property prop: integer
    public function A()
      this.prop := 20
    end A
    function metodo(): integer
      return 300
    end metodo
    public function propioEnHija(c: C): integer
      return c.campo
    end propioEnHija
  end A

  class B extends A
    public function B()
      super()
    end B
    public function enHija(c: C): integer
      return c.campo + c.prop + c.metodo()
    end enHija
    public function porSuper(): integer
      return super.metodo() + this.campo
    end porSuper
  end B

  class C extends B
    public function C()
      super()
      this.campo := 5
    end C
  end C

  function Main()
    var c: C := C()
    print "A, su campo en un C:", A().propioEnHija(c)
    print "B, lo de A en un C:", B().enHija(c)
    print "B, por super:", B().porSuper()
  end Main
end ProtegidoHija
