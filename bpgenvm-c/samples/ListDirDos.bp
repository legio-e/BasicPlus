// ListDirDos.bp — V7/H12, etapa 2b (5-oct, la revisión): DOS HILOS LISTAN UNA CARPETA A LA VEZ. listDir usa la zona
// de rascar compartida, y la tiene mientras reserva los nombres; con dos runs, el del otro hilo la encontraba ocupada y
// lanzaba «la zona de rascar está ocupada»: un error en un programa correcto. Ahora espera a que se suelte (sin
// estorbar al GC). test/test_cola.c, la parte 12, con su sabotaje. Determinista: «listados: 400 fallos: 0».
module ListDirDos
  import IO

  class Lista extends Thread
    var veces: integer
    var hechos: integer
    var fallos: integer
    public function Lista(n: integer)
      super(8192)
      this.veces := n
      this.hechos := 0
      this.fallos := 0
    end Lista
    public function run()
      var i: integer := 0
      while i < this.veces do
        try
          var l: string[] := listDir("ld2b")
          if len(l) != 3 then
            this.fallos := this.fallos + 1
          endif
        catch e: RuntimeError
          this.fallos := this.fallos + 1
        endtry
        this.hechos := this.hechos + 1
        i := i + 1
      endwh
    end run
    public function total(): integer
      return this.hechos
    end total
    public function malos(): integer
      return this.fallos
    end malos
  end Lista

  function Main()
    IO.mkdir("ld2b")
    writeFile("ld2b/uno.txt", "1")
    writeFile("ld2b/dos.txt", "2")
    writeFile("ld2b/tres.txt", "3")
    var a: Lista := Lista(200)
    var b: Lista := Lista(200)
    a.start()
    b.start()
    a.join()
    b.join()
    print "listados: " + (a.total() + b.total()) + " fallos: " + (a.malos() + b.malos())
    IO.removeFile("ld2b/uno.txt")
    IO.removeFile("ld2b/dos.txt")
    IO.removeFile("ld2b/tres.txt")
    IO.rmdir("ld2b")
  end Main
end ListDirDos
