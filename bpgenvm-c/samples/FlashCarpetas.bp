// FlashCarpetas.bp — V8 #816 (13-nov): la flash tiene /sys, /lib, /app y /data, en las placas (al montar y al
// formatear su FS, fs_lfs_*.c), en el micro simulado y en el PC (las dos VMs, al arrancar). /data es nueva: la de los
// datos de los programas, como el ProgramData de Windows (idea de Eduardo), cada uno en su carpeta (/data/<proyecto>), y
// el IDE no la toca. Antes, en la flash del PC no estaba ninguna, y escribir en "/sys/x" iba en la placa y en el PC
// fallaba. La red le da a cada ejecución una flash nueva y vacía: si falta alguna, este programa acaba con un error, y la
// red lo da en ROJO por el código de salida.
//
// Salida esperada (las dos VMs, y la placa):
//   /sys: true
//   /lib: true
//   /app: true
//   /data: true
//   leido en /sys: hola desde /sys
//   leido en /data: lecturas de FlashCarpetas
//   fin
module FlashCarpetas
  import Core
  import IO

  function Main()
    print "/sys: " + boolToString(IO.isDirectory("/sys"))
    print "/lib: " + boolToString(IO.isDirectory("/lib"))
    print "/app: " + boolToString(IO.isDirectory("/app"))
    print "/data: " + boolToString(IO.isDirectory("/data"))

    writeFile("/sys/flash_carpetas.txt", "hola desde /sys")
    print "leido en /sys: " + readFile("/sys/flash_carpetas.txt")
    IO.removeFile("/sys/flash_carpetas.txt")

    // los datos de un programa, en su carpeta de /data
    if not IO.isDirectory("/data/FlashCarpetas") then
      IO.mkdir("/data/FlashCarpetas")
    endif
    writeFile("/data/FlashCarpetas/lecturas.txt", "lecturas de FlashCarpetas")
    print "leido en /data: " + readFile("/data/FlashCarpetas/lecturas.txt")
    IO.removeFile("/data/FlashCarpetas/lecturas.txt")
    IO.rmdir("/data/FlashCarpetas")
    print "fin"
  end Main
end FlashCarpetas
