// ImportHondo.bp — #649 (4-oct): el cargador resuelve los imports SIN recursión. discover_deps se llamaba a sí
// misma por cada nivel de import, con ~1,7 KB de marco (las rutas en la pila): en la placa, la tarea del REPL llegaba
// a ~12 KB de pila cargando TimeDemo, y una cadena de 16 módulos (el tope, BPVM_MAX_MODULES) pedía ~27 KB.
// Aquí, la cadena más honda que cabe: este módulo, Eslabon01 → … → Eslabon13, y Core (15 de 16).
// En la red: en la paridad (las dos VMs, la misma salida) y en `make test-importhondo` (la VM-C con --pila: la carga
// y el RUN en un hilo con la pila acotada, como en placa; con la recursión, caía).
module ImportHondo
  import Eslabon01

  function Main()
    print "cadena de 13 imports: la suma de 1 a 13 es " + Eslabon01.valor()
    print "fin"
  end Main
end ImportHondo
