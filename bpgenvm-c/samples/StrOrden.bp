// StrOrden.bp — V8/H5 (#713, 21-oct): <, <=, >, >=, == y != entre cadenas comparan el TEXTO.
//
// Hasta hoy `a < b` entre dos cadenas compilaba al `<` de enteros: sacaba 4 bytes de la pila donde cada referencia
// ocupa 8, y daba basura en silencio, distinta en cada VM (#713). Eduardo: comparar de verdad, y en C. Ahora los
// cuatro relacionales llaman a __strCompare (un memcmp por bytes: en UTF-8, el orden de los caracteres; null es "") y
// == compara el contenido con él (con sus reglas: null sólo es igual a null). Aquí cada operador, sobre pares de
// cadenas casi iguales con caracteres de 1 a 4 bytes, literales y del heap, vacías y sin valor, contra una referencia
// que compara carácter a carácter con charCodeAt (la Str.compare de antes). Y la línea que #713 rompía, y un `switch`
// de cadenas (también va por ==). Se comprueba ella misma, y va en el corpus de la paridad.
module StrOrden
  import Core

  var hechas: integer := 0
  var malas: integer := 0
  var nada: string          // sin valor: es "" para ordenar, y sólo es igual a otra sin valor
  var otraNada: string
  var x: integer := 13

  // la referencia: carácter a carácter (charCodeAt), null como ""
  function compareRef(a: string, b: string): integer
    var la: integer := strlen(a)
    var lb: integer := strlen(b)
    var n: integer := la
    if lb < n then
      n := lb
    endif
    var i: integer := 0
    while i < n do
      var ca: integer := charCodeAt(a, i)
      var cb: integer := charCodeAt(b, i)
      if ca < cb then
        return -1
      endif
      if ca > cb then
        return 1
      endif
      i := i + 1
    endwh
    if la < lb then
      return -1
    endif
    if la > lb then
      return 1
    endif
    return 0
  end compareRef

  function b2i(v: boolean): integer
    if v then
      return 1
    endif
    return 0
  end b2i

  function mira(que: string, obtenido: boolean, esperado: boolean, a: string, b: string)
    hechas += 1
    if obtenido != esperado then
      malas += 1
      if malas <= 20 then
        print "  MAL " + que + " con [" + a + "] y [" + b + "]: " + boolToString(obtenido)
      endif
    endif
  end mira

  // los seis operadores sobre (a, b); `iguales` es lo que == tiene que dar (las reglas de null van aparte)
  function seis(a: string, b: string, iguales: boolean)
    var c: integer := compareRef(a, b)
    mira("<", a < b, c < 0, a, b)
    mira("<=", a <= b, c <= 0, a, b)
    mira(">", a > b, c > 0, a, b)
    mira(">=", a >= b, c >= 0, a, b)
    mira("==", a == b, iguales, a, b)
    mira("!=", a != b, not iguales, a, b)
  end seis

  function azar(m: integer): integer
    x := (x * 75 + 74) mod 65537
    return x mod m
  end azar

  function unCaracter(): integer
    var r: integer := azar(16)
    if r == 0 then
      return 127
    elseif r == 1 then
      return 128
    elseif r == 2 then
      return 2047
    elseif r == 3 then
      return 2048
    elseif r == 4 then
      return 65533
    elseif r == 5 then
      return 65535
    elseif r == 6 then
      return 65536
    elseif r == 7 then
      return 128512
    elseif r == 8 then
      return 241
    elseif r == 9 then
      return 233
    elseif r == 10 then
      return 8364
    elseif r == 11 then
      return 10003
    endif
    return 97 + azar(4)
  end unCaracter

  function dia(s: string): integer
    switch s
      case "lunes"
        return 1
      case "martes"
        return 2
      case "miércoles"
        return 3
      default
        return 0
    endsw
  end dia

  function Main()
    // la línea que #713 rompía: el texto de delante se perdía y los operandos se mezclaban
    var a0: string := "abc"
    var b0: string := "abd"
    print "a < b: " + boolToString(a0 < b0) + ", a > b: " + boolToString(a0 > b0) + ", a <= a: " + boolToString(a0 <= a0)

    // al azar: pares casi iguales (cambia uno, se corta, crece o nada)
    var k: integer := 0
    while k < 1200 do
      var n: integer := 1 + azar(7)
      var cs: integer[] := newIntArray(n)
      var i: integer := 0
      while i < n do
        cs[i] := unCaracter()
        i += 1
      endwh
      var sa: StringBuilder := StringBuilder()
      var sb: StringBuilder := StringBuilder()
      var donde: integer := azar(n)
      var como: integer := azar(4)
      i := 0
      while i < n do
        sa.appendChar(cs[i])
        if i == donde and como == 0 then
          sb.appendChar(unCaracter())
        elseif i == donde and como == 1 then
          i := n
        else
          sb.appendChar(cs[i])
        endif
        if i < n then
          i += 1
        endif
      endwh
      if como == 2 then
        sb.appendChar(unCaracter())
      endif
      var a: string := sa.toString()
      var b: string := sb.toString()
      seis(a, b, compareRef(a, b) == 0)
      seis(b, a, compareRef(a, b) == 0)
      k += 1
    endwh
    print "al azar: " + hechas + " comprobaciones, " + malas + " malas"

    // los bordes, literales y del heap
    var h0: integer := hechas
    var lits: string[] := ["", "a", "ab", "b", "ñ", "añ", "aña", "€", "a€", "😀", "ñ😀", "z", "Z", "aB", "ab "]
    var p: integer := 0
    while p < len(lits) do
      var q: integer := 0
      while q < len(lits) do
        seis(lits[p], lits[q], p == q)
        seis(fromBytes(toBytes(lits[p])), lits[q], p == q)                         // heap contra literal
        seis(fromBytes(toBytes(lits[p])), fromBytes(toBytes(lits[q])), p == q)     // heap contra heap
        q += 1
      endwh
      // sin valor: para ordenar es "", y == sólo la da igual a otra sin valor
      seis(nada, lits[p], false)
      seis(lits[p], nada, false)
      p += 1
    endwh
    seis(nada, otraNada, true)
    print "bordes: " + (hechas - h0) + " comprobaciones"

    // un switch de cadenas va por ==
    print "switch: " + dia("lunes") + dia("martes") + dia("miércoles") + dia("jueves") + dia("") + dia(nada)
    print "orden: " + hechas + " comprobaciones, " + malas + " malas"
  end Main
end StrOrden
