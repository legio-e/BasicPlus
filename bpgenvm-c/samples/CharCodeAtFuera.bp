// CharCodeAtFuera.bp — V8 (23-oct, #717): charCodeAt FUERA DE RANGO LANZA, como charAt, en las dos VMs.
//
// Antes, la VM-C devolvía 0 en silencio, y la VM-Java lanzaba con otro texto. Ahora, las dos, el de charAt:
// «charCodeAt: idx fuera de rango 9 (len=4)». Por los dos caminos de las cadenas (ASCII y con acentos) y con la cadena
// vacía; y dentro de rango, como siempre. Una línea FALLO pone la red en rojo aunque las dos VMs coincidan.
module CharCodeAtFuera

  var malas: integer := 0

  function mira(que: string, obtenido: string, esperado: string)
    if obtenido == esperado then
      print "ok " + que + ": " + obtenido
    else
      malas += 1
      print "FALLO " + que + ": [" + obtenido + "], se esperaba [" + esperado + "]"
    endif
  end mira

  function prueba(s: string, i: integer, esperado: string)
    try
      mira("charCodeAt('" + s + "', " + intToString(i) + ")", intToString(charCodeAt(s, i)), esperado)
    catch e: RuntimeError
      mira("charCodeAt('" + s + "', " + intToString(i) + ")", e.msg, esperado)
    endtry
  end prueba

  function Main()
    var ascii: string := fromBytes(toBytes("hola"))
    var acentos: string := fromBytes(toBytes("añil"))
    prueba(ascii, 0, "104")
    prueba(ascii, 3, "97")
    prueba(ascii, 4, "charCodeAt: idx fuera de rango 4 (len=4)")
    prueba(ascii, 9, "charCodeAt: idx fuera de rango 9 (len=4)")
    prueba(ascii, -1, "charCodeAt: idx fuera de rango -1 (len=4)")
    prueba(acentos, 1, "241")
    prueba(acentos, 3, "108")
    prueba(acentos, 4, "charCodeAt: idx fuera de rango 4 (len=4)")
    prueba(acentos, -2, "charCodeAt: idx fuera de rango -2 (len=4)")
    prueba("", 0, "charCodeAt: idx fuera de rango 0 (len=0)")
    prueba("hola", 7, "charCodeAt: idx fuera de rango 7 (len=4)")   // un literal (no está en el heap)
    print "CharCodeAtFuera: " + intToString(malas) + " mal"
  end Main
end CharCodeAtFuera
