// FirmaLib.bp — #685 (11-oct): la biblioteca de FirmaUsa. Una función pública cuyo nombre exportado,
// libre(LFirmaLib/<clase de 63>;LFirmaLib/<clase de 63>;)i, tiene 156 caracteres: más de los 127 que el
// cargador de la VM-C copiaba —cortaba el resto en silencio, y la llamada desde otro módulo no enlazaba
// mientras miVM la ejecutaba— y menos del tope del lenguaje, 160.
module FirmaLib
  public class CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC
  end CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC

  public function libre(a: CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC, b: CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC): integer
    return 7
  end libre
end FirmaLib
