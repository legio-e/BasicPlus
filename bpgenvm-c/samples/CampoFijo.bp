// CampoFijo.bp — #680 (10-oct, del D1 de V7): un campo de tamaño fijo `tipo[N]` en una clase
// SIN constructor ni inicializadores. La longitud la escribe el __init de la clase, y una clase así
// no tenía ninguno: `len` daba 0 y el primer acceso, «índice fuera de rango», en las dos VMs.
// Aquí, los casos: sólo campos fijos; con un inicializador (el que ya iba); una subclase sin
// constructor de una clase así; una subclase con constructor propio; y una con su propio campo fijo.
module CampoFijo
  public class Caja
    private var datos: integer[4]
    public function poner(i: integer, v: integer)
      this.datos[i] := v
    end poner
    public function leer(i: integer): integer
      return this.datos[i]
    end leer
    public function largo(): integer
      return len(this.datos)
    end largo
  end Caja

  public class CajaConIni
    private var datos: byte[3]
    var n: integer := 5
    public function largo(): integer
      return len(this.datos) + this.n
    end largo
  end CajaConIni

  public class Hija extends Caja
  end Hija

  public class HijaConCtor extends Caja
    var nombre: string
    public function HijaConCtor(nombre: string)
      this.nombre := nombre
    end HijaConCtor
    public function quien(): string
      return this.nombre
    end quien
  end HijaConCtor

  public class Nieta extends Hija
    private var extra: long[2]
    public function sumaExtra(): long
      this.extra[0] := 40L
      this.extra[1] := 2L
      return this.extra[0] + this.extra[1]
    end sumaExtra
    public function largoExtra(): integer
      return len(this.extra)
    end largoExtra
  end Nieta

  function Main()
    var c: Caja := Caja()
    print "Caja:", c.largo()
    c.poner(1, 7)
    c.poner(3, 9)
    print "  leidos:", c.leer(0), c.leer(1), c.leer(3)

    var d: CajaConIni := CajaConIni()
    print "CajaConIni:", d.largo()

    var h: Hija := Hija()
    print "Hija:", h.largo()
    h.poner(2, 11)
    print "  leido:", h.leer(2)

    var k: HijaConCtor := HijaConCtor("k")
    print "HijaConCtor:", k.quien(), k.largo()
    k.poner(0, 5)
    print "  leido:", k.leer(0)

    var n: Nieta := Nieta()
    print "Nieta:", n.largo(), n.largoExtra(), n.sumaExtra()
    n.poner(3, 1)
    print "  leido:", n.leer(3)
    print "fin"
  end Main
end CampoFijo
