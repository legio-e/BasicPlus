// PrintSinSalto.bp — V8 #700 (18-oct): un `print` que acaba en `;` no salta de línea, como en el BASIC clásico.
// Sus piezas esperan en la línea del hilo (#600) y salen con el siguiente salto; las de un hilo que acaba sin
// él, tal cual, al acabar el hilo. Es el `print(a, b)` de JC (#698), que no salta solo: `print a; b;` en BP. Lo
// que no da: que un trozo salga en el momento (una instrucción de la VM, si un día hace falta; FICHAS #700).
// Lo que queda al acabar el PROGRAMA también sale tal cual, pero no está aquí: el aviso de fin de la VM se le pega
// detrás («…=== FIN DE LA EJECUCION»), en las dos VMs igual, y el arnés tira esa línea entera (medido a mano).
// Cada línea de la salida junta las piezas de varias sentencias. Lo que tiene que salir:
//   ab
//   123 4
//   12345
//   x yz
//   7 1.5 2.5 true
//   nativo 41 42
//   el hilo deja su trozo
//   fin
module PrintSinSalto

  class Trozo extends Thread
    public function Trozo()
      super(4096)
    end Trozo
    public function run()
      print "el hilo deja";
      print " su trozo";
    end run
  end Trozo

  // En el PC corre interpretada; el AOT la traduce a C con los mismos helpers (sin `print_nl`).
  native function trozoNativo(n: integer)
    print "nativo "; n;
    print " "; n + 1;
  end trozoNativo

  function main()
    print "a";
    print "b"
    print 1; 2;
    print 3, 4
    for i := 1 to 5 do
      print i;
    next i
    print ""
    print "x", "y";
    print "z"
    print 7L; " "; 1.5; " "; 2.5d; " "; true;
    print
    trozoNativo(41)
    print
    var t: Trozo := Trozo()
    t.start()
    t.join()
    print
    print "fin"
  end main
end PrintSinSalto
