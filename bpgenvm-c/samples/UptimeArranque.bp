// UptimeArranque.bp — V8 #827 (15-nov): Machine.uptimeMs() cuenta desde el arranque —en el PC, desde la primera vez que
// se pide—, en las dos VMs. La VM-Java daba los ms desde 1970 cortados a 32 bits, que salían negativos («-6d 0-10:0-26»
// en la prueba de resistencia); las restas salían bien, y por eso nadie lo veía. Se comprueba una RELACIÓN —el valor
// cambia en cada ejecución—: «ok» o «FALLO». Sólo en el PC: una placa cuenta desde su arranque, que puede ser de hace
// horas.
// V8 #834 (17-nov): y un sleep(n), medido con uptimeMs(), dura n ms o más, nunca menos. La VM-Java despertaba con el reloj
// de pared (a saltos de ~15,6 ms en Windows) y medía con el monótono: un sleep(100) daba 84–100 ms, una vez de cada 40,
// y un sleep(1), 0 ms unas pocas de cada cien. Ahora las dos VMs despiertan con el reloj de uptimeMs(). Lo que antes se
// quedaba corto lo hacía al azar: por eso muchas esperas, y las de 1 ms, las que más lo destapaban.
module UptimeArranque
  import Machine

  // `veces` esperas de `ms`, medidas con uptimeMs(): ninguna puede quedarse corta
  function esperas(ms: integer, veces: integer)
    var cortas: integer := 0
    var peor: integer := ms
    var a: integer := 0
    var d: integer := 0
    for i := 1 to veces do
      a := Machine.uptimeMs()
      sleep(ms)
      d := Machine.uptimeMs() - a
      if d < ms then
        cortas += 1
        if d < peor then peor := d
      endif
    next i
    if cortas == 0 then
      print "ok " + veces + " esperas de " + ms + " ms, ninguna corta"
    else
      print "FALLO " + cortas + " de " + veces + " esperas de " + ms + " ms, cortas; la peor, " + peor + " ms"
    endif
  end esperas

  function Main()
    var t0: integer := Machine.uptimeMs()
    sleep(100)
    var t1: integer := Machine.uptimeMs()
    if t0 >= 0 and t0 < 60000 then
      print "ok empieza cerca de 0"
    else
      print "FALLO empieza en " + t0
    endif
    if t1 - t0 >= 100 and t1 - t0 < 10000 then
      print "ok cuenta el tiempo"
    else
      print "FALLO en 100 ms conto " + (t1 - t0)
    endif
    esperas(20, 30)
    esperas(1, 60)
    print "fin"
  end Main
end UptimeArranque
