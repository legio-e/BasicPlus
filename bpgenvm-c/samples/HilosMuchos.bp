// HilosMuchos.bp — V7/H7 #604 (29-sep): cuántos hilos puede crear un programa en su vida, y cuántos a la vez.
//
// La VM-C no reutilizaba el hueco ni la pila de un hilo terminado: un programa sólo podía crear 32 hilos EN TODA SU
// VIDA, y el 32 moría con «Thread.start falló», un error que no se atrapa (miVM creaba los que hicieran falta). Un
// programa de días que lance un hilo por tarea moría así. Después (#604) las dos VMs reutilizaban los huecos, con un
// tope de 32 hilos VIVOS a la vez. Desde la etapa 2 de H12 (4-oct; Eduardo: «¿por qué tiene que haber un límite?»), sin
// tope: cada hilo es una struct que se pide al arrancarlo y se devuelve al acabar, y el límite lo pone la memoria —sin
// sitio para su pila, una RuntimeError atrapable, con el mismo texto en las dos—.
//
//   1. 40 hilos de uno en uno (start y join): los 40.
//   2. 40 hilos que esperan a la vez en un Mutex del main —más de los 32 de antes—; si start() dijera que no caben, la
//      excepción atrapada; luego el main suelta el Mutex, acaban todos y se unen.
//   3. otros 40 de uno en uno, sobre las pilas que dejaron los de antes.
module HilosMuchos

  class Tarea extends Thread
    var n: integer

    public function Tarea(n: integer)
      super(0)
      this.n := n
    end Tarea

    public function run()
      var s: integer := 0
      var i: integer := 0
      while i < 10 do
        s := s + i
        i := i + 1
      endwh
      if this.n mod 20 == 0 then
        print "  hilo ", this.n, " suma ", s
      endif
    end run
  end Tarea

  class Espera extends Thread
    var m: Mutex
    public property sig: Espera     // la lista de los que esperan, para unirlos después

    public function Espera(m: Mutex, sig: Espera)
      super(0)
      this.m := m
      this.sig := sig
    end Espera

    public function run()
      this.m.lock()
      this.m.unlock()
    end run
  end Espera

  function unoTrasOtro(desde: integer, cuantos: integer): integer
    var k: integer := 0
    while k < cuantos do
      var t: Thread := Tarea(desde + k)
      t.start()
      t.join()
      k := k + 1
    endwh
    return k
  end unoTrasOtro

  function main(arg: string)
    print "1. de uno en uno: ", unoTrasOtro(1, 40)

    var m: Mutex := Mutex()
    m.lock()
    var primero: Espera := null
    var n: integer := 0
    var lleno: boolean := false
    while n < 40 and not lleno do
      var e: Espera := Espera(m, primero)
      try
        e.start()
        primero := e
        n := n + 1
      catch x: RuntimeError
        print "2. arrancados ", n, "; el siguiente: ", x.msg
        lleno := true
      endtry
    endwh
    m.unlock()
    var j: integer := 0
    var cur: Espera := primero
    while cur != null do
      cur.join()
      j := j + 1
      cur := cur.sig
    endwh
    print "   unidos: ", j

    print "3. otra vez de uno en uno: ", unoTrasOtro(41, 40)
  end main

end HilosMuchos
