// EvReceptorMuerto.bp — #655 (7-oct): un hilo RESUCITADO para atender sus eventos (#342) cuyo primer evento ya no se
// puede inyectar. El hilo levanta dos eventos —el primero a un receptor que suelta él mismo (su campo owner, a null)
// antes de acabar; el segundo a uno vivo— y termina, todo en el mismo cuanto: los dos quedan pendientes. El
// planificador lo resucita para saldarlos; la inyección del primero no puede (un evento sin quien lo escuche se
// IGNORA)... y el hilo corría desde DETRÁS de su final: la VM-C se paraba con NATIVE_RETURN y la VM-Java con «HALT en
// thread no-main». Lo correcto: el primero, ignorado; el hilo vuelve a terminar por el camino de siempre, se le
// resucita otra vez para el segundo —que sí se atiende— y «fin».
module EvReceptorMuerto
  class Oyente
    var nombre: string
    public function Oyente(n: string)
      this.nombre := n
    end Oyente
    function event atender(n: integer)
      print "handler " + this.nombre + " " + n
    end atender
  end Oyente

  class Fuente extends Thread
    event aviso(n: integer)
    event otro(n: integer)
    var owner muere: Oyente
    var owner vive: Oyente

    public function Fuente()
      super(4096)
      this.muere := Oyente("muerto")
      this.vive := Oyente("vivo")
      this.aviso := this.muere::atender
      this.otro := this.vive::atender
    end Fuente

    public function run()
      raise aviso(7)
      raise otro(8)
      this.muere := null      // el primer receptor muere ANTES de que se drene su evento
    end run
  end Fuente

  function Main()
    var t: Fuente := Fuente()
    t.start()
    t.join()
    print "fin"
  end Main
end EvReceptorMuerto
