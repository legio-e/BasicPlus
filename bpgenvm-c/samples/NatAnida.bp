// NatAnida.bp — #571 (V7, 26-sep): una native que llama a BP, que llama a OTRA native, y DESPUÉS lanza.
// El límite de fallos (#186) era un jmp_buf por worker: la native interior lo pisaba con el suyo y, al
// volver, lo dejaba apuntando a su marco muerto; el throw de la exterior saltaba ahí y el PC moría en
// silencio (en placa, un cuelgue o un reinicio). `make test-aotanida` corre el MISMO .mod con el AOT y
// sin él y exige la misma salida.
module NatAnida
  import Core

  function puente(x: integer): integer
    return interior(x) + 1
  end puente

  native function interior(x: integer): integer
    return x * 2
  end interior

  native function exterior(s: string, i: integer): string
    var v: integer := puente(i)
    return charAt(s, v)
  end exterior

  function Main()
    try
      print "ok dentro: [" + exterior("abcdefghijklmnop", 3) + "]"
    catch e: RuntimeError
      print "ok dentro: atrapada: " + e.msg
    endtry
    try
      print "ok fuera: [" + exterior("abc", 5) + "]"
    catch e: RuntimeError
      print "ok fuera: atrapada: " + e.msg
    endtry
    print "ok fin"
  end Main
end NatAnida
