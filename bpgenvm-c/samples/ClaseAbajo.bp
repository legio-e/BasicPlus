// ClaseAbajo.bp — #751 (1-nov): un método construye una clase declarada MÁS ABAJO en el mismo módulo, le pregunta
// `instanceof`, la convierte y la atrapa en un catch. Hasta hoy el emisor reventaba con «Clase 'Abajo' no declarada
// para NEW_OBJECT», sin línea: el escritor del .mod sólo aplazaba el descriptor de la clase que estaba escribiendo
// (#447), y de una de más abajo no sabía nada. En C# el orden de las clases no importa (104 pruebas de Mono lo piden).
// Ahora el emisor le avisa de todas antes de escribir código: en MOD9 van por ref (su padre es de Core: abiertas), y en
// MOD8 su descriptor se parcha al cerrar el módulo. La llamada a un método suyo está en Main, detrás: en MOD8 un método
// de una clase de más abajo no se puede llamar desde arriba (su ranura no se sabe aún), y eso no es de #751.
module ClaseAbajo

  class Arriba
    public function prueba(): Abajo
      var a: Abajo := Abajo(5)
      var o: Object := a
      if o instanceof Abajo then
        print "es Abajo"
      else
        print "mal: no es Abajo"
      endif
      var b: Abajo := Abajo(o)
      try
        throw ErrorAbajo("de abajo")
      catch e: ErrorAbajo
        print "atrapado:", e.msg
      endtry
      return b
    end prueba
  end Arriba

  class Abajo
    var v: integer
    public function Abajo(v: integer)
      this.v := v
    end Abajo
    public function valor(): integer
      return this.v
    end valor
  end Abajo

  class ErrorAbajo extends RuntimeError
    public function ErrorAbajo(m: string)
      super(m)
    end ErrorAbajo
  end ErrorAbajo

  function Main()
    var b: Abajo := Arriba().prueba()
    print "valor", b.valor()
    var c: Object := Arriba()
    print "Arriba es Abajo:", c instanceof Abajo
  end Main
end ClaseAbajo
