# Defaults del proyecto (H4.3). `idf.py set-target esp32s3` fija el target.
#
# Consola/logs de ESP-IDF → USB-Serial-JTAG (puerto nativo). El wire v1
# (binario, lo usa el IDE) va por UART0 vía driver, así que el log de
# texto NO contamina el wire. Depuras con `idf.py monitor` en el nativo.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# La task de app_main ejecuta el REPL + la VM. Holgura de stack C.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Optimizar a tamaño.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# Task Watchdog OFF: esto es un dispositivo-VM que ejecuta código de
# usuario que puede ser CPU-bound y tardar legítimamente (>5s). La
# "inanición del idle" que vigila el task wdt NO es un bug aquí, así que
# lo desactivamos para no spamear backtraces (ni arriesgar reset) en
# programas pesados. El watchdog HW de arranque sigue activo.
CONFIG_ESP_TASK_WDT_INIT=n

# Tabla de particiones custom: añade "bpfs" (datos) para el FS persistente
# (H4.4). Los .mod subidos por el wire sobreviven al reset.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Flash de 16 MB (modulo S3 de referencia). Sin esto el build declara 2 MB y el
# bootloader NO ve mas alla: la tabla de particiones se queda en 2 MB y sobran
# ~15 MB sin mapear, aunque el INFO (que lee el chip por JEDEC) diga 16.
# OJO: sdkconfig es GENERADO — hay que borrarlo o `idf.py reconfigure` para que
# recoja esto (mismo gotcha que el MEMPROT del P4).
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# ─── V6 (5-sep-2026): UN SOLO NÚCLEO, POR ORDEN DE EDUARDO ────────────────────
#
# Este chip tiene dos núcleos y ESP-IDF los usa POR DEFECTO. Hasta hoy esta imagen
# corría con FreeRTOS en los dos **sin que nadie lo hubiera decidido** — y con `A1`
# eso dejó de ser inocuo: la tarea `vm` y el hilo `io` pueden solaparse de verdad
# sobre estado compartido que nunca se había auditado.
#
# Al mirarlo (5-sep) apareció la primera consecuencia a la primera: el depurador y
# el hilo `io` escribían el MISMO buffer de línea. En un núcleo la ventana es un
# cambio de tarea; en dos, solapamiento real.
#
# Criterio de Eduardo: *«La utilización de 2 núcleos debe hacerse de forma
# controlada. Antes de hacerla hay que mirar si tiene consecuencias, no queremos
# corrupciones de memoria de forma aleatoria. Lo ideal es utilizar los 2 núcleos
# pero paso a paso.»* Y la orden: **un solo núcleo hasta nueva orden.**
#
# Va en los DEFAULTS y no en el sdkconfig generado a propósito: el sdkconfig está
# fuera de git, así que ahí la decisión no viajaría y volvería a ser herencia.
# El día que se activen los dos, se quita esta línea y se fijan las tareas a mano
# (`io` en un núcleo, `vm` en el otro), que es como lo tiene previsto la Pico.
# V6 (8-sep) — LA PSRAM DEL S3, QUE LLEVABA DESDE SIEMPRE SIN ACTIVAR.
# El modulo es un ESP32-S3-WROOM-1 con 8 MB de PSRAM EMBEBIDA, y no lo deduzco:
# lo dice el propio chip — `esptool flash_id` sobre esta placa contesta
#   Features: Wi-Fi, BT 5 (LE), 240MHz, Embedded PSRAM 8MB (AP_3v3)
# 8 MB parados. Con esto el S3 pasa a tener region exclusiva como el P4, y de
# paso se le cae UNA de las dos puertas que lo dejaban fuera de las pruebas de
# BD (la otra, no tener binario nativo Xtensa, sigue en pie).
#
# OCT y 80M porque el 8 MB del S3 es octal (S3R8); el de 2 MB seria quad.
# El P4 usa HEX@200, que es su bus, no el de aqui: no se copia el numero.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
#
# ⚠️ IGNORE_NOTFOUND NO es opcional, es la norma de la casa: la imagen es UNICA
# por familia y tiene que arrancar igual en un S3 sin PSRAM (un N16 pelado).
# Sin esto, el bootloader de esa placa entraria en panico. Que haya o no PSRAM
# lo decide la PLACA en arranque, no una macro de compilacion.
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
#
# Los allocs pequenos siguen en DRAM interna (igual que el P4): la PSRAM es
# para el bloque grande de la VM, no para la metralla del sistema.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=2048

CONFIG_FREERTOS_UNICORE=y
