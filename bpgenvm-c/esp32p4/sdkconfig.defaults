# ESP32-P4-Function-EV-Board, silicon rev v1.0 (tirada temprana).
#
# Sin esto, el ESP-IDF 6 (el 6.0.1 y el 6.1, #707) compila para v3.x y el flash falla con
# "bootloader requires chip revision in range [v3.0-v3.99]". Targeteamos
# las P4 < v3 (queda Min v0.0 / Max v1.99 → encaja v1.0). Ver memoria
# esp32-p4-bringup. NO usar --force (v1.x y v3.x no comparten imagen).
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_0=y

# Holgura de stack para app_main.
# 16 KB desde el 24-sep (tarde de placas de V7): con 8 KB la C6 REINICIABA al empezar el RUN
# de TimeDemo y de los Gui* —«Stack protection fault» en la task main: discover_deps (recursiva
# por el arbol de dependencias, mas hondo en V7) -> bpvm_fs_stat -> littlefs -> la lectura SPI—.
# La C5 ya estaba en 16 KB desde el 21-sep; toda la familia ESP32, igual.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# G2 — PSRAM 32 MB (HEX, 200 MHz) para el framebuffer del display. Misma config que
# el ejemplo oficial mipi_dsi del P4. PSRAM@200M y el RMII de Ethernet COEXISTEN en
# placa (el conflicto del MPLL #18377 no nos afecta — verificado).
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y

# RAM — baja el umbral de "siempre interno" de 16 KiB (default IDF) a 2 KiB: los
# objetos LVGL y demás allocs de 2–16 KiB pasan a PSRAM y liberan SRAM interna (la
# escasa). La PSRAM del P4 es rápida (HEX@200) → penalización baja, ×8 más margen
# de objetos pequeños. NB: como es un CONFIG_, sólo aplica al regenerar el
# sdkconfig (idf.py reconfigure, o borrar el sdkconfig).
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=2048

# G4 — la flash REAL es de 16 MB (el chip), no 2 MB. Sin esto IDF compila para 2 MB:
# la imagen con LVGL no cabe en el app de 1 MB de la tabla single-app, y avisa
# "Detected size(16384k) larger than image header(2048k)". Tabla a medida
# (partitions.csv): app de 4 MB + bpfs (FS persistente). Espeja el firmware del S3.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# #138: consola SILENCIADA. El P4-Function-EV tiene un solo puerto serie (CP210x/
# UART0/COM14) y el wire lo usa; con la consola en UART0 se mezclaría, y en USB-JTAG
# (sin host en esta placa) cuelga el arranque. Con NONE, UART0 queda limpio para el
# wire y los logs de diagnóstico salen por Ethernet (net_logf → :5555).
CONFIG_ESP_CONSOLE_NONE=y

# H4 AOT (Hito 2) — el .mdn dinamico ejecuta codigo nativo copiado a RAM. Con
# MEMPROT (W^X, PMP) el heap es NO-ejecutable y MALLOC_CAP_EXEC no existe (Kconfig:
# "allocating memory with MALLOC_CAP_EXEC is not possible when this config is
# enabled"). Ejecutar el .mdn ahi disparaba un fallo de proteccion (panic mudo por
# CONSOLE_NONE, = "cuelgue" visto desde el wire). Desactivamos la proteccion para
# permitir codigo cargable — trade-off estandar de JIT/loadable code; el .mdn es
# codigo de confianza de nuestro propio toolchain. (Al desactivar MEMPROT,
# HEAP_HAS_EXEC_HEAP pasa a 'y' -> MALLOC_CAP_EXEC disponible.)
CONFIG_ESP_SYSTEM_MEMPROT=n

# El CENSO (docs/CENSO_FAMILIAS.md, 17-ago) cazo que esta familia compilaba a
# -Og (DEBUG) mientras el S3 iba a -Os — la leccion del STM32-a-O0 de V4,
# repetida. Se fija AQUI, en los defaults, para que un menuconfig o un
# sdkconfig regenerado no lo devuelva a DEBUG en silencio: los flags de build
# son de CADA familia y nadie los compara si no estan escritos.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# ─── V6 (5-sep-2026): UN SOLO NÚCLEO, POR ORDEN DE EDUARDO ────────────────────
#
# Este chip tiene dos núcleos y ESP-IDF los usa POR DEFECTO. Hasta hoy esta imagen
# corría con FreeRTOS en los dos **sin que nadie lo hubiera decidido** — y con `A1`
# eso dejó de ser inocuo: la tarea `vm` y el hilo `io` pueden solaparse de verdad
# sobre estado compartido que nunca se había auditado.
#
# Al mirarlo (5-sep) apareció la primera consecuencia a la primera: el depurador y
# el hilo `io` escribían el MISMO buffer de línea. En un núcleo la ventana es un
# cambio de tarea; en dos, solapamiento real.
#
# Criterio de Eduardo: *«La utilización de 2 núcleos debe hacerse de forma
# controlada. Antes de hacerla hay que mirar si tiene consecuencias, no queremos
# corrupciones de memoria de forma aleatoria. Lo ideal es utilizar los 2 núcleos
# pero paso a paso.»* Y la orden: **un solo núcleo hasta nueva orden.**
#
# Va en los DEFAULTS y no en el sdkconfig generado a propósito: el sdkconfig está
# fuera de git, así que ahí la decisión no viajaría y volvería a ser herencia.
#
# ─── V7/H12 (6-oct-2026): LOS DOS NÚCLEOS, LA NUEVA ORDEN ─────────────────────
#
# Eduardo: *«si, activa los 2 nucleos en la S3 y la P4»*, y para V7: *«En la Pico
# y Metro, 2 nucleos y 2 runs. En la P4 y la S3 igual. En el resto 1 nucleo y 1
# run»*. El paso a paso que pedía se hizo en H12: el estado compartido, auditado
# y con pruebas (la cola, el mundo parado, los handles, las palabras de la VM, las
# natives y la GUI, que sólo corre en el run 0), y la Pico 2 con dos núcleos y
# dos runs, validada (las puertas de la etapa 3: la tanda, `run_placa` y la
# resistencia de 110 minutos, sin fallos).
#
# Las tareas NO se fijan a mano: la Pico se validó sin afinidad (`io` en el otro
# núcleo apenas se nota), y aquí igual. `vm.cores=1` en el ENV las ancla todas al
# núcleo 0 sin grabar (esp32/common/afinidad_esp32.h); los runs por defecto, uno
# por núcleo (`vm.runs` del ENV manda). La vuelta atrás grabando: `=y` aquí Y en
# el sdkconfig (que ya existe no lo vuelve a sembrar). Explícito y no borrado: el
# que siembre un sdkconfig nuevo tiene que ver la decisión.
CONFIG_FREERTOS_UNICORE=n

# #495 (V7/H8) — LA INTERRUPCION DE LA UART, EN RAM. El wire va por UART0, y mientras la
# ESP32 escribe en la flash se apaga la cache: las interrupciones que no estan en RAM
# esperan, y la FIFO de la UART (128 B) se desborda con lo que el PC manda entretanto
# (medido el 1-oct en la P4: con una ventana de 4 trozos, la placa contestaba «JSON
# invalido»). En RAM, la interrupcion sigue llenando el anillo del driver (8 KB, que con
# esto va a RAM interna) durante la escritura. Es la via del IDF —la ayuda de su Kconfig
# lo dice tal cual— y la decision de Eduardo (1-oct): la interrupcion en RAM, no el DMA.
CONFIG_UART_ISR_IN_IRAM=y
# V7/H12 2b (5-oct): dos indices de notificacion por tarea; el 1, el de la condicion de la VM
# (src/platform_freertos_cond.inc), que no se cruza con el 0 de los drivers.
CONFIG_FREERTOS_TASK_NOTIFICATION_ARRAY_ENTRIES=2
# #707 (19-oct): el perro de las interrupciones, a 800 ms (Eduardo: «Sí 800 ms»). Es lo que pone el IDF 6.1 con PSRAM
# (el 6.0.1 ponía 300); escrito aquí para que no cambie solo con otro IDF.
CONFIG_ESP_INT_WDT_TIMEOUT_MS=800
# V8 #737 (29-oct): LA L2 DE 256 KB (era la de 128, la del IDF). El código de la flash y los datos de la PSRAM comparten
# la L2, y con mucho movimiento de datos echaban al intérprete: tras leer 2 × 64 KB, interpretar costaba un 97 % más.
# Con 256 KB, un 1 %; y leer, crear y gc() con datos grandes, de un 35 a un 62 % más deprisa (medido en la P4 con
# imágenes de prueba). Cuesta 128 KB de la RAM interna, que estaba sin usar (Eduardo: «La RAM libre de la P4 está sin
# utilizar así que 128K más de caché nos salen gratis»). Como las de arriba: aquí Y en el sdkconfig, que ya existe y no
# lo vuelve a sembrar.
CONFIG_CACHE_L2_CACHE_256KB=y
# V8 #784 (3-nov): LA GESTIÓN DE ENERGÍA DEL IDF, ENCENDIDA, para cambiar la frecuencia de la CPU en marcha
# (Machine.setCpuFreqMHz y la clave `cpu.mhz` del ENV; Eduardo: «La velocidad la podriamos seleccionar con una variable
# del Environment?», «O si no con una función como en la Pico»; y «ok» al diseño). La VM la pide con la mínima igual a
# la máxima: sin pedir nada, la CPU va a la de la imagen, como antes. Cuesta unos KB de código, y los drivers piden y
# sueltan un permiso en cada operación. Como las demás: aquí Y en el sdkconfig, que ya existe y no lo vuelve a sembrar.
CONFIG_PM_ENABLE=y
