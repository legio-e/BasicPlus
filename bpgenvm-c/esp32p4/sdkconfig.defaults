# ESP32-P4-Function-EV-Board, silicon rev v1.0 (tirada temprana).
#
# Sin esto, ESP-IDF v6.0.1 compila para v3.x y el flash falla con
# "bootloader requires chip revision in range [v3.0-v3.99]". Targeteamos
# las P4 < v3 (queda Min v0.0 / Max v1.99 → encaja v1.0). Ver memoria
# esp32-p4-bringup. NO usar --force (v1.x y v3.x no comparten imagen).
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_0=y

# Holgura de stack para app_main.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# G2 — PSRAM 32 MB (HEX, 200 MHz) para el framebuffer del display. Misma config que
# el ejemplo oficial mipi_dsi del P4. PSRAM@200M y el RMII de Ethernet COEXISTEN en
# placa (el conflicto del MPLL #18377 no nos afecta — verificado).
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y

# RAM — baja el umbral de "siempre interno" de 16 KiB (default IDF) a 2 KiB: los
# objetos LVGL y demás allocs de 2–16 KiB pasan a PSRAM y liberan SRAM interna (la
# escasa). La PSRAM del P4 es rápida (HEX@200) → penalización baja, ×8 más margen
# de objetos pequeños. NB: como es un CONFIG_, sólo aplica al regenerar el
# sdkconfig (idf.py reconfigure, o borrar el sdkconfig).
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=2048

# G4 — la flash REAL es de 16 MB (el chip), no 2 MB. Sin esto IDF compila para 2 MB:
# la imagen con LVGL no cabe en el app de 1 MB de la tabla single-app, y avisa
# "Detected size(16384k) larger than image header(2048k)". Tabla a medida
# (partitions.csv): app de 4 MB + bpfs (FS persistente). Espeja el firmware del S3.
# La placa lleva 32 MB fisicos. Estuvo a 16 desde el 12-ago porque cambiarlo
# exige reflashear el BOOTLOADER (el tamaño va en su cabecera), y se aparco.
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="32MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_32m.csv"

# #138: consola SILENCIADA. El P4-Function-EV tiene un solo puerto serie (CP210x/
# UART0/COM14) y el wire lo usa; con la consola en UART0 se mezclaría, y en USB-JTAG
# (sin host en esta placa) cuelga el arranque. Con NONE, UART0 queda limpio para el
# wire y los logs de diagnóstico salen por Ethernet (net_logf → :5555).
CONFIG_ESP_CONSOLE_NONE=y

# H4 AOT (Hito 2) — el .mdn dinamico ejecuta codigo nativo copiado a RAM. Con
# MEMPROT (W^X, PMP) el heap es NO-ejecutable y MALLOC_CAP_EXEC no existe (Kconfig:
# "allocating memory with MALLOC_CAP_EXEC is not possible when this config is
# enabled"). Ejecutar el .mdn ahi disparaba un fallo de proteccion (panic mudo por
# CONSOLE_NONE, = "cuelgue" visto desde el wire). Desactivamos la proteccion para
# permitir codigo cargable — trade-off estandar de JIT/loadable code; el .mdn es
# codigo de confianza de nuestro propio toolchain. (Al desactivar MEMPROT,
# HEAP_HAS_EXEC_HEAP pasa a 'y' -> MALLOC_CAP_EXEC disponible.)
CONFIG_ESP_SYSTEM_MEMPROT=n

# El CENSO (docs/CENSO_FAMILIAS.md, 17-ago) cazo que esta familia compilaba a
# -Og (DEBUG) mientras el S3 iba a -Os — la leccion del STM32-a-O0 de V4,
# repetida. Se fija AQUI, en los defaults, para que un menuconfig o un
# sdkconfig regenerado no lo devuelva a DEBUG en silencio: los flags de build
# son de CADA familia y nadie los compara si no estan escritos.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
