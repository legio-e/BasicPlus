# ============================================================
# dist/ — la distribucion CONSTRUIDA
# ============================================================
# Decision de Eduardo (19-ago): *«dist lo reconstruimos antes de publicar. En
# principio no se sube al repositorio, el zip se sube a GitHub aparte.»* O sea
# que es una SALIDA, no una fuente: se rehace en el cierre de cada version y
# viaja como asset de la release, no como ficheros del repo.
#
# El motivo practico esta medido: dentro hay 342 copias de ficheros del arbol
# (samples, .mod, la stdlib), y su `packs/Stdlib.pack` quedo rancio respecto al
# layout nuevo de Collections.Map (#390). Una copia vieja de todo el proyecto
# ensucia las busquedas y da falsos positivos — el 19-ago un grep de FileTest.bp
# salio por duplicado justo por esto.
dist/

# ...pero SI se conservan los MANIFIESTOS de lo publicado: son 4 KB de texto y
# son el unico registro en el repo de que binarios salieron en cada version.
# Sin ellos no se puede verificar un artefacto descargado.
!dist/BasicPlus-4.0-win.zip.sha256
!dist/firmware/
dist/firmware/*
!dist/firmware/README.md
!dist/firmware/SHA256SUMS.txt
# El .slots es una SALIDA del compilador; los versionados son los de
# bpstdlib/ y bpdevices/, que son la distribucion. Estos no.
samples/*.slots

# ============================================================
# samples/ — outputs de compilación (la fuente son los .bp;
# .mod/.bpi/.dbg/.mdn se recompilan). NOTA: bpstdlib/ SÍ se versiona.
# ============================================================
samples/*.mod
samples/*.bpi
samples/*.dbg
samples/*.mdn

# .mod sueltos de demos ad-hoc en la raíz del repo
/*.mod


# Scratch temporal
/Temp/

# Logs de samples (LogTest, etc.)
samples/*.log
samples/*.log.old

# ============================================================
# Capturas de pantalla / imágenes de trabajo (locales, fuera del repo)
# ============================================================
/Captura_pantallas_Graficas/
/Imagenes IDE/

# dist/firmware — las imágenes buenas de la release (H13). Los BINARIOS no van al
# repo: son megas y se adjuntan a la release de GitHub. Lo que SÍ va es el manifiesto
# SHA256SUMS.txt, que es el que deja escrito qué se probó exactamente.
dist/firmware/*.uf2
dist/firmware/*.bin

# El paquete de la release: el ZIP son 9 MB y se adjunta a la release, y el árbol
# montado es material de trabajo que rehace `scripts/montar-zip.sh` de una pasada.
# Va al repo sólo su sello .sha256 — el que permite comprobar que lo que se probó en
# H13 y lo que se descarga el usuario son el mismo fichero.
dist/BasicPlus-*-win/
dist/BasicPlus-*-win.zip

# Imagen de DIAGNOSTICO (H13/#17): binario grande y temporal, no va al repo.
dist/diag/

# Charlas de diseño de la version EN CURSO — NO se publican.
# Publicar es prometer, y no prometemos lo que aun no existe (criterio de
# Eduardo, 6-ago-2026). Se publican hasta la version entregada, no mas.
/notas/

# Packs construidos: son ARTEFACTOS de distribución, van en el ZIP de
# instalación, no en el repo (criterio de Eduardo, 13-ago). Lo que sí está
# versionado es lo que los PRODUCE — el .bpbuild y las fuentes.
# `Stdlib.pack` sigue trackeado porque ya lo estaba; esta regla sólo afecta a
# los nuevos. Si algún día se saca también, es un `git rm --cached`.
packs/*.pack

# V5/#411 - el build del pack de SQLite (los ingredientes SI van: nativo/)
/bpstdlib/sqlite/out/

# residuo de ejecutar las herramientas python de bpgenvm-c/tools
__pycache__/

# V8/H6 - el traductor C# -> JC (compat/csharp/): lo que construye dotnet, y el
# JC que sale de un caso cuando no casa con el esperado (para mirarlo)
/compat/csharp/cs2jc/bin/
/compat/csharp/cs2jc/obj/
/compat/csharp/casos/*.nuevo
