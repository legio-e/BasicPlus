# ============================================================
# Build outputs (Maven)
# ============================================================
target/
*.class

# Maven status / dependency-reduced poms
**/dependency-reduced-pom.xml

# ============================================================
# IDE / editor metadata
# ============================================================
.idea/
.vscode/
*.iml
nbproject/private/
nb-configuration.xml
.classpath
.project
.settings/

# ============================================================
# OS noise
# ============================================================
Thumbs.db
.DS_Store

# ============================================================
# Compilation artifacts en samples/
# ============================================================
# Los .mod/.bpi/.dbg de lexer-java/samples/ son recompilables
# en cualquier momento; los excluímos para que el repo no se
# llene de binarios que cambian con cada compilación.
# NOTA: lo de bpstdlib/ sí va al repo — es la distribución
# del stdlib.
lexer-java/samples/*.mod
lexer-java/samples/*.bpi
lexer-java/samples/*.dbg
lexer-java/samples/**/out/*.mod
lexer-java/samples/**/out/*.bpi
lexer-java/samples/**/out/*.dbg
lexer-java/samples/**/*.class

# Dir de outputs de compilaciones ad-hoc del frontend
lexer-java/out/

# Stray outputs de tests
out_test.txt
tmp_iotest/

# ============================================================
# Claude Code (caché local de permisos por carpeta)
# ============================================================
.claude/settings.local.json
**/.claude/settings.local.json

# ============================================================
# Dependencias externas grandes (vendored / submodule candidates)
# ============================================================
# FreeRTOS-Kernel y FreeRTOS-LTS van con el SDK del Pico, fuera del repo.
FreeRTOS-Kernel/
FreeRTOS-LTS/
FreeRTOSv202604.00-LTS.zip
# Pico SDK: idem.
pico-sdk/

# ============================================================
# Outputs ad-hoc y prefs del IDE
# ============================================================
out/
BpIde/.bpide-prefs

# ============================================================
# Build artefacts del firmware Pico y de bpgenvm-c
# ============================================================
bpgenvm-c/pico/build/
bpgenvm-c/pico/mdn_build/
bpgenvm-c/build/
bpgenvm-c/samples/*.mod
bpgenvm-c/samples/*.bpi
bpgenvm-c/samples/*.dbg

# Outputs locales del IDE/runs en samples/
samples/out/

# ============================================================
# Outputs ad-hoc del AOT/MdnPack en lexer-java
# ============================================================
lexer-java/*.mdn
lexer-java/*.o
lexer-java/aotout/

# ============================================================
# samples/ — outputs de compilación (la fuente son los .bp;
# .mod/.bpi/.dbg/.mdn se recompilan). NOTA: bpstdlib/ SÍ se versiona.
# ============================================================
samples/*.mod
samples/*.bpi
samples/*.dbg
samples/*.mdn

# .mod sueltos de demos ad-hoc en la raíz del repo
/*.mod

# miVM/ — los .mod de los demos los ESCRIBEN los Main*.java (emisores a mano,
# anteriores al compilador): MainArrays→ArrDemo.mod, MainOOP→OOPDemo.mod, etc.
# Son salida, no fuente. Se regeneran ejecutando su Main.
miVM/*.mod
miVM/*.bpi
miVM/*.dbg

# Scratch temporal
/Temp/

# CMake in-source del firmware Pico + outputs de build STM32
bpgenvm-c/pico/CMakeCache.txt
bpgenvm-c/pico/CMakeFiles/
bpgenvm-c/stm32/**/*.bpi
bpgenvm-c/stm32/**/*.dbg
# Los .mod del port STM32 son intermedios: se compilan del .bp de al lado y de
# ahí sale el blob embebido (stm32_mods.c), que ESE sí se versiona.
bpgenvm-c/stm32/**/*.mod

# Logs de samples (LogTest, etc.)
samples/*.log
samples/*.log.old

# ============================================================
# Scratch de bring-up gráfico del ESP32-P4 (ejemplos IDF/BSP +
# sus managed_components/ y build/ = miles de ficheros descargados).
# 100% regenerable, NO va al repo. El firmware REAL es bpgenvm-c/esp32p4/.
# ============================================================
bpgenvm-c/esp32p4_mipi_dsi/
bpgenvm-c/esp32p4_bsp_button/
bpgenvm-c/esp32p4_lvgl_test/

# Firmware REAL del P4: componentes descargados + lock (idf.py los regenera;
# el manifiesto idf_component.yml SÍ se versiona). Igual que el firmware del S3.
bpgenvm-c/esp32p4/managed_components/
bpgenvm-c/esp32p4/dependencies.lock

# ============================================================
# Capturas de pantalla / imágenes de trabajo (locales, fuera del repo)
# ============================================================
/Captura_pantallas_Graficas/
/Imagenes IDE/

# dist/firmware — las imágenes buenas de la release (H13). Los BINARIOS no van al
# repo: son megas y se adjuntan a la release de GitHub. Lo que SÍ va es el manifiesto
# SHA256SUMS.txt, que es el que deja escrito qué se probó exactamente.
dist/firmware/*.uf2
dist/firmware/*.bin

# El paquete de la release: el ZIP son 9 MB y se adjunta a la release, y el árbol
# montado es material de trabajo que rehace `scripts/montar-zip.sh` de una pasada.
# Va al repo sólo su sello .sha256 — el que permite comprobar que lo que se probó en
# H13 y lo que se descarga el usuario son el mismo fichero.
dist/BasicPlus-*-win/
dist/BasicPlus-*-win.zip

# Imagen de DIAGNOSTICO (H13/#17): binario grande y temporal, no va al repo.
dist/diag/

# Charlas de diseño de la version EN CURSO — NO se publican.
# Publicar es prometer, y no prometemos lo que aun no existe (criterio de
# Eduardo, 6-ago-2026). Se publican hasta la version entregada, no mas.
/notas/
