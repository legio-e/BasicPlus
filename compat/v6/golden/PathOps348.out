== join ==
join('a','b')        -> [a/b]
join('a/','b')       -> [a/b]
join('a','/b')       -> [a/b]
join('a//','//b')    -> [a/b]
join('/','x')        -> [/x]
join('','b')         -> [b]
join('a','')         -> [a]
join('/app','d.txt') -> [/app/datos.txt]
== parent ==
parent('a/b/c')      -> [a/b]
parent('a')          -> []
parent('/a')         -> [/]
parent('/')          -> []
parent('a/b/')       -> [a]
parent('')           -> []
== basename ==
base('a/b/c')        -> [c]
base('a')            -> [a]
base('a/b/')         -> [b]
base('/')            -> []
base('')             -> []
base('/app/d.txt')   -> [datos.txt]
== extension ==
ext('d.txt')         -> [txt]
ext('/app/d.txt')    -> [txt]
ext('sin')           -> []
ext('.oculto')       -> []
ext('acaba.')        -> []
ext('a.b.c')         -> [c]
ext('')              -> []
