module CsArraysNuevos
{
   interface IForma
   {
      function int Area();
   }

   class Punto : IForma
   {
      public int x { get; set; }
      public function Punto(int x)
      {
         this.x = x;
      }
      @implement{ IForma }
      public function int Area()
      {
         return this.x * 2;
      }
   }

   enum Color
   {
      Rojo = 0,
      Verde = 7
   }

   class M
   {
      private Punto[] campo = new Punto[2];
      private static string[] nombres = new string[3];
      private static function Punto[] Crea(int n)
      {
         return new Punto[n + 1];
      }
      public static function int Main()
      {
         Punto[] a = new Punto[3];
         if (len(a) != 3 || a[0] != null)
         {
            return 1;
         }
         a[1] = new Punto(6);
         if (a[1].Area() != 12)
         {
            return 2;
         }
         string[] s = new string[2];
         if (s[0] != null)
         {
            return 3;
         }
         s[1] = "hola";
         if (strlen(s[1]) != 4)
         {
            return 4;
         }
         bool[] b = new bool[2];
         if (b[1])
         {
            return 5;
         }
         Color[] c = new Color[2];
         c[1] = Color.Verde;
         if (c[0] != Color.Rojo || c[1] != Color.Verde)
         {
            return 6;
         }
         IForma[] f = new IForma[1];
         f[0] = new Punto(3);
         if (f[0].Area() != 6)
         {
            return 7;
         }
         float[] r = new float[2];
         short[] h = new short[2];
         sbyte[] y = new sbyte[2];
         ushort[] u = new ushort[2];
         if (r[1] != 0 || h[1] != 0 || y[1] != 0 || u[1] != 0)
         {
            return 8;
         }
         long n = 4;
         int[] e = new int[(int) n];
         if (len(e) != 4)
         {
            return 9;
         }
         if (len(M.Crea(2)) != 3)
         {
            return 10;
         }
         if (len(new M().campo) != 2 || len(M.nombres) != 3)
         {
            return 11;
         }
         Integer[] o = new Integer[2];
         if (o[0] != null)
         {
            return 12;
         }
         return 0;
      }
   }

   public function void main()
   {
      int r = M.Main();
      if (r != 0)
      {
         throw new RuntimeError("Main devuelve " + r);
      }
   }
}
