module CsAccesos
{
   import CsSystem;

   class A
   {
      public static int X { get; set; } = 0;
      public int foo { get; set; } = 0;
      public static function int Equis()
      {
         return A.X;
      }
      public function int Foo()
      {
         return this.foo;
      }
      public function int Prot()
      {
         return 7;
      }
   }

   public class A_B
   {
      public function void Sube()
      {
         A.X++;
      }
   }

   public class A_C
   {
      public function void Pon(A a)
      {
         a.foo = 4;
      }
   }

   public class A_D : A
   {
      private A otro;
      public function A_D(A a)
      {
         this.otro = a;
      }
      public function int LeeDelOtro()
      {
         return this.otro.Prot();
      }
   }

   class Programa
   {
      public static function int Main()
      {
         new A_B().Sube();
         if (A.Equis() != 1)
         {
            return 1;
         }
         A a = new A();
         new A_C().Pon(a);
         if (a.Foo() != 4)
         {
            return 2;
         }
         if (new A_D(a).LeeDelOtro() != 7)
         {
            return 7;
         }
         try
         {
            Object lock_s1 = null;
            if (lock_s1 == null)
            {
               throw new CsSystem.ArgumentNullException("obj");
            }
            if (true)
            {
               return 3;
            }
         }
         catch (CsSystem.ArgumentNullException excepcion_cs1)
         {
         }
         Object o = null;
         o = new Object();
         if (true)
         {
            if (o == null)
            {
               return 4;
            }
         }
         if (o == null)
         {
            return 5;
         }
         Object t = new Object();
         if (t == null)
         {
            throw new CsSystem.ArgumentNullException("obj");
         }
         if (true)
         {
            t = null;
         }
         if (t != null)
         {
            return 6;
         }
         println("accesos bien");
         return 0;
      }
   }

   public function void main()
   {
      int r = Programa.Main();
      if (r != 0)
      {
         throw new RuntimeError("Main devuelve " + r);
      }
   }
}
