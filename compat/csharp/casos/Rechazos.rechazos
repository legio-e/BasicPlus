# Lo que el traductor tiene que rechazar en Rechazos.cs, y por qué (una línea por rechazo, en orden).
5: le falta a JC: struct (tipos por valor) — struct Punto { public int X; }
18: le falta a JC: métodos no virtuales (new) — public void Saluda() { }
23: le falta a JC: genéricos — <T>
25: le falta a JC: ref / out — ref int x
30: le falta a JC: as — o as string
31: fuera: ulong, decimal, nint y nuint — ulong
32: le falta a JC: delegados y eventos de C# (sin lambdas) — Func<int, int>
32: fuera: lambdas y métodos anónimos — x => x + 1
34: le falta a JC: ++, -- y = dentro de una expresión — i++
35: le falta a JC: arrays de varias dimensiones — int[,]
36: la biblioteca: System.String.Join — string.Join(",", "a", "b")
41: le falta a JC: errores de la VM con su tipo — NullReferenceException
44: fuera: goto — goto fin;
45: fuera: goto — fin: return 0;
52: le falta a JC: constructor estático — static ConLlamada() { Console.WriteLine("hola"); }
