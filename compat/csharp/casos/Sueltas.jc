module CsSueltas
{
   import CsSystem;

   enum Color
   {
      Rojo = 1,
      Verde = 300
   }

   class Prueba
   {
      private static bool asi = Prueba.Cierto();
      public CsSystem.Version Sin
      {
         get
         {
            throw new Exception("Exception of type 'System.Exception' was thrown.");
         }
      }
      private static function int Cero(Object o)
      {
         return 0;
      }
      private static function void Escribe(string texto)
      {
         println(texto);
      }
      private static function bool Cierto()
      {
         return true;
      }
      public static function int Main()
      {
         // NoEsta(…): [Conditional("NO_DEFINIDO")], sin definir; C# quita la llamada
         if (Prueba.Cero(null) + Prueba.Cero(null) != 0)
         {
            return 9;
         }
         Prueba.Escribe(("caso " + 1));
         // nadie: una local sin valor que nadie usa
         Color c = Color.Verde;
         if ((byte) ((int) (((long) c) & 255L)) != 44 || (ushort) ((int) (((long) c) & 65535L)) != 300 || (sbyte) ((((int) (((long) c) & 255L)) ^ 128) - 128) != 44 || (short) ((((int) (((long) c) & 65535L)) ^ 32768) - 32768) != 300)
         {
            return 8;
         }
         if (Enum.getName(c) != "Verde")
         {
            return 7;
         }
         // direcciones: una local sin valor que nadie usa
         // a, b: una local sin valor que nadie usa
         int usada = 0;
         usada = 2;
         if (!Prueba.asi || usada != 2)
         {
            return 1;
         }
         return 0;
      }
   }

   public function void main()
   {
      int r = Prueba.Main();
      if (r != 0)
      {
         throw new RuntimeError("Main devuelve " + r);
      }
   }
}
