module CsIndexadores
{
   interface ILee
   {
      function int get(int i);
   }

   interface IEscribe : ILee
   {
      function int get(int i);
      function void set(int i, int value);
   }

   class Figura
   {
      public function int get(int i)
      {
         throw new RuntimeError("abstracto: Figura.get");
      }
      public function string get(string k)
      {
         return "figura " + k;
      }
   }

   class Tabla : Figura, ILee
   {
      private int[] d = new int[4];
      @implement{ ILee }
      @override{}
      public function int get(int i)
      {
         return this.d[i];
      }
      public function int Pon(int i, int v)
      {
         this.d[i] = v;
         return v;
      }
   }

   class Hija : Tabla
   {
      @override{}
      public function string get(string k)
      {
         return "hija y " + base.get(k);
      }
      @override{}
      public function int get(int i)
      {
         return base.get(i) * 2;
      }
   }

   class Cuenta : IEscribe
   {
      private int[] d = new int[3];
      public int escritos { get; set; }
      @implement{ IEscribe, ILee }
      public function int get(int i)
      {
         return this.d[i];
      }
      @implement{ IEscribe }
      public function void set(int i, int value)
      {
         this.d[i] = value;
         this.escritos++;
      }
      public function int get(string k)
      {
         return strlen(k);
      }
      public int Suma
      {
         get
         {
            return this[0] + this[1];
         }
      }
   }

   class Malla
   {
      private int[] d = new int[6];
      public function int get(int x, int y)
      {
         return this.d[y * 3 + x];
      }
      public function void set(int x, int y, int value)
      {
         this.d[y * 3 + x] = value;
      }
   }

   class Tiene
   {
      private Object guardado;
      public function Object get(Object llave)
      {
         return this.guardado;
      }
      public function void set(Object llave, Object value)
      {
         this.guardado = value;
      }
   }

   class X
   {
      private static int llamadas;
      private static function int Cual()
      {
         X.llamadas++;
         return 1;
      }
      public static function int Main()
      {
         Tabla t = new Tabla();
         t.Pon(1, 7);
         println(t[1]);
         println(t["x"]);
         Figura f = new Hija();
         ((Tabla) f).Pon(2, 4);
         println(f[2]);
         println(f["y"]);
         ILee l = t;
         println(l[1]);
         Cuenta c = new Cuenta();
         c[0] = 5;
         c[1] = 6;
         c[1] += 4;
         c[X.Cual()] *= 2;
         c[2]++;
         println(c.Suma + " " + c[2] + " " + c["hola"] + " " + c.escritos + " " + X.llamadas);
         IEscribe e = c;
         e[0] = 9;
         println(e[0]);
         Malla m = new Malla();
         m.set(1, 1, 3);
         println(m.get(1, 1) + m.get(0, 0));
         Tiene g = new Tiene();
         g[new Integer(1)] = "uno";
         println(g[new Integer(2)]);
         if (c[1] != 20 || X.llamadas != 1)
         {
            return 1;
         }
         return 0;
      }
   }

   public function void main()
   {
      int r = X.Main();
      if (r != 0)
      {
         throw new RuntimeError("Main devuelve " + r);
      }
   }
}
