// CsSystem.jc — lo de `System` de .NET que piden las pruebas de C# traducidas a JC (V8/H6, el escalón 1;
// docs/V8_IDEAS.md §E9), con los nombres de .NET y hecho sobre lo de BP. Es de la herramienta, no del producto
// (Eduardo, 1-nov: «esas librerías en principio a nosotros para trabajar con los micros no nos interesan ya que
// trabajaremos con las nuestras»): no está en bpstdlib ni en las placas. El traductor la compila al empezar, junto a
// la stdlib, y la pone en el `import` de lo que traduce.
//
// Las excepciones, con la jerarquía de .NET: `System.Exception` es la `Exception` de Core, y `System.SystemException`,
// `RuntimeError` —lo que lanza la VM—, así que sus hijas heredan de `RuntimeError` y un `catch (SystemException)`
// atrapa también un `null` o un índice fuera, como en .NET. Cada una, con el mensaje que pone .NET si se crea sin él.
// Las que lanza la VM (NullReferenceException, IndexOutOfRangeException…) no están: la VM lanza `RuntimeError`, y un
// `catch` de una de ellas no lo atraparía (el traductor lo rechaza: «errores de la VM con su tipo», H7).
module CsSystem
{
   import Math;
   import Str;

   public class ApplicationException : Exception
   {
      public function ApplicationException() : base("Error in the application.") { }
      public function ApplicationException(string message) : base(message) { }
   }

   public class ArgumentException : RuntimeError
   {
      public string ParamName { get; set; }
      public function ArgumentException() : base("Value does not fall within the expected range.") { }
      public function ArgumentException(string message) : base(message) { }
      public function ArgumentException(string message, string paramName) : base(message + " (Parameter '" + paramName + "')")
      {
         this.ParamName = paramName;
      }
   }

   public class ArgumentNullException : ArgumentException
   {
      public function ArgumentNullException() : base("Value cannot be null.") { }
      public function ArgumentNullException(string paramName) : base("Value cannot be null.", paramName) { }
      public function ArgumentNullException(string paramName, string message) : base(message, paramName) { }
   }

   public class ArgumentOutOfRangeException : ArgumentException
   {
      public function ArgumentOutOfRangeException() : base("Specified argument was out of the range of valid values.") { }
      public function ArgumentOutOfRangeException(string paramName)
         : base("Specified argument was out of the range of valid values.", paramName) { }
      public function ArgumentOutOfRangeException(string paramName, string message) : base(message, paramName) { }
   }

   public class InvalidOperationException : RuntimeError
   {
      public function InvalidOperationException() : base("Operation is not valid due to the current state of the object.") { }
      public function InvalidOperationException(string message) : base(message) { }
   }

   public class NotImplementedException : RuntimeError
   {
      public function NotImplementedException() : base("The method or operation is not implemented.") { }
      public function NotImplementedException(string message) : base(message) { }
   }

   public class NotSupportedException : RuntimeError
   {
      public function NotSupportedException() : base("Specified method is not supported.") { }
      public function NotSupportedException(string message) : base(message) { }
   }

   public class FormatException : RuntimeError
   {
      public function FormatException() : base("One of the identified items was in an invalid format.") { }
      public function FormatException(string message) : base(message) { }
   }

   // ------------------------------------------------------------------------------------------- las interfaces
   // Las de .NET que implementan las clases del programa: `IDisposable`, la de `using` (H8, tema 2).

   public interface IDisposable
   {
      function void Dispose();
   }

   // `ICloneable` (H8, tema 8): `Clone()` da un Object, como en .NET
   public interface ICloneable
   {
      function Object Clone();
   }

   // ------------------------------------------------------------------------------------------- el tipo de un objeto
   // `x.GetType()` lo resuelve casi siempre el traductor (cs2jc/Tipos.cs): no hay un `Type`. Aquí, lo que se pide al ejecutar.

   /// El nombre de la clase de un objeto, el que sabe la VM (`Modulo.Clase`): el builtin de `__className`.
   public function string Type_Clase(Object o) inline CALL_BUILTIN 301;

   /// `x.GetType()` lanza si `x` es null.
   public function bool Type_Hay(Object o)
   {
      if (o == null) throw new RuntimeError("Object reference not set to an instance of an object.");
      return true;
   }

   public function bool Type_Hay(string s)
   {
      if (s == null) throw new RuntimeError("Object reference not set to an instance of an object.");
      return true;
   }

   /// `a.GetType() == b.GetType()`, cuando sólo se sabe al ejecutar.
   public function bool Type_Misma(Object a, Object b)
   {
      Type_Hay(a);
      Type_Hay(b);
      return Type_Clase(a) == Type_Clase(b);
   }

   /// `Name`, de un `FullName`: lo que hay detrás del último `.` o `+`.
   public function string Type_Name(string entero)
   {
      int i = strlen(entero) - 1;
      while (i >= 0 && charCodeAt(entero, i) != '.' && charCodeAt(entero, i) != '+') i--;
      return substring(entero, i + 1, strlen(entero));
   }

   // ------------------------------------------------------------------------------------------- System.IO
   // Lo poco que piden las pruebas (H8, tema 1): escribir en un `TextWriter`. Éste no escribe en ningún sitio, como
   // `TextWriter.Null` y `StreamWriter.Null`; `StringWriter` se queda lo que le escriben.

   // `IEnumerable` e `IEnumerator`, los que no son genéricos (H8): una clase del programa los implementa como los suyos, y el foreach
   // sobre ella es el bucle que escribe C#, con `Foreach_Suelta` al salir, si el enumerador se suelta.
   public interface IEnumerator
   {
      function bool MoveNext();
      function void Reset();
      Object Current { get; set; }
   }

   public interface IEnumerable
   {
      function IEnumerator GetEnumerator();
   }

   // `ArrayList` es la `List` de Core (Eduardo: «ArrayList es nuestra List»). Aquí, sólo lo que ella no tiene: el índice que devuelve `Add`,
   // `Clear`, y el enumerador de `GetEnumerator`; el foreach sobre una lista es el de JC.
   public function int ArrayList_Add(List l, Object x)
   {
      l.add(x);
      return l.length() - 1;
   }

   public function void ArrayList_Clear(List l)
   {
      for (int i = l.length() - 1; i >= 0; i--)
      {
         l.remove(i);
      }
   }

   public class ArrayList_Recorre : IEnumerator
   {
      private List lista;
      private int i = -1;

      public function ArrayList_Recorre(List lista)
      {
         this.lista = lista;
      }

      @implement{ IEnumerator }
      public function bool MoveNext()
      {
         this.i += 1;
         return this.i < this.lista.length();
      }

      @implement{ IEnumerator }
      public function void Reset()
      {
         this.i = -1;
      }

      @implement{ IEnumerator }
      public Object Current
      {
         get
         {
            return this.lista.get(this.i);
         }
      }
   }

   // `Hashtable` e `IDictionary` (H8, tema 3), lo que usan los programas: lo demás no se traduce. El `Map` de Collections no vale: ordena sus
   // llaves, y aquí una llave es cualquier objeto. Las guarda en orden, en una `List`, y las busca una a una: en C#, el orden no está definido,
   // y aquí no importa la velocidad. El indexador es `get` y `set`, que es lo que son `x[i]` y `x[i] = v` en JC.
   /// ¿La misma llave? Dos cajas o dos cadenas, por su valor; lo demás, el mismo objeto.
   public function bool Llave_Misma(Object a, Object b)
   {
      if (a == null || b == null)
      {
         return a == b;
      }
      string clase = Type_Clase(a);
      if (clase != Type_Clase(b))
      {
         return false;
      }
      if (clase == "?" || a is Integer || a is Long || a is Double || a is Float || a is Boolean)
      {
         return "" + a == "" + b;     // una cadena no es un objeto: su clase es "?"
      }
      return a == b;
   }

   public class Hashtable
   {
      private List llaves = new List();
      private List valores = new List();

      public function Hashtable() { }

      private function int Busca(Object llave)
      {
         for (int i = 0; i <= this.llaves.length() - 1; i++)
         {
            if (Llave_Misma(this.llaves.get(i), llave))
            {
               return i;
            }
         }
         return -1;
      }

      public int Count
      {
         get
         {
            return this.llaves.length();
         }
      }

      public List Keys
      {
         get
         {
            return this.llaves;
         }
      }

      public List Values
      {
         get
         {
            return this.valores;
         }
      }

      public function void Add(Object llave, Object valor)
      {
         if (this.Busca(llave) >= 0)
         {
            throw new ArgumentException("Item has already been added.");
         }
         this.llaves.add(llave);
         this.valores.add(valor);
      }

      public function void Clear()
      {
         ArrayList_Clear(this.llaves);
         ArrayList_Clear(this.valores);
      }

      public function bool Contains(Object llave)
      {
         return this.Busca(llave) >= 0;
      }

      public function bool ContainsKey(Object llave)
      {
         return this.Busca(llave) >= 0;
      }

      public function Object get(Object llave)
      {
         int i = this.Busca(llave);
         if (i < 0)
         {
            return null;
         }
         return this.valores.get(i);
      }

      public function void set(Object llave, Object valor)
      {
         int i = this.Busca(llave);
         if (i < 0)
         {
            this.llaves.add(llave);
            this.valores.add(valor);
         }
         else
         {
            this.valores.set(i, valor);
         }
      }
   }

   public function void Foreach_Suelta(Object o)
   {
      if (o is IDisposable)
      {
         IDisposable d = (IDisposable) o;
         d.Dispose();
      }
   }

   // `System.Version`, sólo el tipo (test-447): sus miembros no se traducen
   public class Version
   {
   }

   public class TextWriter : IDisposable
   {
      public static TextWriter Null { get; set; } = new TextWriter();

      public function void Write(string s) { }
      public function void WriteLine() { this.Write(eol()); }
      public function void WriteLine(string s)
      {
         this.Write(s);
         this.WriteLine();
      }

      @implement{ IDisposable }
      public function void Dispose() { }
   }

   public class StringWriter : TextWriter
   {
      private string texto = "";

      public function void Write(string s) { this.texto += s; }
      public function string toString() { return this.texto; }
   }

   // ------------------------------------------------------------------------------------------- Math y los números
   // Los métodos estáticos de .NET, como funciones del módulo con el nombre de su tipo delante (`Math.Abs` es
   // `Math_Abs`): una clase Math, Double o Int32 chocaría con lo de BP (el módulo Math, las cajas de Core). Las
   // constantes (int.MaxValue, Math.PI, double.NaN…) no están: el traductor escribe su valor.

   public function int Math_Abs(int x) { return x < 0 ? -x : x; }
   public function long Math_Abs(long x) { return x < 0L ? -x : x; }
   public function double Math_Abs(double x) { return x < 0.0 ? -x : x; }
   public function float Math_Abs(float x) { return x < 0.0f ? -x : x; }

   public function int Math_Max(int a, int b) { return a > b ? a : b; }
   public function long Math_Max(long a, long b) { return a > b ? a : b; }
   public function int Math_Min(int a, int b) { return a < b ? a : b; }
   public function long Math_Min(long a, long b) { return a < b ? a : b; }
   // con un NaN, NaN, como .NET
   public function double Math_Max(double a, double b)
   {
      if (a != a || b != b) return 0.0 / 0.0;
      return a > b ? a : b;
   }
   public function double Math_Min(double a, double b)
   {
      if (a != a || b != b) return 0.0 / 0.0;
      return a < b ? a : b;
   }

   /// Math.Floor y Math.Ceiling de un double (mientras quepa en un long; NaN e infinito, tal cual).
   public function double Math_Floor(double x)
   {
      if (x != x || x == 1.0 / 0.0 || x == -1.0 / 0.0) return x;
      double t = (double) ((long) x);
      return t > x ? t - 1.0 : t;
   }
   public function double Math_Ceiling(double x)
   {
      if (x != x || x == 1.0 / 0.0 || x == -1.0 / 0.0) return x;
      double t = (double) ((long) x);
      return t < x ? t + 1.0 : t;
   }

   /// Math.Round(double): al entero más cercano, y a medias al par, como .NET (MidpointRounding.ToEven): 2.5 es 2.
   public function double Math_Round(double x)
   {
      double f = Math_Floor(x);
      if (f != f || f == x) return f;
      double r = x - f;
      if (r > 0.5) return f + 1.0;
      if (r < 0.5) return f;
      return ((long) f) % 2L == 0L ? f : f + 1.0;
   }

   /// Math.Acos: el acos de BP, que es de float (la precisión de un float).
   public function double Math_Acos(double x) { return (double) Math.acos((float) x); }

   public function bool Double_IsNaN(double x) { return x != x; }
   public function bool Single_IsNaN(float x) { return x != x; }

   // ------------------------------------------------------------------------------------------- los caracteres
   // Un char de C# es un entero en JC, su código (Eduardo, 1-nov: «En JC, char es un entero»). Lo de char, de ASCII:
   // con uno de fuera (una 'é'), .NET sabe más que esto.

   public function bool Char_IsDigit(int c) { return c >= '0' && c <= '9'; }
   public function bool Char_IsUpper(int c) { return c >= 'A' && c <= 'Z'; }
   public function bool Char_IsLower(int c) { return c >= 'a' && c <= 'z'; }
   public function bool Char_IsLetter(int c) { return Char_IsUpper(c) || Char_IsLower(c); }
   public function bool Char_IsLetterOrDigit(int c) { return Char_IsLetter(c) || Char_IsDigit(c); }
   public function bool Char_IsWhiteSpace(int c) { return c == ' ' || (c >= 9 && c <= 13) || c == 133 || c == 160; }
   public function int Char_ToUpper(int c) { return Char_IsLower(c) ? c - 32 : c; }
   public function int Char_ToLower(int c) { return Char_IsUpper(c) ? c + 32 : c; }

   // ------------------------------------------------------------------------------------------- las cadenas
   // Lo que Core ya tiene (StartsWith, EndsWith, Contains, IndexOf, Replace, ToUpper, ToLower, Trim) lo llama el
   // traductor directamente; aquí, lo que no.

   /// s.Substring(i) y s.Substring(i, n): en .NET, el segundo es la LONGITUD; el substring de Core pide el final.
   public function string String_Substring(string s, int desde) { return substring(s, desde, strlen(s)); }

   /// s.Split(c), s.Split(c1, c2…) y s.Split() (H8, tema 9): los trozos entre cada separador, vacíos incluidos; sin
   /// separadores, por los espacios (char.IsWhiteSpace), como .NET. Un carácter de JC es su código.
   public function string[] String_Split(string s, int sep)
   {
      return String_Split(s, [sep]);
   }
   public function string[] String_Split(string s, int[] seps)
   {
      int n = strlen(s);
      int cuantos = 1;
      int i = 0;
      while (i < n)
      {
         if (String_EsSeparador(charCodeAt(s, i), seps)) cuantos++;
         i++;
      }
      string[] r = new string[cuantos];
      int k = 0;
      int desde = 0;
      i = 0;
      while (i < n)
      {
         if (String_EsSeparador(charCodeAt(s, i), seps))
         {
            r[k] = substring(s, desde, i);
            k++;
            desde = i + 1;
         }
         i++;
      }
      r[k] = substring(s, desde, n);
      return r;
   }
   function bool String_EsSeparador(int c, int[] seps)
   {
      if (len(seps) == 0) return Char_IsWhiteSpace(c);
      int j = 0;
      while (j < len(seps))
      {
         if (seps[j] == c) return true;
         j++;
      }
      return false;
   }

   /// bool.Parse (H8, tema 9): «True» o «False», sin mirar mayúsculas ni los espacios de los lados, como .NET; si no,
   /// FormatException.
   public function bool Boolean_Parse(string s)
   {
      string t = lower(trim(s));
      if (t == "true") return true;
      if (t == "false") return false;
      throw new FormatException("String '" + s + "' was not recognized as a valid Boolean.");
   }
   public function string String_Substring(string s, int desde, int largo) { return substring(s, desde, desde + largo); }

   /// string.IsNullOrEmpty(s) (#774: una variable string de JC puede valer null, y con él no se puede medir).
   public function bool String_IsNullOrEmpty(string s) { return s == null || s == ""; }

   /// string.Join(sep, valores): los valores, con el separador entre cada dos (un null, como "": se concatena).
   public function string String_Join(string sep, string[] valores)
   {
      string r = "";
      for (int i = 0; i <= len(valores) - 1; i++)
      {
         if (i > 0) r = r + sep;
         r = r + valores[i];
      }
      return r;
   }

   // ------------------------------------------------------------------------------------------- los formatos
   // (H8, tema 1; 2-nov) Los de `{x,N}` y `{x:F}` que el traductor sabe pasar: el ancho, el hexadecimal (`x`, `X8`) y un
   // formato a medida de ceros y un punto (`0.00`). Los demás (N, F2, D5, las fechas…), todavía no.

   /// `{x,N}`: el texto, con espacios hasta N caracteres; N > 0, a la derecha (los espacios delante); N < 0, a la izquierda.
   public function string Format_Ancho(string s, int n)
   {
      int ancho = n < 0 ? -n : n;
      string r = s == null ? "" : s;                     // #774: un null, como C#, se escribe ""
      while (strlen(r) < ancho)
      {
         if (n > 0) r = " " + r;
         else r = r + " ";
      }
      return r;
   }

   /// `{x:x}` y `{x:X8}`: en hexadecimal, en minúsculas o mayúsculas, con ceros delante hasta `cifras`. Un negativo, en
   /// complemento a dos: 8 cifras un int, 16 un long, como .NET.
   public function string Format_Hex(int x, bool mayusculas, int cifras)
   {
      return Format_Hex(((long) x) & 4294967295L, mayusculas, cifras);
   }
   public function string Format_Hex(long x, bool mayusculas, int cifras)
   {
      string digitos = mayusculas ? "0123456789ABCDEF" : "0123456789abcdef";
      string r = "";
      long v = x;
      do
      {
         int d = (int) (v & 15L);
         r = substring(digitos, d, d + 1) + r;
         v = (v >> 4) & 1152921504606846975L;          // >> sin signo: los 4 bits de arriba, a cero
      }
      while (v != 0L);
      while (strlen(r) < cifras) r = "0" + r;
      return r;
   }

   /// `{x:0.00}`: con `decimales` cifras tras el punto y al menos `enteras` delante, redondeando a medias hacia fuera
   /// del cero, como .NET al formatear.
   public function string Format_Decimales(double x, int enteras, int decimales)
   {
      bool negativo = x < 0.0;
      double a = negativo ? -x : x;
      long escala = 1L;
      for (int i = 1; i <= decimales; i++) escala = escala * 10L;
      long r = (long) (a * ((double) escala) + 0.5);
      string s = "" + (r / escala);
      while (strlen(s) < enteras) s = "0" + s;
      if (decimales > 0)
      {
         string f = "" + (r % escala);
         while (strlen(f) < decimales) f = "0" + f;
         s = s + "." + f;
      }
      return negativo && r != 0L ? "-" + s : s;
   }

   /// int.Parse y long.Parse: el número, o FormatException, como .NET (el desbordamiento no se mira: Str.parseLong).
   public function int Int32_Parse(string s)
   {
      bool err = false;
      int v = 0;
      (err, v) = Str.parseInt(s);
      if (err) throw new FormatException("The input string '" + s + "' was not in a correct format.");
      return v;
   }
   public function long Int64_Parse(string s)
   {
      bool err = false;
      long v = 0L;
      (err, v) = Str.parseLong(s);
      if (err) throw new FormatException("The input string '" + s + "' was not in a correct format.");
      return v;
   }

   // ------------------------------------------------------------------------------------------- int? y los T?
   // (2-nov; Eduardo: «int? es Integer (la clase)») Un T? de C# es la caja de BP de su T, o null: Integer (el int, los
   // enteros estrechos y el char), Long, Float, Double y Boolean. Lo que C# hace con ellos (los operadores «elevados»),
   // aquí, una función por operación: el traductor las llama con cada operando ya en su caja, y así cada uno se calcula
   // una vez, como en C#. Con un null, la aritmética da null, y <, >, <= y >=, false; == compara los valores, y dos null
   // son iguales; y un null se escribe vacío.

   function void Nullable_SinValor() { throw new InvalidOperationException("Nullable object must have a value."); }

   /// x.Value y (int) x: el valor, o InvalidOperationException si es null, como .NET.
   public function int Nullable_Value(Integer x) { if (x == null) Nullable_SinValor(); return x.value(); }
   public function long Nullable_Value(Long x) { if (x == null) Nullable_SinValor(); return x.value(); }
   public function float Nullable_Value(Float x) { if (x == null) Nullable_SinValor(); return x.value(); }
   public function double Nullable_Value(Double x) { if (x == null) Nullable_SinValor(); return x.value(); }
   public function bool Nullable_Value(Boolean x) { if (x == null) Nullable_SinValor(); return x.value(); }

   /// x.GetValueOrDefault() y x.GetValueOrDefault(d).
   public function int Nullable_GetValueOrDefault(Integer x) { return x == null ? 0 : x.value(); }
   public function long Nullable_GetValueOrDefault(Long x) { return x == null ? 0L : x.value(); }
   public function float Nullable_GetValueOrDefault(Float x) { return x == null ? 0.0f : x.value(); }
   public function double Nullable_GetValueOrDefault(Double x) { return x == null ? 0.0 : x.value(); }
   public function bool Nullable_GetValueOrDefault(Boolean x) { return x == null ? false : x.value(); }
   public function int Nullable_GetValueOrDefault(Integer x, int d) { return x == null ? d : x.value(); }
   public function long Nullable_GetValueOrDefault(Long x, long d) { return x == null ? d : x.value(); }
   public function float Nullable_GetValueOrDefault(Float x, float d) { return x == null ? d : x.value(); }
   public function double Nullable_GetValueOrDefault(Double x, double d) { return x == null ? d : x.value(); }
   public function bool Nullable_GetValueOrDefault(Boolean x, bool d) { return x == null ? d : x.value(); }

   /// x.ToString(): vacío si es null; un número, en decimal, y un bool, True o False, como .NET.
   public function string Nullable_ToString(Integer x) { return x == null ? "" : "" + x.value(); }
   public function string Nullable_ToString(Long x) { return x == null ? "" : "" + x.value(); }
   public function string Nullable_ToString(Boolean x) { return x == null ? "" : (x.value() ? "True" : "False"); }

   /// Un T? escrito (Console.WriteLine, la suma de cadenas): vacío si es null; si no, como se escribe su valor.
   public function string Nullable_Texto(Integer x) { return x == null ? "" : "" + x.value(); }
   public function string Nullable_Texto(Long x) { return x == null ? "" : "" + x.value(); }
   public function string Nullable_Texto(Float x) { return x == null ? "" : "" + x.value(); }
   public function string Nullable_Texto(Double x) { return x == null ? "" : "" + x.value(); }
   public function string Nullable_Texto(Boolean x) { return x == null ? "" : "" + x.value(); }

   /// == (!= es su contrario): dos null, iguales; uno solo, distintos; si no, los valores.
   public function bool Nullable_Igual(Integer a, Integer b) { if (a == null || b == null) return a == null && b == null; return a.value() == b.value(); }
   public function bool Nullable_Igual(Long a, Long b) { if (a == null || b == null) return a == null && b == null; return a.value() == b.value(); }
   public function bool Nullable_Igual(Float a, Float b) { if (a == null || b == null) return a == null && b == null; return a.value() == b.value(); }
   public function bool Nullable_Igual(Double a, Double b) { if (a == null || b == null) return a == null && b == null; return a.value() == b.value(); }
   public function bool Nullable_Igual(Boolean a, Boolean b) { if (a == null || b == null) return a == null && b == null; return a.value() == b.value(); }

   /// <, >, <= y >=: false si alguno es null.
   public function bool Nullable_Menor(Integer a, Integer b) { return a != null && b != null && a.value() < b.value(); }
   public function bool Nullable_Menor(Long a, Long b) { return a != null && b != null && a.value() < b.value(); }
   public function bool Nullable_Menor(Float a, Float b) { return a != null && b != null && a.value() < b.value(); }
   public function bool Nullable_Menor(Double a, Double b) { return a != null && b != null && a.value() < b.value(); }
   public function bool Nullable_Mayor(Integer a, Integer b) { return a != null && b != null && a.value() > b.value(); }
   public function bool Nullable_Mayor(Long a, Long b) { return a != null && b != null && a.value() > b.value(); }
   public function bool Nullable_Mayor(Float a, Float b) { return a != null && b != null && a.value() > b.value(); }
   public function bool Nullable_Mayor(Double a, Double b) { return a != null && b != null && a.value() > b.value(); }
   public function bool Nullable_MenorIgual(Integer a, Integer b) { return a != null && b != null && a.value() <= b.value(); }
   public function bool Nullable_MenorIgual(Long a, Long b) { return a != null && b != null && a.value() <= b.value(); }
   public function bool Nullable_MenorIgual(Float a, Float b) { return a != null && b != null && a.value() <= b.value(); }
   public function bool Nullable_MenorIgual(Double a, Double b) { return a != null && b != null && a.value() <= b.value(); }
   public function bool Nullable_MayorIgual(Integer a, Integer b) { return a != null && b != null && a.value() >= b.value(); }
   public function bool Nullable_MayorIgual(Long a, Long b) { return a != null && b != null && a.value() >= b.value(); }
   public function bool Nullable_MayorIgual(Float a, Float b) { return a != null && b != null && a.value() >= b.value(); }
   public function bool Nullable_MayorIgual(Double a, Double b) { return a != null && b != null && a.value() >= b.value(); }

   /// + - * / %: null si alguno es null.
   public function Integer Nullable_Suma(Integer a, Integer b) { return a == null || b == null ? null : new Integer(a.value() + b.value()); }
   public function Long Nullable_Suma(Long a, Long b) { return a == null || b == null ? null : new Long(a.value() + b.value()); }
   public function Float Nullable_Suma(Float a, Float b) { return a == null || b == null ? null : new Float(a.value() + b.value()); }
   public function Double Nullable_Suma(Double a, Double b) { return a == null || b == null ? null : new Double(a.value() + b.value()); }
   public function Integer Nullable_Resta(Integer a, Integer b) { return a == null || b == null ? null : new Integer(a.value() - b.value()); }
   public function Long Nullable_Resta(Long a, Long b) { return a == null || b == null ? null : new Long(a.value() - b.value()); }
   public function Float Nullable_Resta(Float a, Float b) { return a == null || b == null ? null : new Float(a.value() - b.value()); }
   public function Double Nullable_Resta(Double a, Double b) { return a == null || b == null ? null : new Double(a.value() - b.value()); }
   public function Integer Nullable_Mult(Integer a, Integer b) { return a == null || b == null ? null : new Integer(a.value() * b.value()); }
   public function Long Nullable_Mult(Long a, Long b) { return a == null || b == null ? null : new Long(a.value() * b.value()); }
   public function Float Nullable_Mult(Float a, Float b) { return a == null || b == null ? null : new Float(a.value() * b.value()); }
   public function Double Nullable_Mult(Double a, Double b) { return a == null || b == null ? null : new Double(a.value() * b.value()); }
   public function Integer Nullable_Div(Integer a, Integer b) { return a == null || b == null ? null : new Integer(a.value() / b.value()); }
   public function Long Nullable_Div(Long a, Long b) { return a == null || b == null ? null : new Long(a.value() / b.value()); }
   public function Float Nullable_Div(Float a, Float b) { return a == null || b == null ? null : new Float(a.value() / b.value()); }
   public function Double Nullable_Div(Double a, Double b) { return a == null || b == null ? null : new Double(a.value() / b.value()); }
   public function Integer Nullable_Resto(Integer a, Integer b) { return a == null || b == null ? null : new Integer(a.value() % b.value()); }
   public function Long Nullable_Resto(Long a, Long b) { return a == null || b == null ? null : new Long(a.value() % b.value()); }

   /// & | ^ << >> de enteros: null si alguno es null; la cuenta de un desplazamiento, como C# (& 31 en un int, & 63 en
   /// un long).
   public function Integer Nullable_Y(Integer a, Integer b) { return a == null || b == null ? null : new Integer(a.value() & b.value()); }
   public function Long Nullable_Y(Long a, Long b) { return a == null || b == null ? null : new Long(a.value() & b.value()); }
   public function Integer Nullable_O(Integer a, Integer b) { return a == null || b == null ? null : new Integer(a.value() | b.value()); }
   public function Long Nullable_O(Long a, Long b) { return a == null || b == null ? null : new Long(a.value() | b.value()); }
   public function Integer Nullable_OEx(Integer a, Integer b) { return a == null || b == null ? null : new Integer(a.value() ^ b.value()); }
   public function Long Nullable_OEx(Long a, Long b) { return a == null || b == null ? null : new Long(a.value() ^ b.value()); }
   public function Integer Nullable_Izq(Integer a, Integer n) { return a == null || n == null ? null : new Integer(a.value() << (n.value() & 31)); }
   public function Long Nullable_Izq(Long a, Integer n) { return a == null || n == null ? null : new Long(a.value() << (n.value() & 63)); }
   public function Integer Nullable_Der(Integer a, Integer n) { return a == null || n == null ? null : new Integer(a.value() >> (n.value() & 31)); }
   public function Long Nullable_Der(Long a, Integer n) { return a == null || n == null ? null : new Long(a.value() >> (n.value() & 63)); }

   /// & | ^ de bool?, con la lógica de tres valores de C#: null & false es false, y null | true, true.
   public function Boolean Nullable_Y(Boolean a, Boolean b)
   {
      if ((a != null && !a.value()) || (b != null && !b.value())) return new Boolean(false);
      if (a == null || b == null) return null;
      return new Boolean(true);
   }
   public function Boolean Nullable_O(Boolean a, Boolean b)
   {
      if ((a != null && a.value()) || (b != null && b.value())) return new Boolean(true);
      if (a == null || b == null) return null;
      return new Boolean(false);
   }
   public function Boolean Nullable_OEx(Boolean a, Boolean b) { return a == null || b == null ? null : new Boolean(a.value() != b.value()); }

   /// -x, ~x y !x: null si es null.
   public function Integer Nullable_Menos(Integer x) { return x == null ? null : new Integer(-x.value()); }
   public function Long Nullable_Menos(Long x) { return x == null ? null : new Long(-x.value()); }
   public function Float Nullable_Menos(Float x) { return x == null ? null : new Float(-x.value()); }
   public function Double Nullable_Menos(Double x) { return x == null ? null : new Double(-x.value()); }
   public function Integer Nullable_NoBits(Integer x) { return x == null ? null : new Integer(x.value() ^ -1); }
   public function Long Nullable_NoBits(Long x) { return x == null ? null : new Long(x.value() ^ -1L); }
   public function Boolean Nullable_No(Boolean x) { return x == null ? null : new Boolean(!x.value()); }

   /// x++ y x--: null sigue null.
   public function Integer Nullable_Inc(Integer x) { return x == null ? null : new Integer(x.value() + 1); }
   public function Long Nullable_Inc(Long x) { return x == null ? null : new Long(x.value() + 1L); }
   public function Float Nullable_Inc(Float x) { return x == null ? null : new Float(x.value() + 1.0f); }
   public function Double Nullable_Inc(Double x) { return x == null ? null : new Double(x.value() + 1.0); }
   public function Integer Nullable_Dec(Integer x) { return x == null ? null : new Integer(x.value() - 1); }
   public function Long Nullable_Dec(Long x) { return x == null ? null : new Long(x.value() - 1L); }
   public function Float Nullable_Dec(Float x) { return x == null ? null : new Float(x.value() - 1.0f); }
   public function Double Nullable_Dec(Double x) { return x == null ? null : new Double(x.value() - 1.0); }

   /// De una caja a otra (int? a long?, long? a int?…): null sigue null; el valor, con la conversión de C# (a un
   /// entero, truncando; a uno estrecho, sus bits de abajo, como sin `checked`). El char? va como el ushort?.
   public function Long Nullable_ALong(Integer x) { return x == null ? null : new Long((long) x.value()); }
   public function Long Nullable_ALong(Float x) { return x == null ? null : new Long((long) x.value()); }
   public function Long Nullable_ALong(Double x) { return x == null ? null : new Long((long) x.value()); }
   public function Float Nullable_AFloat(Integer x) { return x == null ? null : new Float((float) x.value()); }
   public function Float Nullable_AFloat(Long x) { return x == null ? null : new Float((float) x.value()); }
   public function Float Nullable_AFloat(Double x) { return x == null ? null : new Float((float) x.value()); }
   public function Double Nullable_ADouble(Integer x) { return x == null ? null : new Double((double) x.value()); }
   public function Double Nullable_ADouble(Long x) { return x == null ? null : new Double((double) x.value()); }
   public function Double Nullable_ADouble(Float x) { return x == null ? null : new Double((double) x.value()); }
   public function Integer Nullable_AInteger(Long x) { return x == null ? null : new Integer((int) x.value()); }
   public function Integer Nullable_AInteger(Float x) { return x == null ? null : new Integer((int) x.value()); }
   public function Integer Nullable_AInteger(Double x) { return x == null ? null : new Integer((int) x.value()); }
   public function Integer Nullable_AByte(Integer x) { return x == null ? null : new Integer(x.value() & 255); }
   public function Integer Nullable_AByte(Long x) { return x == null ? null : new Integer((int) (x.value() & 255L)); }
   public function Integer Nullable_ASByte(Integer x) { return x == null ? null : new Integer(((x.value() & 255) ^ 128) - 128); }
   public function Integer Nullable_ASByte(Long x) { return x == null ? null : new Integer((((int) (x.value() & 255L)) ^ 128) - 128); }
   public function Integer Nullable_AShort(Integer x) { return x == null ? null : new Integer(((x.value() & 65535) ^ 32768) - 32768); }
   public function Integer Nullable_AShort(Long x) { return x == null ? null : new Integer((((int) (x.value() & 65535L)) ^ 32768) - 32768); }
   public function Integer Nullable_AUShort(Integer x) { return x == null ? null : new Integer(x.value() & 65535); }
   public function Integer Nullable_AUShort(Long x) { return x == null ? null : new Integer((int) (x.value() & 65535L)); }
   /// A un uint? (un uint es un long, de 0 a 4294967295): sus 32 bits de abajo.
   public function Long Nullable_AUInt(Integer x) { return x == null ? null : new Long(((long) x.value()) & 4294967295L); }
   public function Long Nullable_AUInt(Long x) { return x == null ? null : new Long(x.value() & 4294967295L); }
}
