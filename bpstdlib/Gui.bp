    end setItems

    public property selected: integer
      get
        return __guiGetValue(this.lvglId)
      endget
      set(v)
        __guiSetValue(this.lvglId, v)
      endset
    endprop
  end ListBox

  // ---- Keyboard — teclado en pantalla. Se ata a un Textarea con attach(); las
  //      teclas editan ese campo (que es quien dispara su onChange). ----
  public class Keyboard extends Component
    public function typeName(): string
      return "Keyboard"
    end typeName
    public function Keyboard(parent: Container)
      this.lvglId := __guiCreateKeyboard(parent.lvglId)
      this.attach(parent)
    end Keyboard

    // Ata el teclado al campo que edita. Se llamaba attach(): al llegar
    // Component.attach(padre) en G2-2 la llamada del usuario resolvia al de la
    // base y el teclado se quedaba SIN textarea, en silencio (medido 11-sep).
    public function setTextarea(ta: Textarea)
      __guiKeyboardSetTextarea(this.lvglId, ta.lvglId)
    end setTextarea
  end Keyboard

  // ---- Msgbox — aviso (diálogo NO modal). Mensaje + botones; al pulsar un botón
  //      dispara onChange y `result` = índice pulsado. Es ASÍNCRONO a propósito: un
  //      modal bloqueante colgaría el GUI (el handler corre en el mismo hilo que
  //      bombea; en LVGL single-thread = deadlock). El modal síncrono y "proceso
  //      largo desde evento" están pendientes (ver V3_BACKLOG: GUI-blocking-from-event). ----
  public class Msgbox extends Component
    public function typeName(): string
      return "Msgbox"
    end typeName
    public function jsonProps(o: Json.JsonObject)
      var t: string := __guiGetText(this.lvglId)
      if strlen(t) > 0 then o.put("text", Json.JsonString(t))
    end jsonProps
    public function Msgbox(parent: Container, message: string)
      this.lvglId := __guiCreateMsgbox(parent.lvglId)
      __guiSetText(this.lvglId, message)
      this.attach(parent)
    end Msgbox

    public function setButtons(labels: string)
      __guiSetButtons(this.lvglId, labels)
    end setButtons

    // Índice del botón pulsado (válido tras dispararse onChange).
    public property result: integer
      get
        return __guiGetValue(this.lvglId)
      endget
      set(v)
        __guiSetValue(this.lvglId, v)
      endset
    endprop
  end Msgbox

  // ---- TabPage — página de un Tabview. NO se construye directamente: la devuelve
  //      Tabview.addTab(), envolviendo el handle de la página que crea el backend
  //      (mismo patrón que Screen, que envuelve el handle de la pantalla activa).
  //      Se usa como `parent` de los widgets de esa pestaña. ----
  public class TabPage extends Container
    public function typeName(): string
      return "TabPage"
    end typeName
    public function TabPage(pageId: integer)
      super()
      this.lvglId := pageId
    end TabPage
  end TabPage

  // ---- Tabview — contenedor de pestañas. addTab(nombre) añade una pestaña y
  //      devuelve su página (TabPage, usable como parent). El cambio de pestaña
  //      activa dispara onChange; `active` = índice de la pestaña activa. ----
  public class Tabview extends Container
    public function typeName(): string
      return "Tabview"
    end typeName
    public function Tabview(parent: Container)
      super()
      this.lvglId := __guiCreateTabview(parent.lvglId)
      this.attach(parent)
    end Tabview

    public function addTab(name: string): TabPage
      var p: TabPage := TabPage(__guiTabviewAddTab(this.lvglId, name))
      p.attach(this)                      // V6/G2: la pagina cuelga del Tabview
      return p
    end addTab

    public property active: integer
      get
        return __guiGetValue(this.lvglId)
      endget
      set(v)
        __guiSetValue(this.lvglId, v)
      endset
    endprop
  end Tabview

  // ---- Table — rejilla de celdas de texto (filas×columnas). setGrid fija el
  //      tamaño; setCell/getCell acceden a cada celda. (Solo datos; sin onChange
  //      en este subconjunto — la edición/selección de celda sería repesca.) ----
  // ---- Chart (H7) — gráfica de series. Pensada para sensores: se declara una
  //      ventana de N muestras (setPointCount), se añade una serie por magnitud
  //      (addSeries) y en cada lectura se hace push(), que DESPLAZA la ventana y
  //      mete la muestra al final. El eje Y se fija con setRange (heredado de
  //      Component), y setValue() sirve para rellenar un conjunto de datos ya
  //      conocido en vez de ir en streaming. ----
  public class Chart extends Component
    public function typeName(): string
      return "Chart"
    end typeName
    // Tipos de gráfica para setType().
    public const Chart.LINE := 0
    public const Chart.BARS := 1
    // Máximo de series por gráfica (mismo tope en las dos VMs).
    public const Chart.MAX_SERIES := 8

    public function Chart(parent: Container)
      this.lvglId := __guiCreateChart(parent.lvglId)
    end Chart

    // Rango del eje Y. Usa el intrínseco genérico de rango (el mismo de
    // slider/bar/spinbox), que en un chart aplica al eje Y primario.
    public function setRange(mn: integer, mx: integer)
      __guiSetRange(this.lvglId, mn, mx)
    end setRange

    // Nº de muestras visibles (la ventana). Conserva los datos que sigan cabiendo.
    public function setPointCount(n: integer)
      __guiChartSetPoints(this.lvglId, n)
    end setPointCount

    // Añade una serie del color dado; devuelve su índice (o -1 si se pasó del tope).
    public function addSeries(rgb: integer): integer
      return __guiChartAddSeries(this.lvglId, rgb)
    end addSeries

    // Desplaza la serie una muestra y añade `v` al final. El uso típico.
    public function push(series: integer, v: integer)
      __guiChartPush(this.lvglId, series, v)
    end push

    // Fija un punto concreto (para datos ya conocidos, no streaming).
    public function setValue(series: integer, idx: integer, v: integer)
      __guiChartSetValue(this.lvglId, series, idx, v)
    end setValue

    // LINE o BARS.
    public function setType(t: integer)
      __guiChartSetType(this.lvglId, t)
    end setType
  end Chart

  public class Table extends Component
    public function typeName(): string
      return "Table"
    end typeName
    public function Table(parent: Container)
      this.lvglId := __guiCreateTable(parent.lvglId)
    end Table

    public function setGrid(rows: integer, cols: integer)
      __guiTableSetGrid(this.lvglId, rows, cols)
    end setGrid

    public function setCell(row: integer, col: integer, text: string)
      __guiTableSetCell(this.lvglId, row, col, text)
    end setCell

    public function getCell(row: integer, col: integer): string
      return __guiTableGetCell(this.lvglId, row, col)
    end getCell
  end Table

  // ---- Image — el bitmap en memoria (cargado de archivo una vez con loadFile).
  //      NO es un Component: es un asset, no está en el árbol de widgets. Varias
  //      ImageView pueden compartir la misma Image (ahorra memoria). El decode
  //      real de píxeles es del backend (Swing ImageIO / LVGL+lodepng); en host
  //      el modelo saca width/height del header del PNG (sin decoder). ----
  public class Image
    // id del asset en el registro del backend. 0 = sin crear.
    public property assetId: integer

    public function Image()
      this.assetId := __guiImageNew()
    end Image

    // Carga un PNG desde archivo. true si la cabecera es válida.
    public function loadFile(path: string): boolean
      return __guiImageLoadFile(this.assetId, path) != 0
    end loadFile

    // Dimensiones intrínsecas del PNG (0 si no cargado).
    public function width(): integer
      return __guiImageWidth(this.assetId)
    end width
    public function height(): integer
      return __guiImageHeight(this.assetId)
    end height
  end Image

  // ---- ImageView — control visual que muestra una Image (asignada con
  //      setImage). Component normal (geometría, scroll, onClick). Varias
  //      ImageView pueden apuntar a la misma Image. ----
  public class ImageView extends Component
    public function typeName(): string
      return "ImageView"
    end typeName
    public function ImageView(parent: Container)
      this.lvglId := __guiCreateImageView(parent.lvglId)
      this.attach(parent)
    end ImageView

    public function setImage(img: Image)
      __guiImageViewSetImage(this.lvglId, img.assetId)
    end setImage

    // refresh: recarga la imagen SOLO si el asset cambió (loadFile la actualizó
    // o se asignó otra Image). Si no hay cambios, no recarga — solo invalida.
    public function refresh()
      __guiImageViewRefresh(this.lvglId)
      __guiRefresh(this.lvglId)
    end refresh
  end ImageView

  // ---- Dispatch del upcall: la VM llama aquí (por NOMBRE, resolveGlobal) al
  //      pulsar/cambiar un widget. La VM no sabe de eventos: sólo entrega el
  //      widget, y __fireClick/__fireChange (métodos de Component, #324) son los
  //      que levantan el evento — tienen que estar dentro de la clase porque
  //      `raise` dispara los eventos de `this`. Dos dispatchers (sin rama en BP): la VM elige
  //      según el tipo de evento. ----
  public function __guiDispatch(self: Component)
    self.__fireClick()
  end __guiDispatch

  public function __guiDispatchChange(self: Component)
    self.__fireChange()
  end __guiDispatchChange

  // ---- run — lazo de eventos (bloquea: refresca y entrega los onClick/onChange).
  //
  // #324 — EL LAZO VIVE AQUÍ, EN BP, no dentro del builtin. Antes esto era un
  // __guiRun() que bombeaba hasta cerrar la ventana SIN devolver, y mientras
  // tanto la VM entera estaba parada: ni avanzaban los threads ni se drenaba la
  // cola de eventos. El scheduler sólo inyecta el frame de un handler ENTRE
  // quanta (events.c lo exige: "el thread NO puede estar corriendo"), y dentro
  // del builtin no hay ningún quantum.
  //
  // Con el lazo aquí, cada vuelta es una frontera de instrucción → el scheduler
  // drena. Es la misma forma que recomienda LVGL (while(1){ lv_timer_handler();
  // delay(); }) — y desde #462, TAMBIEN en la espera: LVGL dice cuanto falta y
  // el lazo lo duerme, que es lo que hace ese patron correcto.
  //
  // __guiRunOnce (#462): -1 = "no queda nada, sal"; >= 0 = "vuelve dentro de N
  // ms". Antes devolvia un booleano y se comia la espera por dentro.
  // Medido en samples/GuiEvSpike.bp — sin este lazo, un evento levantado desde
  // el upcall del GUI no se drenaba JAMÁS. ----
  public intrinsic function __guiRunOnce(): integer

  // ---- V6/G1 — EL LAZO, EN SU PROPIO HILO BP ----------------------------------
  //
  // Idea de Eduardo (23-ago), decidida el 6-sep: *«crear nuestro propio bucle
  // corriendo en su propio Thread BP; de esta forma no habra ningun problema de
  // ajustar el bucle, interrumpirlo o salir del programa»*.
  //
  // POR QUE HILO BP Y NO EL HILO `io` (decision de A1.6): todos los hilos BP
  // corren sobre la MISMA tarea de SO (`vm`), interleavados por el scheduler
  // entre quanta. Asi LVGL se sigue llamando desde UN SOLO hilo de SO, que es lo
  // que exige (no es reentrante). Con `io` habria un segundo hilo tocandolo.
  //
  // Y SALIR DEL PROGRAMA SALE GRATIS: el scheduler para cuando no queda NINGUN
  // hilo vivo, no cuando Main vuelve. Asi que el hilo del GUI mantiene vivo el
  // programa por si solo, y `Gui.start()` es de verdad util.
  //
  // OJO A LA PILA: el lazo despacha los handlers del usuario (onClick/onChange
  // se llaman desde dentro de __guiRunOnce), asi que corren en la pila de ESTE
  // hilo. Por eso 8 KB y no la de un hilo de calculo.
  class HiloGui extends Thread
    // El estado del lazo vive AQUI y no en el modulo: una clase no puede leer
    // un `var` de modulo que no sea publico, y publicarlo iria contra la norma
    // de la casa (#143: «sin variables publicas; lo publico es property»). Y
    // ademas es su sitio: lo que se para es ESTE hilo.
    var parar: boolean

    public function HiloGui()
      super(8192)
      this.parar := false
    end HiloGui

    // Lo llama otro hilo (o un handler del propio GUI). No espera.
    public function pedirParada()
      this.parar := true
    end pedirParada

    public function run()
      // SIN `sleep` AQUI, y es a proposito. Yo habia apuntado como hallazgo que
      // «el lazo no duerme»: es FALSO. La espera la pone el BOMBEO, y la pone
      // cada plataforma como le toca — SDL_Delay(16) en el host, vTaskDelay con
      // el idle que sugiere LVGL en el C6 y el P4, __WFI() en el STM32. Y el
      // comentario de miVM dice por que ese es el sitio: «puesto donde el bombeo
      // puede pagarlo sin que el lazo BP tenga que saber de tiempos».
      // Poner otro `sleep` aqui no ajusta el ritmo: lo EMPEORA, porque suma una
      // segunda espera a la que ya hay.
      // #462 - LA PAUSA LA DUERME ESTE HILO BP, no el bombeo.
      //
      // Antes el bombeo se comia la espera por dentro (SDL_Delay(16) en el
      // host, vTaskDelay en el P4, __WFI en el STM32, Thread.sleep(15) en
      // miVM). Y esa espera NO es del hilo BP: todos los hilos BP corren sobre
      // la MISMA tarea de SO, asi que dormir ahi congelaba la VM entera. Se
      // midio (samples/GuiHambre.bp): un hilo testigo corria 85 veces en 3
      // segundos mientras el GUI bombeaba al lado.
      //
      // Ahora __guiRunOnce() hace el trabajo y DEVUELVE el ocio que le dice
      // LVGL: -1 = "no queda nada", >= 0 = "vuelve dentro de N ms". Y quien
      // duerme es este lazo, con un `sleep` de BP -que bloquea SOLO este hilo
      // BP y le pasa el testigo al siguiente-. Eduardo: «si no hay nada
      // pendiente lo que tiene que hacer es una pausa y el sistema de Threads
      // le ha de pasar el testigo al siguiente».
      var ocio: integer := 0
      while not this.parar do
        ocio := __guiRunOnce()
        if ocio < 0 then
          this.parar := true
        else
          if ocio > 0 then
            sleep(ocio)
          endif
        endif
      endwh
    end run
  end HiloGui

  var hilo: HiloGui           // sin inicializador: un var de modulo solo admite literal

  // ---- start — arranca el lazo y VUELVE. El programa sigue vivo mientras el
  //      hilo lo este, asi que Main puede terminar. ----
  public function start()
    if hilo != null then
      return
    endif
    hilo := HiloGui()
    hilo.start()
  end start

  // ---- stop — pide al lazo que termine. Lo puede llamar otro hilo (o un
  //      handler del propio GUI). No espera: usa join() si lo necesitas. ----
  public function stop()
    if hilo != null then
      hilo.pedirParada()
    endif
  end stop

  // ---- join — espera a que el lazo termine. ----
  public function join()
    if hilo != null then
      hilo.join()
      hilo := null
    endif
  end join


  // ---- run — SIGUE SIENDO SINCRONO: arranca el hilo y lo espera. Decision de
  //      Eduardo, y no puede ser de otra forma: varios samples imprimen DESPUES
  //      de `run()` y dependen de que bloquee (GuiCheckDemo, GuiClickDemo,
  //      GuiEvLat). Un programa que hoy funciona no se entera de este cambio. ----
  public function run()
    start()
    join()
  end run

  // ---- loadFont — carga una fuente .bin (LVGL binfont) desde el FS del proyecto
  //      y devuelve su id (1-based). Aplícala con widget.setFont(id). La ruta se
  //      resuelve relativa al cwd y, si no existe, en /app (resources subidos al
  //      device). El host LVGL la dibuja; en miVM/Swing el id es válido pero el
  //      texto sale con la fuente por defecto. 0 = registro lleno. ----
  public function loadFont(path: string): integer
    return __guiLoadFont(path)
  end loadFont

  // ---- setRotation — orientación del display en grados: 0, 90, 180 o 270 (otros
  //      valores se ignoran). En placa el giro lo hace el display (p.ej. panel
  //      portrait usado apaisado con 90/270) y el táctil se ajusta solo; en el host
  //      (miVM/Swing y VM-C/SDL) intercambia el aspecto de la pantalla. Llamable en
  //      cualquier momento; lo natural es al principio, antes de crear widgets. ----
  public function setRotation(deg: integer)
    __guiSetRotation(deg)
  end setRotation

  // ============================================================
  // H13.1 — Forms (Camino A): una ventana = clase Window + un fichero .win (JSON
  // con el árbol de componentes). Los handlers son MÉTODOS de la ventana; el .win
  // los referencia por nombre y el IDE hornea su SLOT de vtable (resuelto vía
  // .bpi/slotOf) como `clicSlot`/`changeSlot`. El loader ata cada widget a la
  // ventana por ese slot; al disparar el evento, Component.onClick/onChange
  // despacha con __guiInvokeBySlot. Handler ausente (slot -1) → se ignora.
  // ============================================================
  public class Window extends Container
    public function typeName(): string
      return "Window"
    end typeName
    public function Window()
      super()
      var scr: integer := __guiScreenActive()
      this.lvglId := __guiCreateObj(scr)                   // contenedor raíz propio
      this.width  := __guiGetWidth(scr)                    // ocupa toda la pantalla
      this.height := __guiGetHeight(scr)
      this.attach(null)
    end Window

    // Carga un .win (JSON), construye el árbol de widgets bajo el raíz y
    // devuelve el widget raíz del form (útil para refrescar/inspeccionar).
    public function load(path: string): Component
      var root: Json.JsonValue := Json.readJsonFile(path)
      var node: Json.JsonObject := root.asObject()
      var w: Component := buildForm(node, this, this)
      // El widget raíz ocupa toda la pantalla salvo que el .win le dé tamaño
      // explícito → un form sin medidas llena la pantalla (no un recuadro).
      var scr: integer := __guiScreenActive()
      if not node.has("width") then  w.width := __guiGetWidth(scr)
      if not node.has("height") then w.height := __guiGetHeight(scr)
      return w
    end load

    // Destruye la ventana → el backend cascadea y borra todo el subárbol.
    public function destroy()
      this.delete()
    end destroy
  end Window

  // buildForm — recursivo: crea el widget del nodo, fija sus props comunes, suscribe
  // sus handlers (por NOMBRE, resuelto en ejecución) y baja a los hijos. Función de
  // módulo PRIVADA (la recursión usa resolución por nombre con fixup tardío).
  public function buildForm(node: Json.JsonObject, parent: Container, win: Window): Component
    var t: string := node.getStringOr("type", "Panel")
    var w: Component := makeWidget(t, parent, node)
    applyCommon(w, node)
    // #324 tanda 2b — TODO sale del NOMBRE, en ejecución. El .win ya no lleva
    // slots horneados: un slot en un fichero es un número congelado que miente
    // en cuanto la clase cambia, y encima obligaba a pasar por el IDE para algo
    // que la VM puede resolver sola (idea de Eduardo).
    //
    // Un nombre, todo lo demás se deriva:
    //     "name": "boton1"  →  property boton1 de la ventana  (setBoton1)
    //                       →  handlers boton1_onClick / boton1_onChange
    //
    // __guiSlotOf pregunta a la tabla `Clase#metodo#slot` que el .mod ya trae.
    // -1 = no existe, y no pasa nada: una ventana no tiene por qué declarar la
    // property de cada widget ni atender todos sus eventos.
    var nom: string := node.getStringOr("name", "")
    if strlen(nom) > 0 then bindMember(win, w, nom)
    bindHandler(win, w, nom, node)
    if node.has("children") then
      // V6/G2: solo un Container tiene hijos. Si el .win cuelga algo de una hoja
      // (un Label con children), el cast GRITA aqui en vez de crear algo raro.
      // (el cast Clase(x) solo se admite desde Object: se pasa por ahi, #492)
      var o: Object := w
      var cont: Container := Container(o)
      var arr: Json.JsonArray := node.getArray("children")
      var i: integer := 0
      while i < arr.length() do
        var child: Json.JsonValue := arr.at(i)
        buildForm(child.asObject(), cont, win)
        i := i + 1
      endwh
    endif
    return w
  end buildForm

  // bindMember — ata el widget a la property de la ventana que lleva su nombre
  // (modelo Swing: la clase DECLARA sus componentes y el form los construye
  // sobre esas declaraciones). La property puede ser PRIVADA — es lo suyo, son
  // las tripas de la ventana — y aun así su accesor tiene slot, que es lo único
  // que hace falta. Sin property con ese nombre: -1, y no pasa nada.
  // OJO con el subconjunto: la VM-C no tiene upper()/lower() — Str.bp lo avisa
  // en su cabecera y por eso tampoco los usa. La inicial se sube a mano con
  // charCodeAt + __charsToString, que sí están en las 3 VMs.
  function bindMember(win: Window, w: Component, nom: string)
    var n: integer := strlen(nom)
    if n == 0 then return
    var cs: integer[] := newIntArray(n)
    var i: integer := 0
    while i < n do
      cs[i] := charCodeAt(nom, i)
      i := i + 1
    endwh
    if (cs[0] >= 97) and (cs[0] <= 122) then cs[0] := cs[0] - 32
    var slot: integer := __guiSlotOf(win, "set" + __charsToString(cs, n))
    if slot >= 0 then __guiInvokeBySlot(win, slot, w)
  end bindMember

  // bindHandler — ata los eventos del widget a métodos de la ventana, SIEMPRE
  // resolviendo el nombre en carga (__guiSlotOf). Dos formas, y ninguna necesita
  // que el IDE hornee nada:
  //
  //   "name": "boton1"          → se DERIVA boton1_onClick / boton1_onChange.
  //                               La convención deja de ser cosmética: es lo
  //                               que evita que los dos nombres se desincronicen.
  //   "clic": "onSaludar"       → handler nombrado a mano. Manda sobre el
  //                               derivado, para poder salirse de la convención
  //                               cuando haga falta (y es lo que hace formdemo).
  //
  // #324 tanda 2c — SUSCRIBE EL EVENTO DE VERDAD. Antes esto guardaba su propio
  // (receptor, slot) en tres campos del widget y __fireClick llamaba por slot: los
  // mismos dos datos que el evento ya guarda, escritos dos veces. Ahora se usa la
  // forma __methodRef(obj, "nombre") — como `obj::metodo` pero con el nombre
  // resuelto en EJECUCION, que es lo que hace falta cuando sale de un .win.
  //
  // NOMBRE EXPLICITO que no existe -> se suscribe igual, con slot -1. Al pulsar,
  // el despachador dira "slot no resoluble" y descartara: lo pediste y no esta,
  // asi que se ve. NOMBRE DERIVADO por convencion que no existe -> no se suscribe
  // y en silencio: es el caso normal (un boton no tiene onChange), y quejarse ahi
  // seria un aviso por cada widget de cada form.
  function bindHandler(win: Window, w: Component, nom: string, node: Json.JsonObject)
    var nClic: string := node.getStringOr("clic", "")
    var nChange: string := node.getStringOr("change", "")
    var clicExplicito: boolean := strlen(nClic) > 0
    var changeExplicito: boolean := strlen(nChange) > 0
    if clicExplicito or changeExplicito then       // V6/G2-4: toJson() los devuelve
      var hc: string := ""
      var hch: string := ""
      if clicExplicito then hc := nClic
      if changeExplicito then hch := nChange
      w.setHandlerNames(hc, hch)
    endif
    if (not clicExplicito) and (strlen(nom) > 0) then   nClic := nom + "_onClick"
    if (not changeExplicito) and (strlen(nom) > 0) then nChange := nom + "_onChange"

    if strlen(nClic) > 0 then
      if clicExplicito or __guiSlotOf(win, nClic) >= 0 then
        w.onClick := __methodRef(win, nClic)
      endif
    endif
    if strlen(nChange) > 0 then
      if changeExplicito or __guiSlotOf(win, nChange) >= 0 then
        w.onChange := __methodRef(win, nChange)
      endif
    endif
  end bindHandler

  // makeWidget — tipo (string) → constructor. Las props específicas del widget
  // (text/value/checked/min/max) se fijan aquí, con el tipo concreto en mano.
  function makeWidget(t: string, parent: Container, node: Json.JsonObject): Component
    if t == "Panel" then
      return Panel(parent)
    endif
    if t == "Label" then
      return Label(parent, node.getStringOr("text", ""))
    endif
    if t == "Button" then
      return Button(parent, node.getStringOr("text", ""))
    endif
    if t == "Checkbox" then
      var cb: Checkbox := Checkbox(parent, node.getStringOr("text", ""))
      cb.checked := node.getBoolOr("checked", false)
      return cb
    endif
    if t == "Toggle" then
      var tg: Toggle := Toggle(parent)
      tg.checked := node.getBoolOr("checked", false)
      return tg
    endif
    if t == "Slider" then
      var sl: Slider := Slider(parent)
      sl.setRange(node.getIntOr("min", 0), node.getIntOr("max", 100))
      sl.value := node.getIntOr("value", 0)
      return sl
    endif
    if t == "Textarea" then
      var ta: Textarea := Textarea(parent)
      ta.text := node.getStringOr("text", "")
      return ta
    endif
    if t == "Bar" then
      var br: Bar := Bar(parent)
      br.setRange(node.getIntOr("min", 0), node.getIntOr("max", 100))
      br.value := node.getIntOr("value", 0)
      return br
    endif
    if t == "Spinbox" then
      var sp: Spinbox := Spinbox(parent)
      sp.setRange(node.getIntOr("min", 0), node.getIntOr("max", 100))
      sp.value := node.getIntOr("value", 0)
      return sp
    endif
    if t == "Led" then
      var ld: Led := Led(parent)
      ld.value := node.getIntOr("value", 0)
      return ld
    endif
    if t == "Dropdown" then
      var dd: Dropdown := Dropdown(parent)
      dd.setOptions(node.getStringOr("options", ""))
      dd.selected := node.getIntOr("selected", 0)
      return dd
    endif
    if t == "ListBox" then
      var lb: ListBox := ListBox(parent)
      lb.setItems(node.getStringOr("items", ""))
      lb.selected := node.getIntOr("selected", 0)
      return lb
    endif
    if t == "Msgbox" then
      var mb: Msgbox := Msgbox(parent, node.getStringOr("text", ""))
      if node.has("buttons") then mb.setButtons(node.getStringOr("buttons", "OK"))
      return mb
    endif
    print "[Gui] aviso: widget desconocido '" + t + "' en el form (uso Panel)"
    return Panel(parent)
  end makeWidget

  // applyCommon — props comunes (geometría/align/fuente), todas en Component.
  function applyCommon(w: Component, node: Json.JsonObject)
    // #324 tanda 2 — el NOMBRE del componente. La property existía y estaba
    // documentada ("el .win lo pone con name") pero nadie la rellenaba: estaba
    // a medio construir. Es la pieza sobre la que se apoya todo lo demás —
    // la property de la ventana que lo sostiene y sus handlers se llaman IGUAL.
    if node.has("name") then     w.name := node.getStringOr("name", "")
    // V6/G2-4 — con "align", x/y son DESPLAZAMIENTOS del ancla (lo que LVGL llama
    // offset), no una posicion. Antes se aplicaban como posicion y luego align(…,0,0)
    // los pisaba: el `"y": 12` de main.win no llegaba al modelo (medido 11-sep).
    if node.has("align") then
      w.align(alignFromName(node.getStringOr("align", "CENTER")), node.getIntOr("x", 0), node.getIntOr("y", 0))
    else
      if node.has("x") then
        w.x := node.getIntOr("x", 0)
      endif
      if node.has("y") then
        w.y := node.getIntOr("y", 0)
      endif
    endif
    if node.has("width") then    w.width := node.getIntOr("width", 0)
    if node.has("height") then   w.height := node.getIntOr("height", 0)
    if node.has("fontSize") then w.fontSize := node.getIntOr("fontSize", 0)
    if node.has("bgColor") then   w.setBgColor(Color(colorFromHex(node.getStringOr("bgColor", "0"))))
    if node.has("textColor") then w.setTextColor(Color(colorFromHex(node.getStringOr("textColor", "0"))))
  end applyCommon

  // colorFromHex — "0xRRGGBB" / "RRGGBB" → entero 0xRRGGBB (0 si inválido). Para el
  // color del .win (JSON no tiene literales hex, así que va como string). Inline para
  // no añadir dependencia de Str a Gui; usa los globales strlen/charCodeAt.
  function colorFromHex(s: string): integer
    var n: integer := strlen(s)
    var i: integer := 0
    if (n >= 2) and (charCodeAt(s, 0) == 48) and ((charCodeAt(s, 1) == 120) or (charCodeAt(s, 1) == 88)) then
      i := 2
    endif
    var acc: integer := 0
    while i < n do
      var c: integer := charCodeAt(s, i)
      var d: integer := -1
      if (c >= 48) and (c <= 57) then
        d := c - 48
      elseif (c >= 97) and (c <= 102) then
        d := (c - 97) + 10
      elseif (c >= 65) and (c <= 70) then
        d := (c - 65) + 10
      endif
      if d < 0 then
        return 0
      endif
      acc := acc * 16 + d
      i := i + 1
    endwh
    return acc
  end colorFromHex

  // alignName — constante de Align → string del .win (inverso de alignFromName).
  public function alignName(a: integer): string
    if a == 0 then return "TOP_LEFT"
    if a == 1 then return "TOP_MID"
    if a == 2 then return "TOP_RIGHT"
    if a == 3 then return "LEFT_MID"
    if a == 5 then return "RIGHT_MID"
    if a == 6 then return "BOTTOM_LEFT"
    if a == 7 then return "BOTTOM_MID"
    if a == 8 then return "BOTTOM_RIGHT"
    return "CENTER"
  end alignName

  // alignFromName — string del .win → constante de Align (default CENTER).
  function alignFromName(a: string): integer
    if a == "TOP_LEFT" then return 0
    if a == "TOP_MID" then return 1
    if a == "TOP_RIGHT" then return 2
    if a == "LEFT_MID" then return 3
    if a == "RIGHT_MID" then return 5
    if a == "BOTTOM_LEFT" then return 6
    if a == "BOTTOM_MID" then return 7
    if a == "BOTTOM_RIGHT" then return 8
    return 4   // CENTER
  end alignFromName

end Gui
