  // ---- Textarea — campo de texto editable. El contenido se lee/escribe con
  //      `text`; la edición dispara onChange. ----
  public class Textarea extends Component
    public function typeName(): string
      return "Textarea"
    end typeName
    public function jsonProps(o: Json.JsonObject)
      if strlen(this.text) > 0 then o.put("text", Json.JsonString(this.text))
      if this.readOnly then o.put("readOnly", Json.JsonBool(true))
    end jsonProps
    public function Textarea(parent: Container)
      this.lvglId := __guiCreateTextarea(parent.lvglId)
      this.attach(parent)
    end Textarea

    public property text: string
      get
        return __guiGetText(this.lvglId)
      endget
      set(v)
        __guiSetText(this.lvglId, v)
      endset
    endprop

    // readOnly: muestra el texto sin cursor y no editable (para inputbox de solo
    // lectura; un textarea sin teclado con cursor confunde). true = solo lectura.
    public property readOnly: boolean
      get
        return __guiTextareaGetReadonly(this.lvglId) != 0
      endget
      set(v)
        if v then
          __guiTextareaSetReadonly(this.lvglId, 1)
        else
          __guiTextareaSetReadonly(this.lvglId, 0)
        endif
      endset
    endprop
  end Textarea

  // ---- ListBox — lista vertical de ítems seleccionables. Ítems \n-separados
  //      (setItems); el índice elegido se lee/escribe con `selected` y el cambio
  //      de selección dispara onChange. (Mismo modelo que Dropdown, render vertical;
  //      se llama ListBox porque `List` es un tipo built-in de colecciones.) ----
  public class ListBox extends Component
    public function typeName(): string
      return "ListBox"
    end typeName
    public function jsonProps(o: Json.JsonObject)
      if this.selected != 0 then o.put("selected", Json.JsonInt(this.selected))
    end jsonProps
    public function ListBox(parent: Container)
      this.lvglId := __guiCreateList(parent.lvglId)
      this.attach(parent)
    end ListBox

    public function setItems(items: string)
