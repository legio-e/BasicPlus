// ============================================================
// Gui.bp — API gráfico de BasicPlus (V3). Contrato OO ÚNICO, idéntico en
// las 3 VMs; cada VM lo cumple con su backend — Swing en miVM, LVGL en la
// VM-C (host SDL y micro TFT). Las clases son BINDINGS sobre un `lvglId`
// (id del objeto espejo, lo asigna el MODELO → idéntico en las 3 VMs). Las
// llamadas a la VM van por funciones `intrinsic` (inline → CALL_BUILTIN);
// la VM es quien llama a LVGL/Swing.
//
// Jerarquía (V3/H6): Object (lenguaje) -> Component (base visual) -> widgets.
// Norma: todo desciende de Object (sin `extends` → implícito); sin variables
// públicas (lo público es `property`, #143).
// ============================================================
module Gui
import Json
import Collections   // V6/G2: la OwnerList de hijos de Container
import Core          // V6/G2: OwnerList extends Core.List — el import no es transitivo

  // ---- Frontera BP↔backend: intrínsecos (inline → CALL_BUILTIN). La VM
  //      los implementa (Swing/LVGL). No los llama el usuario: usa las
  //      clases de abajo. ----
  public intrinsic function __guiScreenActive(): integer
  public intrinsic function __guiCreateObj(parent: integer): integer
  public intrinsic function __guiCreateLabel(parent: integer): integer
  public intrinsic function __guiCreateButton(parent: integer): integer
  public intrinsic function __guiCreateCheckbox(parent: integer): integer
  public intrinsic function __guiSetText(handle: integer, t: string)
  public intrinsic function __guiSetChecked(handle: integer, v: boolean)
  public intrinsic function __guiGetChecked(handle: integer): boolean
  // Value-widgets enteros (slider, bar, ...): valor + rango (el backend clampa).
  public intrinsic function __guiCreateSwitch(parent: integer): integer
  public intrinsic function __guiCreateSlider(parent: integer): integer
  public intrinsic function __guiCreateBar(parent: integer): integer
  public intrinsic function __guiCreateSpinbox(parent: integer): integer
  public intrinsic function __guiCreateLed(parent: integer): integer
  public intrinsic function __guiSetValue(handle: integer, v: integer)
  public intrinsic function __guiGetValue(handle: integer): integer
  public intrinsic function __guiSetRange(handle: integer, mn: integer, mx: integer)
  // Selección/entrada: dropdown (opciones \n-separadas + índice) y textarea (texto).
  public intrinsic function __guiCreateDropdown(parent: integer): integer
  public intrinsic function __guiSetOptions(handle: integer, opts: string)
  public intrinsic function __guiCreateTextarea(parent: integer): integer
  public intrinsic function __guiGetText(handle: integer): string
  public intrinsic function __guiTextareaSetReadonly(handle: integer, ro: integer)
  public intrinsic function __guiTextareaGetReadonly(handle: integer): integer
  // Lista (ítems \n-sep + índice; reusa setOptions/value) y teclado en pantalla.
  public intrinsic function __guiCreateList(parent: integer): integer
  public intrinsic function __guiCreateKeyboard(parent: integer): integer
  public intrinsic function __guiKeyboardSetTextarea(handle: integer, ta: integer)
  // Msgbox (aviso): mensaje (setText) + botones \n-sep; el botón pulsado → value.
  public intrinsic function __guiCreateMsgbox(parent: integer): integer
  public intrinsic function __guiSetButtons(handle: integer, labels: string)
  // Tabview: pestañas; addTab crea una página (handle) que se envuelve en TabPage.
  public intrinsic function __guiCreateTabview(parent: integer): integer
  public intrinsic function __guiTabviewAddTab(handle: integer, name: string): integer
  // Table: rejilla de celdas (filas×columnas) de texto.
  // H7 — Chart. El eje Y usa __guiSetRange (genérico) y el repintado __guiRefresh.
  public intrinsic function __guiCreateChart(parent: integer): integer
  public intrinsic function __guiChartSetPoints(handle: integer, n: integer)
  public intrinsic function __guiChartAddSeries(handle: integer, rgb: integer): integer
  public intrinsic function __guiChartPush(handle: integer, series: integer, v: integer)
  public intrinsic function __guiChartSetValue(handle: integer, series: integer, idx: integer, v: integer)
  public intrinsic function __guiChartSetType(handle: integer, t: integer)

  public intrinsic function __guiCreateTable(parent: integer): integer
  public intrinsic function __guiTableSetGrid(handle: integer, rows: integer, cols: integer)
  public intrinsic function __guiTableSetCell(handle: integer, row: integer, col: integer, text: string)
  public intrinsic function __guiTableGetCell(handle: integer, row: integer, col: integer): string
  // Image: asset (bitmap) cargado de archivo, separado del control que lo muestra.
  public intrinsic function __guiImageNew(): integer
  public intrinsic function __guiImageLoadFile(handle: integer, path: string): integer
  public intrinsic function __guiImageWidth(handle: integer): integer
  public intrinsic function __guiImageHeight(handle: integer): integer
  public intrinsic function __guiCreateImageView(parent: integer): integer
  public intrinsic function __guiImageViewSetImage(view: integer, image: integer)
  // refresh: recarga la imagen en el control SOLO si el asset cambió desde la
  // última vez (version-stamp en el backend); si no, no-op (evita re-decodificar).
  public intrinsic function __guiImageViewRefresh(view: integer)
  // Fuente: tamaño en px del texto del componente (0 = la fuente por defecto).
  // El backend mapea px → fuente disponible (LVGL Montserrat / Swing derive).
  public intrinsic function __guiSetFontSize(handle: integer, px: integer)
  public intrinsic function __guiGetFontSize(handle: integer): integer
  // Geometría: x/y/width/height — backend = verdad (get/set → intrínsecos).
  public intrinsic function __guiSetX(handle: integer, x: integer)
  public intrinsic function __guiGetX(handle: integer): integer
  public intrinsic function __guiSetY(handle: integer, y: integer)
  public intrinsic function __guiGetY(handle: integer): integer
  public intrinsic function __guiSetWidth(handle: integer, w: integer)
  public intrinsic function __guiGetWidth(handle: integer): integer
  public intrinsic function __guiSetHeight(handle: integer, h: integer)
  public intrinsic function __guiGetHeight(handle: integer): integer
  public intrinsic function __guiAlign(handle: integer, a: integer, dx: integer, dy: integer)
  // Scroll: opt-in (NONE/HOR/VER/BOTH); default NONE en el backend.
  public intrinsic function __guiSetScrollDir(handle: integer, dir: integer)
  public intrinsic function __guiGetScrollDir(handle: integer): integer
  // V6/G2-4 — la geometria AUTORADA (la del dump), para toJson(): align = -1 si
  // mandan x,y explicitos; width/height = -1 si son auto. Los get de arriba
  // devuelven el pixel computado, que no se serializa (PC y placa divergirian).
  public intrinsic function __guiGetAlign(handle: integer): integer
  public intrinsic function __guiGetAlignDx(handle: integer): integer
  public intrinsic function __guiGetAlignDy(handle: integer): integer
  public intrinsic function __guiGetAuthWidth(handle: integer): integer
  public intrinsic function __guiGetAuthHeight(handle: integer): integer
  public intrinsic function __guiSetBgColor(handle: integer, rgb: integer)
  public intrinsic function __guiSetTextColor(handle: integer, rgb: integer)
  public intrinsic function __guiSetFont(handle: integer, fontId: integer)
  public intrinsic function __guiLoadFont(path: string): integer
  public intrinsic function __guiSetRotation(deg: integer)
  public intrinsic function __guiRefresh(handle: integer)
  public intrinsic function __guiClean(handle: integer)
  public intrinsic function __guiDelete(handle: integer)
  public intrinsic function __guiScreenLoad(handle: integer)
  public intrinsic function __guiRun()
  public intrinsic function __guiDumpTree(): string

  // ---- Color (RGB 0xRRGGBB). Ej.: Gui.Color(0xFF0000) = rojo. ----
  public class Color
    public property rgb: integer
    public function Color(rgb: integer)
      this.rgb := rgb
    end Color
  end Color

  // ---- Align — anclas de posición (subconjunto del ALIGN de LVGL). ----
  public class Align
    public const Align.TOP_LEFT:     integer := 0
    public const Align.TOP_MID:      integer := 1
    public const Align.TOP_RIGHT:    integer := 2
    public const Align.LEFT_MID:     integer := 3
    public const Align.CENTER:       integer := 4
    public const Align.RIGHT_MID:    integer := 5
    public const Align.BOTTOM_LEFT:  integer := 6
    public const Align.BOTTOM_MID:   integer := 7
    public const Align.BOTTOM_RIGHT: integer := 8
  end Align

  // ---- ScrollDir — dirección de scroll (opt-in; default NONE). ----
  public class ScrollDir
    public const ScrollDir.NONE: integer := 0
    public const ScrollDir.HOR:  integer := 1
    public const ScrollDir.VER:  integer := 2
    public const ScrollDir.BOTH: integer := 3
  end ScrollDir

  // ---- Component — base de TODO widget. Desciende de Object (sin `extends`).
  //      Mantiene el objeto BP en paralelo al del backend (lv_obj / JComponent)
  //      vía lvglId, y la geometría / apariencia / eventos comunes. ----
  public class Component
    // id del objeto espejo (lo asigna el modelo en el constructor del widget).
    // 0 = sin crear. Auto-property: el backing field queda privado en su slot.
    public property lvglId: integer

    // -- Nombre: identificador del componente para localizarlo desde el código (el
    //    .win lo pone con "name"; vacío por defecto). Es puro BP — el backend no lo
    //    usa. Todos los widgets lo heredan de Component. Auto-property: backing field
    //    privado en su slot. --
    public property name: string

    // -- Geometría (común: LVGL set_pos/size · Swing setBounds). El backend es
    //    la verdad: get/set llaman a los intrínsecos, sin backing field BP. --
    public property x: integer
      get
        return __guiGetX(this.lvglId)
      endget
      set(v)
        __guiSetX(this.lvglId, v)
      endset
    endprop
    public property y: integer
      get
        return __guiGetY(this.lvglId)
      endget
      set(v)
        __guiSetY(this.lvglId, v)
      endset
    endprop
    public property width: integer
      get
        return __guiGetWidth(this.lvglId)
      endget
      set(v)
        __guiSetWidth(this.lvglId, v)
      endset
    endprop
    public property height: integer
      get
        return __guiGetHeight(this.lvglId)
      endget
      set(v)
        __guiSetHeight(this.lvglId, v)
      endset
    endprop

    // -- Scroll: lo controla el programador (default NONE). --
    public property scrollDir: integer
      get
        return __guiGetScrollDir(this.lvglId)
      endget
      set(v)
        __guiSetScrollDir(this.lvglId, v)
      endset
    endprop

    // -- Fuente: tamaño en px del texto (0 = por defecto). El backend mapea al
    //    tamaño disponible más cercano (catálogo Montserrat en placa). --
    public property fontSize: integer
      get
        return __guiGetFontSize(this.lvglId)
      endget
      set(v)
        __guiSetFontSize(this.lvglId, v)
      endset
    endprop

    // -- Conveniencias de geometría --
    public function setPos(px: integer, py: integer)
      __guiSetX(this.lvglId, px)
      __guiSetY(this.lvglId, py)
    end setPos
    public function setSize(w: integer, h: integer)
      __guiSetWidth(this.lvglId, w)
      __guiSetHeight(this.lvglId, h)
    end setSize
    public function setBounds(px: integer, py: integer, w: integer, h: integer)
      __guiSetX(this.lvglId, px)
      __guiSetY(this.lvglId, py)
      __guiSetWidth(this.lvglId, w)
      __guiSetHeight(this.lvglId, h)
    end setBounds
    // align — azúcar: el backend calcula x,y desde el ancla + offset.
    public function align(a: integer, dx: integer, dy: integer)
      __guiAlign(this.lvglId, a, dx, dy)
    end align

    public function setBgColor(c: Color)
      __guiSetBgColor(this.lvglId, c.rgb)
    end setBgColor

    // Color del texto. Vale para cualquier widget con texto (label, botón…):
    // en LVGL el text_color se hereda, así que en un botón colorea su label hijo.
    public function setTextColor(c: Color)
      __guiSetTextColor(this.lvglId, c.rgb)
    end setTextColor

    // refresh — invalidar para repintar (Swing repaint / LVGL lv_obj_invalidate).
    public function refresh()
      __guiRefresh(this.lvglId)
    end refresh

    // -- V6/G2-4 — SERIALIZACION. El arbol es nuestro, asi que se recorre en BP y
    //    se escribe UNA vez, con el modulo Json (paridad gratis: mismo codigo en
    //    las dos VMs). Formato: el de los .win, para que la ida y vuelta sea la
    //    prueba. Dos reglas para que el JSON tenga paridad de verdad y no solo de
    //    aspecto: NO se resuelve el layout (un widget por align emite align +
    //    desplazamientos, nunca el x,y calculado) y se OMITE lo auto (width/height
    //    a -1 no van). Cada clase dice su typeName() y anade lo suyo en jsonProps();
    //    Container anade "children". --
    var handlerClic: string        // nombres EXPLICITOS del .win ("clic"/"change"):
    var handlerChange: string      // los derivados de `name` no se guardan, se derivan

    // Los anota el cargador (bindHandler es funcion de modulo y los campos son
    // protegidos). "" = no hay nombre explicito.
    public function setHandlerNames(clic: string, change: string)
      this.handlerClic := clic
      this.handlerChange := change
    end setHandlerNames

    public function typeName(): string
      return "Component"
    end typeName

    // Lo propio de cada widget (text, checked, value...). Solo lo que no es el
    // valor por defecto, como en un .win escrito a mano. Las hojas lo sobrescriben.
    public function jsonProps(o: Json.JsonObject)
    end jsonProps

    public function toJson(): Json.JsonObject
      var o: Json.JsonObject := Json.JsonObject()
      o.put("type", Json.JsonString(this.typeName()))
      if strlen(this.name) > 0 then o.put("name", Json.JsonString(this.name))
      this.jsonProps(o)
      var a: integer := __guiGetAlign(this.lvglId)
      if a >= 0 then
        // Por NOMBRE, como en el .win; y solo si hay algo que decir: TOP_LEFT +0,0
        // es lo que tiene un widget recien creado.
        var dx: integer := __guiGetAlignDx(this.lvglId)
        var dy: integer := __guiGetAlignDy(this.lvglId)
        if (a != 0) or (dx != 0) or (dy != 0) then o.put("align", Json.JsonString(alignName(a)))
        if dx != 0 then o.put("x", Json.JsonInt(dx))
        if dy != 0 then o.put("y", Json.JsonInt(dy))
      else
        o.put("x", Json.JsonInt(__guiGetX(this.lvglId)))
        o.put("y", Json.JsonInt(__guiGetY(this.lvglId)))
      endif
      var w: integer := __guiGetAuthWidth(this.lvglId)
      var h: integer := __guiGetAuthHeight(this.lvglId)
      if w >= 0 then o.put("width", Json.JsonInt(w))
      if h >= 0 then o.put("height", Json.JsonInt(h))
      var fs: integer := __guiGetFontSize(this.lvglId)
      if fs != 0 then o.put("fontSize", Json.JsonInt(fs))
      if strlen(this.handlerClic) > 0 then o.put("clic", Json.JsonString(this.handlerClic))
      if strlen(this.handlerChange) > 0 then o.put("change", Json.JsonString(this.handlerChange))
      return o
    end toJson

    // El texto directamente: quien solo quiere guardar la ventana no tiene por
    // que importar Json para hablar con el arbol que devuelve toJson() (los
    // imports no son transitivos, #492).
    public function toJsonText(): string
      return this.toJson().toJson()
    end toJsonText

    // -- V6/G2 — EL ARBOL ES NUESTRO. Quien me contiene (null = raiz). Lo pone
    //    attach(), que llama todo constructor: el alta en el padre es UN solo
    //    punto, y por eso todos los widgets pasan por aqui. --
    var parent: Container

    public function attach(padre: Container)
      this.parent := padre
      if padre != null then
        // Por una referencia tipada Component, no Container: el emisor resuelve
        // los slots en orden de fichero y Container se declara DESPUES de esta
        // clase. El despacho es virtual, asi que llega al register() de Container.
        var c: Component := padre
        c.register(this)
      endif
      __guiBindClick(this.lvglId, this)
    end attach

    // -- Alta y baja de hijos. En una HOJA no hacen nada: una hoja no contiene.
    //    Container los sobrescribe. Viven aqui y no solo en Container por la
    //    limitacion del emisor de arriba (un solo paso, en orden de fichero). --
    public function register(c: Component)
    end register
    public function unregister(c: Component)
    end unregister

    public function getParent(): Container
      return this.parent
    end getParent

    public function clean()
      __guiClean(this.lvglId)
    end clean

    // Borra el widget en los dos planos (el nodo del modelo y, si hay, el lv_obj)
    // y se da de BAJA en la lista del padre: alta y baja simetricas, o el modelo
    // miente. Idempotente y silencioso si ya no existe (decision de Eduardo: «un
    // pequeno error que no deberia suceder pero que toleramos»).
    public function delete()
      __guiDelete(this.lvglId)
      if this.parent != null then
        var c: Component := this.parent   // misma razon que en attach()
        c.unregister(this)
        this.parent := null
      endif
    end delete

    // -- Eventos (#324). Al pulsar → onClick; al cambiar de valor → onChange.
    //
    //    Antes esto eran dos MÉTODOS virtuales que el usuario reescribía
    //    subclaseando el widget: para atender un botón había que fabricar una
    //    clase. Ahora son EVENTOS H5.c, así que el handler es una función
    //    cualquiera de un objeto cualquiera y no hace falta heredar de nada:
    //
    //      boton1.onClick := pantalla::boton1_onClick
    //
    //    Convención de nombres (Eduardo, 30-jul): el handler se llama
    //    <nombreDelComponente>_<nombreDelEvento>, con el MISMO nombre que lleva
    //    la variable que sostiene el widget y que su `name` (el que pone el .win).
    //    Un nombre, tres sitios — así dos botones tienen handlers distintos sin
    //    inventar nombres.
    //
    //    Sin suscriptor no pasa nada: `raise` encola y el despachador tira el
    //    evento si no hay destino vivo. Esa comprobación vive en UN sitio. --
    event onClick(sender: Component)
    event onChange(sender: Component)

    // -- __fire* — el puente desde la VM. Los llama Gui.__guiDispatch, no el
    //    usuario. Tienen que estar AQUÍ dentro porque `raise` sólo dispara
    //    eventos del objeto en curso (lee ev$recv/ev$dest de `this`), y el
    //    despachador es una función de módulo.
    //
    //    #324 tanda 2c: UN SOLO CAMINO. Hasta aquí levantaban el evento Y ademas
    //    llamaban por slot (el camino de Forms), porque el cargador guardaba su
    //    propio (receptor, slot) en tres campos a mano. Eran los MISMOS dos
    //    datos que el evento ya guarda, escritos dos veces; ahora el cargador
    //    suscribe el evento de verdad y aquí sólo queda el `raise`. --
    public function __fireClick()
      raise onClick(this)
    end __fireClick
    public function __fireChange()
      raise onChange(this)
    end __fireChange
  end Component

  // ============================================================================
  // V6/G2 — Container: el que puede CONTENER a otros. Decision de Eduardo (11-sep):
  // «el modelo LVGL es su modelo, pero el modelo de ventanas y componentes BP es
  // NUESTRO modelo, y tiene que ser coherente: si un objeto contiene a otro,
  // deberia poder verse». Las 16 hojas (Label, Checkbox, Slider...) descienden de
  // Component y no pagan nada; los contenedores (Screen, Panel, Window, TabPage,
  // Tabview, Button) descienden de esto y llevan la lista.
  //
  // `children` es una OwnerList: al liberarse el contenedor (FREE_REF por `owner`
  // o por fin de ambito) la cascada del heap alcanza a los wrappers de los hijos.
  // OJO: eso libera MEMORIA BP, no el nodo C ni el lv_obj — para eso esta delete(),
  // que baja por los hijos. Atar «muere el wrapper» a «muere el nodo» es el
  // destructor de #491 (V7).
  //
  // Regla de orden, la misma que en gui.c y en miVM: HIJOS ANTES QUE PADRE, y cada
  // nodo borra su propio lv_obj. Asi LVGL nunca cascadea por nosotros.
  // ============================================================================
  public class Container extends Component
    var owner children: Collections.OwnerList

    public function Container()
      this.children := Collections.OwnerList()
    end Container

    // Alta y baja: las llama Component (attach / delete). No las llames a mano.
    public function register(c: Component)
      this.children.add(c)
    end register
    public function unregister(c: Component)
      var i: integer := 0
      var n: integer := this.children.length()
      while i < n do
        if Component(this.children.get(i)) == c then
          this.children.remove(i)      // quita SIN liberar: el programa puede seguir sujetandolo
          return
        endif
        i := i + 1
      endwh
    end unregister

    public function childCount(): integer
      return this.children.length()
    end childCount
    public function childAt(i: integer): Component
      return Component(this.children.get(i))
    end childAt

    public function typeName(): string
      return "Container"
    end typeName

    // ¿Este hijo se serializa? Button dice que no a su etiqueta: va como "text".
    public function jsonChild(c: Component): boolean
      return true
    end jsonChild

    public function toJson(): Json.JsonObject
      var o: Json.JsonObject := super.toJson()
      var arr: Json.JsonArray := Json.JsonArray()
      var n: integer := this.childCount()
      var i: integer := 0
      while i < n do
        var c: Component := this.childAt(i)
        if this.jsonChild(c) then arr.add(c.toJson())
        i := i + 1
      endwh
      if arr.length() > 0 then o.put("children", arr)
      return o
    end toJson

    // Hijos antes que padre. De atras hacia delante porque cada delete() del hijo
    // lo da de baja de esta lista y los indices posteriores ya no existen.
    public function delete()
      var i: integer := this.childCount() - 1
      while i >= 0 do
        this.childAt(i).delete()
        i := i - 1
      endwh
      super.delete()
    end delete

    // Vacia el contenedor y se queda: los hijos BP se van cada uno con su nodo, y
    // el clean del backend barre lo que LVGL haya creado por dentro del widget.
    public function clean()
      var i: integer := this.childCount() - 1
      while i >= 0 do
        this.childAt(i).delete()
        i := i - 1
      endwh
      super.clean()
    end clean
  end Container

  // ---- Eventos (upcall). __guiBindClick registra el objeto BP dueño del handle;
  //      al pulsar/cambiar, la VM llama por NOMBRE a __guiDispatch(self) →
  //      self.__fireClick() o a __guiDispatchChange(self) → self.__fireChange()
  //      según el tipo de evento, y ésos levantan el evento BP (#324).
  //      __guiClick inyecta un clic sintético (diagnóstico). ----
  public intrinsic function __guiBindClick(handle: integer, self: Component)
  public intrinsic function __guiClick(w: Component)
  public intrinsic function __guiChange(w: Component)   // cambio de valor sintético (diagnóstico)
  // H13 — Forms: call-by-name del handler. Resuelve `name` como función PÚBLICA
  // del módulo al que pertenece `host` (la ventana) y la invoca con `sender`
  // (el widget que disparó) como arg0. La usa el dispatch de eventos de Gui.Window.
  // (Param `host`, no `owner`: `owner` es palabra clave del lenguaje — RAII.)
  public intrinsic function __guiInvokeByName(host: Object, name: string, sender: Object)
  // H13.1 — Forms Camino A: dispatch del handler por SLOT de vtable. `win` es la
  // ventana, `slot` el índice de vtable del método handler (lo hornea el IDE en el
  // .win, resuelto vía .bpi/slotOf), `sender` el widget que disparó. Handler =
  // MÉTODO de la ventana. slot < 0 (handler ausente) → se ignora.
  public intrinsic function __guiInvokeBySlot(win: Object, slot: integer, sender: Object)
  // #324 tanda 2b — REFLEXIÓN MÍNIMA (idea de Eduardo): nombre de método →
  // slot de vtable, en ejecución. -1 si esa clase no lo tiene. No hace falta
  // dato nuevo: el .mod ya exporta `Clase#metodo#slot` por cada entrada de la
  // vtable, así que el mapa ya viajaba y sólo faltaba preguntarle. Con esto el
  // .win deja de llevar slots horneados — y un slot horneado es un número
  // congelado en un fichero, que miente en cuanto la clase cambia.
  public intrinsic function __guiSlotOf(obj: Object, name: string): integer

  // ---- Screen — pantalla raíz (la entrega el backend ya montada). ----
  public class Screen extends Container
    public function typeName(): string
      return "Screen"
    end typeName
    public function Screen()
      super()
      this.lvglId := __guiScreenActive()
      this.attach(null)
    end Screen
    public function load()
      __guiScreenLoad(this.lvglId)
    end load
  end Screen

  // ---- Panel — contenedor simple (agrupa widgets). ----
  public class Panel extends Container
    public function typeName(): string
      return "Panel"
    end typeName
    public function Panel(parent: Container)
      super()
      this.lvglId := __guiCreateObj(parent.lvglId)
      this.attach(parent)
    end Panel
  end Panel

  // ---- Label — texto. ----
  public class Label extends Component
    public function typeName(): string
      return "Label"
    end typeName
    public function jsonProps(o: Json.JsonObject)
      var t: string := __guiGetText(this.lvglId)
      if strlen(t) > 0 then o.put("text", Json.JsonString(t))
    end jsonProps
    public function Label(parent: Container, text: string)
      this.lvglId := __guiCreateLabel(parent.lvglId)
      __guiSetText(this.lvglId, text)
      this.attach(parent)
    end Label

    public function setText(t: string)
      __guiSetText(this.lvglId, t)
    end setText

    public function setFont(font: integer)
      __guiSetFont(this.lvglId, font)
    end setFont
  end Label

  // ---- Button — botón clicable. Lleva un Label hijo con el texto. Reacciona
  //      reescribiendo onClick. (Botón con icono = Image hijo, futura tanda.) ----
  public class Button extends Container
    public function typeName(): string
      return "Button"
    end typeName
    // El boton con texto se escribe como en el .win: "text", no un Label hijo.
    // Lo que cuelgue del boton ADEMAS de su etiqueta (un icono) si va en children.
    public function jsonProps(o: Json.JsonObject)
      if this.etiqueta != null then
        var t: string := __guiGetText(this.etiqueta.lvglId)
        if strlen(t) > 0 then
          o.put("text", Json.JsonString(t))
        endif
      endif
    end jsonProps
    public function jsonChild(c: Component): boolean
      if this.etiqueta == null then return true
      return c.lvglId != this.etiqueta.lvglId
    end jsonChild
    // V6/G2 — el boton es un CONTENEDOR (decision de Eduardo, 11-sep): «todos los
    // botones pueden tener varios componentes; un constructor normal y otro para el
    // caso mas frecuente, el boton con un texto». La idea de un Button hoja y un
    // ButtonEx que herede y contenga no cabe en BP: sin interfaces de clase, un
    // ButtonEx extends Button nunca seria un Container y el parent de los
    // constructores no tendria tipo. Y el Button de siempre YA hacia Label(this,
    // text): era esto sin decirlo.
    var etiqueta: Label          // la del constructor con texto (null en el vacio)

    // UN solo constructor, con el texto por DEFECTO (Eduardo, 11-sep): «declarar el
    // constructor con un parametro string pero asignarle un valor por defecto, con
    // lo que cubres llamar al constructor sin parametro y con parametro». Cubre los
    // dos casos y cruza modulos — los defectos viajan en la interfaz (ParamSig.
    // defaultValue, H8.1) y la sobrecarga de constructores NO (#492). Sin texto, el
    // boton es un contenedor vacio de verdad: ningun Label de mas.
    public function Button(parent: Container, text: string := "")
      super()
      this.lvglId := __guiCreateButton(parent.lvglId)
      this.attach(parent)
      if strlen(text) > 0 then
        this.etiqueta := Label(this, text)   // se registra sola como hijo
      endif
    end Button
  end Button

  // ---- Checkbox — casilla on/off con etiqueta. El toggle dispara onChange
  //      (override-able); el estado se lee/escribe con la propiedad `checked`. ----
  public class Checkbox extends Component
    public function typeName(): string
      return "Checkbox"
    end typeName
    public function jsonProps(o: Json.JsonObject)
      var t: string := __guiGetText(this.lvglId)
      if strlen(t) > 0 then o.put("text", Json.JsonString(t))
      if this.checked then o.put("checked", Json.JsonBool(true))
    end jsonProps
    public function Checkbox(parent: Container, text: string)
      this.lvglId := __guiCreateCheckbox(parent.lvglId)
      __guiSetText(this.lvglId, text)
      this.attach(parent)
    end Checkbox

    public function setText(t: string)
      __guiSetText(this.lvglId, t)
    end setText

    public property checked: boolean
      get
        return __guiGetChecked(this.lvglId)
      endget
      set(v)
        __guiSetChecked(this.lvglId, v)
      endset
    endprop
  end Checkbox

  // ---- Toggle — interruptor on/off (booleano, como Checkbox pero sin etiqueta;
  //      "switch" en LVGL — pero `switch` es palabra reservada del lenguaje). El
  //      toggle dispara onChange; el estado se lee/escribe con `checked`. ----
  public class Toggle extends Component
    public function typeName(): string
      return "Toggle"
    end typeName
    public function jsonProps(o: Json.JsonObject)
      if this.checked then o.put("checked", Json.JsonBool(true))
    end jsonProps
    public function Toggle(parent: Container)
      this.lvglId := __guiCreateSwitch(parent.lvglId)
      this.attach(parent)
    end Toggle

    public property checked: boolean
      get
        return __guiGetChecked(this.lvglId)
      endget
      set(v)
        __guiSetChecked(this.lvglId, v)
      endset
    endprop
  end Toggle

  // ---- Slider — deslizador de valor entero en un rango. El arrastre dispara
