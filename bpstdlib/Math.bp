// ============================================================
// Math.bp — módulo stdlib con funciones matemáticas no implícitas.
//
// Todas las funciones aquí son INTRÍNSECAS (H1, 20-sep): funciones normales cuyo cuerpo es
// el bytecode escrito, `inline CALL_BUILTIN <id>`, como el `inline($CD/$21)` de Turbo
// Pascal. El compilador, al ver una llamada `Math.foo(...)`, mete ese bytecode en el
// call-site (en lugar de emitir CALL_EXT): este .mod no contiene código — existe para
// darle a `import Math` un namespace y firmas tipadas. El número ES el id del builtin
// en las dos VMs: Builtin.java y builtins.c se generan de estas líneas.
//
// Lo que NO necesita estar aquí (ya es implícito sin import):
//   abs, min, max, sqrt, pow, floor, ceil, round, exp, random, randomInt.
// ============================================================
module Math

  // -------- Constantes --------
  // π ≈ 3.14159...
  public function pi(): float
    inline CALL_BUILTIN 29
  end pi
  // e ≈ 2.71828... (constante de Euler).
  public function e(): float
    inline CALL_BUILTIN 30
  end e

  // -------- Trigonometría --------
  public function sin(x: float): float
    inline CALL_BUILTIN 24
  end sin
  public function cos(x: float): float
    inline CALL_BUILTIN 25
  end cos
  public function tan(x: float): float
    inline CALL_BUILTIN 26
  end tan

  // -------- Logaritmos --------
  // Logaritmo natural (base e). Equivalente a ln(x) en notación matemática.
  public function ln(x: float): float
    inline CALL_BUILTIN 21
  end ln
  // Logaritmo en base 10.
  public function log10(x: float): float
    inline CALL_BUILTIN 22
  end log10

  // -------- Signo --------
  // Devuelve -1, 0, +1 según el signo del argumento.
  public function sign(x: integer): integer
    inline CALL_BUILTIN 56
  end sign

  // Versión para float. Devuelve un integer (-1/0/+1). NaN → 0.
  public function signF(x: float): integer
    inline CALL_BUILTIN 57
  end signF

  // -------- Trigonometría inversa --------
  public function asin(x: float): float
    inline CALL_BUILTIN 58
  end asin
  public function acos(x: float): float
    inline CALL_BUILTIN 59
  end acos
  public function atan(x: float): float
    inline CALL_BUILTIN 60
  end atan

  // atan2(y, x) — ángulo del vector (x,y) en (-π, π].
  public function atan2(y: float, x: float): float
    inline CALL_BUILTIN 61
  end atan2

  // -------- Factorial / Gamma --------
  // n >= 0, n <= 12 (máximo que cabe en i32). Fuera de rango → RuntimeError.
  public function factorial(n: integer): integer
    inline CALL_BUILTIN 62
  end factorial

  // -------- Rango y geometría (V6) --------
  // Acota x al intervalo [lo, hi]. Con lo > hi el intervalo está del revés y el
  // resultado es `lo` o `hi` según de qué lado caiga x — no es un error, es la
  // consecuencia de aplicar las dos comparaciones en orden. NaN sale como NaN.
  public function clamp(x: float, lo: float, hi: float): float
    inline CALL_BUILTIN 228
  end clamp

  // Envuelve x dentro de [lo, hi) de forma cíclica: wrap(370, 0, 360) = 10 y
  // wrap(-10, 0, 360) = 350. Exige hi > lo; si no, lanza RuntimeError (un
  // rango vacío no tiene respuesta correcta y devolver algo la inventaría).
  public function wrap(x: float, lo: float, hi: float): float
    inline CALL_BUILTIN 229
  end wrap

  // Longitud del vector (x, y) = raíz(x² + y²).
  public function hypot(x: float, y: float): float
    inline CALL_BUILTIN 230
  end hypot

  // Lleva x del rango [inLo, inHi] al rango [outLo, outHi], linealmente. No
  // acota: fuera del rango de entrada extrapola (si quieres acotar, `clamp`
  // después). Exige inHi != inLo; si no, lanza RuntimeError.
  public function remap(x: float, inLo: float, inHi: float, outLo: float, outHi: float): float
    inline CALL_BUILTIN 231
  end remap

  // Función Γ (Lanczos approximation). Γ(n+1) = n! para naturales.
  // Definida para x > 0; para 0 < x < 0.5 usa la reflexión de Euler.
  public function gamma(x: float): float
    inline CALL_BUILTIN 63
  end gamma

end Math
