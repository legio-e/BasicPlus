// ============================================================
// Collections.bp — estructuras de datos para BasicPlus (H4.A / H5).
//
// Map: diccionario clave->valor, UNA sola clase, thread-safe, en BP puro.
// Interno = dos List paralelas (claves y valores) ORDENADAS por clave +
// búsqueda binaria O(log n). NO tabla hash (decisión de diseño).
//
// Modelo de objetos (estilo Java, manual): claves y valores son `Object`
// (el tipo raíz universal). Los strings ya son referencias → se usan tal
// cual. Los primitivos (int, float, ...) se ENVUELVEN a mano en su clase
// (Integer(x), ...) para meterlos como clave/valor — boxing manual.
//
// Orden de las claves: un objeto Comparator. Por defecto StringComparator
// (claves string). Para otro orden, subclasea Comparator y pásalo con
// withComparator(...). El Map lo invoca por vtable (cero coste de VM).
//
// Thread-safety: cada método público toma un Mutex; los helpers privados
// no lo toman (el Mutex no es reentrante).
// ============================================================
module Collections

  import Str
  // #446 — Comparable y los envoltorios viven en Core desde el 18-ago.
  import Core

  // -------------------------------------------------------------
  // Comparator — base para ordenar claves. -1 / 0 / 1.
  // Subclasea y override compare(...) para un orden a medida.
  // -------------------------------------------------------------
  public class Comparator
    public function Comparator()
    end Comparator
    public function compare(a: Object, b: Object): integer
      return 0
    end compare
  end Comparator

  // Comparador por defecto: claves string, orden lexicográfico por codepoint.
  public class StringComparator extends Comparator
    public function StringComparator()
      super()
    end StringComparator
    public function compare(a: Object, b: Object): integer
      var sa: string := string(a)
      var sb: string := string(b)
      return Str.compare(sa, sb)
    end compare
  end StringComparator

  // -------------------------------------------------------------

  // Comparador natural: ordena claves Comparable por su compareTo
  // (polimórfico). Para claves boxed (Integer/Long/Double/...):
  //   var m := Collections.Map().withComparator(Collections.NaturalComparator())
  public class NaturalComparator extends Comparator
    public function NaturalComparator()
      super()
    end NaturalComparator
    public function compare(a: Object, b: Object): integer
      var ca: Core.Comparable := Core.Comparable(a)
      return ca.compareTo(b)
    end compare
  end NaturalComparator

  // -------------------------------------------------------------
  // #450 — SyncList y OwnerList, en BP y en Collections.
  //
  // Decision de Eduardo (18-ago): «SyncList y OwnerList deberian estar en
  // collections. Hacerlas sintetizadas me parece raro, no veo la razon».
  // La razon era una sola, y esta escrita en el emisor: «emitidas siempre...
  // a cambio cualquier programa puede usarlas sin import explicito». Hoy eso
  // lo da el import implicito, y el precio que se pagaba era que CADA modulo
  // llevaba su propia copia de las tres.
  //
  // `List` vive en Core (es tipo basico y el Map de aqui la usa); estas dos
  // son de colecciones y se quedan en su sitio.
  // -------------------------------------------------------------
  // #451 — SyncList, ya en su sitio.
  //
  // Estuvo un rato en Core porque sus metodos con cerrojo llaman a
  // `super.add(...)`, y un super cross-module no se podia hacer: un modulo
  // NO exportaba sus metodos, solo se llegaba a ellos por vtable.
  //
  // Lo desatasco una observacion de Eduardo: «si declaras una clase que
  // hereda de otra, aunque no lo escribas, se hace la llamada al constructor
  // de super». Esa SI cruzaba — porque el ctor tiene una factoria exportada,
  // `__cls_init_<Cls>`. Ahora los metodos tienen la suya
  // (`__cls_m_<Cls>_<metodo>`) y esto vive donde debe.
  // -------------------------------------------------------------

  // Lista con cerrojo: cada operacion es atomica de por si. NO hace atomica
  // una SECUENCIA de operaciones — para eso, un Mutex del llamante.
  public class SyncList extends Core.List
    var mtx: Mutex

    public function SyncList()
      super()
      this.mtx := Mutex()
    end SyncList

    // Las cinco con cerrojo. Ojo: SOLO se redefine add(Object) — las
    // sobrecargas add(integer/long/...) se heredan de List y delegan en
    // `this.add(o)`, que despacha por vtable y acaba AQUI, con el cerrojo
    // puesto (medido en samples/ListaHer.bp).
    // #795 — con `finally`: un índice fuera de la lista lanza, y el cerrojo no se puede quedar cogido.
    public function add(o: Object)
      this.mtx.lock()
      try
        super.add(o)
      finally
        this.mtx.unlock()
      endtry
    end add

    public function get(idx: integer): Object
      this.mtx.lock()
      try
        return super.get(idx)
      finally
        this.mtx.unlock()
      endtry
    end get

    public function set(idx: integer, o: Object)
      this.mtx.lock()
      try
        super.set(idx, o)
      finally
        this.mtx.unlock()
      endtry
    end set

    public function length(): integer
      this.mtx.lock()
      var n: integer := super.length()
      this.mtx.unlock()
      return n
    end length

    public function remove(idx: integer)
      this.mtx.lock()
      try
        super.remove(idx)
      finally
        this.mtx.unlock()
      endtry
    end remove

    // Propio de SyncList: sacar el ultimo de forma atomica (cola LIFO).
    public function pop(): Object
      this.mtx.lock()
      var r: Object := null
      var n: integer := super.length()
      if n > 0 then
        r := super.get(n - 1)
        super.remove(n - 1)
      endif
      this.mtx.unlock()
      return r
    end pop

    // Espera hasta que haya algo. El sleep(1) cede el turno: un spin a secas
    // se comeria el nucleo y, en el planificador propio, podria no dejar
    // avanzar al que tiene que meter el dato.
    public function popBlocking(): Object
      var r: Object := this.pop()
      while r == null do
        sleep(1)
        r := this.pop()
      endwh
      return r
    end popBlocking
  end SyncList

  // -------------------------------------------------------------

  // Lista PROPIETARIA: al liberarla se liberan tambien sus elementos. Eso lo
  // hace el `var owner` del campo, que marca el bit del descriptor y la VM
  // cascadea (verificado en samples/OwnerBp.bp, con el guardian de fin de RUN
  // diciendo «0 bloques sin liberar»).
  public class OwnerList extends Core.List
    // V6/G2 — EL ARRAY QUE POSEE, y el `items` de List es su ALIAS.
    //
    // Lo que habia: `propios` declarado owner y NUNCA usado — add/get/remove iban
    // por el `items` de List, que no es owner. Asi que liberar una OwnerList no
    // liberaba ningun elemento, y el test que la validaba solo imprimia
    // longitudes: no podia verlo. Medido el 11-sep con samples/OwnerCascada.bp:
    // una segunda referencia al elemento seguia VIVA tras morir la lista.
    //
    // Y no tiene arreglo por herencia: una subclase no puede volver owner un
    // campo heredado (el bit es del descriptor de quien lo declara). La forma,
    // de Eduardo: propios y items apuntan al MISMO array — propios lo posee,
    // List lo usa por items sin enterarse. Al morir la lista, FREE_REF cascadea
    // por propios y libera el array Y todos sus elementos (interp.c:588).
    //
    // Solo hay que intervenir donde List SUSTITUYE el array: grow(), que es
    // virtual. add/get/remove quedan tal cual.
    var owner propios: Object[]

    public function OwnerList()
      super()
      this.propios := this.backing()      // el mismo array: propios posee, items lo usa
    end OwnerList

    public function grow()
      var viejo: Object[] := this.backing()
      var n: integer := this.length()
      super.grow()                          // copia al nuevo; items ya apunta a el
      // ⚠️ VACIAR el viejo ANTES de soltarlo: growObjArray COPIA y lo deja
      // intacto, y `this.propios := nuevo` es SET_FIELD_OWNER — libera el
      // anterior CON CASCADA, y mataria a los elementos recien copiados.
      var i: integer := 0
      while i < n do
        viejo[i] := null
        i := i + 1
      endwh
      this.propios := this.backing()      // suelta el viejo (ya vacio) y posee el nuevo
    end grow

    // Quitar UN elemento liberandolo. El `var owner` local emite el FREE_REF
    // al salir del scope, que es la misma semantica que el removeAndFree
    // sintetizado escribia a mano.
    public function removeAndFree(idx: integer)
      var owner muerto: Object := this.get(idx)
      this.remove(idx)
    end removeAndFree
  end OwnerList

  // -------------------------------------------------------------
  // Map — diccionario ordenado por clave.
  // -------------------------------------------------------------
  public class Map
    var keyList: List
    var valList: List
    var cmp:     Comparator
    var lock:    Mutex

    // Constructor: Map vacío con comparador de strings por defecto.
    public function Map()
      this.keyList := List()
      this.valList := List()
      this.cmp     := StringComparator()
      this.lock    := Mutex()
    end Map

    // Cambia el comparador (llamar ANTES de insertar). Devuelve this para
    // encadenar: var m := Map().withComparator(miCmp)
    public function withComparator(c: Comparator): Map
      this.lock.lock()
      this.cmp := c
      this.lock.unlock()
      return this
    end withComparator

    // Búsqueda binaria PRIVADA (sin lock). Devuelve el índice si la clave
    // existe; si no, -(ip)-1 donde ip es el punto de inserción.
    function bsearch(key: Object): integer
      var lo: integer := 0
      var hi: integer := this.keyList.length() - 1
      while lo <= hi do
        var mid: integer := (lo + hi) / 2
        var midKey: Object := this.keyList.get(mid)
        var c: integer := this.cmp.compare(key, midKey)
        if c == 0 then
          return mid
        endif
        if c < 0 then
          hi := mid - 1
        else
          lo := mid + 1
        endif
      endwh
      return (-lo) - 1
    end bsearch

    // Inserta (key,val) en el punto ip desplazando a la derecha. PRIVADO.
    //
    // V8/H5 (21-oct) — EL TRAMO SE DESPLAZA DE UNA VEZ. La lista se usa como un array ordenado con búsqueda
    // dicotómica (bsearch: la 1 de Eduardo, «Utilizar la lista como si fuera un array»), y desplazar era lo que
    // faltaba: elemento a elemento en BP, con cuatro llamadas a métodos por elemento —el 97 % del tiempo de un put con
    // 8000 claves en desorden, en el PC—. Ahora `move` (un memmove en C, en las dos VMs) mueve el tramo de cada lista en
    // UNA llamada. Sigue siendo O(n) por inserción, pero de bytes en C.
    function insertAt(ip: integer, key: Object, val: Object)
      var n: integer := this.keyList.length()
      this.keyList.add(key)               // crece 1 (y el array, si hace falta)
      this.valList.add(val)
      if ip < n then
        var ks: Object[] := this.keyList.backing()   // después de add: add puede cambiar el array
        var vs: Object[] := this.valList.backing()
        move(ks, ks, ip, ip + 1, n - ip)
        move(vs, vs, ip, ip + 1, n - ip)
        this.keyList.set(ip, key)
        this.valList.set(ip, val)
      endif
    end insertAt

    // Nº de entradas.
    public function size(): integer
      this.lock.lock()
      var n: integer := this.keyList.length()
      this.lock.unlock()
      return n
    end size

    // Inserta o actualiza.
    //
    // (V8/H7.5, 7-nov: el error, un NullReferenceError, como en Java.)
    // V8 #774 (2-nov) — UNA CLAVE null, UN ERROR, en put, get, containsKey y remove (Eduardo: «una clave de un Map,
    // error»; Java y C# coinciden). Antes del lock: lanzar con él tomado dejaría el Map cerrado. Hasta hoy, con el Map
    // vacío entraba (bsearch no compara nada) y la operación siguiente fallaba al compararla. Escrito en cada uno, y no
    // en un método: uno nuevo cambia la interfaz de la clase (ver remove).
    public function put(key: Object, val: Object)
      if key == null then
        throw NullReferenceError("referencia nula: Map.put con una clave null")
      endif
      this.lock.lock()
      var idx: integer := this.bsearch(key)
      if idx >= 0 then
        this.valList.set(idx, val)
      else
        this.insertAt((-idx) - 1, key, val)
      endif
      this.lock.unlock()
    end put

    // Devuelve el valor, o null si la clave no existe.
    public function get(key: Object): Object
      if key == null then   // #774 (ver put)
        throw NullReferenceError("referencia nula: Map.get con una clave null")
      endif
      this.lock.lock()
      var idx: integer := this.bsearch(key)
      var result: Object := null
      if idx >= 0 then
        result := this.valList.get(idx)
      endif
      this.lock.unlock()
      return result
    end get

    public function containsKey(key: Object): boolean
      if key == null then   // #774 (ver put)
        throw NullReferenceError("referencia nula: Map.containsKey con una clave null")
      endif
      this.lock.lock()
      var found: boolean := this.bsearch(key) >= 0
      this.lock.unlock()
      return found
    end containsKey

    // Borra la clave. Devuelve true si existía.
    public function remove(key: Object): boolean
      if key == null then   // #774 (ver put)
        throw NullReferenceError("referencia nula: Map.remove con una clave null")
      endif
      this.lock.lock()
      var idx: integer := this.bsearch(key)
      var existed: boolean := false
      if idx >= 0 then
        // V8/H5 (21-oct): el tramo de detrás sube de una vez (`move`, como en insertAt) y se quita la última entrada,
        // que ha quedado repetida (List.remove del final no desplaza nada y vacía su casilla). Aquí y no en un método
        // aparte: un método nuevo, aunque sea privado, cambia la interfaz de la clase, y los programas compilados
        // contra la de antes la verían «compilada contra otra interfaz».
        var n: integer := this.keyList.length()
        if idx < n - 1 then
          var ks: Object[] := this.keyList.backing()
          var vs: Object[] := this.valList.backing()
          move(ks, ks, idx + 1, idx, n - 1 - idx)
          move(vs, vs, idx + 1, idx, n - 1 - idx)
        endif
        this.keyList.remove(n - 1)
        this.valList.remove(n - 1)
        existed := true
      endif
      this.lock.unlock()
      return existed
    end remove

    // -------- Las sobrecargas (H1, decisión de Eduardo 21-sep) --------
    // «Map es con key: Object y value: Object. Los keys normales son integer y string, value en
    // cambio puede ser cualquier objeto. Así que put se sobrecarga con put(k: integer, v: Object),
    // put(k: string, v: Object) y put(k: Object, v: Object). Los gets con uno específico para cada
    // cosa.» Todo delega en la versión Object: nada de casos especiales en el compilador. Una clave
    // integer se envuelve (Integer) y necesita un comparador numérico: numericMap(), no Map().
    // Un string YA es un Object (#389): el paso por `var o: Object` evita que la sobrecarga se
    // llame a sí misma.
    public function put(k: integer, v: Object)
      this.put(Integer(k), v)
    end put
    public function put(k: string, v: Object)
      var o: Object := k
      this.put(o, v)
    end put

    public function get(k: integer): Object
      return this.get(Integer(k))
    end get
    public function get(k: string): Object
      var o: Object := k
      return this.get(o)
    end get

    public function containsKey(k: integer): boolean
      return this.containsKey(Integer(k))
    end containsKey
    public function containsKey(k: string): boolean
      var o: Object := k
      return this.containsKey(o)
    end containsKey

    public function remove(k: integer): boolean
      return this.remove(Integer(k))
    end remove
    public function remove(k: string): boolean
      var o: Object := k
      return this.remove(o)
    end remove

    // Los captadores tipados del valor, como los de List: el valor se guardó envuelto
    // (Integer(3), Double(2.5)…) y aquí se desenvuelve; una clave que no está es un
    // valor null y el desenvolver lanza (RuntimeError), no devuelve un cero en silencio.
    public function getString(k: Object): string
      var o: Object := this.get(k)
      try
        return string(o)
      catch e: Exception
      endtry
      return o.toString()
    end getString
    public function getString(k: integer): string
      return this.getString(Integer(k))
    end getString
    public function getString(k: string): string
      var o: Object := k
      return this.getString(o)
    end getString

    public function getInteger(k: Object): integer
      var c: Comparable := Comparable(this.get(k))
      return c.toInteger()
    end getInteger
    public function getInteger(k: integer): integer
      return this.getInteger(Integer(k))
    end getInteger
    public function getInteger(k: string): integer
      var o: Object := k
      return this.getInteger(o)
    end getInteger

    public function getLong(k: Object): long
      var c: Comparable := Comparable(this.get(k))
      return c.toLong()
    end getLong
    public function getLong(k: integer): long
      return this.getLong(Integer(k))
    end getLong
    public function getLong(k: string): long
      var o: Object := k
      return this.getLong(o)
    end getLong

    public function getFloat(k: Object): float
      var c: Comparable := Comparable(this.get(k))
      return c.toFloat()
    end getFloat
    public function getFloat(k: integer): float
      return this.getFloat(Integer(k))
    end getFloat
    public function getFloat(k: string): float
      var o: Object := k
      return this.getFloat(o)
    end getFloat

    public function getDouble(k: Object): double
      var c: Comparable := Comparable(this.get(k))
      return c.toDouble()
    end getDouble
    public function getDouble(k: integer): double
      return this.getDouble(Integer(k))
    end getDouble
    public function getDouble(k: string): double
      var o: Object := k
      return this.getDouble(o)
    end getDouble

    public function getBoolean(k: Object): boolean
      var c: Comparable := Comparable(this.get(k))
      return c.toBoolean()
    end getBoolean
    public function getBoolean(k: integer): boolean
      return this.getBoolean(Integer(k))
    end getBoolean
    public function getBoolean(k: string): boolean
      var o: Object := k
      return this.getBoolean(o)
    end getBoolean

    // Acceso por índice (0..size-1) en orden de clave. Para iterar:
    //   var i := 0
    //   while i < m.size() do
    //     ... m.keyAt(i) ... m.valueAt(i) ...
    //     i := i + 1
    //   endwh
    // (Se evita devolver List por la API pública porque el tipo built-in
    //  List no unifica su identidad cross-module — ver GAP-2 en backlog.)
    public function keyAt(i: integer): Object
      this.lock.lock()
      var k: Object := null
      try
        k := this.keyList.get(i)
      finally
        this.lock.unlock()
      endtry
      return k
    end keyAt

    public function valueAt(i: integer): Object
      this.lock.lock()
      var v: Object := null
      try
        v := this.valList.get(i)
      finally
        this.lock.unlock()
      endtry
      return v
    end valueAt

  end Map

  // -------------------------------------------------------------
  // Factories. Construyen el comparador DENTRO del módulo (donde el
  // subtipado subclase→base funciona). Pasar una subclase de Comparator
  // cross-module aún no va (GAP-3), así que el usuario usa estos factories
  // en vez de Map().withComparator(miCmp) desde fuera.
  // -------------------------------------------------------------

  // Map con claves string (orden lexicográfico). = Collections.Map().
  public function stringMap(): Map
    return Map()
  end stringMap

  // Map con claves boxed Comparable (Integer/Long/Double/...), orden natural.
  public function numericMap(): Map
    return Map().withComparator(NaturalComparator())
  end numericMap

end Collections
