// ============================================================
// Collections.bp — estructuras de datos para BasicPlus (H4.A / H5).
//
// Map: diccionario clave->valor, UNA sola clase, thread-safe, en BP puro.
// Interno = dos List paralelas (claves y valores) ORDENADAS por clave +
// búsqueda binaria O(log n). NO tabla hash (decisión de diseño).
//
// Modelo de objetos (estilo Java, manual): claves y valores son `Object`
// (el tipo raíz universal). Los strings ya son referencias → se usan tal
// cual. Los primitivos (int, float, ...) se ENVUELVEN a mano en su clase
// (Integer(x), ...) para meterlos como clave/valor — boxing manual.
//
// Orden de las claves: un objeto Comparator. Por defecto StringComparator
// (claves string). Para otro orden, subclasea Comparator y pásalo con
// withComparator(...). El Map lo invoca por vtable (cero coste de VM).
//
// Thread-safety: cada método público toma un Mutex; los helpers privados
// no lo toman (el Mutex no es reentrante).
// ============================================================
module Collections

  import Str
  // #446 — Comparable y los envoltorios viven en Core desde el 18-ago.
  import Core

  // -------------------------------------------------------------
  // Comparator — base para ordenar claves. -1 / 0 / 1.
  // Subclasea y override compare(...) para un orden a medida.
  // -------------------------------------------------------------
  public class Comparator
    public function Comparator()
    end Comparator
    public function compare(a: Object, b: Object): integer
      return 0
    end compare
  end Comparator

  // Comparador por defecto: claves string, orden lexicográfico por codepoint.
  public class StringComparator extends Comparator
    public function StringComparator()
      super()
    end StringComparator
    public function compare(a: Object, b: Object): integer
      var sa: string := string(a)
      var sb: string := string(b)
      return Str.compare(sa, sb)
    end compare
  end StringComparator

  // -------------------------------------------------------------

  // Comparador natural: ordena claves Comparable por su compareTo
  // (polimórfico). Para claves boxed (Integer/Long/Double/...):
  //   var m := Collections.Map().withComparator(Collections.NaturalComparator())
  public class NaturalComparator extends Comparator
    public function NaturalComparator()
      super()
    end NaturalComparator
    public function compare(a: Object, b: Object): integer
      var ca: Core.Comparable := Core.Comparable(a)
      return ca.compareTo(b)
    end compare
  end NaturalComparator

  // -------------------------------------------------------------
  // #450 — SyncList y OwnerList, en BP y en Collections.
  //
  // Decision de Eduardo (18-ago): «SyncList y OwnerList deberian estar en
  // collections. Hacerlas sintetizadas me parece raro, no veo la razon».
  // La razon era una sola, y esta escrita en el emisor: «emitidas siempre...
  // a cambio cualquier programa puede usarlas sin import explicito». Hoy eso
  // lo da el import implicito, y el precio que se pagaba era que CADA modulo
  // llevaba su propia copia de las tres.
  //
  // `List` vive en Core (es tipo basico y el Map de aqui la usa); estas dos
  // son de colecciones y se quedan en su sitio.
  // -------------------------------------------------------------
  // #451 — SyncList, ya en su sitio.
  //
  // Estuvo un rato en Core porque sus metodos con cerrojo llaman a
  // `super.add(...)`, y un super cross-module no se podia hacer: un modulo
  // NO exportaba sus metodos, solo se llegaba a ellos por vtable.
  //
  // Lo desatasco una observacion de Eduardo: «si declaras una clase que
  // hereda de otra, aunque no lo escribas, se hace la llamada al constructor
  // de super». Esa SI cruzaba — porque el ctor tiene una factoria exportada,
  // `__cls_init_<Cls>`. Ahora los metodos tienen la suya
  // (`__cls_m_<Cls>_<metodo>`) y esto vive donde debe.
  // -------------------------------------------------------------

  // Lista con cerrojo: cada operacion es atomica de por si. NO hace atomica
  // una SECUENCIA de operaciones — para eso, un Mutex del llamante.
  public class SyncList extends Core.List
    var mtx: Mutex

    public function SyncList()
      super()
      this.mtx := Mutex()
    end SyncList

    // Las cinco con cerrojo. Ojo: SOLO se redefine add(Object) — las
    // sobrecargas add(integer/long/...) se heredan de List y delegan en
    // `this.add(o)`, que despacha por vtable y acaba AQUI, con el cerrojo
    // puesto (medido en samples/ListaHer.bp).
    public function add(o: Object)
      this.mtx.lock()
      super.add(o)
      this.mtx.unlock()
    end add

    public function get(idx: integer): Object
      this.mtx.lock()
      var r: Object := super.get(idx)
      this.mtx.unlock()
      return r
    end get

    public function set(idx: integer, o: Object)
      this.mtx.lock()
      super.set(idx, o)
      this.mtx.unlock()
    end set

    public function length(): integer
      this.mtx.lock()
      var n: integer := super.length()
      this.mtx.unlock()
      return n
    end length

    public function remove(idx: integer)
      this.mtx.lock()
      super.remove(idx)
      this.mtx.unlock()
    end remove

    // Propio de SyncList: sacar el ultimo de forma atomica (cola LIFO).
    public function pop(): Object
      this.mtx.lock()
      var r: Object := null
      var n: integer := super.length()
      if n > 0 then
        r := super.get(n - 1)
        super.remove(n - 1)
      endif
      this.mtx.unlock()
      return r
    end pop

    // Espera hasta que haya algo. El sleep(1) cede el turno: un spin a secas
    // se comeria el nucleo y, en el planificador propio, podria no dejar
    // avanzar al que tiene que meter el dato.
    public function popBlocking(): Object
      var r: Object := this.pop()
      while r == null do
        sleep(1)
        r := this.pop()
      endwh
      return r
    end popBlocking
  end SyncList

  // -------------------------------------------------------------

  // Lista PROPIETARIA: al liberarla se liberan tambien sus elementos. Eso lo
  // hace el `var owner` del campo, que marca el bit del descriptor y la VM
  // cascadea (verificado en samples/OwnerBp.bp, con el guardian de fin de RUN
  // diciendo «0 bloques sin liberar»).
  public class OwnerList extends Core.List
    var owner propios: Object[]

    public function OwnerList()
      super()
    end OwnerList

    // Quitar UN elemento liberandolo. El `var owner` local emite el FREE_REF
    // al salir del scope, que es la misma semantica que el removeAndFree
    // sintetizado escribia a mano.
    public function removeAndFree(idx: integer)
      var owner muerto: Object := this.get(idx)
      this.remove(idx)
    end removeAndFree
  end OwnerList

  // -------------------------------------------------------------
  // Map — diccionario ordenado por clave.
  // -------------------------------------------------------------
  public class Map
    var keyList: List
    var valList: List
    var cmp:     Comparator
    var lock:    Mutex

    // Constructor: Map vacío con comparador de strings por defecto.
    public function Map()
      this.keyList := List()
      this.valList := List()
      this.cmp     := StringComparator()
      this.lock    := Mutex()
    end Map

    // Cambia el comparador (llamar ANTES de insertar). Devuelve this para
    // encadenar: var m := Map().withComparator(miCmp)
    public function withComparator(c: Comparator): Map
      this.lock.lock()
      this.cmp := c
      this.lock.unlock()
      return this
    end withComparator

    // Búsqueda binaria PRIVADA (sin lock). Devuelve el índice si la clave
    // existe; si no, -(ip)-1 donde ip es el punto de inserción.
    function bsearch(key: Object): integer
      var lo: integer := 0
      var hi: integer := this.keyList.length() - 1
      while lo <= hi do
        var mid: integer := (lo + hi) / 2
        var midKey: Object := this.keyList.get(mid)
        var c: integer := this.cmp.compare(key, midKey)
        if c == 0 then
          return mid
        endif
        if c < 0 then
          hi := mid - 1
        else
          lo := mid + 1
        endif
      endwh
      return (-lo) - 1
    end bsearch

    // Inserta (key,val) en el punto ip desplazando a la derecha. PRIVADO.
    function insertAt(ip: integer, key: Object, val: Object)
      this.keyList.add(key)               // crece 1 (se sobreescribe luego)
      this.valList.add(val)
      var i: integer := this.keyList.length() - 1
      while i > ip do
        this.keyList.set(i, this.keyList.get(i - 1))
        this.valList.set(i, this.valList.get(i - 1))
        i := i - 1
      endwh
      this.keyList.set(ip, key)
      this.valList.set(ip, val)
    end insertAt

    // Nº de entradas.
    public function size(): integer
      this.lock.lock()
      var n: integer := this.keyList.length()
      this.lock.unlock()
      return n
    end size

    // Inserta o actualiza.
    public function put(key: Object, val: Object)
      this.lock.lock()
      var idx: integer := this.bsearch(key)
      if idx >= 0 then
        this.valList.set(idx, val)
      else
        this.insertAt((-idx) - 1, key, val)
      endif
      this.lock.unlock()
    end put

    // Devuelve el valor, o null si la clave no existe.
    public function get(key: Object): Object
      this.lock.lock()
      var idx: integer := this.bsearch(key)
      var result: Object := null
      if idx >= 0 then
        result := this.valList.get(idx)
      endif
      this.lock.unlock()
      return result
    end get

    public function containsKey(key: Object): boolean
      this.lock.lock()
      var found: boolean := this.bsearch(key) >= 0
      this.lock.unlock()
      return found
    end containsKey

    // Borra la clave. Devuelve true si existía.
    public function remove(key: Object): boolean
      this.lock.lock()
      var idx: integer := this.bsearch(key)
      var existed: boolean := false
      if idx >= 0 then
        this.keyList.remove(idx)
        this.valList.remove(idx)
        existed := true
      endif
      this.lock.unlock()
      return existed
    end remove

    // Acceso por índice (0..size-1) en orden de clave. Para iterar:
    //   var i := 0
    //   while i < m.size() do
    //     ... m.keyAt(i) ... m.valueAt(i) ...
    //     i := i + 1
    //   endwh
    // (Se evita devolver List por la API pública porque el tipo built-in
    //  List no unifica su identidad cross-module — ver GAP-2 en backlog.)
    public function keyAt(i: integer): Object
      this.lock.lock()
      var k: Object := this.keyList.get(i)
      this.lock.unlock()
      return k
    end keyAt

    public function valueAt(i: integer): Object
      this.lock.lock()
      var v: Object := this.valList.get(i)
      this.lock.unlock()
      return v
    end valueAt

  end Map

  // -------------------------------------------------------------
  // Factories. Construyen el comparador DENTRO del módulo (donde el
  // subtipado subclase→base funciona). Pasar una subclase de Comparator
  // cross-module aún no va (GAP-3), así que el usuario usa estos factories
  // en vez de Map().withComparator(miCmp) desde fuera.
  // -------------------------------------------------------------

  // Map con claves string (orden lexicográfico). = Collections.Map().
  public function stringMap(): Map
    return Map()
  end stringMap

  // Map con claves boxed Comparable (Integer/Long/Double/...), orden natural.
  public function numericMap(): Map
    return Map().withComparator(NaturalComparator())
  end numericMap

end Collections
