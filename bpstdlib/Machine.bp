// Machine.bp — informacion del MICRO y de la PLACA, para todas las familias.
//
// Antes se llamaba `Pico`, y era un mal nombre: este modulo no es de la Pico, es
// de todos los micros. Renombrado en V6 por decision de Eduardo (8-sep):
//
//   «Pico no ha de ser "Pico": es un modulo para todos los micros. Se le puede
//    cambiar el nombre a "machine" o "system" o algo parecido. El mismo para
//    todos.»
//
// `system` se descarto a proposito: ese nombre esta pedido por el MODULO RAIZ de
// V7 (al estilo de la unidad System de Turbo Pascal), y gastarlo aqui lo dejaria
// ocupado para lo otro.
//
// ⚠️ `Pico` SIGUE EXISTIENDO como alias que reenvia aqui, porque V4 y V5 estan
// publicadas y hay programas escritos contra el. Norma de la casa: lo nuevo se
// ANADE y se cuenta la convivencia. Ver `bpstdlib/Pico.bp`.

module Machine

  // ---- Identificación ----
  // ID único del chip flash (16 chars hex). Permanece estable
  // entre reboots y entre flasheos del firmware.
  public function uniqueId(): string
    inline CALL_BUILTIN 104
  end uniqueId

  // Nombre legible de la board. "pico2" en RP2350, "host" en VM
  // Java sin HW.
  // ---- Los DOS nombres de la identidad (V6) ----
  //
  // Se devuelven los dos y decide el programa cual le interesa, que es justo lo
  // que antes no se podia: habia UN campo y cada familia le daba un significado
  // distinto, asi que un programa en un C3 se creia un S3.
  //
  //   getMicro()  el CHIP: "rp2350", "esp32s3", "esp32c3", "esp32p4", "stm32u5"
  //               (en el PC, "host"). Real y especifico SIEMPRE.
  //   getBoard()  la PLACA: "generic" cuando la imagen no conoce el modelo, que
  //               es lo normal — las imagenes se hacen para el MICRO. El RP2350
  //               y el STM32 si la conocen ("pico2", "nucleo-u575zi"...).
  public function getMicro(): string
    inline CALL_BUILTIN 233
  end getMicro
  public function getBoard(): string
    inline CALL_BUILTIN 105
  end getBoard

  // Obsoleta: es lo mismo que getBoard(). Se conserva por los programas ya
  // escritos; para codigo nuevo, usa getMicro() o getBoard() segun lo que
  // quieras saber, que es la distincion que esta funcion no sabia hacer.
  public function boardName(): string
    inline CALL_BUILTIN 105
  end boardName

  // ---- La configuracion de la placa: su ENV (V7/H10, #626) ----
  // El valor de una clave del ENV —las variables `clave=valor` que el IDE ensena y
  // edita en «Variables del entorno»—, o "" si la clave no esta. Las claves no
  // distinguen mayusculas: `PSRAM` y `psram` son la misma. Es el ENV con el que
  // arranco la placa, como el hardware que configura: un cambio desde el IDE se
  // ve al reiniciar. En el PC no hay ENV: siempre "".
  //
  //   var f: string := Machine.getEnv("imagen.fecha")   // la que mira Rtc.Clock.isSet()
  public function getEnv(key: string): string
    inline CALL_BUILTIN 271
  end getEnv

  // ---- Sensores internos ----
  // Temperatura del die en °C. Lee el sensor interno del ADC
  // (canal 4 en RP2350). Precisión típica ±2 °C sin calibración.
  public function tempC(): float
    inline CALL_BUILTIN 106
  end tempC

  // ---- Reloj ----
  // Frecuencia actual del clk_sys en Hz. En RP2350 con config por
  // defecto es 150_000_000 (150 MHz).
  public function cpuFreqHz(): integer
    inline CALL_BUILTIN 107
  end cpuFreqHz

  // Milisegundos desde el boot del firmware. 32-bit unsigned con
  // wrap ≈ 49 días. Para uptimes más largos, usar un acumulador en
  // BP que detecte el wrap.
  public function uptimeMs(): integer
    inline CALL_BUILTIN 108
  end uptimeMs

  // ---- Board-aware (H7.3) ----
  // Número de GPIO disponibles en la PLACA. Lo resuelve el firmware
  // desde el board_desc (variante RP2350A=30 / RP2350B=48, u override
  // de /sys/board.json). En la VM Java (host) devuelve 30 (perfil A).
  // GPIO_COUNT() delega aquí para que sea board-aware automáticamente.
  public function gpioCount(): integer
    inline CALL_BUILTIN 123
  end gpioCount

  // ---- Causa del último reset (H10) ----
  // Devuelve por qué se reinició el MCU como string: "watchdog (IWDG)",
  // "power-on/brown-out", "software", "pin (NRST)", "low-power", ... En la
  // VM Java (host) devuelve "unknown" (un PC no tiene causa de reset de MCU).
  // Útil para diagnosticar reinicios inesperados (p.ej. un watchdog que saltó).
  public function resetCause(): string
    inline CALL_BUILTIN 201
  end resetCause

  // ---- Breadcrumb en RAM retenida (H10) ----
  // "Migas" que sobreviven al reset (registros de backup del MCU). La app deja
  // marcas (setMark) por fases; tras un reset inesperado se lee el rastro que
  // llevó al fallo. Útil contra cascadas de errores: markAt(0) es SIEMPRE la
  // causa ORIGINAL (1ª marca, pegajosa); el resto son las últimas N. En la VM
  // Java (host) no hay RAM retenida → setMark no-op, markCount=0, bootCount=1.
  //
  //   Pico.setMark(10)                  // antes de cada fase arriesgada
  //   ...
  //   // tras un reset, al arrancar:
  //   var n: integer := Pico.markCount()
  //   var i: integer := 0
  //   while i < n do
  //     print "  miga " + intToString(i) + ": " + intToString(Pico.markAt(i))
  //     i := i + 1
  //   endwh
  public function setMark(code: integer)
    inline CALL_BUILTIN 202
  end setMark
  public function markCount(): integer
    inline CALL_BUILTIN 203
  end markCount
  public function markAt(i: integer): integer
    inline CALL_BUILTIN 204
  end markAt
  public function bootCount(): integer
    inline CALL_BUILTIN 205
  end bootCount

  // Variante del chip como string ("A" / "B"), derivada de gpioCount()
  // — no necesita su propio intrínseco. RP2350A bondea 30 GPIO, RP2350B
  // 48; el umbral 40 los separa con holgura.
  public function variant(): string
    // V7/H4: ya no inventa («B si gpioCount >= 40» contestaba B en un ESP32-P4). La variante
    // A/B es cosa del RP2350; en cualquier otro micro es "". Para el paquete real, package().
    var m: string := getMicro()
    if m == "rp2350a" then
      return "A"
    endif
    if m == "rp2350b" then
      return "B"
    endif
    return ""
  end variant

  // Frecuencia máxima soportada en MHz para setCpuFreqMHz().
  //
  // Conservador: el RP2350 nominal es 150 MHz; con voltaje core
  // estándar (~1.10 V) la mayoría de chips llegan a 250-300 MHz sin
  // refrigeración. 300 MHz es el techo "seguro" para configs sin
  // ajuste de voltaje. Por encima requiere vreg_set_voltage(),
  // posible inestabilidad de XIP (flash) y refrigeración activa.
  // Si alguien quiere apurar a 400+ MHz, que use el backend C
  // directamente; nuestro BP juega seguro.
  public function MAX_CPU_MHZ(): integer
    return __capsInt(0) / 1000000     // V7/H4: POR MICRO (antes los 300 del RP2350 para todos)
  end MAX_CPU_MHZ

  // Frecuencia mínima razonable. Por debajo la PLL del RP2350 no
  // sintetiza limpio.
  public function MIN_CPU_MHZ(): integer
    return __capsInt(1) / 1000000
  end MIN_CPU_MHZ

  // Cambia el clk_sys del MCU a `mhz` MHz. Devuelve true si la PLL
  // pudo configurarse, false si la combinación pedida (incluso tras
  // clamp) no es alcanzable por el HW.
  //
  // Política: si mhz > MAX_CPU_MHZ se aplica MAX_CPU_MHZ
  // (no falla); si mhz < MIN_CPU_MHZ se aplica MIN_CPU_MHZ.
  // Ambos clamps ocurren AQUÍ — el backend recibe el valor ya
  // saneado y limita su propio rango mínimo de PLL al margen.
  //
  // CRÍTICO: llamar a setCpuFreqMHz ANTES de configurar UART/SPI/
  // I2C/PWM. Esos buses calculan sus divisores en base a clk_peri
  // (derivado de clk_sys); cambiar clk_sys después deja los
  // baudrates/freq mal. Si se hace, hay que re-llamar a Uart.init /
  // Spi.init / etc. para recalcular.
  //
  // Las funciones sleep* (sleep, sleepSec, sleepUs, now) NO se ven
  // afectadas — usan el timer hardware del RP2350 que corre a 1 MHz
  // independiente del clk_sys.
  public function setCpuFreqMHz(mhz: integer): boolean
    var clamped: integer := mhz
    if clamped > MAX_CPU_MHZ() then
      clamped := MAX_CPU_MHZ()
    endif
    if clamped < MIN_CPU_MHZ() then
      clamped := MIN_CPU_MHZ()
    endif
    return setCpuFreqMHzRaw(clamped)
  end setCpuFreqMHz

  // Intrínseco interno (mapea al builtin nativo). Aplica la
  // frecuencia tal cual sin clampear — el wrapper público
  // setCpuFreqMHz() es el que hace el clamp con MAX/MIN_CPU_MHZ.
  // Se expone como `public` porque la infraestructura intrinsic
  // exige visibilidad pública, pero no debería usarse directo
  // desde BP de usuario.
  public function setCpuFreqMHzRaw(mhz: integer): boolean
    inline CALL_BUILTIN 111
  end setCpuFreqMHzRaw

  // ---- Constantes de capacidades del MCU ----
  // Permiten que código BP defensivo valide rangos antes de usar
  // p.ej. Spi.init(bus=3, ...) cuando solo hay 2 buses.
  // V7/H4 — LA TABLA DE CAPACIDADES: lo que este micro tiene, dicho por su imagen (una fuente
  // para el INFO del wire, para esto y para la validación de las fachadas). Los arrays son de
  // Eduardo: las instancias válidas de cada bus, tal como las toma Uart.Port(id, …) —«el número
  // es la longitud del array»—; para lo que se construye por PIN (PWM, ADC, pulsos) lo útil es
  // saber QUÉ pines pueden. Los contadores de siempre se quedan como azúcar de estos.
  function __capsArray(kind: integer): integer[]
    inline CALL_BUILTIN 250
  end __capsArray
  function __capsInt(kind: integer): integer
    inline CALL_BUILTIN 251
  end __capsInt
  function __capsStr(kind: integer): string
    inline CALL_BUILTIN 252
  end __capsStr
  function __capsPin(pin: integer): integer
    inline CALL_BUILTIN 253
  end __capsPin

  // Las instancias válidas: Uart.Port(id, …) sólo acepta las de uarts(), etc.
  public function uarts(): integer[]
    return __capsArray(0)
  end uarts
  public function i2cs(): integer[]
    return __capsArray(1)
  end i2cs
  public function spis(): integer[]
    return __capsArray(2)
  end spis
  // Los pines: los que existen, y los que pueden cada cosa.
  public function pins(): integer[]
    return __capsArray(3)
  end pins
  public function analogPins(): integer[]
    return __capsArray(4)
  end analogPins
  public function pwmPins(): integer[]
    return __capsArray(5)
  end pwmPins
  public function pulsePins(): integer[]
    return __capsArray(6)
  end pulsePins
  public function openDrainPins(): integer[]
    return __capsArray(7)
  end openDrainPins
  public function hasPin(pin: integer): boolean
    return __capsPin(pin) != 0
  end hasPin
  public function isAnalog(pin: integer): boolean
    return (__capsPin(pin) & 2) != 0
  end isAnalog
  public function isInputOnly(pin: integer): boolean
    return (__capsPin(pin) & 32) != 0
  end isInputOnly
  // La unidad en que cuenta PWM_SLICES(): "slice" (RP2350) o "canal" (LEDC, timer).
  public function pwmUnit(): string
    return __capsStr(3)
  end pwmUnit
  public function manufacturer(): string
    return __capsStr(2)
  end manufacturer
  // La VARIANTE del micro elegida en el arranque: "QFN-60"/"QFN-80" en el RP2350, "LQFP144" en un STM32…
  public function package(): string
    return __capsStr(1)
  end package
  public function adcUnits(): integer
    return __capsInt(4)
  end adcUnits
  public function hasBreadcrumb(): boolean
    return __capsInt(5) != 0
  end hasBreadcrumb
  public function I2C_BUSES(): integer
    return len(i2cs())
  end I2C_BUSES
  public function SPI_BUSES(): integer
    return len(spis())
  end SPI_BUSES
  public function UART_BUSES(): integer
    return len(uarts())
  end UART_BUSES

  // Board-aware desde H7.3: delega en el intrínseco gpioCount() (lo
  // resuelve el firmware por variante / board.json). 30 en host/RP2350A,
  // 48 en RP2350B (Metro).
  public function GPIO_COUNT(): integer
    return gpioCount()
  end GPIO_COUNT

  // Board-aware (H14): los resuelve el firmware desde su DESCRIPTOR de placa
  // (board_desc / board.json en RP2350; p4_board_id en ESP32). En host/RP2350
  // = perfil RP2350 (4 ADC externos GP26..29 / 12 slices PWM); en el P4 → 14/14.
  public function ADC_CHANNELS(): integer
    inline CALL_BUILTIN 208
  end ADC_CHANNELS

  public function PWM_SLICES(): integer
    inline CALL_BUILTIN 209
  end PWM_SLICES

end Machine
