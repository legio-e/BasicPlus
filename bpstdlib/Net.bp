// ============================================================
// Net.bp — módulo stdlib de red: cliente TCP simple (H11, #241).
//
// Las funciones tcp* son `intrinsic`: el compilador inlina
// CALL_BUILTIN 131..134 en el call-site. La implementación:
//
//   - VM Java (PC):      java.net.Socket (siempre disponible).
//   - VM C host:         sockets del SO via fachada bpvm_net
//                        (Winsock2 en Windows, POSIX en el resto).
//   - Firmwares:         SIN backend por ahora (H11.b/c traerán
//                        lwIP en Pico 2 W / ESP32-S3). Cualquier
//                        operación lanza RuntimeError ATRAPABLE
//                        "Net: sin red en esta plataforma".
//
// Contrato (paridad dual-VM byte-idéntica):
//   - El fallo de CONEXIÓN es un resultado NORMAL (connect devuelve
//     false), no una excepción: rechazo, timeout y DNS fallido se
//     tratan igual.
//   - recv SIEMPRE lleva timeout (en device un recv infinito
//     bloquearía el worker entero). Timeout → byte[] vacío.
//   - El peer cerrando la conexión (FIN) o un error de red en
//     send/recv → RuntimeError atrapable.
//
// Política HW=clases: la forma recomendada es la clase Net.Tcp.
// ============================================================
module Net

  // -------- Intrínsecos de bajo nivel (handle = integer) --------

  // Conecta a host:port. timeoutMs <= 0 → 5000. Devuelve un handle
  // >= 1, o 0 si no se pudo conectar (resultado normal, no error).
  public function tcpConnect(host: string, port: integer, timeoutMs: integer): integer
    inline CALL_BUILTIN 131
  end tcpConnect

  // Envía TODOS los bytes del array. Devuelve los bytes enviados
  // (== len(data)). Conexión rota/handle inválido → RuntimeError.
  public function tcpSend(h: integer, data: byte[]): integer
    inline CALL_BUILTIN 132
  end tcpSend

  // Lee hasta `max` bytes (tope 65536) esperando como máximo
  // timeoutMs (<= 0 → 1 ms). Timeout → byte[] vacío. El peer cerró →
  // RuntimeError "Net.recv: conexión cerrada por el peer".
  public function tcpRecv(h: integer, max: integer, timeoutMs: integer): byte[]
    inline CALL_BUILTIN 133
  end tcpRecv

  // Cierra el handle. Tolerante: handle inválido = no-op.
  public function tcpClose(h: integer)
    inline CALL_BUILTIN 134
  end tcpClose

  // -------- Clase OO (forma recomendada) --------

  public class Tcp

    public property h: integer   // handle de la conexión; 0 = no conectada
    private var pendiente: byte[]   // V8/H5 (#711): el principio de un carácter que no llegó entero (0 a 3 bytes)

    public function Tcp()
      this.h := 0
      this.pendiente := newByteArray(0)
    end Tcp

    // Conecta. Devuelve true si la conexión quedó establecida.
    public function connect(host: string, port: integer, timeoutMs: integer): boolean
      this.h := tcpConnect(host, port, timeoutMs)
      return this.h != 0
    end connect

    public function isOpen(): boolean
      return this.h != 0
    end isOpen

    // Envía bytes crudos. Devuelve los bytes enviados.
    public function send(data: byte[]): integer
      return tcpSend(this.h, data)
    end send

    // Azúcar: envía un string como sus bytes UTF-8.
    public function sendStr(s: string): integer
      return tcpSend(this.h, toBytes(s))
    end sendStr

    // Lee hasta max bytes con timeout. Vacío = no llegó nada a tiempo.
    public function recv(max: integer, timeoutMs: integer): byte[]
      return tcpRecv(this.h, max, timeoutMs)
    end recv

    // Azúcar: lee y decodifica como UTF-8 ("" = timeout). V8/H5 (#711): un carácter puede llegar partido entre dos
    // paquetes; sus primeros bytes (tres como mucho) se quedan en la conexión y se juntan con el paquete siguiente, en
    // vez de dar un error con un texto bueno (Eduardo, de los streams: «si le faltan bytes lo que toca sería esperar a
    // que continue la lectura»). Si vence el plazo, "" y lo pendiente sigue esperando. Lo que no es UTF-8 válido,
    // EncodingError; con ignorarError, «�». Va ANTES que recvStr(max, timeoutMs), que la llama.
    public function recvStr(max: integer, timeoutMs: integer, ignorarError: boolean): string
      var llega: byte[] := tcpRecv(this.h, max, timeoutMs)
      var np: integer := len(this.pendiente)
      var n: integer := np + len(llega)
      var b: byte[] := llega
      if np > 0 then
        b := newByteArray(n)
        move(this.pendiente, b, 0, 0, np)
        move(llega, b, 0, np, len(llega))
      endif
      // un principio de carácter (C2..F4) entre los tres últimos bytes, con menos bytes detrás de los que pide: ahí
      // se corta, y lo de detrás espera al paquete siguiente
      var corte: integer := n
      var i: integer := n - 1
      var parar: boolean := false
      while i >= 0 and i >= n - 3 and not parar do
        var c: integer := b[i] & 255
        if c >= 0xC0 then
          var pide: integer := 0
          if c >= 0xC2 and c <= 0xDF then
            pide := 2
          elseif c >= 0xE0 and c <= 0xEF then
            pide := 3
          elseif c >= 0xF0 and c <= 0xF4 then
            pide := 4
          endif
          if pide > n - i then
            corte := i
          endif
          parar := true
        elseif c < 0x80 then
          parar := true
        endif
        i := i - 1
      endwh
      this.pendiente := newByteArray(n - corte)
      move(b, this.pendiente, corte, 0, n - corte)
      var cuerpo: byte[] := b
      if corte < n then
        cuerpo := newByteArray(corte)
        move(b, cuerpo, 0, 0, corte)
      endif
      return fromBytes(cuerpo, ignorarError)
    end recvStr

    public function recvStr(max: integer, timeoutMs: integer): string
      return this.recvStr(max, timeoutMs, false)
    end recvStr

    public function close()
      if this.h != 0 then
        tcpClose(this.h)
        this.h := 0
      endif
    end close

    // V7 #667 (8-oct): la conexión que muere se cierra.
    public function ~Tcp()
      this.close()
    end ~Tcp

  end Tcp

end Net
