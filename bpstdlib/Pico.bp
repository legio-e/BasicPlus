// Pico.bp — ALIAS OBSOLETO de `Machine`. No añadir nada aquí.
//
// Este modulo se llamaba asi por la primera placa que hubo, y era un mal nombre:
// no es de la Pico, es de todos los micros. En V6 pasa a ser `Machine` (decision
// de Eduardo, 8-sep) y esto se queda como PUENTE, no por comodidad sino por norma
// de la casa: V4 y V5 estan publicadas y hay programas escritos contra `Pico.*`.
// Lo nuevo se ANADE y se cuenta la convivencia; no se rompe lo que ya corre.
//
// ⚠️ Para codigo nuevo, usa `Machine`. Aqui no hay nada propio: cada funcion
// reenvia a la suya, y este fichero se GENERA de las firmas de Machine.bp — si
// añades algo alli, regeneralo en vez de escribirlo a mano.
//
// Coste: ~2 KB de flash por imagen. Las declaraciones no gastan RAM (el cargador
// salta la seccion `interface`).

module Pico
  import Machine

  public function uniqueId(): string
    return Machine.uniqueId()
  end uniqueId

  public function boardName(): string
    return Machine.boardName()
  end boardName

  public function tempC(): float
    return Machine.tempC()
  end tempC

  public function cpuFreqHz(): integer
    return Machine.cpuFreqHz()
  end cpuFreqHz

  public function uptimeMs(): integer
    return Machine.uptimeMs()
  end uptimeMs

  public function gpioCount(): integer
    return Machine.gpioCount()
  end gpioCount

  public function resetCause(): string
    return Machine.resetCause()
  end resetCause

  public function setMark(code: integer)
    Machine.setMark(code)
  end setMark

  public function markCount(): integer
    return Machine.markCount()
  end markCount

  public function markAt(i: integer): integer
    return Machine.markAt(i)
  end markAt

  public function bootCount(): integer
    return Machine.bootCount()
  end bootCount

  public function variant(): string
    return Machine.variant()
  end variant

  public function MAX_CPU_MHZ(): integer
    return Machine.MAX_CPU_MHZ()
  end MAX_CPU_MHZ

  public function MIN_CPU_MHZ(): integer
    return Machine.MIN_CPU_MHZ()
  end MIN_CPU_MHZ

  public function setCpuFreqMHz(mhz: integer): boolean
    return Machine.setCpuFreqMHz(mhz)
  end setCpuFreqMHz

  public function setCpuFreqMHzRaw(mhz: integer): boolean
    return Machine.setCpuFreqMHzRaw(mhz)
  end setCpuFreqMHzRaw

  public function I2C_BUSES(): integer
    return Machine.I2C_BUSES()
  end I2C_BUSES

  public function SPI_BUSES(): integer
    return Machine.SPI_BUSES()
  end SPI_BUSES

  public function UART_BUSES(): integer
    return Machine.UART_BUSES()
  end UART_BUSES

  public function GPIO_COUNT(): integer
    return Machine.GPIO_COUNT()
  end GPIO_COUNT

  public function ADC_CHANNELS(): integer
    return Machine.ADC_CHANNELS()
  end ADC_CHANNELS

  public function PWM_SLICES(): integer
    return Machine.PWM_SLICES()
  end PWM_SLICES

end Pico