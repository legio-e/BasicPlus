module Json

  import Core   // V6: los tipos de Core se importan

  // ====================================================================
  // Json.bp — librería para leer y escribir archivos JSON en BasicPlus.
  //
  // Jerarquía de objetos (clases sintetizadas en el módulo):
  //
  //   JsonValue (base; isXxx() y asXxx() polimórficos)
  //     ├── JsonNull
  //     ├── JsonBool    (value: boolean)
  //     ├── JsonInt     (value: integer)
  //     ├── JsonFloat   (value: float)
  //     ├── JsonString  (value: string)
  //     ├── JsonArray   (items)
  //     └── JsonObject  (keys/values; preserva orden de inserción)
  //
  // API pública del módulo:
  //
  //   Json.parseJson(text)         → JsonValue   parsea string a árbol
  //   Json.writeJson(root)         → string      serializa árbol (compacto)
  //   Json.readJsonFile(path)      → JsonValue   readFile + parseJson
  //   Json.writeJsonFile(path, v)  → void        toJson + writeFile
  //
  // Errores (V8 #725) → parseJson sigue tras cada error de sintaxis, como un compilador, y al acabar lanza
  // AggregateError (hija de RuntimeError) con todos, diez como mucho: su msg los dice, uno por línea, con su
  // «línea L, columna C»; su lista `errors`, cada uno un JsonError (con line y column).
  //
  // NOTA del autor: las funciones del parser recursivo (parseValue,
  // parseObject, parseArray, ...) están a nivel de módulo en lugar de
  // métodos sobre JsonReader porque BP resuelve las llamadas a métodos
  // de clase EAGER por slot — no soportan forward references entre
  // métodos de la misma clase. Las llamadas a funciones del módulo
  // van por nombre con fixup tardío, así que la recursión mutua sí
  // funciona ahí.
  // ====================================================================

  // -------------------------------------------------------------------
  // Jerarquía JsonValue
  // -------------------------------------------------------------------

  public class JsonValue
    public function JsonValue()
    end JsonValue

    public function isNull():   boolean
      return false
    end isNull
    public function isBool():   boolean
      return false
    end isBool
    public function isNumber(): boolean
      return false
    end isNumber
    public function isInt():    boolean
      return false
    end isInt
    public function isFloat():  boolean
      return false
    end isFloat
    public function isString(): boolean
      return false
    end isString
    public function isArray():  boolean
      return false
    end isArray
    public function isObject(): boolean
      return false
    end isObject

    // Conversores tipados — las subclases concretas overrideán los que les
    // aplican. Llamarlos sobre un tipo equivocado lanza RuntimeError.
    public function asBool(): boolean
      throw RuntimeError("JsonValue: no es boolean")
      return false
    end asBool
    public function asInt(): integer
      throw RuntimeError("JsonValue: no es integer")
      return 0
    end asInt
    public function asFloat(): float
      throw RuntimeError("JsonValue: no es float")
      return 0.0
    end asFloat
    public function asString(): string
      throw RuntimeError("JsonValue: no es string")
      return ""
    end asString
    public function asArray(): JsonArray
      throw RuntimeError("JsonValue: no es array")
      return null
    end asArray
    public function asObject(): JsonObject
      throw RuntimeError("JsonValue: no es object")
      return null
    end asObject

    // Hook polimórfico que las subclases overrideán para serializar.
    public function writeTo(sb: StringBuilder)
    end writeTo

    // Empaqueta writeTo en un StringBuilder fresco.
    public function toJson(): string
      var sb: StringBuilder := StringBuilder()
      this.writeTo(sb)
      return sb.toString()
    end toJson
  end JsonValue

  public class JsonNull extends JsonValue
    public function JsonNull()
      super()
    end JsonNull
    public function isNull(): boolean
      return true
    end isNull
    public function writeTo(sb: StringBuilder)
      sb.appendStr("null")
    end writeTo
  end JsonNull

  public class JsonBool extends JsonValue
    public property value: boolean
    public function JsonBool(value: boolean)
      super()
      this.value := value
    end JsonBool
    public function isBool(): boolean
      return true
    end isBool
    public function asBool(): boolean
      return this.value
    end asBool
    public function writeTo(sb: StringBuilder)
      if this.value then
        sb.appendStr("true")
      else
        sb.appendStr("false")
      endif
    end writeTo
  end JsonBool

  public class JsonInt extends JsonValue
    public property value: integer
    public function JsonInt(value: integer)
      super()
      this.value := value
    end JsonInt
    public function isNumber(): boolean
      return true
    end isNumber
    public function isInt(): boolean
      return true
    end isInt
    public function asInt(): integer
      return this.value
    end asInt
    public function writeTo(sb: StringBuilder)
      sb.appendInt(this.value)
    end writeTo
  end JsonInt

  public class JsonFloat extends JsonValue
    public property value: float
    public function JsonFloat(value: float)
      super()
      this.value := value
    end JsonFloat
    public function isNumber(): boolean
      return true
    end isNumber
    public function isFloat(): boolean
      return true
    end isFloat
    public function asFloat(): float
      return this.value
    end asFloat
    public function writeTo(sb: StringBuilder)
      sb.appendStr(floatToString(this.value))
    end writeTo
  end JsonFloat

  public class JsonString extends JsonValue
    public property value: string
    public function JsonString(value: string)
      super()
      this.value := value
    end JsonString
    public function isString(): boolean
      return true
    end isString
    public function asString(): string
      return this.value
    end asString
    public function writeTo(sb: StringBuilder)
      appendQuotedString(sb, this.value)
    end writeTo
  end JsonString

  public class JsonArray extends JsonValue
    public property items: List

    public function JsonArray()
      super()
      this.items := List()
    end JsonArray

    public function isArray(): boolean
      return true
    end isArray

    public function asArray(): JsonArray
      return this
    end asArray

    public function add(v: JsonValue)
      this.items.add(v)
    end add

    public function at(i: integer): JsonValue
      return JsonValue(this.items.get(i))
    end at

    public function length(): integer
      return this.items.length()
    end length

    public function writeTo(sb: StringBuilder)
      sb.appendChar(91)         // '['
      var n: integer := this.items.length()
      var i: integer := 0
      while i < n do
        if i > 0 then
          sb.appendChar(44)     // ','
        endif
        var v: JsonValue := JsonValue(this.items.get(i))
        v.writeTo(sb)
        i := i + 1
      endwh
      sb.appendChar(93)         // ']'
    end writeTo
  end JsonArray

  public class JsonObject extends JsonValue
    // Pareja paralela: keys[i] (JsonString) ↔ values[i] (JsonValue).
    // Las claves se guardan como JsonString porque BP no permite asignar
    // `any → string` (primitiva); sí permite `any → ClassType`.
    // Preserva orden de inserción.
    public property keys:   List
    public property values: List

    public function JsonObject()
      super()
      this.keys   := List()
      this.values := List()
    end JsonObject

    public function isObject(): boolean
      return true
    end isObject

    public function asObject(): JsonObject
      return this
    end asObject

    public function length(): integer
      return this.keys.length()
    end length

    // OJO: declarada ANTES de put/find/has — los métodos de clase se
    // resuelven eagerly por slot, así que el callee debe ya existir
    // cuando se emite el caller.
    public function indexOfKey(key: string): integer
      var n: integer := this.keys.length()
      var i: integer := 0
      while i < n do
        var kw: JsonString := JsonString(this.keys.get(i))
        if kw.value == key then
          return i
        endif
        i := i + 1
      endwh
      return -1
    end indexOfKey

    public function put(key: string, v: JsonValue)
      var idx: integer := this.indexOfKey(key)
      if idx >= 0 then
        this.values.set(idx, v)
      else
        this.keys.add(JsonString(key))
        this.values.add(v)
      endif
    end put

    public function find(key: string): JsonValue
      var idx: integer := this.indexOfKey(key)
      if idx < 0 then
        return null
      endif
      return JsonValue(this.values.get(idx))
    end find

    public function has(key: string): boolean
      return this.indexOfKey(key) >= 0
    end has

    public function keyAt(i: integer): string
      var kw: JsonString := JsonString(this.keys.get(i))
      return kw.value
    end keyAt

    public function valueAt(i: integer): JsonValue
      return JsonValue(this.values.get(i))
    end valueAt

    // --- accesores de conveniencia (ergonomía) ---
    // req(): devuelve el valor de la clave o lanza si falta.
    public function req(key: string): JsonValue
      var v: JsonValue := this.find(key)
      if v == null then
        throw RuntimeError("Json: falta la clave '" + key + "'")
      endif
      return v
    end req

    // Estrictos: lanzan si la clave falta (req) o el tipo no cuadra (asXxx).
    public function getString(key: string): string
      return this.req(key).asString()
    end getString
    public function getInt(key: string): integer
      return this.req(key).asInt()
    end getInt
    public function getFloat(key: string): float
      return this.req(key).asFloat()
    end getFloat
    public function getBool(key: string): boolean
      return this.req(key).asBool()
    end getBool
    public function getObject(key: string): JsonObject
      return this.req(key).asObject()
    end getObject
    public function getArray(key: string): JsonArray
      return this.req(key).asArray()
    end getArray

    // Con valor por defecto si la clave falta o el tipo no cuadra.
    public function getStringOr(key: string, def: string): string
      var v: JsonValue := this.find(key)
      if v == null then
        return def
      endif
      if not v.isString() then
        return def
      endif
      return v.asString()
    end getStringOr
    public function getIntOr(key: string, def: integer): integer
      var v: JsonValue := this.find(key)
      if v == null then
        return def
      endif
      if not v.isInt() then
        return def
      endif
      return v.asInt()
    end getIntOr
    public function getFloatOr(key: string, def: float): float
      var v: JsonValue := this.find(key)
      if v == null then
        return def
      endif
      if not v.isFloat() then
        return def
      endif
      return v.asFloat()
    end getFloatOr
    public function getBoolOr(key: string, def: boolean): boolean
      var v: JsonValue := this.find(key)
      if v == null then
        return def
      endif
      if not v.isBool() then
        return def
      endif
      return v.asBool()
    end getBoolOr

    public function writeTo(sb: StringBuilder)
      sb.appendChar(123)        // '{'
      var n: integer := this.keys.length()
      var i: integer := 0
      while i < n do
        if i > 0 then
          sb.appendChar(44)     // ','
        endif
        var kw: JsonString := JsonString(this.keys.get(i))
        appendQuotedString(sb, kw.value)
        sb.appendChar(58)       // ':'
        var v: JsonValue := JsonValue(this.values.get(i))
        v.writeTo(sb)
        i := i + 1
      endwh
      sb.appendChar(125)        // '}'
    end writeTo
  end JsonObject

  // -------------------------------------------------------------------
  // V8 #725 — LOS ERRORES, COMO UN COMPILADOR (Eduardo: «Despues de un error debe intentar recuperarse como un
  // compilador. El número de errore, yo pondría un límite de 10 como máximo, si hay mas hasta que no arregle los primero
  // el resto no se ven y aborta, lanzando la excepción»). parseJson apunta cada error de sintaxis con su línea y su
  // columna, salta hasta la siguiente ',' o el cierre del array u objeto en el que está, y sigue; al acabar lanza
  // AggregateError con todos. Al décimo, se para y lanza esos diez.
  // -------------------------------------------------------------------

  // Un error de sintaxis de JSON, con su sitio: la línea y la columna (desde 1, en caracteres).
  public class JsonError extends RuntimeError
    public property line: integer
    public property column: integer

    public function JsonError(m: string, line: integer, column: integer)
      super(m)
      this.line := line
      this.column := column
    end JsonError
  end JsonError

  // Una excepción con una LISTA de causas (Eduardo: «me cree una excepción a la que podías añadir una lista de
  // excepciones como causa»). parseJson la lanza con todos sus errores, cada uno un JsonError; su msg los dice todos,
  // uno por línea. Va aquí, con el analizador (Eduardo: «Si alguien la quiere utilizar puede importar la librería o
  // copiar el código»). Hija de RuntimeError: quien ya atrapa RuntimeError la atrapa también.
  public class AggregateError extends RuntimeError
    public property errors: List

    public function AggregateError(m: string, errors: List)
      super(m)
      this.errors := errors
    end AggregateError
  end AggregateError

  // -------------------------------------------------------------------
  // Reader (simple state container; los helpers que necesitan recursión
  // mutua viven como funciones del módulo más abajo).
  // -------------------------------------------------------------------

  public class JsonReader
    public property text: string
    public property pos:  integer
    public property len:  integer
    var errores: List              // V8 #725: los JsonError apuntados, en orden
    var textos: StringBuilder      // sus textos, uno por línea, para el msg de AggregateError
    var ultLinea: integer          // el sitio del último apuntado: otro en el mismo sitio es la cascada del primero
    var ultColumna: integer

    public function JsonReader(text: string)
      this.text := text
      this.pos  := 0
      this.len  := strlen(text)
      this.errores := List()
      this.textos := StringBuilder()
      this.ultLinea := 0
      this.ultColumna := 0
    end JsonReader

    // V8 #725 — el error de sintaxis en la posición p (en caracteres): «línea L, columna C: texto».
    public function nuevoError(p: integer, texto: string): JsonError
      var linea: integer := 1
      var ini: integer := 0          // donde empieza la línea de p
      var i: integer := 0
      while i < p and i < this.len do
        if charCodeAt(this.text, i) == 10 then
          linea := linea + 1
          ini := i + 1
        endif
        i := i + 1
      endwh
      var col: integer := p - ini + 1
      return JsonError("línea " + intToString(linea) + ", columna " + intToString(col) + ": " + texto, linea, col)
    end nuevoError

    // Lo lanza; lo atrapa el array u objeto que lo contiene (o parseJson), que lo apunta y se recupera.
    public function error(p: integer, texto: string)
      throw this.nuevoError(p, texto)
    end error

    // La excepción con todos los apuntados.
    public function agregado(): AggregateError
      var n: integer := this.errores.length()
      if n == 1 then
        return AggregateError("JSON: " + JsonError(this.errores.get(0)).msg, this.errores)
      endif
      var cabeza: string := "JSON: " + intToString(n) + " errores:"
      if n >= 10 then
        cabeza := "JSON: 10 errores, los primeros (puede haber más: se para en el décimo):"
      endif
      return AggregateError(cabeza + "\n" + this.textos.toString(), this.errores)
    end agregado

    // Apunta un error, salvo otro en el mismo sitio que el anterior (la cascada de uno solo). Al décimo, se para: lanza
    // AggregateError, que no es un JsonError (no lo atrapa ningún array u objeto) y sale de parseJson tal cual.
    public function apunta(e: JsonError)
      if e.line == this.ultLinea and e.column == this.ultColumna then
        return
      endif
      this.ultLinea := e.line
      this.ultColumna := e.column
      if this.errores.length() > 0 then
        this.textos.appendStr("\n")
      endif
      this.textos.appendStr("  " + e.msg)
      this.errores.add(e)
      if this.errores.length() >= 10 then
        throw this.agregado()
      endif
    end apunta

    public function hayErrores(): boolean
      return this.errores.length() > 0
    end hayErrores

    public function peek(): integer
      if this.pos >= this.len then
        return -1
      endif
      return charCodeAt(this.text, this.pos)
    end peek

    public function advance(): integer
      var c: integer := this.peek()
      this.pos := this.pos + 1
      return c
    end advance

    // V8 #725: si no es el esperado, el error es en él, y NO se consume (la recuperación sigue desde ahí; si no, el
    // cierre que estaba en su sitio se perdía y salía otro error en cascada)
    public function expect(expected: integer)
      if this.peek() != expected then
        this.error(this.pos, "se esperaba '" + caracterJson(expected) + "'")
      endif
      this.pos := this.pos + 1
    end expect

    public function skipWs()
      var done: boolean := false
      while not done do
        if this.pos >= this.len then
          done := true
        else
          var c: integer := charCodeAt(this.text, this.pos)
          if c == 32 or c == 9 or c == 10 or c == 13 then
            this.pos := this.pos + 1
          else
            done := true
          endif
        endif
      endwh
    end skipWs
  end JsonReader

  // -------------------------------------------------------------------
  // Helpers de serialización (públicos para que sean callable desde
  // métodos de clases del módulo)
  // -------------------------------------------------------------------

  public function appendQuotedString(sb: StringBuilder, s: string)
    sb.appendChar(34)               // '"'
    var n: integer := strlen(s)
    var i: integer := 0
    while i < n do
      var c: integer := charCodeAt(s, i)
      if c == 34 then
        sb.appendChar(92)
        sb.appendChar(34)
      elseif c == 92 then
        sb.appendChar(92)
        sb.appendChar(92)
      elseif c == 10 then
        sb.appendChar(92)
        sb.appendChar(110)
      elseif c == 13 then
        sb.appendChar(92)
        sb.appendChar(114)
      elseif c == 9 then
        sb.appendChar(92)
        sb.appendChar(116)
      elseif c == 8 then
        sb.appendChar(92)
        sb.appendChar(98)
      elseif c == 12 then
        sb.appendChar(92)
        sb.appendChar(102)
      elseif c < 32 then
        sb.appendChar(92)
        sb.appendChar(117)          // 'u'
        sb.appendChar(48)
        sb.appendChar(48)
        var hi: integer := (c / 16) mod 16
        var lo: integer := c mod 16
        sb.appendChar(hexDigit(hi))
        sb.appendChar(hexDigit(lo))
      else
        sb.appendChar(c)
      endif
      i := i + 1
    endwh
    sb.appendChar(34)
  end appendQuotedString

  public function hexDigit(d: integer): integer
    if d < 10 then
      return 48 + d              // '0' + d
    endif
    return 87 + d                // 'a' + (d-10)
  end hexDigit

  public function isDigitCode(c: integer): boolean
    if c >= 48 and c <= 57 then
      return true
    endif
    return false
  end isDigitCode

  // -------------------------------------------------------------------
  // Parser recursivo: funciones del módulo (no métodos de clase) para
  // permitir recursión mutua via late-binding de CALL.
  // -------------------------------------------------------------------

  public function parseValueOn(r: JsonReader): JsonValue
    r.skipWs()
    var c: integer := r.peek()
    if c == 123 then
      return parseObjectOn(r)
    endif
    if c == 91 then
      return parseArrayOn(r)
    endif
    if c == 34 then
      return JsonString(parseStringLitOn(r))
    endif
    if c == 116 then
      return parseTrueOn(r)
    endif
    if c == 102 then
      return parseFalseOn(r)
    endif
    if c == 110 then
      return parseNullLitOn(r)
    endif
    return parseNumberOn(r)
  end parseValueOn

  public function parseTrueOn(r: JsonReader): JsonValue
    r.expect(116)
    r.expect(114)
    r.expect(117)
    r.expect(101)
    return JsonBool(true)
  end parseTrueOn

  public function parseFalseOn(r: JsonReader): JsonValue
    r.expect(102)
    r.expect(97)
    r.expect(108)
    r.expect(115)
    r.expect(101)
    return JsonBool(false)
  end parseFalseOn

  public function parseNullLitOn(r: JsonReader): JsonValue
    r.expect(110)
    r.expect(117)
    r.expect(108)
    r.expect(108)
    return JsonNull()
  end parseNullLitOn

  public function parseHexDigitOn(r: JsonReader): integer
    var c: integer := r.advance()
    if c >= 48 and c <= 57 then
      return c - 48
    endif
    if c >= 97 and c <= 102 then
      return c - 87
    endif
    if c >= 65 and c <= 70 then
      return c - 55
    endif
    return -1   // V8 #725: no es un dígito; quien llama da el error (y antes salta hasta el final de la cadena)
  end parseHexDigitOn

  // V8 #725 — los cuatro dígitos de un escape de JSON en u: su valor, o -1 si alguno no es hexadecimal.
  public function hex4On(r: JsonReader): integer
    var u: integer := 0
    var k: integer := 0
    while k < 4 do
      var d: integer := parseHexDigitOn(r)
      if d < 0 then
        return -1
      endif
      u := u * 16 + d
      k := k + 1
    endwh
    return u
  end hex4On

  // V8 #725 — desde dentro de una cadena, hasta después de su comilla de cierre (o el final del texto), saltando los
  // escapes: tras un error en una cadena, la recuperación sigue desde fuera de ella.
  public function saltaCadenaOn(r: JsonReader)
    var fin: boolean := false
    while r.pos < r.len and not fin do
      var c: integer := charCodeAt(r.text, r.pos)
      if c == 92 then
        r.pos := r.pos + 2
      else
        r.pos := r.pos + 1
        if c == 34 then
          fin := true
        endif
      endif
    endwh
  end saltaCadenaOn

  // V8 #725 — un error dentro de una cadena: salta hasta su final y lo lanza, en p.
  public function cadenaMalaOn(r: JsonReader, p: integer, texto: string)
    saltaCadenaOn(r)
    r.error(p, texto)
  end cadenaMalaOn

  // V8 #725 — ¿puede empezar un valor de JSON con c? Una comilla, una llave o un corchete de apertura, un dígito, el
  // signo menos, o la t, la f y la n de true, false y null.
  public function empiezaValor(c: integer): boolean
    return c == 34 or c == 123 or c == 91 or c == 45 or isDigitCode(c) or c == 116 or c == 102 or c == 110
  end empiezaValor

  // V8 #725 — un carácter, como texto (para los mensajes).
  public function caracterJson(c: integer): string
    var sb: StringBuilder := StringBuilder()
    sb.appendChar(c)
    return sb.toString()
  end caracterJson

  // V8 #725 — tras un error dentro de un array u objeto: hasta la siguiente ',' de este nivel o un cierre (de este nivel
  // o de uno de fuera), sin contar lo que haya dentro de cadenas ni de arrays u objetos anidados. Devuelve el carácter
  // en el que se paró (',' ']' '}'), sin consumirlo, o -1 al final del texto.
  public function sincronizaOn(r: JsonReader): integer
    var hondo: integer := 0
    while r.pos < r.len do
      var c: integer := charCodeAt(r.text, r.pos)
      if c == 34 then
        r.pos := r.pos + 1
        saltaCadenaOn(r)
      elseif c == 123 or c == 91 then
        hondo := hondo + 1
        r.pos := r.pos + 1
      elseif c == 125 or c == 93 then
        if hondo == 0 then
          return c
        endif
        hondo := hondo - 1
        r.pos := r.pos + 1
      elseif c == 44 and hondo == 0 then
        return c
      else
        r.pos := r.pos + 1
      endif
    endwh
    return -1
  end sincronizaOn

  // V8 #725 — el final de la recuperación de un array (cierre ']') u objeto ('}'): si se paró en una ',', sigue con el
  // elemento siguiente (false); en su cierre, lo consume y se acabó (true); en otro cierre (el de uno de fuera) o en el
  // final del texto, éste se queda sin cerrar: lo apunta y se acabó (true).
  public function cierraOn(r: JsonReader, cierre: integer): boolean
    var s: integer := sincronizaOn(r)
    if s == 44 then
      r.pos := r.pos + 1
      r.skipWs()
      return false
    endif
    if s == cierre then
      r.pos := r.pos + 1
      return true
    endif
    r.apunta(r.nuevoError(r.pos, "se esperaba '" + caracterJson(cierre) + "'"))
    return true
  end cierraOn

  public function parseStringLitOn(r: JsonReader): string
    var inicio: integer := r.pos        // V8 #725: la comilla de apertura (una cadena sin cerrar se dice ahí)
    r.expect(34)
    var sb: StringBuilder := StringBuilder()
    var done: boolean := false
    while not done do
      if r.pos >= r.len then
        r.error(inicio, "cadena sin cerrar")
      endif
      var c: integer := charCodeAt(r.text, r.pos)
      r.pos := r.pos + 1
      if c == 34 then
        done := true
      elseif c == 92 then
        var donde: integer := r.pos - 1   // la barra del escape
        var esc: integer := r.advance()
        if esc == 34 then
          sb.appendChar(34)
        elseif esc == 92 then
          sb.appendChar(92)
        elseif esc == 47 then
          sb.appendChar(47)
        elseif esc == 98 then
          sb.appendChar(8)
        elseif esc == 102 then
          sb.appendChar(12)
        elseif esc == 110 then
          sb.appendChar(10)
        elseif esc == 114 then
          sb.appendChar(13)
        elseif esc == 116 then
          sb.appendChar(9)
        elseif esc == 117 then
          var u: integer := hex4On(r)
          if u < 0 then
            cadenaMalaOn(r, donde, "escape en u con un dígito que no es hexadecimal")
          endif
          // V8/H5 (#711): un carácter por encima de FFFF va en JSON como DOS escapes en u, un par de sustitutos (el
          // alto, D800..DBFF, y el bajo, DC00..DFFF: RFC 8259 §7). Se juntan en uno. Uno suelto no es un carácter
          // (appendChar daría EncodingError): es un error de JSON, con su sitio, como los demás.
          if u >= 55296 and u <= 57343 then              // D800..DFFF
            var bajo: integer := -1
            if u <= 56319 and r.peek() == 92 then         // un alto (..DBFF) y detrás una barra
              r.advance()
              if r.advance() == 117 then                  // 'u'
                bajo := hex4On(r)
              endif
            endif
            if bajo < 56320 or bajo > 57343 then          // DC00..DFFF
              cadenaMalaOn(r, donde, "sustituto UTF-16 sin su pareja")
            endif
            u := 65536 + (u - 55296) * 1024 + (bajo - 56320)
          endif
          sb.appendChar(u)
        else
          cadenaMalaOn(r, donde, "escape no válido")
        endif
      else
        sb.appendChar(c)
      endif
    endwh
    return sb.toString()
  end parseStringLitOn

  public function parseNumberOn(r: JsonReader): JsonValue
    var startPos: integer := r.pos
    var isF: boolean := false
    var sawDigit: boolean := false
    var cifras: integer := 0          // V8 #725: las de la parte entera (con 9 o menos, parseInt no puede fallar)
    if r.peek() == 45 then
      r.pos := r.pos + 1
    endif
    while r.pos < r.len and isDigitCode(charCodeAt(r.text, r.pos)) do
      sawDigit := true
      cifras := cifras + 1
      r.pos := r.pos + 1
    endwh
    if r.peek() == 46 then
      isF := true
      r.pos := r.pos + 1
      while r.pos < r.len and isDigitCode(charCodeAt(r.text, r.pos)) do
        sawDigit := true
        r.pos := r.pos + 1
      endwh
    endif
    var pc: integer := r.peek()
    if pc == 101 or pc == 69 then
      isF := true
      r.pos := r.pos + 1
      var sign: integer := r.peek()
      if sign == 43 or sign == 45 then
        r.pos := r.pos + 1
      endif
      while r.pos < r.len and isDigitCode(charCodeAt(r.text, r.pos)) do
        sawDigit := true
        r.pos := r.pos + 1
      endwh
    endif
    // Sin ningún dígito no hay número que parsear: entrada vacía, fin
    // inesperado, o un carácter que no abre ningún valor JSON (p. ej. un
    // .win ausente que readFile devolvió vacío, o basura). parseInt("")
    // divergía entre VMs (miVM lanzaba, VM-C devolvía 0 mudo) → rompía la
    // paridad y aceptaba JSON inválido en placa. Falla limpio en AMBAS.
    if not sawDigit then
      r.error(startPos, "se esperaba un valor")
    endif
    var numStr: string := substring(r.text, startPos, r.pos)
    if isF or cifras >= 10 then
      return numeroJsonOn(r, numStr, startPos, isF)   // puede no valer: con su try
    endif
    return JsonInt(parseInt(numStr))                   // [-] y hasta 9 cifras: siempre cabe (sin try: es lo común)
  end parseNumberOn

  // V8 #716/#725 — un número que parseInt o parseFloat pueden rechazar (un decimal, o un entero de 10 cifras o más): lo
  // que rechacen (un exponente sin cifras, lo que no cabe) es un error de JSON más, con su sitio y su texto. Lo demás
  // (sin memoria), tal cual.
  public function numeroJsonOn(r: JsonReader, numStr: string, startPos: integer, isF: boolean): JsonValue
    var v: JsonValue := JsonNull()
    try
      if isF then
        v := JsonFloat(parseFloat(numStr))
      else
        v := JsonInt(parseInt(numStr))
      endif
    catch e: RuntimeError
      if startsWith(e.msg, "parseInt: ") or startsWith(e.msg, "parseFloat: ") then
        r.error(startPos, substring(e.msg, indexOf(e.msg, " ") + 1, strlen(e.msg)))
      endif
      throw e
    endtry
    return v
  end numeroJsonOn

  public function parseArrayOn(r: JsonReader): JsonValue
    r.expect(91)
    var arr: JsonArray := JsonArray()
    r.skipWs()
    if r.peek() == 93 then
      r.pos := r.pos + 1
      return arr
    endif
    var done: boolean := false
    while not done do
      try
        var v: JsonValue := parseValueOn(r)
        arr.add(v)
        r.skipWs()
        var c: integer := r.peek()
        if c == 44 then
          r.pos := r.pos + 1
          r.skipWs()
        elseif c == 93 then
          r.pos := r.pos + 1
          done := true
        elseif empiezaValor(c) then
          // V8 #725: falta la coma, y lo que viene es otro elemento: se apunta y se sigue con él, como un compilador
          // (si no, saltar hasta la coma siguiente se llevaba ese elemento, con los errores que tuviera dentro)
          r.apunta(r.nuevoError(r.pos, "se esperaba ',' o ']'"))
        else
          r.error(r.pos, "se esperaba ',' o ']'")
        endif
      catch e: JsonError
        r.apunta(e)                   // V8 #725: se apunta y se sigue (al décimo, se para)
        done := cierraOn(r, 93)
      endtry
    endwh
    return arr
  end parseArrayOn

  public function parseObjectOn(r: JsonReader): JsonValue
    r.expect(123)
    var obj: JsonObject := JsonObject()
    r.skipWs()
    if r.peek() == 125 then
      r.pos := r.pos + 1
      return obj
    endif
    var done: boolean := false
    while not done do
      try
        r.skipWs()
        if r.peek() != 34 then
          r.error(r.pos, "se esperaba una clave entre comillas")
        endif
        var key: string := parseStringLitOn(r)
        r.skipWs()
        if r.peek() != 58 then
          r.error(r.pos, "se esperaba ':'")
        endif
        r.pos := r.pos + 1
        var v: JsonValue := parseValueOn(r)
        obj.put(key, v)
        r.skipWs()
        var c: integer := r.peek()
        if c == 44 then
          r.pos := r.pos + 1
        elseif c == 125 then
          r.pos := r.pos + 1
          done := true
        elseif c == 34 then
          // V8 #725: falta la coma, y lo que viene es otra clave: se apunta y se sigue con ella, como un compilador
          r.apunta(r.nuevoError(r.pos, "se esperaba ',' o '}'"))
        else
          r.error(r.pos, "se esperaba ',' o '}'")
        endif
      catch e: JsonError
        r.apunta(e)                   // V8 #725: se apunta y se sigue (al décimo, se para)
        done := cierraOn(r, 125)
      endtry
    endwh
    return obj
  end parseObjectOn

  // -------------------------------------------------------------------
  // API pública
  // -------------------------------------------------------------------

  public function parseJson(text: string): JsonValue
    var r: JsonReader := JsonReader(text)
    var v: JsonValue := JsonNull()
    try
      r.skipWs()
      v := parseValueOn(r)
      r.skipWs()
      if r.pos < r.len then
        r.error(r.pos, "sobra texto tras el valor")
      endif
    catch e: JsonError
      r.apunta(e)
    endtry
    // V8 #725: con algún error, todos de una vez (diez como mucho)
    if r.hayErrores() then
      throw r.agregado()
    endif
    return v
  end parseJson

  public function writeJson(root: JsonValue): string
    return root.toJson()
  end writeJson

  // Serializa con indentación legible (2 espacios por nivel) — útil para
  // ficheros de configuración / diseño editables a mano.
  public function writeJsonPretty(root: JsonValue): string
    var sb: StringBuilder := StringBuilder()
    prettyOn(sb, root, 0)
    return sb.toString()
  end writeJsonPretty

  function jsonIndent(sb: StringBuilder, depth: integer)
    var i: integer := 0
    while i < depth do
      sb.appendChar(32)
      sb.appendChar(32)
      i := i + 1
    endwh
  end jsonIndent

  function prettyOn(sb: StringBuilder, v: JsonValue, depth: integer)
    if v.isObject() then
      var o: JsonObject := v.asObject()
      var n: integer := o.length()
      if n == 0 then
        sb.appendStr("{}")
      else
        sb.appendChar(123)            // '{'
        sb.appendChar(10)
        var i: integer := 0
        while i < n do
          jsonIndent(sb, depth + 1)
          appendQuotedString(sb, o.keyAt(i))
          sb.appendStr(": ")
          prettyOn(sb, o.valueAt(i), depth + 1)
          if i < n - 1 then
            sb.appendChar(44)         // ','
          endif
          sb.appendChar(10)
          i := i + 1
        endwh
        jsonIndent(sb, depth)
        sb.appendChar(125)            // '}'
      endif
    elseif v.isArray() then
      var a: JsonArray := v.asArray()
      var m: integer := a.length()
      if m == 0 then
        sb.appendStr("[]")
      else
        sb.appendChar(91)             // '['
        sb.appendChar(10)
        var j: integer := 0
        while j < m do
          jsonIndent(sb, depth + 1)
          prettyOn(sb, a.at(j), depth + 1)
          if j < m - 1 then
            sb.appendChar(44)
          endif
          sb.appendChar(10)
          j := j + 1
        endwh
        jsonIndent(sb, depth)
        sb.appendChar(93)             // ']'
      endif
    else
      v.writeTo(sb)                   // escalar: reusa la forma compacta
    endif
  end prettyOn

  public function readJsonFile(path: string): JsonValue
    return parseJson(readFile(path))
  end readJsonFile

  public function writeJsonFile(path: string, root: JsonValue)
    writeFile(path, root.toJson())
  end writeJsonFile

end Json
