// ============================================================
// Gpio.bp — módulo stdlib para control de pines GPIO.
//
// Todas las funciones son `intrinsic`: el compilador inlina
// CALL_BUILTIN <id> en el call-site. La implementación concreta
// depende de la plataforma:
//
//   - VM Java (PC, x86):  loggea las acciones por stdout —
//                          útil para desarrollo sin hardware.
//   - VM C en Raspberry Pi Pico 2: el handler de builtin llama
//                          al SDK del Pico (`gpio_init`, `gpio_put`,
//                          `gpio_get`, `gpio_set_dir`, `gpio_pull_up/down`).
//   - VM C en otros hosts: stubs no-op + logging por stdout.
//
// Convenciones de modos y valores:
//   mode    : 0 = INPUT,    1 = OUTPUT
//   value   : 0 = LOW,      cualquier otra cosa = HIGH
//   pull    : 0 = none,     1 = up,   2 = down
// ============================================================
module Gpio

  import Core   // V6: los tipos de Core se importan

  // H7.3 — board-aware: el constructor Gpio.Pin valida el número de
  // pin contra Machine.gpioCount() (30 en RP2350A/Pico, 48 en RP2350B/Metro).
  import Machine

  // Configura el modo del pin (entrada o salida).
  // Llamar UNA vez por pin antes de read/write.
  public function init(pin: integer, mode: integer)
    inline CALL_BUILTIN 78
  end init

  // Configura resistencia de pull-up/pull-down. 0=none, 1=up, 2=down.
  public function pull(pin: integer, pullMode: integer)
    inline CALL_BUILTIN 81
  end pull

  // Escribe en un pin configurado como OUTPUT.
  // value: 0=LOW, !=0=HIGH.
  public function write(pin: integer, value: integer)
    inline CALL_BUILTIN 79
  end write

  // Lee un pin configurado como INPUT. Devuelve 0 o 1.
  public function read(pin: integer): integer
    inline CALL_BUILTIN 80
  end read
  // V7/H4 (#479) — el pin vuelve a libre en el común (el estado que hace comprobable
  // «analógico ⇒ no digital»); lo llama Pin.release() y ~Pin().
  public function release(pin: integer)
    inline CALL_BUILTIN 254
  end release
  // V7/H4 — el ADC por PIN: (unidad, canal) del mapa de capacidades; devuelve el canal.
  public function __adcInitPin(pin: integer): integer
    inline CALL_BUILTIN 255
  end __adcInitPin
  public function __adcReadChannel(ch: integer): integer
    inline CALL_BUILTIN 115
  end __adcReadChannel

  // -------- Constantes públicas para los enums --------
  // (Definidas como funciones intrínsecas de 0 args para mantener la
  // simplicidad del modelo — el compilador inlina el literal en la
  // pila. Alternativa más bonita: `public const INPUT: integer = 0`
  // tras N-const-stdlib, pendiente.)
  public function INPUT(): integer
    return 0
  end INPUT
  public function OUTPUT(): integer
    return 1
  end OUTPUT
  public function LOW(): integer
    return 0
  end LOW
  public function HIGH(): integer
    return 1
  end HIGH
  public function PULL_NONE(): integer
    return 0
  end PULL_NONE
  public function PULL_UP(): integer
    return 1
  end PULL_UP
  public function PULL_DOWN(): integer
    return 2
  end PULL_DOWN

  // ============================================================
  // Clase Pin — wrapper OO sobre los intrínsecos de arriba.
  //
  // Cada instancia encapsula el número de pin físico, así que el
  // código de usuario no tiene que repetir el número en cada
  // operación. Constructor `Pin(num, mode)` configura el pin
  // automáticamente. Los métodos `on()`/`off()` son la forma
  // canónica de escribir HIGH/LOW.
  //
  // Uso típico:
  //
  //   import Gpio
  //   var led: Gpio.Pin := Gpio.Pin(25, Gpio.Pin.OUTPUT)
  //   led.on()
  //   sleep(500)
  //   led.off()
  //
  //   var boton: Gpio.Pin := Gpio.Pin(14, Gpio.Pin.INPUT)
  //   boton.setPull(Gpio.Pin.PULL_UP)
  //   if boton.isLow() then
  //     print "pulsado"
  //   endif
  // ============================================================
  public class Pin

    // Static consts accesibles como `Gpio.Pin.OUTPUT`, etc.
    public const Pin.INPUT:     integer := 0
    public const Pin.OUTPUT:    integer := 1
    public const Pin.OPEN_COLLECTOR: integer := 2   // V7/H4: salida en colector abierto, donde el silicio la tiene (ESP32, STM32)
    public const Pin.ANALOG:    integer := 3        // V7/H4: entrada de ADC; lo pone AnPin
    public const Pin.PULL_NONE: integer := 0
    public const Pin.PULL_UP:   integer := 1
    public const Pin.PULL_DOWN: integer := 2

    public property num:  integer    // número de pin físico (GP0..GP29)
    public property mode: integer    // INPUT (0) u OUTPUT (1)
    // V7 #667: lo que tomó es suyo (se lo dieron: el constructor no lanzó). release() y el destructor sólo
    // sueltan lo suyo, una vez: un objeto cuyo constructor lanzó también se destruye (#668), y no tiene nada.
    var tomado_: boolean

    // Constructor: configura el pin en el modo indicado. V7/H4 (#479): la validación la hace
    // el común contra la TABLA de capacidades del micro y el estado de los pines, con nombre
    // («el pin 99 no existe en esp32c5», «el pin 26 es analógico (AnPin): primero release()»,
    // «el pin 5 de rp2350a no puede salir en colector abierto») — el mismo texto en las dos VMs.
    public function Pin(num: integer, mode: integer)
      this.num  := num
      this.mode := mode
      init(num, mode)
      this.tomado_ := true
    end Pin

    // El pin vuelve a libre: otro objeto (o un AnPin) puede tomarlo; y, V7 #667, a como estaba en el reset (una
    // salida deja de serlo). Lo llama el destructor.
    public function release()
      if this.tomado_ then
        this.tomado_ := false
        release(this.num)
      endif
    end release

    public function ~Pin()
      this.release()
    end ~Pin

    // V7 #667 (8-oct) — tras release() el objeto ya no tiene su recurso: usarlo es un error con nombre, no un
    // silencio (el canal que soltó puede ser ya de otro objeto).
    function vivo_()
      if not this.tomado_ then
        throw RuntimeError("Gpio.Pin " + intToString(this.num) + ": ya se soltó con release()")
      endif
    end vivo_

    // Pone el pin a HIGH (sólo válido si es OUTPUT).
    public function on()
      this.vivo_()
      write(this.num, 1)
    end on

    // Pone el pin a LOW (sólo válido si es OUTPUT).
    public function off()
      this.vivo_()
      write(this.num, 0)
    end off

    // Conmuta el pin (HIGH↔LOW). Comodidad para parpadeos.
    public function toggle()
      this.vivo_()
      var v: integer := read(this.num)
      if v == 0 then
        write(this.num, 1)
      else
        write(this.num, 0)
      endif
    end toggle

    // Lee el estado del pin. Devuelve 0 o 1.
    public function value(): integer
      this.vivo_()
      return read(this.num)
    end value

    // Conveniencia: true si el pin lee HIGH (1).
    public function isHigh(): boolean
      this.vivo_()
      return read(this.num) == 1
    end isHigh

    // Conveniencia: true si el pin lee LOW (0).
    public function isLow(): boolean
      this.vivo_()
      return read(this.num) == 0
    end isLow

    // Configura la resistencia interna del pin (sólo útil en INPUT).
    //   pullMode: Pin.PULL_NONE / Pin.PULL_UP / Pin.PULL_DOWN
    // Nombre distinto del intrínseco `pull` del módulo para evitar
    // la colisión de nombres dentro de la clase.
    public function setPull(pullMode: integer)
      this.vivo_()
      pull(this.num, pullMode)
    end setPull
  end Pin

  // ============================================================
  // V7/H4 (#479) — AnPin: un pin ANALÓGICO, que ES un pin (decisión de Eduardo, 6-sep: «como un
  // pin físico puede ser o analógico o digital, AnPin desciende de Pin»). Lo que su invariante
  // prohíbe —on()/off()/value() de un pin analógico— lo para el común con un error con nombre.
  // El (unidad, canal) sale del MAPA del micro: en un S3 el GPIO 4 es ADC1 canal 3, en la Pico
  // el 26 es el canal 0. Hoy las imágenes atienden la unidad 1; la 2 avisa con nombre.
  //   var luz: Gpio.AnPin := Gpio.AnPin(26)
  //   print luz.read(), luz.readVolts()
  // ============================================================
  public class AnPin extends Pin
    private var ch: integer

    public function AnPin(num: integer)
      super(num, Pin.ANALOG)            // el estado en el común: analógico ⇒ no digital
      this.ch := __adcInitPin(num)      // y el hardware: (unidad, canal) del mapa
    end AnPin

    // El canal de ADC (de la unidad 1) al que está conectado este pin.
    public function channel(): integer
      return this.ch
    end channel

    // UNA lectura, 0..4095; si el backend no puede, RuntimeError (como Adc.Channel).
    public function read(): integer
      this.vivo_()
      var raw: integer := __adcReadChannel(this.ch)
      if raw < 0 then
        throw RuntimeError("AnPin.read: el pin " + intToString(this.num) + " no se pudo leer")
      endif
      return raw
    end read

    public function readVolts(): float
      return float(this.read()) * 3.3 / 4095.0
    end readVolts
  end AnPin
end Gpio
