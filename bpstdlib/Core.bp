// Core.bp — núcleo del modelo de excepciones (#248).
//
// Jerarquía decidida (2026-06-10): Object -> Exception -> RuntimeError | resto.
// UNA sola clase real en toda la VM (identidad por puntero único, cross-module
// via la maquinaria L2 v3: factory __cls_new_*, TRY_BEGIN_EXT, extends/instanceof
// cross-module) — sustituye a las copias per-módulo sintetizadas por el emitter.
//
// INVARIANTE de layout: `msg` es el PRIMER miembro de Exception → backing field
// en el SLOT 0 de toda excepción (RuntimeError no añade campos; las clases de
// usuario heredan msg en 0 y añaden los suyos después). Los throws nativos de
// las VMs (div0, null deref, OOB...) construyen RuntimeError escribiendo
// slot 0 = msgRef directamente, sin ejecutar el constructor — ese atajo es
// correcto POR CONSTRUCCIÓN gracias a este invariante (y es lo que desbloquea
// #213: throw de clases de usuario desde native).
module Core

  // ------------------------------------------------------------------------------
  // LAS CLASES DEL LENGUAJE (H1 P3, 20-sep) — Object, Thread, Mutex y StringBuilder,
  // escritas en BP y compiladas UNA vez aquí. Hasta V7 el compilador las sintetizaba
  // en Java y las COPIABA en cada .mod (≈1,3 KB por módulo, con hilos o sin ellos).
  // `root class` = no desciende de nada (sólo la raíz puede escribirlo). El ORDEN de
  // campos y métodos es un contrato con las dos VMs: __threadStart lee el tid en el
  // campo 0 y el stackSize en el 1, y arranca run() por la RANURA 0 de la vtable (por
  // eso Thread es root: si descendiera de Object, la 0 sería toString); __mutexLock
  // lee __mid en el campo 0. No mover nada de sitio.
  // ------------------------------------------------------------------------------

  // La raíz de toda clase que no diga otra cosa. toString ranura 0, compareTo ranura 1.
  public root class Object
    public function toString(): string
      return "object@" + __refToString(this)
    end toString

    // Por defecto lanza: comparar objetos sin sobrescribirlo es un error de programación
    // que debe salir a la luz, no «iguales».
    public function compareTo(other: Object): integer
      __throwRte("compareTo() no implementado: la clase no sobrescribe Object.compareTo")
      return 0
    end compareTo

    // El destructor (V7/H1, 21-sep): «qué significa destruir esto» se escribe UNA vez, en la
    // clase; lo llama el lenguaje al morir un `var owner` local (y no el usuario). Aquí, nada:
    // una clase que tenga un recurso externo lo sobrescribe y lo libera. Al acabar el de una
    // hija corre el de su padre.
    public function ~Object()
    end ~Object
  end Object

  // Un hilo preemptivo de la VM. Se subclasea, se sobrescribe run(), y start()/join().
  public root class Thread
    var __tid: integer         // campo 0 — id del hilo (0 = sin arrancar); lo escribe la VM
    var __stackSize: integer   // campo 1 — lo lee __threadStart (0 = por defecto)

    public function Thread(stackSize: integer)
      this.__tid := 0
      this.__stackSize := stackSize
    end Thread

    public function run()      // ranura 0: la que arranca la VM
    end run

    public function start()
      __threadStart(this)
    end start

    public function join()
      __threadJoin(this)
    end join

    public function toString(): string   // #526: Thread no es Object, así que lo lleva ella
      return "thread@" + __refToString(this)
    end toString

    public function ~Thread()            // raíz: su destructor vacío, para que sus hijas encadenen
    end ~Thread
  end Thread

  // Exclusión mutua entre hilos. NO es reentrante: lock() dos veces desde el mismo hilo
  // es error. unlock() despierta al primer hilo que esperaba.
  public class Mutex
    var __mid: integer         // campo 0 — índice del mutex en la VM

    public function Mutex()
      this.__mid := __mutexCreate()
    end Mutex

    public function lock()
      __mutexLock(this)
    end lock

    public function unlock()
      __mutexUnlock(this)
    end unlock
  end Mutex

  // Construcción eficiente de strings: acumula code points y los vuelca en toString().
  public class StringBuilder
    var chars: integer[]
    var size: integer
    var cap: integer

    public function StringBuilder()
      this.chars := newIntArray(64)
      this.size := 0
      this.cap := 64
    end StringBuilder

    public function appendChar(c: integer)
      if this.size >= this.cap then
        this.cap := this.cap * 2
        this.chars := __growIntArray(this.chars, this.cap)
      endif
      this.chars[this.size] := c
      this.size := this.size + 1
    end appendChar

    public function appendStr(s: string)
      var n: integer := strlen(s)
      var i: integer := 0
      while i < n do
        this.appendChar(charCodeAt(s, i))
        i := i + 1
      endwh
    end appendStr

    public function appendInt(n: integer)
      this.appendStr(intToString(n))
    end appendInt

    public function toString(): string
      return __charsToString(this.chars, this.size)
    end toString

    public function length(): integer
      return this.size
    end length
  end StringBuilder

  // Base de TODAS las excepciones. `msg` como property pública: el backing
  // field queda en slot 0 y los accesores viajan en la .bpi (los fields raw
  // no se exportan cross-module — decisión #143).
  public class Exception
    public property msg: string

    public function Exception(m: string)
      this.msg := m
    end Exception

    // V6/#459 — una excepcion se imprime como su MENSAJE, no como `object@1234`.
    // Es el slot 0 de la vtable (heredado de Object), asi que esto lo SOBRESCRIBE
    // y no corre ningun slot; el layout de campos tampoco cambia, que importa
    // porque las dos VMs asumen `campo 0 = msg` al fabricar un RuntimeError.
    // Lo hereda RuntimeError y cualquier excepcion de usuario.
    public function toString(): string
      return this.msg
    end toString
  end Exception

  // Errores nativos de la VM (división por cero, null deref, índice fuera de
  // rango, faults de native/AOT...). Sin campos propios: msg queda en slot 0.
  public class RuntimeError extends Exception
    public function RuntimeError(m: string)
      super(m)
    end RuntimeError
  end RuntimeError

  // -------------------------------------------------------------
  // #446 — COMPARABLE Y LOS ENVOLTORIOS, traidos de Collections el 18-ago.
  //
  // Vienen porque `List` se muda aqui (decision de Eduardo: «la list
  // sintetizada deberia desaparecer y utilizar la de Core») y sus
  // sobrecargas de `add` los necesitan para envolver los escalares. Si se
  // quedaran en Collections, Core tendria que importar Collections y
  // Collections a Core — circular.
  //
  // Ayer esto no se podia: `NaturalComparator` se queda en Collections y
  // baja a `Comparable`, o sea un downcast cross-module, que REVENTABA el
  // compilador. Lo arreglo #444 esta misma tarde.
  // -------------------------------------------------------------
  // Comparable + envoltorios (boxing MANUAL de primitivos).
  // Los contenedores trabajan con Object; para meter un primitivo se
  // envuelve a mano: Integer(5), Double(3.14)... Para sacarlo: .value().
  // Campos privados (no se exportan cross-module) → unboxing por método.
  // Integer/Long/Double/Float/Boolean funcionan same-module y cross-module
  // (BUG-6 cerrado: campos de instancia de 8 bytes long/double + paso de
  //  args de 8 bytes en métodos virtuales, ambas VMs en paridad).
  // -------------------------------------------------------------

  // Base de claves/valores ordenables. compareTo: -1 / 0 / 1.
  public class Comparable
    public function Comparable()
    end Comparable
    public function compareTo(other: Object): integer
      return 0
    end compareTo

    // ── Conversiones (V5, 19-ago) ─────────────────────────────────────────
    // Viven AQUI y no en cada envoltorio suelto porque hacen falta para los
    // captadores tipados de `List`, y BP no tiene con que preguntarle su tipo a
    // un `Object`: no hay `is`, ni `instanceof`, ni `typeof`. La salida en un
    // lenguaje OO es esta — que cada clase sepa convertirse a si misma y el
    // despacho virtual haga el resto. Sin excepciones en el camino normal y sin
    // tocar el formato del `.mod`, que en V5 esta congelado.
    //
    // (La alternativa buena, `className()` sobre el objeto, no cabia: el
    // descriptor de clase NO guarda el nombre —el que sale en el error de un
    // cast viene de un operando que pone el compilador— asi que exigia meterlo
    // en el descriptor. Aplazado a V6.)
    //
    // Aqui la implementacion por defecto FALLA a proposito: si una clase no
    // sabe volverse numero, pedirselo es un error del programa, no un cero.
    public function toInteger(): integer
      throw RuntimeError("no se puede convertir a integer")
    end toInteger
    public function toLong(): long
      throw RuntimeError("no se puede convertir a long")
    end toLong
    public function toFloat(): float
      throw RuntimeError("no se puede convertir a float")
    end toFloat
    public function toDouble(): double
      throw RuntimeError("no se puede convertir a double")
    end toDouble
    public function toBoolean(): boolean
      throw RuntimeError("no se puede convertir a boolean")
    end toBoolean
  end Comparable

  public class Integer extends Comparable
    var v: integer
    public function Integer(x: integer)
      super()
      this.v := x
    end Integer
    public function value(): integer
      return this.v
    end value
    public function compareTo(other: Object): integer
      var o: Integer := Integer(other)
      if this.v < o.v then
        return -1
      endif
      if this.v > o.v then
        return 1
      endif
      return 0
    end compareTo
    public function toString(): string
      return intToString(this.v)
    end toString

    public function toInteger(): integer
      return this.v
    end toInteger
    public function toLong(): long
      return long(this.v)
    end toLong
    public function toFloat(): float
      return float(this.v)
    end toFloat
    public function toDouble(): double
      return double(this.v)
    end toDouble
  end Integer

  public class Long extends Comparable
    var v: long
    public function Long(x: long)
      super()
      this.v := x
    end Long
    public function value(): long
      return this.v
    end value
    public function compareTo(other: Object): integer
      var o: Long := Long(other)
      if this.v < o.v then
        return -1
      endif
      if this.v > o.v then
        return 1
      endif
      return 0
    end compareTo
    public function toString(): string
      return longToString(this.v)
    end toString

    public function toInteger(): integer
      if this.v > 2147483647L or this.v < -2147483648L then
        throw RuntimeError("el valor no cabe en un integer")
      endif
      return integer(this.v)
    end toInteger
    public function toLong(): long
      return this.v
    end toLong
    public function toFloat(): float
      return float(this.v)
    end toFloat
    public function toDouble(): double
      return double(this.v)
    end toDouble
  end Long

  public class Double extends Comparable
    var v: double
    public function Double(x: double)
      super()
      this.v := x
    end Double
    public function value(): double
      return this.v
    end value
    public function compareTo(other: Object): integer
      var o: Double := Double(other)
      if this.v < o.v then
        return -1
      endif
      if this.v > o.v then
        return 1
      endif
      return 0
    end compareTo
    public function toString(): string
      return doubleToString(this.v)
    end toString

    public function toInteger(): integer
      if this.v > 2147483647.0d or this.v < -2147483648.0d then
        throw RuntimeError("el valor no cabe en un integer")
      endif
      return integer(this.v)
    end toInteger
    public function toLong(): long
      return long(this.v)
    end toLong
    public function toFloat(): float
      return float(this.v)
    end toFloat
    public function toDouble(): double
      return this.v
    end toDouble
  end Double

  public class Float extends Comparable
    var v: float
    public function Float(x: float)
      super()
      this.v := x
    end Float
    public function value(): float
      return this.v
    end value
    public function compareTo(other: Object): integer
      var o: Float := Float(other)
      if this.v < o.v then
        return -1
      endif
      if this.v > o.v then
        return 1
      endif
      return 0
    end compareTo
    public function toString(): string
      return doubleToString(this.v)
    end toString

    public function toInteger(): integer
      if double(this.v) > 2147483647.0d or double(this.v) < -2147483648.0d then
        throw RuntimeError("el valor no cabe en un integer")
      endif
      return integer(this.v)
    end toInteger
    public function toLong(): long
      return long(this.v)
    end toLong
    public function toFloat(): float
      return this.v
    end toFloat
    public function toDouble(): double
      return double(this.v)
    end toDouble
  end Float

  public class Boolean extends Comparable
    var v: boolean
    public function Boolean(x: boolean)
      super()
      this.v := x
    end Boolean
    public function value(): boolean
      return this.v
    end value
    public function compareTo(other: Object): integer
      var o: Boolean := Boolean(other)
      if (not this.v) and o.v then
        return -1
      endif
      if this.v and (not o.v) then
        return 1
      endif
      return 0
    end compareTo
    public function toString(): string
      return boolToString(this.v)
    end toString

    // `False`=0 y `True`=1 (decision de Eduardo, 19-ago). Al reves NO: un
    // numero no se convierte a booleano, que ahi no hay convenio evidente.
    public function toInteger(): integer
      if this.v then
        return 1
      endif
      return 0
    end toInteger
    public function toLong(): long
      return long(this.toInteger())
    end toLong
    public function toFloat(): float
      return float(this.toInteger())
    end toFloat
    public function toDouble(): double
      return double(this.toInteger())
    end toDouble
    public function toBoolean(): boolean
      return this.v
    end toBoolean
  end Boolean

  // -------------------------------------------------------------
  // #446 — formateo de double, traido de Str.
  //
  // Viene porque los envoltorios Double/Float lo usan en su toString(), y
  // Core no puede importar Str: Str usa excepciones, o sea que ya importa
  // Core implicitamente y seria circular.
  //
  // Y NO vale sustituirlo por `"" + x`: MEDIDO el 18-ago, coinciden en los
  // casos normales pero NO en los extremos — el concat da 1E12 y 1E-9
  // donde esto da 1000000000000 y 0. Cambiarlo movia la salida.
  // -------------------------------------------------------------

  public function formatDouble(x: double, dec: integer): string
    var neg: boolean := x < 0.0
    var ax: double := x
    if neg then
      ax := -ax
    endif
    var scale: long := 1
    var i: integer := 0
    while i < dec do
      scale := scale * 10
      i := i + 1
    endwh
    var scaled: long := long(ax * double(scale) + 0.5)
    if scaled == 0 then
      neg := false                  // evita "-0.00"
    endif
    var intPart: long := scaled / scale
    var fracPart: long := scaled mod scale
    var sb: StringBuilder := StringBuilder()
    if neg then
      sb.appendChar(45)             // '-'
    endif
    sb.appendStr(longToString(intPart))
    if dec > 0 then
      sb.appendChar(46)             // '.'
      var fs: string := longToString(fracPart)
      var pad: integer := dec - strlen(fs)
      var k: integer := 0
      while k < pad do
        sb.appendChar(48)           // '0' de relleno a la izquierda
        k := k + 1
      endwh
      sb.appendStr(fs)
    endif
    return sb.toString()
  end formatDouble

  public function doubleToString(x: double): string
    var s: string := formatDouble(x, 6)    // dec=6 → siempre incluye '.'
    var stop: integer := strlen(s)
    while stop > 0 and charCodeAt(s, stop - 1) == 48 do   // quita '0'
      stop := stop - 1
    endwh
    if stop > 0 and charCodeAt(s, stop - 1) == 46 then     // quita '.' suelto
      stop := stop - 1
    endif
    return substring(s, 0, stop)
  end doubleToString

  // #446 — traida de Str: la usa formatDouble.
  public function longToString(x: long): string
    if x == 0 then
      return "0"
    endif
    var neg: boolean := x < 0
    var v: long := x
    if not neg then
      v := -v                       // ahora v <= 0 siempre
    endif
    var digits: integer[] := newIntArray(24)
    var nd: integer := 0
    while v < 0 do
      var d: integer := integer(-(v mod 10))   // 0..9 (v es negativo)
      digits[nd] := d
      nd := nd + 1
      v := v / 10
    endwh
    var sb: StringBuilder := StringBuilder()
    if neg then
      sb.appendChar(45)             // '-'
    endif
    var i: integer := nd - 1
    while i >= 0 do
      sb.appendChar(48 + digits[i]) // '0' + dígito
      i := i - 1
    endwh
    return sb.toString()
  end longToString

  // -------------------------------------------------------------
  // #448 — LIST, en BP y en Core.
  //
  // Decision de Eduardo (18-ago): «la list sintetizada deberia desaparecer
  // (se puede comentar) y utilizar la de Core». El motivo por el que se
  // sintetizaba —«para poder usarla sin import»— ya lo da el import
  // implicito de Core.
  //
  // Que hacia falta para poder escribirla aqui, y se hizo hoy:
  //   #442  un literal de array guardaba SIEMPRE 4 bytes por casilla
  //   #443  newObjArray/growObjArray: crear un array de refs POR TAMANO
  //   #444  el downcast a una clase de otro modulo (Integer(o) desde fuera)
  //   #447  el downcast a la PROPIA clase (Integer(other) en su compareTo)
  //
  // El `add` sobrecargado es el diseno de Eduardo: «add(i:integer) lo que
  // hace es llamar a add(obj:Object) y le pasa Integer(i). Los object,
  // strings y arrays en teoria no hace falta envolverlos.»
  //
  // Y esa delegacion es VIRTUAL, lo que hace que las subclases hereden las
  // sobrecargas sin copiarlas: a SyncList le basta con su add(Object) con
  // lock (medido en samples/ListaHer.bp).
  //
  // ⚠️ La PRIMERA firma es la de Object a proposito: por la regla de H5.a la
  // primera lleva el nombre pelado y el resto van mangleadas, asi que el
  // simbolo `add` sigue significando lo de siempre.
  // -------------------------------------------------------------

  public class List
    var items: Object[]
    var size:  integer
    var cap:   integer

    public function List()
      this.cap   := 4
      this.size  := 0
      this.items := newObjArray(this.cap)
    end List

    public function add(o: Object)
      if this.size >= this.cap then
        this.grow()
      endif
      this.items[this.size] := o
      this.size := this.size + 1
    end add


    // Las sobrecargas: envuelven el escalar y DELEGAN. Nada de casos
    // especiales en el compilador.
    public function add(i: integer)
      this.add(Integer(i))
    end add
    public function add(l: long)
      this.add(Long(l))
    end add
    public function add(d: double)
      this.add(Double(d))
    end add
    public function add(f: float)
      this.add(Float(f))
    end add
    public function add(b: boolean)
      this.add(Boolean(b))
    end add

    public function get(idx: integer): Object
      return this.items[idx]
    end get

    public function set(idx: integer, o: Object)
      this.items[idx] := o
    end set

    // ── Captadores TIPADOS (V5, 19-ago — encargo de Eduardo) ─────────────
    // `get` devuelve `Object`, asi que todo uso tipado pedia un downcast en
    // CADA sitio. El coste estaba medido: arreglar `Json.bp` fueron 8 casts,
    // los 8 el mismo patron. Esto lo escribe UNA vez, aqui.
    //
    // No son casts: CONVIERTEN. `getInteger` sobre un `Long` que cabe da el
    // numero; si no cabe, LANZA — perder informacion es un error, no un
    // redondeo silencioso (misma razon que #385). `double`->entero trunca
    // HACIA CERO, que es lo que ya hace el cast del lenguaje: -2,7 -> -2, y ojo
    // que `floor` daria -3. Para redondear esta `round()`, que para eso esta.
    //
    // Lo que NO hacen: parsear cadenas. Hacia `string` la conversion es
    // implicita porque no puede fallar; desde `string` falla por el CONTENIDO,
    // y eso se pide aparte con `Str.parseInt` y compania, que devuelven
    // `(ok, valor)` en vez de lanzar.
    public function getString(idx: integer): string
      var o: Object := this.get(idx)
      // Una CADENA no despacha metodos (no es un objeto con vtable), asi que
      // `o.toString()` peta con "el receptor no es un objeto". Y para separar
      // los dos casos no hay test de tipo en BP... salvo el cast `string(o)`,
      // que por dentro ES uno: `CHECKCAST` con clase 0 comprueba justo eso.
      // De ahi el try, que no es pereza: es el unico test de tipo disponible.
      // Con `className()` (V6) esto seria un `if` y se acabo.
      try
        return string(o)
      catch e: Exception
      endtry
      return o.toString()
    end getString

    public function getInteger(idx: integer): integer
      var c: Comparable := Comparable(this.get(idx))
      return c.toInteger()
    end getInteger

    public function getLong(idx: integer): long
      var c: Comparable := Comparable(this.get(idx))
      return c.toLong()
    end getLong

    public function getFloat(idx: integer): float
      var c: Comparable := Comparable(this.get(idx))
      return c.toFloat()
    end getFloat

    public function getDouble(idx: integer): double
      var c: Comparable := Comparable(this.get(idx))
      return c.toDouble()
    end getDouble

    public function getBoolean(idx: integer): boolean
      var c: Comparable := Comparable(this.get(idx))
      return c.toBoolean()
    end getBoolean

    public function length(): integer
      return this.size
    end length

    public function remove(idx: integer)
      var i: integer := idx
      while i < this.size - 1 do
        this.items[i] := this.items[i + 1]
        i := i + 1
      endwh
      this.size := this.size - 1
      this.items[this.size] := null
    end remove
    // V6/G2 — el crecimiento SEPARADO y virtual: es la unica operacion que
    // sustituye el array de respaldo, y una subclase que POSEA sus elementos
    // (OwnerList) necesita enterarse justo de eso. Sacarlo de add() es lo que
    // permite que OwnerList no reescriba add.
    public function grow()
      this.cap   := this.cap * 2
      this.items := growObjArray(this.items, this.cap)
    end grow

    // V6/G2 — el array de respaldo, para las subclases. Nacio como rodeo: hasta
    // V7 (#492, 14-sep-2026) un descendiente de OTRO modulo no veia `items`
    // porque la interfaz no publicaba campos. Desde V7 los campos protegidos
    // cruzan (`field items:Object[] slot n` en la interfaz) y `this.items` vale
    // desde cualquier modulo; el getter se queda por compatibilidad con quien
    // ya lo usa.
    public function backing(): Object[]
      return this.items
    end backing
  end List

  // ------------------------------------------------------------------------------
  // LAS PRIMITIVAS DE LA VM (H1, 20-sep) — una función por builtin, en orden de id. El
  // cuerpo es su bytecode (`inline CALL_BUILTIN <id>`, o el opcode directo): Builtin.java y
  // el enum de builtins.c se GENERAN de estas líneas (scripts/gen_builtins.py), y el id es
  // el número escrito: no se mueve. Las `public` se ven sin cualificar en todo programa
  // (Core es el módulo raíz); las demás son sólo la tabla: cada módulo de la stdlib declara
  // las suyas con el mismo número (Math.sin → 24). Las `__` son del compilador.
  // ------------------------------------------------------------------------------
  public function strlen(s: string): integer
    inline CALL_BUILTIN 0
  end strlen
  public function parseInt(s: string): integer
    inline CALL_BUILTIN 1
  end parseInt
  public function parseFloat(s: string): float
    inline CALL_BUILTIN 2
  end parseFloat
  public function intToString(n: integer): string
    inline CALL_BUILTIN 3
  end intToString
  public function floatToString(x: float): string
    inline CALL_BUILTIN 4
  end floatToString
  public function boolToString(b: boolean): string
    inline CALL_BUILTIN 5
  end boolToString
  public function upper(s: string): string
    inline CALL_BUILTIN 6
  end upper
  public function lower(s: string): string
    inline CALL_BUILTIN 7
  end lower
  public function trim(s: string): string
    inline CALL_BUILTIN 8
  end trim
  public function substring(s: string, start: integer, hasta: integer): string
    inline CALL_BUILTIN 9
  end substring
  public function indexOf(s: string, target: string): integer
