// Core.bp — núcleo del modelo de excepciones (#248).
//
// Jerarquía decidida (2026-06-10): Object -> Exception -> RuntimeError | resto.
// UNA sola clase real en toda la VM (identidad por puntero único, cross-module
// via la maquinaria L2 v3: factory __cls_new_*, TRY_BEGIN_EXT, extends/instanceof
// cross-module) — sustituye a las copias per-módulo sintetizadas por el emitter.
//
// INVARIANTE de layout: `msg` es el PRIMER miembro de Exception → backing field
// en el SLOT 0 de toda excepción (RuntimeError no añade campos; las clases de
// usuario heredan msg en 0 y añaden los suyos después). Los throws nativos de
// las VMs (div0, null deref, OOB...) construyen RuntimeError escribiendo
// slot 0 = msgRef directamente, sin ejecutar el constructor — ese atajo es
// correcto POR CONSTRUCCIÓN gracias a este invariante (y es lo que desbloquea
// #213: throw de clases de usuario desde native).
module Core

  // Base de TODAS las excepciones. `msg` como property pública: el backing
  // field queda en slot 0 y los accesores viajan en la .bpi (los fields raw
  // no se exportan cross-module — decisión #143).
  public class Exception
    public property msg: string

    public function Exception(m: string)
      this.msg := m
    end Exception
  end Exception

  // Errores nativos de la VM (división por cero, null deref, índice fuera de
  // rango, faults de native/AOT...). Sin campos propios: msg queda en slot 0.
  public class RuntimeError extends Exception
    public function RuntimeError(m: string)
      super(m)
    end RuntimeError
  end RuntimeError

  // -------------------------------------------------------------
  // #446 — COMPARABLE Y LOS ENVOLTORIOS, traidos de Collections el 18-ago.
  //
  // Vienen porque `List` se muda aqui (decision de Eduardo: «la list
  // sintetizada deberia desaparecer y utilizar la de Core») y sus
  // sobrecargas de `add` los necesitan para envolver los escalares. Si se
  // quedaran en Collections, Core tendria que importar Collections y
  // Collections a Core — circular.
  //
  // Ayer esto no se podia: `NaturalComparator` se queda en Collections y
  // baja a `Comparable`, o sea un downcast cross-module, que REVENTABA el
  // compilador. Lo arreglo #444 esta misma tarde.
  // -------------------------------------------------------------
  // Comparable + envoltorios (boxing MANUAL de primitivos).
  // Los contenedores trabajan con Object; para meter un primitivo se
  // envuelve a mano: Integer(5), Double(3.14)... Para sacarlo: .value().
  // Campos privados (no se exportan cross-module) → unboxing por método.
  // Integer/Long/Double/Float/Boolean funcionan same-module y cross-module
  // (BUG-6 cerrado: campos de instancia de 8 bytes long/double + paso de
  //  args de 8 bytes en métodos virtuales, ambas VMs en paridad).
  // -------------------------------------------------------------

  // Base de claves/valores ordenables. compareTo: -1 / 0 / 1.
  public class Comparable
    public function Comparable()
    end Comparable
    public function compareTo(other: Object): integer
      return 0
    end compareTo
  end Comparable

  public class Integer extends Comparable
    var v: integer
    public function Integer(x: integer)
      super()
      this.v := x
    end Integer
    public function value(): integer
      return this.v
    end value
    public function compareTo(other: Object): integer
      var o: Integer := Integer(other)
      if this.v < o.v then
        return -1
      endif
      if this.v > o.v then
        return 1
      endif
      return 0
    end compareTo
    public function toString(): string
      return intToString(this.v)
    end toString
  end Integer

  public class Long extends Comparable
    var v: long
    public function Long(x: long)
      super()
      this.v := x
    end Long
    public function value(): long
      return this.v
    end value
    public function compareTo(other: Object): integer
      var o: Long := Long(other)
      if this.v < o.v then
        return -1
      endif
      if this.v > o.v then
        return 1
      endif
      return 0
    end compareTo
    public function toString(): string
      return longToString(this.v)
    end toString
  end Long

  public class Double extends Comparable
    var v: double
    public function Double(x: double)
      super()
      this.v := x
    end Double
    public function value(): double
      return this.v
    end value
    public function compareTo(other: Object): integer
      var o: Double := Double(other)
      if this.v < o.v then
        return -1
      endif
      if this.v > o.v then
        return 1
      endif
      return 0
    end compareTo
    public function toString(): string
      return doubleToString(this.v)
    end toString
  end Double

  public class Float extends Comparable
    var v: float
    public function Float(x: float)
      super()
      this.v := x
    end Float
    public function value(): float
      return this.v
    end value
    public function compareTo(other: Object): integer
      var o: Float := Float(other)
      if this.v < o.v then
        return -1
      endif
      if this.v > o.v then
        return 1
      endif
      return 0
    end compareTo
    public function toString(): string
      return doubleToString(this.v)
    end toString
  end Float

  public class Boolean extends Comparable
    var v: boolean
    public function Boolean(x: boolean)
      super()
      this.v := x
    end Boolean
    public function value(): boolean
      return this.v
    end value
    public function compareTo(other: Object): integer
      var o: Boolean := Boolean(other)
      if (not this.v) and o.v then
        return -1
      endif
      if this.v and (not o.v) then
        return 1
      endif
      return 0
    end compareTo
    public function toString(): string
      return boolToString(this.v)
    end toString
  end Boolean

  // -------------------------------------------------------------
  // #446 — formateo de double, traido de Str.
  //
  // Viene porque los envoltorios Double/Float lo usan en su toString(), y
  // Core no puede importar Str: Str usa excepciones, o sea que ya importa
  // Core implicitamente y seria circular.
  //
  // Y NO vale sustituirlo por `"" + x`: MEDIDO el 18-ago, coinciden en los
  // casos normales pero NO en los extremos — el concat da 1E12 y 1E-9
  // donde esto da 1000000000000 y 0. Cambiarlo movia la salida.
  // -------------------------------------------------------------

  public function formatDouble(x: double, dec: integer): string
    var neg: boolean := x < 0.0
    var ax: double := x
    if neg then
      ax := -ax
    endif
    var scale: long := 1
    var i: integer := 0
    while i < dec do
      scale := scale * 10
      i := i + 1
    endwh
    var scaled: long := long(ax * double(scale) + 0.5)
    if scaled == 0 then
      neg := false                  // evita "-0.00"
    endif
    var intPart: long := scaled / scale
    var fracPart: long := scaled mod scale
    var sb: StringBuilder := StringBuilder()
    if neg then
      sb.appendChar(45)             // '-'
    endif
    sb.appendStr(longToString(intPart))
    if dec > 0 then
      sb.appendChar(46)             // '.'
      var fs: string := longToString(fracPart)
      var pad: integer := dec - strlen(fs)
      var k: integer := 0
      while k < pad do
        sb.appendChar(48)           // '0' de relleno a la izquierda
        k := k + 1
      endwh
      sb.appendStr(fs)
    endif
    return sb.toString()
  end formatDouble

  public function doubleToString(x: double): string
    var s: string := formatDouble(x, 6)    // dec=6 → siempre incluye '.'
    var stop: integer := strlen(s)
    while stop > 0 and charCodeAt(s, stop - 1) == 48 do   // quita '0'
      stop := stop - 1
    endwh
    if stop > 0 and charCodeAt(s, stop - 1) == 46 then     // quita '.' suelto
      stop := stop - 1
    endif
    return substring(s, 0, stop)
  end doubleToString

  // #446 — traida de Str: la usa formatDouble.
  public function longToString(x: long): string
    if x == 0 then
      return "0"
    endif
    var neg: boolean := x < 0
    var v: long := x
    if not neg then
      v := -v                       // ahora v <= 0 siempre
    endif
    var digits: integer[] := newIntArray(24)
    var nd: integer := 0
    while v < 0 do
      var d: integer := integer(-(v mod 10))   // 0..9 (v es negativo)
      digits[nd] := d
      nd := nd + 1
      v := v / 10
    endwh
    var sb: StringBuilder := StringBuilder()
    if neg then
      sb.appendChar(45)             // '-'
    endif
    var i: integer := nd - 1
    while i >= 0 do
      sb.appendChar(48 + digits[i]) // '0' + dígito
      i := i - 1
    endwh
    return sb.toString()
  end longToString

  // -------------------------------------------------------------
  // #448 — LIST, en BP y en Core.
  //
  // Decision de Eduardo (18-ago): «la list sintetizada deberia desaparecer
  // (se puede comentar) y utilizar la de Core». El motivo por el que se
  // sintetizaba —«para poder usarla sin import»— ya lo da el import
  // implicito de Core.
  //
  // Que hacia falta para poder escribirla aqui, y se hizo hoy:
  //   #442  un literal de array guardaba SIEMPRE 4 bytes por casilla
  //   #443  newObjArray/growObjArray: crear un array de refs POR TAMANO
  //   #444  el downcast a una clase de otro modulo (Integer(o) desde fuera)
  //   #447  el downcast a la PROPIA clase (Integer(other) en su compareTo)
  //
  // El `add` sobrecargado es el diseno de Eduardo: «add(i:integer) lo que
  // hace es llamar a add(obj:Object) y le pasa Integer(i). Los object,
  // strings y arrays en teoria no hace falta envolverlos.»
  //
  // Y esa delegacion es VIRTUAL, lo que hace que las subclases hereden las
  // sobrecargas sin copiarlas: a SyncList le basta con su add(Object) con
  // lock (medido en samples/ListaHer.bp).
  //
  // ⚠️ La PRIMERA firma es la de Object a proposito: por la regla de H5.a la
  // primera lleva el nombre pelado y el resto van mangleadas, asi que el
  // simbolo `add` sigue significando lo de siempre.
  // -------------------------------------------------------------

  public class List
    var items: Object[]
    var size:  integer
    var cap:   integer

    public function List()
      this.cap   := 4
      this.size  := 0
      this.items := newObjArray(this.cap)
    end List

    public function add(o: Object)
      if this.size >= this.cap then
        this.cap   := this.cap * 2
        this.items := growObjArray(this.items, this.cap)
      endif
      this.items[this.size] := o
      this.size := this.size + 1
    end add

    // Las sobrecargas: envuelven el escalar y DELEGAN. Nada de casos
    // especiales en el compilador.
    public function add(i: integer)
      this.add(Integer(i))
    end add
    public function add(l: long)
      this.add(Long(l))
    end add
    public function add(d: double)
      this.add(Double(d))
    end add
    public function add(f: float)
      this.add(Float(f))
    end add
    public function add(b: boolean)
      this.add(Boolean(b))
    end add

    public function get(idx: integer): Object
      return this.items[idx]
    end get

    public function set(idx: integer, o: Object)
      this.items[idx] := o
    end set

    public function length(): integer
      return this.size
    end length

    public function remove(idx: integer)
      var i: integer := idx
      while i < this.size - 1 do
        this.items[i] := this.items[i + 1]
        i := i + 1
      endwh
      this.size := this.size - 1
      this.items[this.size] := null
    end remove
  end List

  // -------------------------------------------------------------
  // #451 — SyncList esta AQUI y no en Collections, que es donde Eduardo
  // la queria, por un motivo concreto y medido: sus metodos con cerrojo
  // llaman a `super.add(...)`, y **un `super` cross-module no se puede
  // hacer hoy** — un modulo NO exporta sus metodos (solo __init y los
  // __cls_new_/__cls_init_), asi que no hay simbolo al que llamar; se
  // llega por vtable. `OwnerList` si esta en Collections porque solo usa
  // llamadas VIRTUALES (this.get / this.remove), que si cruzan.
  //
  // Se mueve a Collections en cuanto exista el super cross-module (ficha
  // #451). Mientras tanto vive junto a su base, que es lo unico que
  // funciona sin dejar el reparto a medias.
  // -------------------------------------------------------------

  // Lista con cerrojo: cada operacion es atomica de por si. NO hace atomica
  // una SECUENCIA de operaciones — para eso, un Mutex del llamante.
  public class SyncList extends List
    var mtx: Mutex

    public function SyncList()
      super()
      this.mtx := Mutex()
    end SyncList

    // Las cinco con cerrojo. Ojo: SOLO se redefine add(Object) — las
    // sobrecargas add(integer/long/...) se heredan de List y delegan en
    // `this.add(o)`, que despacha por vtable y acaba AQUI, con el cerrojo
    // puesto (medido en samples/ListaHer.bp).
    public function add(o: Object)
      this.mtx.lock()
      super.add(o)
      this.mtx.unlock()
    end add

    public function get(idx: integer): Object
      this.mtx.lock()
      var r: Object := super.get(idx)
      this.mtx.unlock()
      return r
    end get

    public function set(idx: integer, o: Object)
      this.mtx.lock()
      super.set(idx, o)
      this.mtx.unlock()
    end set

    public function length(): integer
      this.mtx.lock()
      var n: integer := super.length()
      this.mtx.unlock()
      return n
    end length

    public function remove(idx: integer)
      this.mtx.lock()
      super.remove(idx)
      this.mtx.unlock()
    end remove

    // Propio de SyncList: sacar el ultimo de forma atomica (cola LIFO).
    public function pop(): Object
      this.mtx.lock()
      var r: Object := null
      var n: integer := super.length()
      if n > 0 then
        r := super.get(n - 1)
        super.remove(n - 1)
      endif
      this.mtx.unlock()
      return r
    end pop

    // Espera hasta que haya algo. El sleep(1) cede el turno: un spin a secas
    // se comeria el nucleo y, en el planificador propio, podria no dejar
    // avanzar al que tiene que meter el dato.
    public function popBlocking(): Object
      var r: Object := this.pop()
      while r == null do
        sleep(1)
        r := this.pop()
      endwh
      return r
    end popBlocking
  end SyncList


end Core
